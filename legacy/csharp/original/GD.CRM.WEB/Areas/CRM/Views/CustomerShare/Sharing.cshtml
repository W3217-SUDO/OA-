@using Dchien.Legal.Common
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.CRM.ViewModels.CustomerShare.CustomerShareModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
 
<div class="modal fade" id="customerShareModal"  >
    <div class="modal-dialog" style="width:700px">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">

                <div class="modal-header">
                    <button type="button" class="close" id="btnCustomerShareClose">×</button>
                    <h5 class="modal-title ng-binding">客户共享</h5>
                </div>
                <div class="modal-body" style="height: 280px; padding: 10px;">
                    <div class="form-group">

                        @using (Html.BeginForm("CustomerSharing", "CustomerShare", FormMethod.Post, new { @class = "form-inline ng-valid ng-valid-required" }))
                        {
                             @Html.HiddenFor(m => m.Customer.CustomerBasic.CustomerId)
                            
                            <label class="control-label" style="float: left; padding-left: 15px; padding-top: 5px; ">
                                <span class="ng-binding">客户编号：</span>
                                @Html.DisplayTextFor(m => m.Customer.CustomerBasic.CustomerNo)
                            </label>
                            <div  style="float: left;">
                               
                             </div>
                            
                             <label class="control-label" style="float: left; padding-left: 20px; padding-top: 5px; ">
                                <span class="ng-binding">客户名称：</span>
                                 @Html.DisplayTextFor(m => m.Customer.CustomerBasic.CustomerName)
                            </label>
                            <div  style="float: left;">
                              
                            </div>
 
                        }

                    </div>

                    <div class="form-group">
                        <div class="col-sm-12" style="padding: 10px">
                            <div class="gridSection" >

                                <table id='tblCustomerShareHeader' class='table table-hover' style='width: 100%; margin-top: 0px; margin-bottom: 0px;'>
                                    <colgroup>
                                        <col style="width: 70%">
                                        <col style="width: 30%">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th style="text-align: center">共享对象</th>
                                            <th style="text-align: center">操作</th>
                                        </tr>
                                    </thead>
                                </table>
                                <div class="context" id='divCustomerShareList' style="max-height:200px; overflow-y: auto; ">
                                    <table class="table table-hover" id="tblCustomerShareList" style=' width:100%; margin-top: -1px; margin-bottom: 0px;'>
                                        <colgroup>
                                            <col style="width:70%">
                                            <col style="width:30%">
                                        </colgroup>
                                        <tbody>
                                            <tr style="display: none">
                                                 <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                            </tr>
                                        </tbody>
                                    </table>

                                    <div class="i_common_select" id="divModelAssociateUserList" style="display: none;">
                                        <div class="i_common_wrap">
                                            <div class="i_common_list"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <input class="btn btn-primary ng-binding" type="button" id="btnCustomerShareCreate" value="确定" />
                    <input class="btn btn-default ng-binding" type="button" id="btnCustomerShareCancel" value="取消" />
                </div>
            </div>
        </div>
    </div> 
</div>

