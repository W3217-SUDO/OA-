@using Dchien.Legal.Entity.System
@using Dchien.Legal.Service.BAS.Type

@model Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationTask.InvestigationTaskListModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/font-awesome.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/citys/city.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/bootstrap-tagsinput.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" />
<link type="text/css" rel="stylesheet" href=@Url.Content("~/Resource/css/ticketSystem/add.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"]) />

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Common/citys/jquery.citys.json.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Common/citys/jquery.citys.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Common/bootstrap-tagsinput.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/CIT/Investigation/CIT.Investigation.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/CIT/Investigation/CIT.Investigation.Task.List.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>



<div class="viewFramework-product">
    @*<div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("MenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>*@
    <div class="viewFramework-product-body">
        <div ng-transclude="">
            <div class="console-container ng-scope">
                <div class="row ng-scope">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>调查任务列表</h5>
                            </div>
                        </div>

                        <div class="pull-left margin-top-1 col-sm-12" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm">
                                @Html.HiddenFor(m => m.SearchCondition.PageId)
                                @Html.HiddenFor(m => m.SearchCondition.PageName, new { name = "PageName" })
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageNo" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.TotalCount, new { name = "TotalCount" })
                                <table class="search_table" style="width: 600px">
                                    <colgroup>
                                        <col style="width: 60px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px;" />
                                        <col style="width: 220px" />
                                        <col style="width: 80px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px;" />
                                        <col style="width: 60px;" />
                                        <col style="width: 60px;" />
                                        <col style="width: 60px;" />
                                        <col>
                                    </colgroup>
                                    <tr>
                                        <th style="text-align: right">
                                            任务编号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.InvestigationTaskNo, new { @class = "form-control", @style = "width:100%" })
                                        </td>
                                        <th style="text-align: right">
                                            调查日期：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.BeginTime, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.EndTime, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </td>

                                        <th style="text-align: right">
                                            调查员：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.InvestigatorName, new { @class = "form-control", @style = "width:100%" })
                                        </td>

                                    </tr>
                                    <tr>
                                        <th style="text-align: right">
                                            调查区域：
                                        </th>
                                        <td >
                                            @Html.TextBoxFor(m => m.SearchCondition.Province, new { @class = "form-control", @style = "width:100%" })
                                        </td>
                   
                                        <th style="text-align: right">
                                            权利人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.IndicterName, new { @class = "form-control", @style = "width:97.5%" })
                                        </td>
                    
                                        <th style="text-align: right">
                                            权利类型：
                                        </th>
                                        <td>
                                            @Html.DropDownListFor(m => m.SearchCondition.CaseTypeId, CaseRightTypeService.Instance.GetCaseRightTypeList(true), new { maxlength = 60, @class = "form-control select", style = " width:100%" })
                                         </td>
                                        <td style="text-align: right">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnInvestigationTaskSearch">
                                                <span>查询</span>
                                            </a>
                                        </td>
                              
                                    </tr>
 
                                </table>

                            </form>
                        </div>

                    </div>
                    <div class="col-sm-12">
                        <div class="ng-scope">
                            <div class="gridSection" id="investigationgridSection">
                                <table  class="aps-table aps-widget aps-ani-transition " id="tblTaskList" width="100%">
                                    <colgroup>
                                        <col style="width: 3%">
                                        <col style="width: 10%">
                                        <col style="width: 20%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 15%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <td><input type="checkbox" onclick="javascript: investigation.Investigations.Selected(this);" id="chkInvestigationAll" name="chkInvestigationAll"></td>

                                            <th style="text-align: center">
                                                任务编号
                                            </th>
                                            <th style="text-align: center">
                                                权利人
                                            </th>
                                            <th style="text-align: center">
                                                权利类型
                                            </th>
                                            <th style="text-align: center">
                                                调查员
                                            </th>
                                            <th style="text-align: center">
                                                调查区域
                                            </th>
                                            <th style="text-align: center">
                                                开始时间
                                            </th>
                                            <th style="text-align: center">
                                                结束时间
                                            </th>
                                            <th style="text-align: center">
                                                案源人
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td style="text-align: center">
                                                &nbsp;
                                            </td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left;white-space: nowrap;" ></td>
                                            <td style="text-align: center"></td>
                                             <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>

                                        </tr>
                                    </tbody>
                                    <tfoot class="ng-scope" style="display:none">
                                        <tr>
                                            <td><input type="checkbox" onclick="javascript: investigation.Investigations.Selected(this);" id="chkInvestigationAll" name="chkInvestigationAll"></td>

                                            <td colspan="8">
                                                <div class="pull-left">
                                                    <input type="button" onclick="javascript: investigation.Investigations.Investigation.Tasks.TaskList();" class="btn btn-default" style="height:32px" value="刷新" />
                                                    
                                                    @if (Model.SearchCondition.PageId == PageId.PageId_1401002)
                                                    {
                                                        <input type="button" id="btnInvestigationTaskListClueCreate" class="btn btn-default" style="height:32px" value="新增线索" />
                                                    }

                                                    @if (Model.SearchCondition.PageId == PageId.PageId_1401005)
                                                    {
                                                        <input type="button" class="btn btn-default investigationTaskEdit" style="height:32px" value="修改" />
                                                        <input type="button" id="btnInvestigationTaskDelete" class="btn btn-default" style="height:32px" value="批量删除" />
                                                    }


                                                </div>
                                                <div class="ng-scope">
                                                    <div class="pull-right page-box task">

                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left ng-binding">没有查询到符合条件的记录</span>
                                            <span class="ng-binding">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

 
                </div>
            </div>
        </div>

 
        <div id="sidebox" class="sidebox active"  style="overflow-y: auto;width: 30%; min-width: 750px; display:none">
            <div class="sidebox-content" ></div>
        </div>
    </div>
</div>
