@model Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationTask.InvestigationTaskListModel

<form id="postForm" action="">
    <div class="gridSection">
        <div id='divContextList' style="overflow-y: auto; margin-top: -1px; overflow-x: hidden; overflow-y: auto; ">
            <table class='table table-hover' id="tblInvestigationTaskList" width="100%">
                <colgroup>
                    <col style="width: 3%">
                    <col style="width: 15%">
                    <col style="width: 15%">
                    <col style="width: 20%">
                    <col style="width: 15%">
                    <col style="width: 15%">
                </colgroup>
                <thead>
                    <tr>
                        <td><input type="checkbox" id="chkTaskAll" name="chkTaskAll"></td>
                        <th style="text-align: center">
                            子任务号
                        </th>
                        <th style="text-align: center">
                            调查员
                        </th>
                        <th style="text-align: center">
                            调查区域
                        </th>
                        <th style="text-align: center">
                            开始时间
                        </th>
                        <th style="text-align: center">
                            结束时间
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="display: none">
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                        <td style="text-align: center;white-space: nowrap;" ></td>
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                    </tr>
                </tbody>
                <tfoot class="ng-scope" style="display:none">
                    <tr>
                        <td><input type="checkbox" id="chkTaskAll" name="chkTaskAll"></td>
                        <td colspan="5">
                            <div class="pull-left">
                                <input type="button" onclick="javascript: investigation.Investigations.Investigation.Tasks.List();" id="btnInvestigationTaskRefresh" class="btn btn-default" style="height:32px" value="刷新" />
                                @*<input type="button" class="btn btn-default investigationTaskCreate" style="height:32px" value="新增" />
                                <input type="button" class="btn btn-default investigationTaskEdit" style="height:32px" value="修改" />
                                <input type="button" id="btnInvestigationTaskDelete" class="btn btn-default" style="height:32px" value="批量删除" />*@  
                            </div>
                            <div class="ng-scope">
                                <div class="pull-right page-box investigationtask">
                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>
            <div class="simple-grid-none-data-wrap none-investigationtask">
                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                        <div class="text-size-16 tip-text inline-block">
                            <span class="margin-left ng-binding"></span>没有查询到调查子任务.
                            
                            <span class="ng-binding"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.TotalCount, new { name = "TotalCount" })
    @Html.HiddenFor(m => m.PageNo, new { name = "PageNo" })
    @Html.HiddenFor(m => m.PageSize, new { name = "PageSize" })
</form>

