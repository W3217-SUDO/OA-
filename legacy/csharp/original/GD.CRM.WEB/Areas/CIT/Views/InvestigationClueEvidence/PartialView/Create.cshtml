@using Dchien.Legal.Service.Legal.Investigation.Clue
@model Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationClue.InvestigationClueEvidenceModel
    

<style>
    .bootstrap-tagsinput {
        width: 100%;
        border-radius: 0px;
        padding: 2px 4px;
    }

        .bootstrap-tagsinput input {
            padding: 0px;
            width: 50px;
        }

    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>

<div class="modal fade" id="investigationClueEvidenceModal">
    <div class="modal-dialog" style="width:660px">
        <div class="modal-content">
            <div class="ng-scope">
                @using (Html.BeginForm("CreateUpdate", "InvestigationClueEvidence", FormMethod.Post, new { id = "investigationClueEvidence", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.InvestigationClueEvidence.Basic.ClueGuid)
                    @Html.HiddenFor(m => m.InvestigationClueEvidence.Basic.EvidenceGuid)

                    <div class="modal-header">
                        <button type="button" class="close" onclick="javascript: $('#investigationClueEvidenceModal').modal('hide');">×</button>
                        <h5 class="modal-title ng-binding">取证</h5>
                    </div>
                    <div class="modal-body">
                        <div class="">
                            <div class="form-horizontal margin-top-3 ">

                                <div class="form-group">

                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span>取证机构：</span>
                                    </label>
                                    <div class="col-sm-6">
                                        <div class="bootstrap-tagsinput">

                                            @Html.TextBoxFor(m => m.InvestigationClueEvidence.Basic.NotaryOrganization,
                                            new
                                            {
                                                @readonly=true,
                                                placeholder = "取证机构",
                                                style = "height:24px;width:90%",
                                                autocomplete = "off"
                                            })

                                        </div>
                                    </div>



                                    @*<div class="i_common_select" id="div_NotaryOfficeList" style="display: none;">
                    <div class="i_common_wrap">
                        <div class="i_common_list"></div>
                    </div>
                </div>*@

                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        @*<span class="text-danger">*</span>*@
                                        <span>公证书号：</span>
                                    </label>
                                    <div class="col-sm-6">
                                        <div class="bootstrap-tagsinput">
                                            @Html.TextBoxFor(m => m.InvestigationClueEvidence.Basic.NotarialNo,
                                            new
                                            {
                                                placeholder = "公证书号",
                                                style = "height:24px;width:90%",
                                                autocomplete = "off"
                                            })
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                     
                                        <span>取证时间：</span>
                                    </label>
                                    <div class="col-sm-6">
                                        <div class="bootstrap-tagsinput">

                                            @Html.TextBoxFor(m => m.InvestigationClueEvidence.Basic.EvidenceDate, "{0:yyyy-MM-dd}",
                                             new
                                             {
                                                 placeholder = "取证时间",
                                                 style = "height:24px;width:90%",
                                                 autocomplete = "off",
                                                 @onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})"
                                             })
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group" style="display:none">

                                    <label class="col-sm-3 control-label">

                                        <span>取证地点：</span>
                                    </label>
                                    <div class="col-sm-6">
                                        <div class="bootstrap-tagsinput">

                                            @Html.TextBoxFor(m => m.InvestigationClueEvidence.Basic.EvidenceAddress,
                                            new
                                            {
                                                placeholder = "取证地点",
                                                style = "height:24px;width:90%",
                                                autocomplete = "off"
                                            })

                                        </div>
                                    </div>
                                </div>

                                <div class="form-group" style="display:none">
                                    <label class="col-sm-3 control-label">

                                        <span>落款时间：</span>
                                    </label>
                                    <div class="col-sm-6">
                                        <div class="bootstrap-tagsinput">

                                            @Html.TextBoxFor(m => m.InvestigationClueEvidence.Basic.NotarialObtainDate, "{0:yyyy-MM-dd}",
                                             new
                                             {
                                                 placeholder = "落款时间",
                                                 style = "height:24px;width:90%",
                                                 autocomplete = "off",
                                                 @onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})"
                                             })
                                        </div>

                                    </div>
                                </div>

                                <div class="form-group">

                                    <label class="col-sm-3 control-label">
                                        @*<span class="text-danger">*</span>*@
                                        <span>发票号码：</span>
                                    </label>
                                    <div class="col-sm-6">
                                        <div class="bootstrap-tagsinput">

                                            @Html.TextBoxFor(m => m.InvestigationClueEvidence.Basic.InvoiceNo,
                                            new
                                            {
                                                placeholder = "发票号码",
                                                style = "height:24px;width:90%",
                                                autocomplete = "off"
                                            })

                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span>证物存放处：</span>
                                    </label>
                                    <div class="col-sm-6">
                                        <div class="bootstrap-tagsinput">
                                            @Html.HiddenFor(m => m.InvestigationClueEvidence.Basic.WarehouseNo)
                                            @Html.HiddenFor(m => m.InvestigationClueEvidence.Basic.StorageLocationNo)
                                            @Html.HiddenFor(m => m.InvestigationClueEvidence.Basic.StorageLocationName)

                                            @Html.TextBoxFor(m => m.InvestigationClueEvidence.Basic.DepositAddress,
                                            new
                                            {
                                                placeholder = "证物存放处",
                                                style = "height:24px;width:90%",
                                                autocomplete = "off",
                                                @readonly = true
                                            })
                                        </div>

                                        <div class='divwarehouses' style='overflow-y: scroll; '>
                                            <div id="divWarehouseCheckBoxList" style="display:none" class='i_common_box'>
                                                <div class='i_common_hd'>
                                                    从下列库位中选择
                                                    @*<input type='hidden' id='hidStorageLocationNo'>
                                <input type='hidden' id='hidWarehouseNo'>
                                <input type='hidden' id='hidStorageLocationName'>*@
                                                </div>
                                                <div class='i_common_bd'>
                                                    <ul id='warehouseTree' class='ztree' style="max-height:300px"></ul>
                                                    <div class="pull-right">
                                                        <input class='btn btn-primary' type='button' id='btnStorageLocationSelected' value='确定' />
                                                        <input class='btn btn-default' type='button' value='取消' onclick="$('#divWarehouseCheckBoxList').hide();" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <div class="form-group">

                                    <label class="col-sm-3 control-label">
                                        @*<span class="text-danger">*</span>*@
                                        <span>证物状态：</span>
                                    </label>
                                    <div class="col-sm-6">

                                        @Html.DropDownListFor(m => m.InvestigationClueEvidence.Basic.EvidenceStatus, Dchien.Legal.Service.BAS.Warehouse.WarehouseGoodsStatusService.Instance.GetWarehouseGoodsStatusList(false), new { maxlength = 60, @class = "form-control select", style = " width:100%;height:30px" })

                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        @*<span class="text-danger ng-binding">*</span>*@
                                        <span class="ng-binding">证据文件：</span>
                                    </label>
                                    <div class="col-sm-6">

                                        <div class="form-control-wrap">
                                            <input id="txtFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control" style="height:30px;display:inline-block">
                                            <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                                <input type="file" multiple value="" id="flFile" name="flFile" style="height: 30px; width: 250px; margin-left: 10px;">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="divNotaryOffices"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" onclick="javascript: investigation.Investigations.Investigation.Evidences.Evidence.CreateUpdate(false);" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" onclick="javascript: $('#investigationClueEvidenceModal').modal('hide');" value="取消" />

                    </div>
                }
            </div>
        </div>
    </div>
</div>
