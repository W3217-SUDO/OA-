@using Dchien.Legal.Service.BAS

@model  Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationClue.InvestigationIndicteeModel
<script type="text/javascript" src="@Url.Content("~/Scripts/CIT/Investigation/CIT.Investigation.Clue.Indictee.CreateUpdate.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<div class="modal fade" id="investigationClueIndicteeModal">
    <div class="modal-dialog" style="width:600px">
        <div class="modal-content">
            <div class="ng-scope">
                @using (Html.BeginForm("CreateUpdate", "InvestigationClueIndictee", FormMethod.Post, new { id = "investigationClueIndictee", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    <div class="modal-header">
                        <button type="button" class="close" onclick="javascript: $('#investigationClueIndicteeModal').modal('hide');">×</button>
                        <h5 class="modal-title ng-binding">经营主体</h5>
                    </div>
                    <div class="modal-body">
                        <div class="">
                            <div class="form-horizontal margin-top-3 ">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span>经营性质：</span>
                                    </label>
                                    <div class="col-sm-8">
                                       
                                        @Html.DropDownListFor(m => m.InvestigationClueIndictee.BusinessNatureType, DictionaryTypeService.Instance.GetInvestigationBusinessNatureTypeList(false), new { @class = "form-control select", style = "height:28px" })
                                        
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span>主体名称：</span>
                                    </label>
                                    <div class="col-sm-8">
                                       
                                            @Html.TextBoxFor(m => m.InvestigationClueIndictee.IndicteeName,
                                            new
                                            {
                                                @class = "form-control",
                                                placeholder = "请输入主体名称",
                                                style = "height:28px;",
                                                autocomplete = "off"
                                            })
                                      
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span>确认方式：</span>
                                    </label>
                                    <div class="col-sm-8">
                                        @Html.DropDownListFor(m => m.InvestigationClueIndictee.BusinessNatureSubType, DictionaryTypeService.Instance.GetInvestigationBusinessNatureSubTypeList(false), new { @class = "form-control select", style = "height:28px" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span class="indicteeLicenseNo">身份证号：</span>
                                    </label>
                                    <div class="col-sm-8">
                                            @Html.TextBoxFor(m => m.InvestigationClueIndictee.IndicteeLicenseNo,
                                            new
                                            {
                                                @class = "form-control",
                                                placeholder = "请输入身份证号",
                                                style = "height:28px;",
                                                autocomplete = "off"
                                            })
                                        
                                    </div>
                                </div>

                                <div  class="divlegalRepresentative form-group" style="display:none">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span class="legalRepresentative">法定代表人：</span>
                                    </label>
                                    <div class="col-sm-8">

                                        @Html.TextBoxFor(m => m.InvestigationClueIndictee.LegalRepresentative,
                                            new
                                            {
                                                @class = "form-control",
                                                placeholder = "请输入法定代表人",
                                                style = "height:28px;",
                                                autocomplete = "off"
                                            })

                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                      
                                        <span>主体区域：</span>
                                    </label>
                                    <div class="col-sm-8">
                                        <div id="indictee_district">
                                            <select class="form-control" style="width:32%;height:100%;display:inline" id="InvestigationClueIndictee_Province" name="province"></select>
                                            <select class="form-control" style="width:32%;height:100%;display:inline" id="InvestigationClueIndictee_City" name="city"></select>
                                            <select class="form-control" style="width:33%;height:100%;display:inline" id="InvestigationClueIndictee_District" name="area"></select>
                                        </div>   
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span>工商地址：</span>
                                    </label>
                                    <div class="col-sm-8">
                                      
                                            @Html.TextBoxFor(m => m.InvestigationClueIndictee.Address,
                                            new
                                            {
                                                @class = "form-control",
                                                placeholder = "工商地址",
                                                style = "height:28px;",
                                                autocomplete = "off"
                                            })
                                      
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnInvestigationClueIndicteeCreateUpdate" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" onclick="javascript: $('#investigationClueIndicteeModal').modal('hide');" value="取消" />

                    </div>
                }
            </div>
        </div>
    </div>
</div>
