@using Dchien.Legal.Service.BAS

@model  Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationClue.InvestigationProducerModel
<script type="text/javascript" src="@Url.Content("~/Scripts/CIT/Investigation/CIT.Investigation.Clue.Producer.CreateUpdate.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<div class="modal fade" id="investigationClueProducerModal">
    <div class="modal-dialog" style="width:660px">
        <div class="modal-content">
            <div class="ng-scope">
                @using (Html.BeginForm("CreateUpdate", "InvestigationClueProducer", FormMethod.Post, new { id = "investigationClueProducer", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    <div class="modal-header">
                        <button type="button" class="close" onclick="javascript: $('#investigationClueProducerModal').modal('hide');">×</button>
                        <h5 class="modal-title ng-binding">生产商</h5>
                    </div>
                    <div class="modal-body">
                        <div class="">
                            <div class="form-horizontal margin-top-3 ">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span>生产商：</span>
                                    </label>
                                    <div class="col-sm-8">

                                        @Html.TextBoxFor(m => m.InvestigationClueProducer.ProducerName,
                                            new
                                            {
                                                @class = "form-control",
                                                placeholder = "请输入生产商",
                                                style = "height:28px;",
                                                autocomplete = "off"
                                            })
                                        
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                       
                                        <span>主体区域：</span>
                                    </label>
                                    <div class="col-sm-8">
                                        <div id="producer_district">
                                            <select class="form-control" style="width:32%;height:100%;display:inline" id="InvestigationClueProducer_Province" name="province"></select>
                                            <select class="form-control" style="width:32%;height:100%;display:inline" id="InvestigationClueProducer_City" name="city"></select>
                                            <select class="form-control" style="width:33%;height:100%;display:inline" id="InvestigationClueProducer_District" name="area"></select>
                                        </div>   
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                       
                                        <span>工商地址：</span>
                                    </label>
                                    <div class="col-sm-8">
                                      
                                            @Html.TextBoxFor(m => m.InvestigationClueProducer.Address,
                                            new
                                            {
                                                @class = "form-control",
                                                placeholder = "工商地址",
                                                style = "height:28px;",
                                                autocomplete = "off"
                                            })
                                      
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnInvestigationClueProducerCreateUpdate" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" onclick="javascript: $('#investigationClueProducerModal').modal('hide');" value="取消" />

                    </div>
                }
            </div>
        </div>
    </div>
</div>
