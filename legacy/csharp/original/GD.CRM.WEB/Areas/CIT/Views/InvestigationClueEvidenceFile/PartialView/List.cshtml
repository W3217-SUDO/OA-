@using Dchien.Legal.Entity.System
@model Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationClue.File.FileListModel

<div class="modal fade" id="investigationClueEvidenceFileModal">
    <div class="modal-dialog" style="width:45%">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                <form id="postForm"  class="form-horizontal ng-invalid ng-invalid-required" >
                    <div class="modal-header">
                        <button type="button" class="close" onclick="javascript: $('#investigationClueEvidenceFileModal').modal('hide');">×</button>
                        <h5 class="modal-title ">证据文件列表</h5>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div class="gridSection">
                                    <div id='divContextList' style="overflow-y: auto; margin-top: -1px; overflow-x: hidden; overflow-y: auto; ">
                                        <table class='table table-hover' id="tblInvestigationClueEvidenceFileList">
                                            <colgroup>
                                                <col style="width: 10%">
                                                <col style="width: 10%">
                                                <col style="width: 20%">
                                                <col style="width: 10%">
                                                <col style="width: 10%">
                                            </colgroup>
                                            <thead>
                                                <tr>

                                                    <th style="text-align: center">
                                                        上传人
                                                    </th>
                                                    <th style="text-align: center">
                                                        文件类别
                                                    </th>
                                                    <th style="text-align: center">
                                                        文件名称
                                                    </th>
                                                    <th style="text-align: center">
                                                        文档日期
                                                    </th>
                                                    <th style="text-align: center">
                                                        查看
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr style="display: none">
                                                    <td style="text-align: center"></td>
                                                    <td style="text-align: center"></td>
                                                    <td style="text-align: center"></td>
                                                    <td style="text-align: center"></td>
                                                    <td style="text-align: center"></td>
                                                </tr>
                                            </tbody>
                                            <tfoot class="ng-scope" style="display:none">
                                                <tr>
                                                    <td colspan="5">
                                                        <div class="pull-left">
                                                        </div>
                                                        <div class="ng-scope">
                                                            <div class="pull-right page-box investigationclueevidencefile">
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                        <div class="simple-grid-none-data-wrap none-investigationclueevidencefile">
                                            <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                                                <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                                    <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                                    <div class="text-size-16 tip-text inline-block">
                                                        <span class="margin-left ng-binding"></span>没有查询到证据文件。
                                                        <span class="ng-binding"></span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-default" type="button" onclick="javascript: $('#investigationClueEvidenceFileModal').modal('hide');" value="关闭" />
                    </div>
                 </form>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.TotalCount, new { name = "TotalCount" })
    @Html.HiddenFor(m => m.PageNo, new { name = "PageNo" })
    @Html.HiddenFor(m => m.PageSize, new { name = "PageSize" })
</div>


