<SCRIPT type="text/javascript">

     function zTreeOnClick(event, treeId, treeNode) {
        if (treeNode.id != null)
        {
            var subCasePhases = $.lsCasePhase.getSubCasePhases(treeNode.id)
            var subCasePhaseIds = new Array();
            var subCasePhaseNames = new Array();

            $.each(subCasePhases, function (i, f) {
                subCasePhaseIds.push(f.CasePhaseId);
                subCasePhaseNames.push(f.CasePhaseName);
            });

            $("#SearchCondition_CasePhaseId").val(subCasePhaseIds.join(','));
            $("#SearchCondition_CasePhaseName").val(subCasePhaseNames.join(','));
        }

        $("#SearchCondition_PageNo").val(1);
        $("#SearchCondition_PageSize").val(10);
        c.Cases.List();
    };

    var setting = {
        view: {
            showLine: false,
            addHoverDom: addHoverDom,
            removeHoverDom: removeHoverDom,
            selectedMulti: false
        },
        edit: {
            enable: true,
            showRemoveBtn: false,
            showRenameBtn: false,
            showUploadBtn: false

        },
        data: {
            simpleData: {
                enable: true
             }
        },
        callback: {
            onClick: zTreeOnClick

        }
    };

    var log, className = "dark";

    function getTime() {
        var now = new Date(),
        h = now.getHours(),
        m = now.getMinutes(),
        s = now.getSeconds(),
        ms = now.getMilliseconds();
        return (h + ":" + m + ":" + s + " " + ms);
    }

    var newCount = 1;
    function addHoverDom(treeId, treeNode) {
        return false;
    };
    function removeHoverDom(treeId, treeNode) {
    };
    function selectAll() {
        var zTree = $.fn.zTree.getZTreeObj("caseListTree");
        zTree.setting.edit.editNameSelectAll = $("#selectAll").attr("checked");
    }

    $(document).ready(function () {

        var data = {
            caseTypeId: $("#SearchCondition_CaseTypeId").val()
        };
        $.ajaxPost(AP_ROOT + AP_PAGE_ID + "/Legal/CasePhase/GetCasePhaseList", data, function (response) {
            if (response.IsSuccess) {
                if (response.Data.PhaseCaseCounts.length > 0)
                {
                    var zNodes = [];
                    $.each(response.Data.PhaseCaseCounts, function (i, phase) {
                        var node = {};
                        node.id = phase.Item1.CasePhaseId;
                        node.pId = phase.Item1.ParentPhaseId;
                        node.name = phase.Item1.CasePhaseName + "【" + phase.Item2 + "】";
                        node.open = false;

                        zNodes.push(node);
                    });

                    $.fn.zTree.init($("#caseListTree"), setting, zNodes);
                    var zTree = $.fn.zTree.getZTreeObj("caseListTree");
                    $("#selectAll").bind("click", selectAll);

                }
            }
        });
    });

</SCRIPT>

