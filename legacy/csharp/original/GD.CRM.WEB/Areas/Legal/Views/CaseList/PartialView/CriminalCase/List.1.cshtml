@using Dchien.Legal.Service
@using Dchien.Legal.Service.BAS.Type;
@using Dchien.Legal.Entity.System;

@model Dchien.Legal.Web.Areas.Legal.ViewModels.CaseList.CaseListModel
<script>
    $(function () {
         $("[data-toggle='tooltip']").tooltip();
    });
</script>
<style type="text/css">
    .webuploader-pick {
        position: relative;
        display: inline-block;
        cursor: pointer;
        background: #f7f7f7;
        padding: 10px 15px;
        color: #333;
        text-align: center;
        border-radius: 3px;
        overflow: hidden;
    }

    .webuploader-pick-hover {
        background: #8b9aa3;
    }

    .filePicker div:nth-child(2) {
        width: 100% !important;
        height: 100% !important;
    }

    .instance-list-name-width {
        min-width: 185px;
        max-width: 200px;
        padding-right: 0 !important;
        word-wrap: break-word;
    }

    .aps-table th {
        padding: 4px 4px;
        width: 138px;
        border: 0px solid #eee;
    }

    .aps-table td {
        padding: 4px 4px 4px 4px;
        border: 0px solid #eee;
    }

    td {
        white-space: nowrap;
    }
</style>

<table id="" class="aps-table aps-widget aps-ani-transition" style="width:100%">
    <colgroup>
        <col style="width: 3%">
        <col style="width: 10%">
        <col style="width: 20%">
        <col style="width: 12%">
        <col style="width: 10%">
        <col style="width: 15%">
        <col style="width: 15%">
        <col style="width:10%">
        <col style="width: 17px">
    </colgroup>
    <thead>
        <tr>
            <th width="10">
                <input type="checkbox" id="chkCaseAll" name="chkCaseAll">
            </th>
            <th style="text-align: left">
                基本信息
                <span>
                    <span class="aps-state-hidden"></span>
                    <span data-field="T.caseNo" class="aps-widget aps-ani-transition aps-sort aps-state-visible">
                        <i type="up" class="aps-icon aps-ani-transition aps-widget aps-icon-shangjiantou aps-sort-btn aps-sort-btn-up"></i>
                        <i type="down" class="aps-icon aps-ani-transition aps-widget aps-icon-xiajiantou aps-sort-btn aps-sort-btn-down"
                           style="top:9px">
                        </i>
                    </span>
                </span>
            </th>

            <th style="text-align: left">当事人信息</th>
            <th style="text-align: left">法院信息</th>
            <th style="text-align: left">委托律师</th>
            <th style="text-align: left">调查信息</th>
            <th id="divTaskHeader" style="text-align: left" colspan="2">任务信息</th>
            <th id="divAppelleeHeader" style="display:none;text-align: left" colspan="2">主体信息</th>
            <th></th>
        </tr>
    </thead>

</table>

<div id="divCaseList" style="border-top: 0;margin-top: -1px; overflow-x:hidden; overflow-y: scroll;">

    <table id="tblCaseList" class="aps-table aps-widget aps-ani-transition" style="width:100%">
        <colgroup>
            <col style="width: 3%">
            <col style="width: 10%">
            <col style="width: 20%">
            <col style="width: 12%">
            <col style="width: 10%">
            <col style="width: 15%">
            <col style="width: 15%">
            <col style="width:10%">
        </colgroup>

        <tbody>
            <tr style="display: none">
                <td>
                    &nbsp;
                </td>
                <td style="text-align: left" class="instance-list-name-width"></td>
                <td style="text-align: left"></td>
                <td style="text-align: left"></td>
                <td style="text-align: left"></td>
                <td style="text-align: left"></td>
                <td style="text-align: left"></td>
                <td style="text-align: left"></td>

            </tr>
            <tr style="display: none">
                <td>
                    &nbsp;
                </td>
                <td style="text-align: left" class="instance-list-name-width"></td>
                <td style="text-align: left"></td>
                <td style="text-align: left"></td>
                <td style="text-align: left"></td>
                <td style="text-align: left"></td>
                <td style="text-align: left"></td>
                <td style="text-align: left"></td>

            </tr>
        </tbody>
        <tfoot class="" style="display: none">
            <tr style="border: 1px solid #E1E6EB;">
                <td width="1">
                    <input type="checkbox" id="chkCaseAll" name="chkCaseAll">
                </td>
                <td colspan="7">
                    <div class="pull-left" style="position:absolute;z-index: 1000;">
                        @*<input type="button" id="btnCaseExportToExcel" class="btn btn-default" style="height:32px" value="导出Excel" />*@

                        <div class="inline-block dropdown" style="margin-left: 4px">
                            <div class="divdropdown dropdown ng-scope">
                                <button class="btn btn-default dropdown-toggle" style="height:32px" data-toggle="dropdown">
                                    导出案件
                                    <span class="caret"></span>
                                </button>
                                <ul class="dropdown-menu" style="position:absolute;z-index: 99999;text-align: left;">
                                    <li>
                                        <a href="javascript:;" id="btnCaseExportToExcel" onclick="javascript:void(0);">
                                            <span style="font-size:12px">导出选中</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" id="btnAllCaseExportToExcel" onclick="javascript:void(0);">
                                            <span style="font-size:12px">导出全部</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="filePicker btn btn-default" style="padding-top:1.5px;padding-bottom:1.5px; height:32px;">上传文件</div>
                        @if (Model.SearchCondition.PageId == PageId.PageId_1001103010
                        || Model.SearchCondition.PageId == PageId.PageId_1001103020
                        || Model.SearchCondition.PageId == PageId.PageId_1001103030
                        || Model.SearchCondition.PageId == PageId.PageId_1001103040)
                        {
                            <input type="button" id="btnCaseDelete" class="btn btn-default" style="height:32px" value="删除案件" />
                        }

                        <div class="divdropdown inline-block dropdown" style="margin-left: 4px">
                            <div class="dropdown ng-scope">
                                <button class="btn btn-default dropdown-toggle" style="height:32px" data-toggle="dropdown">
                                    更多操作
                                    <span class="caret"></span>
                                </button>
                                <ul class="dropdown-menu" style="position:absolute;z-index: 99999;text-align: left;">
                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.MultiOpen($.checkbox.vals('chkCaseId'));">
                                            <span style="font-size:12px">上传案件文档</span>
                                        </a>
                                    </li>
                                    @*<li>
                                            <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">新增案件费用</span></a>
                                        </li>*@

                                    <li class="dropdown-submenu">
                                        <a tabindex="-1" href="javascript:;">新增案件费用</a>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'), $.lsCaseFeeType.TypeId.OfficeFee);">
                                                    <span>新增官费</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'), $.lsCaseFeeType.TypeId.NonOfficeFee);">
                                                    <span>新增代理费</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'), $.lsCaseFeeType.TypeId.CommissionFee);">
                                                    <span>新增其他费用</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </li>


                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.InternalFees.InternalFee.MultiOpen($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">新增内部费用</span></a>
                                    </li>

                                    <li class="dropdown-submenu">
                                        <a tabindex="-1" href="javascript:;">批量修改</a>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.Participant.Open($.checkbox.vals('chkCaseId'));">
                                                    <span>修改经办律师</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.Participant.Open($.checkbox.vals('chkCaseId'));">
                                                    <span>修改律师助理</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </li>

                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.AuthorizationLetter.Create($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">生成授权委托书</span></a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.LawyersLetter.Create($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">生成律所函</span></a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.IdentificationLetter.Create($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">生成身份证明</span></a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.SettlementList.Create($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">生成结算提成表</span></a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseTasks.CaseTask.Open($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">案件任务</span></a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseLogs.CaseLog.Open($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">案件日志</span></a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                    </div>
                    <div class="">
                        <div class="pull-right page-box Caselist">
                        </div>
                    </div>
                </td>
            </tr>
        </tfoot>
    </table>

</div>