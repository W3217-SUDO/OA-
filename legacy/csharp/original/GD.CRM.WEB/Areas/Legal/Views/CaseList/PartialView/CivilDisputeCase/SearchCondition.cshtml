@using Dchien.Legal.Service
@using Dchien.Legal.Service.BAS
@using Dchien.Legal.Service.BAS.Type;
@using Dchien.Legal.Entity.System;

@model Dchien.Legal.Web.Areas.Legal.ViewModels.CaseList.CaseListModel

<table class="search_table" style="width: 600px">
    <colgroup>
        <col style="width: 60px;" />
        <col style="width: 190px" />
        <col style="width: 60px;" />
        <col style="width: 160px" />
        <col style="width: 60px;" />
        <col style="width: 160px" />
        <col style="width: 60px;" />
        <col style="width: 160px" />
        <col style="width: 40px;" />
        <col style="width: 30px" />
        <col />
    </colgroup>
    <tr>
        <th>
            原告：
        </th>
        <td>
            @Html.TextBoxFor(m => m.SearchCondition.AppellantName, new { @class = "form-control",@autocomplete = "off", @placeholder = "原告", @style = "width:91.7%" })
        </td>

        <th>
            案件编号：
        </th>
        <td>
            @Html.TextBoxFor(m => m.SearchCondition.CaseNos, new { @class = "form-control",@autocomplete = "off", @placeholder = "案件编号", @style = "width:90%" })
        </td>


        <th>
            取证机构：
        </th>
        <td>
            @Html.TextBoxFor(m => m.SearchCondition.NotaryOrganization, new { @class = "form-control", @autocomplete = "off", @placeholder = "取证机构", @style = "width:90%" })
        </td>
        <th>
            关键字：
        </th>
        <td colspan="3">
            @Html.TextBoxFor(m => m.SearchCondition.Keyword, new { @class = "form-control",@autocomplete = "off", @placeholder = "案号、法院号、案件名、客户名、任务内容", @style = "width:90%" })
        </td>

    </tr>
    <tr>
        <th>
            被告：
        </th>
        <td>
            @Html.TextBoxFor(m => m.SearchCondition.AppelleeName, new { @class = "form-control",@autocomplete = "off", @placeholder = "被告", @style = "width:91.7%" })
        </td>

        <th>
            经办律师：
        </th>
        <td>
            @Html.TextBoxFor(m => m.SearchCondition.CaseLawyer, new { @class = "form-control", @autocomplete = "off", @placeholder = "经办律师", @style = "width:90%" })
        </td>
        <th>
            公证书号：
        </th>
        <td>
            @Html.TextBoxFor(m => m.SearchCondition.NotarialNo, new { @class = "form-control", @autocomplete = "off", @placeholder = "公证书号", @style = "width:90%" })
        </td>
        <th>
            案件阶段：
        </th>
        <td colspan="3">
            @Html.HiddenFor(m => m.SearchCondition.CasePhaseId)
            @Html.TextBoxFor(m => m.SearchCondition.CasePhaseName, new { @class = "form-control",@autocomplete = "off", @placeholder = "案件阶段", @style = "width:90%" })
        </td>

    </tr>
    <tr>

        <th>
            开庭律师：
        </th>
        <td>
            @Html.TextBoxFor(m => m.SearchCondition.CourtLawyer, new { @class = "form-control",@autocomplete = "off", @placeholder = "开庭律师", @style = "width:91.7%" })
        </td>
        <th>
            律师助理：
        </th>
        <td>
            @Html.TextBoxFor(m => m.SearchCondition.CaseAssistant, new { @class = "form-control", @autocomplete = "off", @placeholder = "律师助理", @style = "width:90%" })
        </td>
        <th>
            调查员：
        </th>
        <td>
            @Html.TextBoxFor(m => m.SearchCondition.InvestigatorName, new { @class = "form-control", @autocomplete = "off", @placeholder = "调查员", @style = "width:90%" })
        </td>
        <th>
            法院名称：
        </th>
        <td colspan="3">
            @Html.TextBoxFor(m => m.SearchCondition.CourtName, new { @class = "form-control",@autocomplete = "off", @placeholder = "法院名称", @style = "width:90%" })
        </td>

    </tr>
    <tr class="advancedSearch" style="display:none">

        <th>
            案源时间：
        </th>

        <td>
            @Html.TextBoxFor(m => m.SearchCondition.CaseRegisterDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @autocomplete = "off", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:80px" })
            -
            @Html.TextBoxFor(m => m.SearchCondition.CaseRegisterDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @autocomplete = "off", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:80px" })
        </td>

        @*<th>
            侵权方式：
        </th>
        <td>
            @Html.DropDownListFor(m => m.SearchCondition.BusinessType, DictionaryTypeService.Instance.GetInvestigationBusinessTypeList(true), new { @class = "form-control select", @style = "width:90%" })
        </td>*@

        <th>
            侵权渠道：
        </th>
        <td>
            @Html.DropDownListFor(m => m.SearchCondition.ChannelType, DictionaryTypeService.Instance.GetElectroniccommerceChannelList(true), new { @class = "form-control select", style = "width:90%" })
        </td>


        <th>
            仓库：
        </th>
        <td>
            @Html.TextBoxFor(m => m.SearchCondition.WarehouseName, new { @class = "form-control",@autocomplete = "off", @placeholder = "仓库", @style = "width:90%" })
        </td>

        <th>
            文档名称：
        </th>
        <td colspan="3">
            @Html.TextBoxFor(m => m.SearchCondition.CaseFileName, new { @class = "form-control",@autocomplete = "off", @placeholder = "文档名称", @style = "width:90%" })
        </td>


    </tr>
    <tr  class="advancedSearch" style="display:none">
        <th>
            开庭时间：
        </th>

        <td>
            @Html.TextBoxFor(m => m.SearchCondition.LawfulDayFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:80px" })
            -
            @Html.TextBoxFor(m => m.SearchCondition.LawfulDayTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:80px" })
        </td>

        <th>
            侵权区域：
        </th>

        <td>
            @Html.TextBoxFor(m => m.SearchCondition.StoreAddress, new { @class = "form-control", @autocomplete = "off", @placeholder = "侵权区域", @style = "width:90%" })
        </td>

        <th>
            库位：
        </th>
        <td>
            @Html.TextBoxFor(m => m.SearchCondition.StorageLocationName, new { @class = "form-control",@autocomplete = "off", @placeholder = "库位", @style = "width:90%" })
        </td>
        <th>
            日志内容：
        </th>
        <td colspan="3">
            @Html.TextBoxFor(m => m.SearchCondition.LogContent, new { @class = "form-control",@autocomplete = "off", @placeholder = "日志内容", @style = "width:90%" })
        </td>
    </tr>
    <tr >
        <th>
        </th>
        <td>
            <div class="form-group">
                <a href="javascript:void(0);" class="btn btn-primary " id="btnCaseSearch">
                    <span>查询</span>
                </a>
                <a href="javascript:void(0);" class="btn btn-default " id="btnCaseSearchReset">
                    <span>重置</span>
                </a>
            </div>
        </td>
    </tr>
</table>