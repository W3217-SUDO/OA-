@using Dchien.Legal.Service
@using Dchien.Legal.Service.BAS.Type;
@using Dchien.Legal.Entity.System;

@model Dchien.Legal.Web.Areas.Legal.ViewModels.CaseList.CaseListModel
 

<table id="" class="aps-table aps-widget aps-ani-transition" style="width:100%">
    <colgroup>
        <col style="width: 3%">
        <col style="width: 10%">
        <col style="width: 15%">
        <col style="width: 15%">
        <col style="width: 15%">
        <col style="width: 8%">
        <col style="width: 12%">
        <col style="width: 8%">
        <col style="width: 8%">
        <col style="width: 8%">
        <col style="width: 6%">
        <col style="width: 6%">
        <col style="width: 17px">
    </colgroup>
    <thead>
        <tr>
            <th width="10">
                <input type="checkbox" id="chkCaseAll" name="chkCaseAll">
            </th>
            <th style="text-align: center">
                案件编号
                <span>
                    <span class="aps-state-hidden"></span>
                    <span data-field="T.caseNo" class="aps-widget aps-ani-transition aps-sort aps-state-visible">
                        <i type="up" class="aps-icon aps-ani-transition aps-widget aps-icon-shangjiantou aps-sort-btn aps-sort-btn-up"></i>
                        <i type="down" class="aps-icon aps-ani-transition aps-widget aps-icon-xiajiantou aps-sort-btn aps-sort-btn-down"
                           style="top:9px">
                        </i>
                    </span>
                </span>
            </th>

            @if (Model.SearchCondition.PageId == PageId.PageId_1001103040
                                          || Model.SearchCondition.PageId == PageId.PageId_1001102040
                                          || Model.SearchCondition.PageId == PageId.PageId_100110140)
            {
                <th style="text-align: center">顾问类型</th>
                                                <th style="text-align: center;" colspan="2">客户</th>
                                                <th style="text-align: center" colspan="3">顾问期限</th>

            }
            else
            {
                <th style="text-align: center">案由</th>
                <th style="text-align: center">申请人</th>
                <th style="text-align: center">被申请人</th>
                <th style="text-align: center">案件阶段</th>
                <th style="text-align: center">仲裁机构</th>
                <th style="text-align: center">
                    开庭时间
                    <span>
                        <span class="aps-state-hidden"></span>
                        <span data-field="T.lawfulDay" class="aps-widget aps-ani-transition aps-sort  aps-state-visible">
                            <i type="up" class="aps-icon aps-ani-transition aps-widget aps-icon-shangjiantou aps-sort-btn aps-sort-btn-up"></i>
                            <i type="down" class="aps-icon aps-ani-transition aps-widget aps-icon-xiajiantou aps-sort-btn aps-sort-btn-down"
                                style="top:9px">
                            </i>
                        </span>
                    </span>
                </th>
            }

            <th style="text-align: center">经办律师 </th>
            <th style="text-align: center">律师助理</th>
            <th style="text-align: center">案源人</th>
            <th style="text-align: center">剩余时间</th>
            <th></th>
        </tr>
    </thead>

</table>

<div id="divCaseList" style="border-top: 0;margin-top: -1px; overflow-x:hidden; overflow-y: scroll;">

    <table id="tblCaseList" class="aps-table aps-widget aps-ani-transition" style="width:100%">
        <colgroup>
            <col style="width: 3%">
            <col style="width: 10%">
            <col style="width: 15%">
            <col style="width: 15%">
            <col style="width: 15%">
            <col style="width: 8%">
            <col style="width: 12%">
            <col style="width: 8%">
            <col style="width: 8%">
            <col style="width: 8%">
            <col style="width: 6%">
            <col style="width: 6%">
        </colgroup>

        <tbody>
            <tr style="display: none">
                <td>
                    &nbsp;
                </td>
                <td style="text-align: center"></td>


                @if (Model.SearchCondition.PageId == PageId.PageId_1001103040
     || Model.SearchCondition.PageId == PageId.PageId_1001102040
     || Model.SearchCondition.PageId == PageId.PageId_100110140)
                {
                    <td style="text-align: center"></td>
                                                    <td style="text-align: left" colspan="2"></td>
                                                    <td style="text-align: center" colspan="2"></td>
                }
                else
                {
                    <td style="text-align: left"></td>
                                                    <td style="text-align: left"></td>
                                                    <td style="text-align: left"></td>
                                                    <td style="text-align: center"></td>
                                                    <td style="text-align: left"></td>
                                                    <td style="text-align: center"></td>
                }

                <td style="text-align: center"></td>
                <td style="text-align: center"></td>
                <td style="text-align: center"></td>
                <td style="text-align: center"></td>
            </tr>
            <tr style="display: none">
                <td>
                    &nbsp;
                </td>
                <td style="text-align: center"></td>


                @if (Model.SearchCondition.PageId == PageId.PageId_1001103040
        || Model.SearchCondition.PageId == PageId.PageId_1001102040
        || Model.SearchCondition.PageId == PageId.PageId_100110140)
                {
                    <td style="text-align: center"></td>
                                                    <td style="text-align: left" colspan="2"></td>
                                                    <td style="text-align: center" colspan="3"></td>
                }
                else
                {
                    <td style="text-align: left"></td>
                                                    <td style="text-align: left"></td>
                                                    <td style="text-align: left"></td>
                                                    <td style="text-align: center"></td>
                                                    <td style="text-align: left"></td>
                                                    <td style="text-align: center"></td>
                }

                <td style="text-align: center"></td>
                <td style="text-align: center"></td>
                <td style="text-align: center"></td>
                <td style="text-align: center"></td>
            </tr>
        </tbody>
        <tfoot class="" style="display: none">
            <tr>
                <td width="1">
                    <input type="checkbox" id="chkCaseAll" name="chkCaseAll">
                </td>
                <td colspan="11">
                    <div class="pull-left" style="position:absolute;z-index: 1000;">
                        <input type="button" id="btnCaseExportToExcel" class="btn btn-default" style="height:32px" value="导出Excel" />
                        @if (Model.SearchCondition.PageId == PageId.PageId_1001103010
                                        || Model.SearchCondition.PageId == PageId.PageId_1001103020
                                        || Model.SearchCondition.PageId == PageId.PageId_1001103030
                                        || Model.SearchCondition.PageId == PageId.PageId_1001103040)
                        {
                            <input type="button" id="btnCaseDelete" class="btn btn-default" style="height:32px" value="删除案件" />
                        }
                        <div id="divdropdown" class="inline-block dropdown" style="margin-left: 4px">
                            <div class="dropdown ng-scope">
                                <button class="btn btn-default dropdown-toggle" style="height:32px" data-toggle="dropdown">
                                    更多操作
                                    <span class="caret"></span>
                                </button>
                                <ul class="dropdown-menu" style="position:absolute;z-index: 99999;text-align: left;">

                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.MultiOpen($.checkbox.vals('chkCaseId'));">
                                            <span style="font-size:12px">上传案件文档</span>
                                        </a>
                                    </li>

                                    @*<li>
                                            <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">新增案件费用</span></a>
                                        </li>*@

                                    <li class="dropdown-submenu">
                                        <a tabindex="-1" href="javascript:;">新增律所费用</a>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'), $.lsCaseFeeType.TypeId.OfficeFee, $.lsGroupId.Lawfirm);">
                                                    <span>新增官费</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'), $.lsCaseFeeType.TypeId.Nonparty, $.lsGroupId.Lawfirm);">
                                                    <span>新增第三方费用</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'), $.lsCaseFeeType.TypeId.NonOfficeFee, $.lsGroupId.Lawfirm);">
                                                    <span>新增代理费</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'), $.lsCaseFeeType.TypeId.CommissionFee, $.lsGroupId.Lawfirm);">
                                                    <span>新增其他费用</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </li>


                                    <li class="dropdown-submenu">
                                        <a tabindex="-1" href="javascript:;">新增平台费用</a>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'), $.lsCaseFeeType.TypeId.OfficeFee, $.lsGroupId.Trad);">
                                                    <span>新增官费</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'), $.lsCaseFeeType.TypeId.Nonparty, $.lsGroupId.Trad);">
                                                    <span>新增第三方费用</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'), $.lsCaseFeeType.TypeId.NonOfficeFee, $.lsGroupId.Trad);">
                                                    <span>新增代理费</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFees.CaseFee.MultiCreate($.checkbox.vals('chkCaseId'), $.lsCaseFeeType.TypeId.CommissionFee, $.lsGroupId.Trad);">
                                                    <span>新增其他费用</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </li>


                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.InternalFees.InternalFee.MultiOpen($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">新增内部费用</span></a>
                                    </li>

                                    <li class="dropdown-submenu">
                                        <a tabindex="-1" href="javascript:;">批量修改</a>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.Participant.Open($.checkbox.vals('chkCaseId'));">
                                                    <span>修改开庭律师</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.Participant.Open($.checkbox.vals('chkCaseId'));">
                                                    <span>修改经办律师</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.Participant.Open($.checkbox.vals('chkCaseId'));">
                                                    <span>修改律师助理</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: if ($.checkbox.vals('chkCaseId').length == 0) { $.showTips('请选择案件.', 0, 3); return false; } c.Cases.Case.CasePhases.CasePhase.Open($.checkbox.vals('chkCaseId'));">
                                                    <span>修改案件阶段</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </li>

                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.AuthorizationLetter.Create($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">生成授权委托书</span></a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.LawyersLetter.Create($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">生成律所函</span></a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.IdentificationLetter.Create($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">生成身份证明</span></a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.SettlementList.Create($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">生成结算提成表</span></a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseTasks.CaseTask.Open($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">案件任务</span></a>
                                    </li>
                                    <li>
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseLogs.CaseLog.Open($.checkbox.vals('chkCaseId'));"><span style="font-size:12px">案件日志</span></a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                    </div>
                    <div class="">
                        <div class="pull-right page-box Caselist">
                        </div>
                    </div>
                </td>
            </tr>
        </tfoot>
    </table>

</div>