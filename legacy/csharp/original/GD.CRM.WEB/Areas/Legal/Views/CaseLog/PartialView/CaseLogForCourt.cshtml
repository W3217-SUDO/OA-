@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Entity.Legal.Case;

@model Dchien.Legal.Web.Areas.Legal.ViewModels.Case.CaseLogModel

<div class="modal fade" id="caseLogModal" >
 
    <div class="modal-dialog" >
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseLog", "Case", FormMethod.Post, new { id = "caseLog", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CaseId)
                    @Html.HiddenFor(m => m.CaseNo)
                    @Html.HiddenFor(m => m.CaseNos)
                    @Html.HiddenFor(m => m.CaseLog.LogId)

                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseLogClose" onclick="javascript:$('#caseLogModal').modal('hide');">×</button>
                        <h5 class="modal-title ng-binding">案件日志</h5>
                    </div>
                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label for="CaseLog_Content" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">提交法院时间:</span>
                                </label>
                                <div class="col-sm-6">
                                    <input class="input_time form-control" data-val="true" data-val-date="The field Deadline must be a date." id="Court_SubmitDate" name="Court.SubmitDate" onfocus="WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" required="true" type="text" value="">
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="CaseLog_Content" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">法院联系人:</span>
                                </label>
                                <div class="col-sm-6">
                                    <input class="form-control"   id="Court_Contacts" name="Court.Contacts"  type="text" value="">
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="CaseLog_Content" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">联系电话:</span>
                                </label>
                                <div class="col-sm-6">
                                    <input class="form-control"  id="Court_Phone" name="Court.Phone" type="text" value="">
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="CaseLog_Content" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">快递单号:</span>
                                </label>
                                <div class="col-sm-6">
                                    <input class="form-control"  id="Court_TrackingNo" name="Court.TrackingNo" onfocus="WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})"   type="text" value="">
                                </div>
                            </div>
                            

                            <div class="form-group">
                                <label for="CaseLog_Content" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">日志内容</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextAreaFor(m => m.CaseLog.Content, new { @required = "true", maxlength = 1000, rows=4,style = "width:120%" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        @if (Model.CaseLog != null && Model.CaseLog.LogId > 0 && Model.CaseLog.LogType == (int)CaseLogType.Business)
                        {
                            if (LoginHelper.IsAdmin() && LoginHelper.GetUserName() == Model.CaseLog.Operator)
                            {
                                <input class="btn btn-primary ng-binding" type="button" id="btnCaseLogDelete" onclick="javascript:c.Cases.Case.CaseLogs.CaseLog.Delete();" value="删除" />
                            }
                        }
                        else if(Model.CaseLog != null  && Model.CaseLog.LogType == (int)CaseLogType.Business)
                        {
                            <input class="btn btn-primary ng-binding" type="button" id="btnCaseLog"  onclick="javascript:c.Cases.Case.CaseLogs.CaseLog.CreateUpdate();" value="确定" />
                        }
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseLogCancel"  onclick="javascript:$('#caseLogModal').modal('hide');"  value="取消" />
                    </div>
                }
            </div>
        </div>
    </div>
   
</div>