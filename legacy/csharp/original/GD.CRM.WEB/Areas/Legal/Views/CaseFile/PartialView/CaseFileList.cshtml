<SCRIPT type="text/javascript">

    var setting = {
        view: {
            showLine: false,
            addHoverDom: c.Cases.Case.CaseFiles.CaseFileType.Tree.addHoverDom,
            removeHoverDom: c.Cases.Case.CaseFiles.CaseFileType.Tree.removeHoverDom,
            selectedMulti: false
        },
        edit: {
            enable: true,
            editNameSelectAll: true,
            showRemoveBtn: c.Cases.Case.CaseFiles.CaseFileType.Tree.showRemoveBtn,
            showRenameBtn: c.Cases.Case.CaseFiles.CaseFileType.Tree.showRenameBtn,
            showUploadBtn: false
        },
        data: {
            simpleData: {
                enable: true
            }
        },
        callback: {
            onClick: c.Cases.Case.CaseFiles.CaseFileType.Tree.zTreeOnClick,
            beforeDrag: c.Cases.Case.CaseFiles.CaseFileType.Tree.beforeDrag,
            beforeEditName: c.Cases.Case.CaseFiles.CaseFileType.Tree.beforeEditName,
            beforeRemove: c.Cases.Case.CaseFiles.CaseFileType.Tree.beforeRemove,
            beforeRename: c.Cases.Case.CaseFiles.CaseFileType.Tree.beforeRename,
            onRemove: c.Cases.Case.CaseFiles.CaseFileType.Tree.onRemove,
            onRename: c.Cases.Case.CaseFiles.CaseFileType.Tree.onRename
        }
    };
    var log, className = "dark";
    var newCount = 1;

</SCRIPT>


