@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>打开文档</title>
    <meta http-equiv="pragma" content="no-cache">
    <meta http-equiv="cache-control" content="no-cache">
    <meta http-equiv="expires" content="0">
    <meta http-equiv="keywords" content="keyword1,keyword2,keyword3">
    <meta http-equiv="description" content="This is my page">
    <!--
    <link rel="stylesheet" type="text/css" href="styles.css">
    -->
    <script src="@Url.Content("~/Scripts/Common/jquery-3.3.1.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

     <script type="text/javascript">
            function Save() {
                pageofficectrl.WebSave();
            }
            function showRevision() {
                pageofficectrl.ShowRevisions = true;
                //document.getElementById("PageOfficeCtrl1").ShowRevisions = true;
            }
            function hideRevision() {
                pageofficectrl.ShowRevisions = false;
                //document.getElementById("PageOfficeCtrl1").ShowRevisions = false;
            }
            function SaveAndSeal() {
                //alert(";;;");
                pageofficectrl.WebSave();
                $.ajax({
                    url: "@System.Configuration.ConfigurationManager.AppSettings["onlineurl"]/100110110/Legal/CaseFile/CaseFileWordToSeal", // 替换为你的API端点
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ caseFileId:  @ViewBag.FileId  }),
                    processData: false,
                    dataType: 'json',
                    success: function(response) {
                        alert("提交用印成功.");
                        //POBrowser.closeWindow();
                        //window.close();
                    },
                    error: function(xhr, status, error) {
                        console.error('Error:', error);
                        alert(error);
                    }
                });
            }
            //加盖印章
            function InsertSeal() {
                try {
                    pageofficectrl.zoomseal.AddSeal();
                } catch (e) {
                }
            }
        </script>
    </head>
    <body>
        <div style="width:1200px; height:900px;">
            @Html.Raw(ViewBag.EditorHtml)
        </div >
</body>
</html>






