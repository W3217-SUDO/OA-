@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.BAS.Type
@using Dchien.Legal.Entity.Legal.Case
@using Dchien.Legal.Service.Legal.Investigation.Clue

@model Dchien.Legal.Web.Areas.Legal.ViewModels.Case.CaseModel

<link rel="stylesheet" href="@Url.Content("~/Resource/css/bootstrap-tagsinput.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" />
<script src="@Url.Content("~/Scripts/Common/bootstrap-tagsinput.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Legal/Case/Legal.Case.Basic.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<style>
    .bootstrap-tagsinput {
        width: 100%;
        border-radius: 0px;
        padding: 2px 4px;
    }

        .bootstrap-tagsinput input {
            padding: 0px;
            width: 50px;
        }
           
    .chosen-container-multi .chosen-choices {
        border: 1px solid #cccccc;
        font-size: 12px;
    }
</style>


<div class="modal fade" id="caseBasicModal" >
 
    <div class="modal-dialog" style="width:700px" >
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("Edit", "Case", FormMethod.Post, new { id = "caseLog", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {

                    <div class="modal-header">
                        <button type="button" class="close" onclick="javascript:$('#caseBasicModal').modal('hide');">×</button>
                        <h5 class="modal-title ng-binding">基本信息</h5>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span>客户：</span>
                            </label>
                            <div class="col-sm-7">
                                <div class="bootstrap-tagsinput">
                                    @Html.HiddenFor(m => m.Case.Basic.CustomerNo)
                                    @Html.TextBoxFor(m => m.Case.Basic.CustomerName,
                                    new
                                    {
                                        @class = "form-control inline-block ",
                                        placeholder = "客户名称",
                                        style = "height:24px;width:90%",
                                        @value = "",
                                        cityvalue = "",
                                        autocomplete = "off",
                                        @readonly = true

                                    })

                                    @*<div style="float:right;margin-top:6px;background-color:white; important" class="label">
                                        <a style="color:green;" title="新增客户" data-toggle="tooltip" data-container="body" href="javascript:void(0);">
                                            <span class="btn_indicter_add fa fa-user-plus"></span>
                                        </a>
                                    </div>*@

                                </div>
                   
                            </div>

                        </div>

                        @*<div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span>案由：</span>
                            </label>
                            <div class="col-sm-7">
                                @Html.TextBoxFor(m => m.Case.Basic.CauseName,
                    new
                    {
                        @class = "form-control inline-block ",
                        placeholder = "案由",
                        style = "height:29px;width:100%",
                        @value = "",
                        cityvalue = "",
                        autocomplete = "off"
                    })

                                <div class="i_common_select" id="div_cause" style="display: none;">
                                    <div class="i_common_wrap">
                                        <div class="i_common_list"></div>
                                    </div>
                                </div>
                            </div>
                        </div>*@


                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span>案由：</span>
                            </label>
                            <div class="col-sm-7">

                                <div class="bootstrap-tagsinput">

                                    @if (!string.IsNullOrEmpty(Model.Case.Basic.CauseName))
                                    {
                                        foreach (var causeName in Model.Case.Basic.CauseName.Split(','))
                                        {
                                            <span class="tag label label-info">
                                                <a name="causename" style="color:white; width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                                   causename="@causeName"  data-toggle="tooltip" data-container="body" href="javascript:void(0);"
                                                   target="_blank" data-original-title="@causeName">@causeName</a>
                                                <span class="causeremove" data-role="remove"></span>
                                            </span>
                                        }
                                    }

                                    <input type="text" placeholder="案由" class="form-control inline-block" style="height:22px;width: 200px;margin-left: 6px;" id="Case_Basic_CauseName_Input" autocomplete="off" size="1">
                                </div>

                                <div class="i_common_select" id="div_cause" style="display: none;">
                                    <div class="i_common_wrap">
                                        <div class="i_common_list"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span>案件名称：</span>
                            </label>
                            <div class="col-sm-7">
                                @Html.TextBoxFor(m => m.Case.Basic.CaseName,
                                new
                                {
                                    @class = "form-control inline-block ",
                                    placeholder = "案件名称",
                                    style = "height:29px;width:100%",
                                    @value = "",
                                    cityvalue = "",
                                    autocomplete = "off"
                                })

                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span>案件阶段：</span>
                            </label>
                            <div class="col-sm-7">
                                @Html.DropDownListFor(m => m.Case.Basic.CasePhaseId, CasePhaseService.Instance.GetCasePhaseList(Model.Case.Basic.CaseTypeId.Value), new { maxlength = 60, @class = "form-control select", style = "height:29px; " })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span>经办律师：</span>
                            </label>
                            <div class="col-sm-7">
                                <div class="bootstrap-tagsinput">
                                  
                                        @if (!string.IsNullOrEmpty(Model.Case.Basic.CaseLawyer))
                                        {
                                            var caseLawyerNames = Model.Case.Basic.CaseLawyerName.Split(',');
                                            var i = 0;
                                            foreach (var caseLawyer in Model.Case.Basic.CaseLawyer.Split(','))
                                            {
                                                 <span class="tag label label-info">
                                                    <a name="lawyername" style="color:white; width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                                       username="REDACTED_ARCHIVE_ONLY"  userchname="@caseLawyerNames[i]" data-toggle="tooltip" data-container="body" href="javascript:caseInfo.CaseCustomer.ViewCustomer('@caseLawyer');"
                                                       target="_blank" data-original-title="@caseLawyerNames[i]">@caseLawyerNames[i]</a>
                                                    <span class="lawyerremove" data-role="remove"></span>
                                                </span>
                                                i++;
                                            }
                                        }
                                    <input type="text" placeholder="经办律师" class="form-control inline-block" style="height:22px;width: 100px;margin-left: 6px;" id="Case_Basic_CaseLawyer_Input" autocomplete="off" size="1">
                                </div>
                                <div class="i_common_select" id="div_lawyerlist" style="display: none;">
                                    <div class="i_common_wrap">
                                        <div class="i_common_list"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger"></span>
                                <span>律师助理：</span>
                            </label>
                            <div class="col-sm-7">
                                <div class="bootstrap-tagsinput">

                                    @if (!string.IsNullOrEmpty(Model.Case.Basic.CaseAssistant))
                                    {
                                        var caseAssistantNames = Model.Case.Basic.CaseAssistantName.Split(',');
                                        var i = 0;
                                        foreach (var caseAssistant in Model.Case.Basic.CaseAssistant.Split(','))
                                        {
                                            <span class="tag label label-info">
                                                <a name="assistantname" style="color:white; width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                                   username="REDACTED_ARCHIVE_ONLY"  userchname="@caseAssistantNames[i]" data-toggle="tooltip" data-container="body" href="javascript:caseInfo.CaseCustomer.ViewCustomer('@caseAssistant');"
                                                   target="_blank" data-original-title="@caseAssistantNames[i]">@caseAssistantNames[i]</a>
                                                <span class="assistantremove" data-role="remove"></span>
                                            </span>
                                            i++;
                                        }
                                    }

                                    <input type="text" placeholder="律师助理" class="form-control inline-block" style="height:22px;width: 100px;margin-left: 6px;" id="Case_Basic_CaseAssistant_Input" autocomplete="off" size="1">
                                </div>
                                <div class="i_common_select" id="div_assistantlist" style="display: none;">
                                    <div class="i_common_wrap">
                                        <div class="i_common_list"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                  
                        <div class="form-group" style="display:none">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger"></span>
                                <span>调查线索：</span>
                            </label>
                            <div class="col-sm-7">
                                <select data-placeholder="调查线索" multiple id="Case_Basic_InvestigationClueNo" class="Case_Basic_InvestigationClueNo" style="height:22px;width: 100%;">
                                    @{
                                        var clueNotUsedList = InvestigationClueService.Instance.GetNotUsedInvestigationClueListByIndicterNo(Model.Case.Basic.CustomerNo);
                                        if (clueNotUsedList != null && clueNotUsedList.Any())
                                        {
                                            foreach (var clue in clueNotUsedList)
                                            {
                                                if (Model.Case.Basic.InvestigationClueNos.Contains(clue.Basic.ClueNo))
                                                {
                                                    <option selected="selected" value="@clue.Basic.ClueNo">@(clue.Basic.ClueNo + "_" + clue.Basic.Indictee)</option>
                                                }
                                                else
                                                {
                                                    <option value="@clue.Basic.ClueNo">@(clue.Basic.ClueNo + "_" + clue.Basic.Indictee)</option>
                                                }
                                            }
                                        }

                                        var clueUsedList = InvestigationClueService.Instance.GetUsedInvestigationClueListByIndicterNo(Model.Case.Basic.CustomerNo);

                                        if (clueUsedList != null && clueUsedList.Any())
                                        {
                                            foreach (var clue in clueUsedList)
                                            {
                                                if (Model.Case.Basic.InvestigationClueNos.Contains(clue.Basic.ClueNo))
                                                {
                                                    <option selected="selected" value="@clue.Basic.ClueNo">@(clue.Basic.ClueNo + "_" + clue.Basic.Indictee)</option>
                                                }
                                                else
                                                {
                                                    <option value="@clue.Basic.ClueNo">@(clue.Basic.ClueNo + "_" + clue.Basic.Indictee)</option>
                                                }
                                            }
                                        }

                                    }
                                </select>
                            </div>
                        </div>


                        <div class="form-group"  style="display:none">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger"></span>
                                <span>调查员：</span>
                            </label>
                            <div class="col-sm-7">
                                <div class="bootstrap-tagsinput">
                                    @if (!string.IsNullOrEmpty(Model.Case.Basic.Investigator))
                                    {
                                        var investigatorNames = Model.Case.Basic.InvestigatorName.Split(',');
                                        var i = 0;
                                        foreach (var investigatorName in Model.Case.Basic.Investigator.Split(','))
                                        {
                                            <span class="tag label label-info">
                                                <a name="investigatorname" style="color:white; width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                                   username="REDACTED_ARCHIVE_ONLY" userchname="@investigatorNames[i]" data-toggle="tooltip" data-container="body" href="javascript:caseInfo.CaseCustomer.ViewCustomer('@investigatorName');"
                                                   target="_blank" data-original-title="@investigatorNames[i]">@investigatorNames[i]</a>
                                                <span class="investigatorremove" data-role="remove"></span>
                                            </span>
                                            i++;
                                        }
                                    }

                                    <input type="text" placeholder="调查员" class="form-control inline-block" style="height:22px;width: 100px;margin-left: 6px;" id="Case_Basic_Investigator_Input" autocomplete="off" size="1">
                                </div>
                                <div class="i_common_select" id="div_investigatorlist" style="display: none;">
                                    <div class="i_common_wrap">
                                        <div class="i_common_list"></div>
                                    </div>
                                </div>

                                <label>
                                    <span class="text-danger" >
                                        如存在线索号,不要再填调查员.
                                    </span>
                                </label>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button"    onclick="javascript: c.Cases.Case.CreateUpdate(c.Cases.Case.CreateUpdate_Refersh);" value="确定" />
                        <input class="btn btn-default ng-binding" type="button"    onclick="javascript:$('#caseBasicModal').modal('hide');"  value="取消" />
                    </div>
                }
            </div>
        </div>
    </div>
   
</div>