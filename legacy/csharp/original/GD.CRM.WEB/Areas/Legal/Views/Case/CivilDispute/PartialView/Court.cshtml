@using Dchien.Legal.Entity.System
@using Dchien.Legal.Service.BAS
@using Dchien.Legal.Service.BAS.Type

@model Dchien.Legal.Web.Areas.Legal.ViewModels.Case.CaseModel

@*<script type="text/javascript" src="@Url.Content("~/Scripts/CIT/Investigation/CIT.Investigation.Clue.CreateUpdate.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
    <script src="@Url.Content("~/Scripts/Common/jquery-citys.js")" type="text/javascript"></script>*@

<link type="text/css" rel="stylesheet" href=@Url.Content("~/Resource/css/ticketSystem/add.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"]) />

<style>
    .bootstrap-tagsinput {
        width: 90%;
        border-radius: 0px;
        padding: 2px 4px;
        box-shadow: inset 0 0px 0px rgba(0, 0, 0, 0.075);
    }

        .bootstrap-tagsinput input {
            padding: 0px;
            width: 50px;
        }

        .bootstrap-tagsinput span {
            line-height: 1.4;
        }

    .chosen-container-multi .chosen-choices {
        border: 1px solid #cccccc;
        font-size: 12px;
    }
</style>



<div class="slide-panels">
    <div class="slide-panel active medium">
        <div class="slide-panel-content">
            <div class="panel-header">
                <h5>生成案件</h5>
                <a class="panel-close" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');">
                    <i class="next-icon next-icon-close next-small" style="font-size: 0px;">close</i>
                </a>
                <div class="head-custom"></div>
            </div>
            <div class="placeholder">...</div>
            <div class="panel-body">
                <div class="panel-body-content">
                    <div class="page-overview-panel-apply">
                        <div ui-view="myTicket">
                            <div class="ticket-detail ">
                                <div class="create-ticket-step clearfix" style="margin-top: 0px;margin-bottom: 20px;">
                                    <div class="create-ticket-step-item ">
                                        <div class="item-wrap">
                                            <span class="icon-step">1</span>
                                            <span class="dingding-text">基本信息</span>
                                        </div>
                                    </div>
                                    <div class="create-ticket-step-item ">
                                        <div class="item-wrap">
                                            <span class="icon-step">2</span>
                                            <span class="dingding-text">当事人信息</span>
                                        </div>
                                    </div>
                                    <div class="create-ticket-step-item active">
                                        <div class="item-wrap">
                                            <span class="icon-step">3</span>
                                            <span class="dingding-text">法院信息</span>
                                        </div>
                                    </div>
                                </div>




                                <div role="grid" class="next-form next-medium">
                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label required="">一审法院：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <div class="bootstrap-tagsinput">
                                                @Html.HiddenFor(m => m.Case.Basic.FirstIntanceCourt)
                                                @Html.TextBoxFor(m => m.Case.Basic.FirstIntanceCourtName,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "一审法院",
                                                   style = "height:26px;width:100%",
                                                   @value = "",
                                                   cityvalue = "",
                                                   autocomplete = "off"
                                               })

                                                <div class="i_common_select" id="div_FirstIntanceCourtList" style="display: none;">
                                                    <div class="i_common_wrap">
                                                        <div class="i_common_list"></div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>

                                    </div>
                                    <div class="e_ec next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label required="">法庭：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <span class="next-input next-medium">
                                                @Html.TextBoxFor(m => m.Case.Basic.FirstIntanceCourtRoom,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "法庭",
                                                   style = "height:26px;width:100%",
                                                   autocomplete = "off"
                                               })
                                             </span>
</div>
                                    </div>
                                    <div class="e_ec next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">

                                            <label required="">法官：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <div class="bootstrap-tagsinput">
                                                @Html.HiddenFor(m => m.Case.Basic.FirstIntanceJudge)
                                                @Html.TextBoxFor(m => m.Case.Basic.FirstIntanceJudgeName,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "法官",
                                                   style = "height:26px;width:90%",
                                                   @value = "",
                                                   cityvalue = "",
                                                   autocomplete = "off"
                                               })
                                                <div style="float:right;margin-top:4px;background-color:white; important" class="label">
                                                    <a style="color:green;" title="新增" data-toggle="tooltip" data-container="body" href="javascript:void(0);">
                                                        <span class="btn_FirstIntanceJudge_add glyphicon glyphicon-plus"></span>
                                                    </a>
                                                </div>
                                            </div>
                                            <div class="i_common_select" id="div_FirstIntanceJudgeList" style="display: none;">
                                                <div class="i_common_wrap">
                                                    <div class="i_common_list"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="e_ec next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">

                                            <label required="">书记员：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <div class="bootstrap-tagsinput">
                                               @Html.HiddenFor(m => m.Case.Basic.FirstIntanceClerk)
                                            @Html.TextBoxFor(m => m.Case.Basic.FirstIntanceClerkName,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "书记员",
                                                   style = "height:26px;width:90%",
                                                   @value = "",
                                                   cityvalue = "",
                                                   autocomplete = "off"
                                               })
                                                <div style="float:right;margin-top:4px;background-color:white; important" class="label">
                                                    <a style="color:green;" title="新增" data-toggle="tooltip" data-container="body" href="javascript:void(0);">
                                                        <span class="btn_FirstIntanceJudge_add glyphicon glyphicon-plus"></span>
                                                    </a>
                                                </div>
                                            </div>
                                            <div class="i_common_select" id="div_FirstIntanceJudgeList" style="display: none;">
                                                <div class="i_common_wrap">
                                                    <div class="i_common_list"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="e_ec next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">

                                            <label required="">一审案号：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <span class="next-input next-medium">
                                                @Html.TextBoxFor(m => m.Case.Basic.FirstIntanceCaseNo,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "一审案号",
                                                   style = "height:26px;;width:100%",
                                                   @value = "",
                                                   cityvalue = "",
                                                   autocomplete = "off"
                                               })
                                            </span>
                                            
                                        </div>
                                    </div>

                                    <div class="e_ec next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">

                                            <label required="">立案日期：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <span class="next-input next-medium">
                                               @Html.TextBoxFor(m => m.Case.Basic.FirstIntanceRegisterDate,
                                               new
                                               {
                                                   @class = "input_time form-control inline-block ",
                                                   placeholder = "立案日期",
                                                   style = "height:26px;width:100%",
                                                   @value = "",
                                                   cityvalue = "",
                                                   autocomplete = "off",
                                                   onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})",
                                                   required = "true"

                                               })
                                            </span>

                                        </div>
                                    </div>

                                    <div class="e_ec next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">

                                            <label required="">开庭日期：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <span class="next-input next-medium">
                                                @Html.TextBoxFor(m => m.Case.Basic.FirstIntanceLawfulDay,
                                               new
                                               {
                                                   @class = "input_time form-control inline-block ",
                                                   placeholder = "开庭日期",
                                                   style = "height:26px;width:100%",
                                                   @value = "",
                                                   cityvalue = "",
                                                   autocomplete = "off",
                                                   onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})",
                                                   required = "true"
                                               })


                                            </span>

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="panel-footer">
                <div class="btn-con">
                    <input type="button" id="btnCaseCreate" class="btn btn-primary ng-binding" style="height: 32px; line-height: 14px;   padding: 8px 16px;" value="下一步" />


                    <input type="button" class="btn  btn-normal" style="border-radius: 0;
                                                                        padding: 0 16px;
                                                                        height: 32px;
                                                                        line-height: 30px;
                                                                        font-size: 12px;
                                                                        border-width: 1px;" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');" value="取消" />
                </div>
            </div>
        </div>
    </div>
</div>
