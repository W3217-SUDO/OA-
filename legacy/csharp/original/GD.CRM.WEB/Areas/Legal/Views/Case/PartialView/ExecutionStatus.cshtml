@using Dchien.Legal.Service.BAS.Type

@model Dchien.Legal.Web.Areas.Legal.ViewModels.Case.ExecutionStatusModel

<div class="modal fade" id="executionStatusChangeModel">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="ng-scope">
                @using (Html.BeginForm("ExecutionStatus", "Case", FormMethod.Post, new { id = "executionStatusChange", @class = "form-horizontal" }))
                {
                    @Html.HiddenFor(m => m.CaseNos)

                    <div class="modal-header">
                        <button type="button" class="close" id="btnExecutionStatusChangeClose" onclick="javascript: $('#executionStatusChangeModel').modal('hide');">×</button>
                        <h5 class="modal-title ">选择执行进度</h5>
                    </div>
                    <div class="modal-body">
                        <div>
                            <div class="form-group  margin-top-3 ">
                                <label class="col-sm-3 control-label">
                                    <span class="text-danger ">*</span>
                                    <span class="">执行进度:</span>
                                </label>
                                <div class="col-sm-6">
                                        @Html.DropDownListFor(m => m.ExecutionStatus, ExecutionStatusService.Instance.GetExecutionStatusList(true), new { @class = "form-control", style = "width:90%" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary " type="button" id="btnExecutionStatusUpdate" value="确定" />
                        <input class="btn btn-default " type="button" id="btnExecutionStatusUpdateCancel" value="取消" onclick="javascript: $('#executionStatusChangeModel').modal('hide');" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>


