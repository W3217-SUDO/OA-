                                    <li  class="dropdown-submenu pull-left">
                                        <a tabindex="-1" href="javascript:;"  >修改法院信息</a>
                                        <ul class="dropdown-menu" style="text-align: left; left: auto;">
                                            <li>
                                                <a href="javascript:; " onclick="javascript: c.Cases.Case.Court.FirstCourt();" >
                                                    <span> 一审 </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.Court.SecondCourt();" >
                                                    <span> 二审 </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.Court.LastCourt();" >
                                                    <span> 再审 </span>
                                                </a>
                                            </li>
                                        </ul>
                                    </li>

                                    <li class="">
                                        <a href="javascript:;" onclick="javascript: c.Cases.Case.SettlementAmount.Open();"><span>修改判决金额</span></a>
                                    </li>

                                    <li class="dropdown-submenu pull-left">
                                        <a tabindex="-1" href="javascript:;"  >更多操作</a>
                     
                                        <ul class="dropdown-menu" style="text-align: left; left: auto;">
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.AuthorizationLetter.Create(new Array($('#Case_Basic_CaseNo').val()));"><span style="font-size:12px">生成授权委托书</span></a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.LawyersLetter.FirstIntanceAppellant.Create(new Array($('#Case_Basic_CaseNo').val()));"><span style="font-size:12px">生成一审所函(我方原告)</span></a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.LawyersLetter.FirstIntanceAppellee.Create(new Array($('#Case_Basic_CaseNo').val()));"><span style="font-size:12px">生成一审所函(我方被告)</span></a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.LawyersLetter.SecondIntanceAppellant.Create(new Array($('#Case_Basic_CaseNo').val()));"><span style="font-size:12px">生成二审所函(我方上诉)</span></a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.LawyersLetter.SecondIntanceAppellee.Create(new Array($('#Case_Basic_CaseNo').val()));"><span style="font-size:12px">生成二审所函(对方上诉)</span></a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.IdentificationLetter.Execution.Create(new Array($('#Case_Basic_CaseNo').val()));"><span style="font-size:12px">生成身份证明</span></a>
                                            </li>
                                            <li>
                                                <a href="javascript:;" onclick="javascript: c.Cases.Case.CaseFiles.CaseFile.SettlementList.Create(new Array($('#Case_Basic_CaseNo').val()));"><span style="font-size:12px">生成结算提成表</span></a>
                                            </li>
                                        </ul>
                                    </li>

                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="case-section-main">
                        <!-- 左侧 -->
                        <div class="case-section-left" style="padding-right: 15%;">
                            <div class="case-section-wrap" style="padding:2px">
                                <div class="case-section-product">
                                    <!-- product section -->
                                    <div class="product-container">
                                        <div class="product-section">
                                            @using (Html.BeginForm("CaseInfo", "Case", FormMethod.Post, new { id = "caseForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                                            {
                                                @Html.HiddenFor(m => m.Case.Basic.CaseId)
                                                @Html.HiddenFor(m => m.Case.Basic.CaseNo)
                                                @Html.HiddenFor(m => m.Case.Basic.CaseTypeId)
                                                @Html.HiddenFor(m => m.Case.Basic.CustomerNo)
                                                @Html.HiddenFor(m => m.Case.Basic.ContractNo)

                                                @Html.HiddenFor(m => m.Case.Basic.CaseLawyer)
                                                @Html.HiddenFor(m => m.Case.Basic.CaseLawyerName)
                                                @Html.HiddenFor(m => m.Case.Basic.Investigator)
                                                @Html.HiddenFor(m => m.Case.Basic.InvestigatorName)
                                                @Html.HiddenFor(m => m.Case.Basic.CaseAssistant)
                                                @Html.HiddenFor(m => m.Case.Basic.CaseAssistantName)
                                                @Html.HiddenFor(m => m.Case.Basic.BusinessOwner)
                                                @Html.HiddenFor(m => m.Case.Basic.BusinessOwnerName)


                                                <div class="section-content clearfix" style='padding:0px'>
                                                    <div class="ng-scope">
