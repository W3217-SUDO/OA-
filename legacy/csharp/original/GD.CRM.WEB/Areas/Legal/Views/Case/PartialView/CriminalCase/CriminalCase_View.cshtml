                                        @Html.DisplayTextFor(m => m.Case.Basic.FirstIntanceCaseNo)
                                    </td>

                                    <th>
                                        立案时间
                                    </th>
                                    <td>
                                        @Html.DisplayFor(m => m.Case.Basic.FirstIntanceRegisterDate)
                                    </td>

                                    <th>
                                        开庭时间
                                    </th>
                                    <td>
                                        @Html.DisplayFor(m => m.Case.Basic.FirstIntanceLawfulDay)
                                    </td>

                                    <th>
                                        判决日期
                                    </th>
                                    <td>
                                        @Html.DisplayFor(m => m.Case.Basic.FirstIntanceJudgmentDate)
                                    </td>
                                </tr>

                                <tr>
                                    <th>
                                        二审法院
                                    </th>
                                    <td>
                                        @*<a style="color:#06C; width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                            data-container="body"
                                            data-toggle="popover"
                                            title="二审法院"
                                            href="javascript:;"
                                            target="_blank"
                                            data-original-title="@Model.Case.Basic.SecondIntanceCourtName">@Model.Case.Basic.SecondIntanceCourtName</a>*@

                                        @{
                                            var courtJudgeOfficer2 = string.IsNullOrEmpty(Model.Case.Basic.SecondIntanceJudge) ? null : CourtOfficerService.Instance.GetCourtOfficer(Model.Case.Basic.SecondIntanceJudge);
                                            var courtClerkOfficer2 = string.IsNullOrEmpty(Model.Case.Basic.SecondIntanceJudge) ? null : CourtOfficerService.Instance.GetCourtOfficer(Model.Case.Basic.SecondIntanceClerk);

                                            <a style="color:#06C; width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                               data-container="body"
                                               data-toggle="popover_court"
                                               title="二审法院"
                                               href="javascript:;"
                                               court_name="@Model.Case.Basic.SecondIntanceCourtName"
                                               court_judge_name="@Model.Case.Basic.SecondIntanceJudgeName"
                                               court_judge_phone="@(courtJudgeOfficer == null ? string.Empty : courtJudgeOfficer.Phone)"
                                               court_judge_email="@(courtJudgeOfficer == null ? string.Empty : courtJudgeOfficer.Email)"
                                               court_clerk_name="@Model.Case.Basic.SecondIntanceClerkName"
                                               court_clerk_phone="@(courtClerkOfficer == null ? string.Empty : courtClerkOfficer.Phone)"
