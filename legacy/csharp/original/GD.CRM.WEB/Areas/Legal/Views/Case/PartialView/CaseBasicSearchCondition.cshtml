                                    <div class="form-group" style="padding-bottom: 20px">
                                        <label class="control-label" style="float:left;width:15%">
                                            @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasCaseRequestDate, new { @class = "has" })
                                            @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.CaseRequestDateFrom)
                                        </label>
                                        <div style="float:left;width:52%">
                                            @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.CaseRequestDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                            <span>-</span>
                                            @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.CaseRequestDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                        </div>
                                        <label style="float: left; width: 10%" class=" control-label">
                                            @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInCaseRequestDate, new { @class = "notin" })
                                            @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInCaseRequestDate)
                                        </label>
                                    </div>
                                </div>

