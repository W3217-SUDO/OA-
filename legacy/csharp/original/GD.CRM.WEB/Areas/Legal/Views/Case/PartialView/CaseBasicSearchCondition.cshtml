@using SunHold.Legal.Common
@using SunHold.Legal.Service
@model SunHold.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseSearchConditionModel

@{
    object htmlAttribute = new { required = "false" };
}

<style>

</style>

<div class="ng-scope">
    <div class="casesearch-section-main clearfix">
        <div>
            <div class="casesearch-section-wrap">
                <div class="casesearch-section-product">
                    <!-- product section -->
                    <div class="product-container">
                        <div class="product-section">
                            <!--</div>--><!--</div>-->
                            <div class="section-head casesearch-cursor-pointer">
                                <a class="ng-binding">
                                    @Html.CheckBoxFor(m => m.Search.HasCaseBasicSearchCondition, new { style = "vertical-align: middle; " })<span class="list-title-em" style="vertical-align: middle; ">基本信息</span>
                                </a>
                                <span style="padding-left: 50px">

                                    @Html.CheckBoxFor(m => m.Search.IsUnionCaseBasicSearchCondition, new { style = "vertical-align: middle; " })@Html.LabelFor(m => m.Search.IsUnionCaseBasicSearchCondition)
                                    @Html.CheckBoxFor(m => m.Search.IsNotUnionCaseBasicSearchCondition, new { style = "vertical-align: middle; " })@Html.LabelFor(m => m.Search.IsNotUnionCaseBasicSearchCondition)

                                    @*<input type="checkbox" style="vertical-align: middle; "><label style="vertical-align: middle; ">并集</label>
                                        <input type="checkbox" style="vertical-align: middle; "><label style="vertical-align: middle; ">交集</label>*@
                                </span>
                            </div>
                            <div class="section-content clearfix" style='margin: 0 16px;'>
                                <div>
                                    <div class="form-group" style="padding-bottom: 20px">
                                        <div style="float:left;width:50%">
                                            <label class="control-label" style="float:left;width:30%">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasCaseType, new { @class = "has" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.HasCaseType)
                                            </label>
                                            <div style="float: left; width: 50%">
                                                @{
                                                    var caseTypeIds = string.Empty;
                                                    var caseTypeNames = string.Empty;
                                                    if (@Model != null && @Model.Search != null && @Model.Search.CaseBasicSearchCondition != null)
                                                    {
                                                        if (@Model.Search.CaseBasicSearchCondition.CaseTypeId != null && @Model.Search.CaseBasicSearchCondition.CaseTypeId.Any())
                                                        {
                                                            caseTypeIds = string.Join(",", @Model.Search.CaseBasicSearchCondition.CaseTypeId);
                                                        }

                                                        if (@Model.Search.CaseBasicSearchCondition.CaseTypeName != null && @Model.Search.CaseBasicSearchCondition.CaseTypeName.Any())
                                                        {
                                                            caseTypeNames = string.Join(",", @Model.Search.CaseBasicSearchCondition.CaseTypeName);
                                                        }
                                                    }
                                                }

                                                @Html.TextBoxFor(m => caseTypeNames, new { @id = "Search_CaseBasicSearchCondition_CaseType" })
                                                @Html.HiddenFor(m => caseTypeIds, new { @id = "hid_Search_CaseBasicSearchCondition_CaseType" })
                                            </div>
                                            <label style="float: left; width: 20%" class=" control-label">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInCaseType, new { @class = "notin" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInCaseType)
                                            </label>
                                        </div>

                                        <div style="float:left;width:50%">
                                            <label class="control-label" style="float:left;width:30%">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasCaseOriginPeople, new { @class = "has" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.CaseOriginPeople)
                                            </label>
                                            <div style="float: left; width: 50%">
                                                @Html.HiddenFor(m => m.Search.CaseBasicSearchCondition.CaseOriginPeople)
                                                @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.CaseOriginPeopleName)
                                            </div>
                                            <label style="float: left; width: 20%" class=" control-label">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInCaseOriginPeople, new { @class = "notin" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInCaseOriginPeople)
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    <div class="form-group" style="padding-bottom: 20px">
                                        
                                        @{
                                            var casePhaseIds = string.Empty;
                                            var casePhaseNames = string.Empty;
                                            if (@Model != null && @Model.Search != null && @Model.Search.CaseBasicSearchCondition != null)
                                            {
                                                if (@Model.Search.CaseBasicSearchCondition.CasePhaseId != null && @Model.Search.CaseBasicSearchCondition.CasePhaseId.Any())
                                                {
                                                    casePhaseIds = string.Join(",", @Model.Search.CaseBasicSearchCondition.CasePhaseId);
                                                }

                                                if (@Model.Search.CaseBasicSearchCondition.CasePhaseName != null && @Model.Search.CaseBasicSearchCondition.CasePhaseName.Any())
                                                {
                                                    casePhaseNames = string.Join(",", @Model.Search.CaseBasicSearchCondition.CasePhaseName);
                                                }
                                            }
                                        }

                                        <label class="control-label" style="float:left;width:15%">
                                            @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasCasePhase, new { @class = "has" })
                                            @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.CasePhaseId)
                                        </label>
                                        <div style="float:left;width:75%">
                                            @Html.TextBoxFor(m => casePhaseNames, new { @id = "Search_CaseBasicSearchCondition_CasePhase", @style = "width: 99%" })
                                            @Html.HiddenFor(m => casePhaseIds, new { @id = "hid_Search_CaseBasicSearchCondition_CasePhase" })
                                        </div>
                                        <label style="float: left; width: 10%" class=" control-label">
                                            @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInCasePhase, new { @class = "notin" })
                                            @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInCasePhase)

                                        </label>
                                    </div>
                                </div>

                                <div>
                                    <div class="form-group" style="padding-bottom: 20px">
                                        <div style="float:left;width:50%">
                                            <label class="control-label" style="float:left;width:30%">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasCaseOfficer, new { @class = "has" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.CaseOfficer)
                                            </label>
                                            <div style="float:left;width:50%">
                                                @Html.HiddenFor(m => m.Search.CaseBasicSearchCondition.CaseOfficer, htmlAttribute)
                                                @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.CaseOfficerName, htmlAttribute)
                                            </div>
                                            <label style="float: left; width: 20%" class=" control-label">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInCaseOfficer, new { @class = "notin" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInCaseOfficer)
                                            </label>
                                        </div>
                                        <div style="float:left;width:50%">
                                            <label class="control-label" style="float:left;width:30%">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasProcurator, new { @class = "has" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.Procurator)
                                            </label>
                                            <div style="float:left;width:50%">
                                                @Html.HiddenFor(m => m.Search.CaseBasicSearchCondition.Procurator, htmlAttribute)
                                                @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.ProcuratorName, htmlAttribute)
                                            </div>
                                            <label style="float: left; width: 20%" class=" control-label">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInProcurator, new { @class = "notin" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInProcurator)
                                            </label>

                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <div class="form-group" style="padding-bottom: 20px">

