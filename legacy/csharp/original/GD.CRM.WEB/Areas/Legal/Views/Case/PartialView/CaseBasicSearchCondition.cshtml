                                            @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.DeadlineTo, "{0:yyyy-MM-dd}", new { @class = "input_time", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                        </div>
                                        <label style="float: left; width: 10%" class=" control-label">
                                            @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInDeadline, new { @class = "notin" })
                                            @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInDeadline)
                                        </label>
                                    </div>
                                </div>

