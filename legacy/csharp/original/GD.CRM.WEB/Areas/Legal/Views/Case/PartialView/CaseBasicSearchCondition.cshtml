                                    <div class="form-group" style="padding-bottom: 20px">
                                        <label class="control-label" style="float:left;width:15%">
                                            @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasAuthorizationDate, new { @class = "has" })
                                            @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.AuthorizationDateFrom)
                                        </label>
                                        <div style="float:left;width:52%">
                                            @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.AuthorizationDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                            <span>-</span>
