                                        <label class="control-label" style="float:left;width:15%">
                                            @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasCaseSubmitDate, new { @class = "has" })
                                            @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.CaseSubmitDateFrom)
