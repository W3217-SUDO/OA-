                                            <label class="control-label" style="float:left;width:30%">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasCopywriter, new { @class = "has" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.Copywriter)
                                            </label>
                                            <div style="float:left;width:50%">
                                                @Html.HiddenFor(m => m.Search.CaseBasicSearchCondition.Copywriter, htmlAttribute)
                                                @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.CopywriterName, htmlAttribute)
                                            </div>
                                            <label style="float: left; width: 20%" class=" control-label">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInCopywriter, new { @class = "notin" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInCopywriter)

                                            </label>
                                        </div>

                                        <div style="float:left;width:50%">
                                            <label class="control-label" style="float:left;width:30%">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasCaseInventor, new { @class = "has" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.CaseInventor)
                                            </label>
                                            <div style="float:left;width:50%">
                                                @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.CaseInventor, htmlAttribute)
                                            </div>
                                            <label style="float: left; width: 20%" class=" control-label">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInCaseInventor, new { @class = "notin" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInCaseInventor)

                                            </label>
                                        </div>

                                    </div>
                                </div>

                                <div>
                                    <div class="form-group" style="padding-bottom: 20px">

                                        <div style="float:left;width:50%">
                                            <label class="control-label" style="float:left;width:30%">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasCaseRequestNo, new { @class = "has" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.CaseRequestNo)
                                            </label>
                                            <div style="float:left;width:50%">
                                                @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.CaseRequestNo, htmlAttribute)
                                            </div>
                                            <label style="float: left; width: 20%" class=" control-label">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInCaseRequestNo, new { @class = "notin" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInCaseRequestNo)

                                            </label>
                                        </div>

                                        <div style="float:left;width:50%">
                                            <label class="control-label" style="float:left;width:30%">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasCaseProposer, new { @class = "has" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.CaseProposer)
                                            </label>
                                            <div style="float:left;width:50%">
                                                @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.CaseProposer, htmlAttribute)
                                            </div>
                                            <label style="float: left; width: 20%" class=" control-label">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInCaseProposer, new { @class = "notin" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInCaseProposer)

                                            </label>
                                        </div>

                                    </div>
                                </div>

                                <div>
                                    <div class="form-group" style="padding-bottom: 20px">
                                        <div style="float:left;width:50%">
                                            <label class="control-label" style="float:left;width:30%">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasCaseCustomerNo, new { @class = "has" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.CaseCustomerNo)
                                            </label>
                                            <div style="float:left;width:50%">
                                                @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.CaseCustomerNo, htmlAttribute)
                                            </div>
                                            <label style="float: left; width: 20%" class=" control-label">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInCaseCustomerNo, new { @class = "notin" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInCaseCustomerNo)

                                            </label>
                                        </div>


                                        <div style="float:left;width:50%">
                                            <label class="control-label" style="float:left;width:30%">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasPriority, new { @class = "has" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.HasPriority)
                                            </label>
                                            <div style="float:left;width:50%">

                                            </div>
                                            <label style="float: left; width: 20%" class=" control-label">
                                                @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInHasPriority, new { @class = "notin" })
                                                @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInHasPriority)

                                            </label>
                                        </div>
                                    </div>
                                </div>

                                @{
                                    htmlAttribute = new { @class = "input_time", @onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" };
                                }

                                <div>
                                    <div class="form-group" style="padding-bottom: 20px">
                                        <label class="control-label" style="float:left;width:15%">
                                            @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.HasCaseRegisterDate, new { @class = "has" })
                                            @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.CaseRegisterDateFrom)
                                        </label>
                                        <div style="float:left;width:52%">
                                            @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.CaseRegisterDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                            <span>-</span>
                                            @Html.TextBoxFor(m => m.Search.CaseBasicSearchCondition.CaseRegisterDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })

                                        </div>
                                        <label style="float: left; width: 10%" class=" control-label">
                                            @Html.CheckBoxFor(m => m.Search.CaseBasicSearchCondition.NotInCaseRegisterDate, new { @class = "notin" })
                                            @Html.LabelFor(m => m.Search.CaseBasicSearchCondition.NotInCaseRegisterDate)

                                        </label>
                                    </div>
                                </div>

