@using Dchien.Legal.Service.BAS.Type

<div class="modal fade" id="quickCreateModel">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="ng-scope">
                @using (Html.BeginForm("QuickCreate", "Case", FormMethod.Post, new { id = "quickCreateCase", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    <div class="modal-header">
                        <button type="button" class="close" id="btnQuickCreateCaseClose" onclick="javascript: $('#quickCreateModel').modal('hide');">×</button>
                        <h5 class="modal-title ng-binding">选择案件类型</h5>
                    </div>
                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">案件类型:</span>
                                </label>
                                <div class="col-sm-6">

                                    @{
                                        var caseTypes = CaseTypeService.Instance.GetAllCaseTypes();

                                        <select data-placeholder="选择案件类型" id="Case_Basic_CaseTypeId" class="Case_Basic_CaseTypeId" style="height:28px;width: 100%;">
                                            @if (caseTypes != null && caseTypes.Any())
                                            {
                                                foreach (var caseType in caseTypes)
                                                {
                                                    <option value="@caseType.CaseTypeId">@caseType.CaseTypeName</option>
                                                }
                                            }
                                        </select>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnQuickCreateCase" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnQuickCreateCaseCancel" value="取消" onclick="javascript: $('#quickCreateModel').modal('hide');" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>


