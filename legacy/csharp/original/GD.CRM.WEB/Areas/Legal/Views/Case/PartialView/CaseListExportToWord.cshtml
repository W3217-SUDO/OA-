@using SunHold.Legal.Common
@using SunHold.Legal.Service

@model SunHold.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseListToWordModel

@{
    object htmlAttribute = null;
}

<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>

<div class="modal fade" id="caseToWordModal"  >
    <div class="ng-scope" >
        <div class="modal-dialog" >
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("CaseListFileUploading", "Case", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.CaseIds)
                        @Html.HiddenFor(m => m.CaseFileTypeId)
                        
                        <div class="modal-header">
                            <button type="button" class="close" id="btnCaseListExportToWordClose">×</button>
                            <h5 class="modal-title ng-binding">导出转文文档</h5>
                        </div>
 
                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label for="CaseFileTypeId" class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">文档类型</span>
                                    </label>
                                    <div class="col-sm-6">
                                       
                                        <input type="text" autocomplete="off" class="form-control  ng-valid" placeholder="请选择文档类型" id="CaseFileType">  
                                        

                                    </div>
                                    <div style="float: left; padding-top: 7px; padding-left: 1px;">
                                        <a id="lnkCaseFileTypeId" href="javascript:void(0)">选择</a>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="form-group">
                                    <label  class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">上传文档</span>
                                    </label>
                                    <div class="col-sm-6">
                                        <div >
                                            <div class="btn btn-default btn-xs btn-expense-file-upload" style="height :30px; line-height :25px;"  >
                                                <input type="file" value='' name="flFile" id="flFile"  class="form-control" style="height: 30px;">
                                                <span class="ng-binding">上传文件</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            

                            <div class="divCaseFileTypeList"> </div>
                            
                            <div class="i_common_select" id="div_CaseFileTypeList" style="display: none;">
                                <div class="i_common_wrap">
                                    <div class="i_common_list"></div>
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnCaseListExportToWordCreate" value="生成" />
                            <input class="btn btn-primary ng-binding" type="button" id="btnCaseListExportToWordUpload" value="上传" />
                            <input class="btn btn-default ng-binding" type="button" id="btnCaseListExportToWordCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div><!-- /.modal -->
    </div>
</div>
