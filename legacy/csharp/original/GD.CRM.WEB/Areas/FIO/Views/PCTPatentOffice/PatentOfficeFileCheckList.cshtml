
@using Dchien.Legal.Service.FIO.PatentOffice

@model Dchien.Legal.Web.Areas.FIO.ViewModels.PatentOfficeFileCheckListModel


<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />


<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/FIO/FIO.PCT.Patent.OfficeFile.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<div class="viewFramework-product  viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("MenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body" style="background:#ffffff">
        <div class="console-container ng-scope">
            <div class="row ng-scope">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5 class="ng-binding">专利检查清单导入</h5>
                        </div>
                    </div>
                    <div class="pull-left margin-top-1 col-sm-12">
                        @*@using (Html.BeginForm("PatentOfficeCheckListUploading", "PatentOffice", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-inline ng-valid ng-valid-required" }))
                            {*@

                        @*<div class="simple-form-field ng-scope ng-isolate-scope">
                                <div class="form-group ng-scope">
                                    <label for="text3" class="  control-label">
                                        <span  class="text-danger ng-binding"></span>
                                        <span class="ng-binding">请选择上传文件：</span>
                                    </label>
                                    <div class="form-control-wrap">
                                        <input id="txtFilePath" ng-model="formData.file" placeholder="选择一个文件" disabled="disabled" class="form-control ng-pristine ng-valid" style="width: 150px; display: inline-block">
                                        <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px; border: 0px">
                                            <input type="file" value="" id="flZip" name="flFile" style="height: 40px; width: 150px; margin-left: 118px;">
                                        </div>
                                    </div>
                                </div>
                            </div>*@

                        <div class="pull-left margin-top-1 col-sm-12" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm">
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                                @Html.HiddenFor(m => m.SearchCondition.FileGuid)
                                <table class="search_table" style="width: 100%">
                                    <colgroup>
                                        <col style="width: 80px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 60px" />
                                        <col style="width: 60px" />
                                        <col style="width: 60px" />
                                        <col style="width: 60px" />
                                        <col>
                                    </colgroup>
                                    <tr>

                                        <th style="text-align:right">
                                            申请号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseNo, new { @class = "form-control", @placeholder = "申请号" })
                                        </td>

                                        <th style="text-align:right">
                                            专利名称：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseName, new { @class = "form-control", @placeholder = "发明名称" })
                                        </td>

                                        <th style="text-align:right">
                                            发文日期：
                                        </th>
                                        <td colspan="2">
                                            @Html.TextBoxFor(m => m.SearchCondition.IssueDateStart, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.IssueDateEnd, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </td>

                                        <th>
                                            处理状态：
                                        </th>
                                        <td colspan="2">
                                            @Html.DropDownListFor(m => m.SearchCondition.Status, PatentOfficeFileService.Instance.GetStatusList(), new { @class = "form-control", @style = "width:100%" })
                                        </td>

                                   

                                    </tr>
                                    <tr>
                                        <th style="text-align:right">
                                            发文序列号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.FAWENXLH, new { @class = "form-control", @placeholder = "发文序列号" })
                                        </td>

                                        <th style="text-align:right">
                                            申请人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CustomerName, new { @class = "form-control", @placeholder = "申请人" })
                                        </td>

                                        <th style="text-align:right">
                                            入库日期：
                                        </th>
                                        <td colspan="2">
                                            @Html.TextBoxFor(m => m.SearchCondition.InDateStart, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.InDateEnd, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </td>

                                        <td colspan="4">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnCheckListSearch">
                                                <span>查询</span>
                                            </a>
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnCheckListFileUpload">
                                                <span>上传</span>
                                            </a>
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnCheckListExport">
                                                <span>导出</span>
                                            </a>

                                        </td>


                                        <td colspan="4">
                                            <label class="control-label">
                                                <span style='color:red;text-align:right' id="message"></span>
                                            </label>
                                        </td>
                                    </tr>
                                </table>
                            </form>
                        </div>

                        @*<div class="simple-form-field ng-scope ng-isolate-scope">
                                <div class="form-group simple-form-submit ng-scope">
                                    <label for="submit4" class="control-label">
                                        <span class="ng-binding">
                                        </span>
                                    </label>
                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-isolate-scope" type="button" id="btnCheckListFileUpload" value="上传并检查" />
                                    </div>

                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-isolate-scope" type="button" id="btnCheckListHasError" value="只显示错误文件" />
                                    </div>

                                    <label class="control-label">
                                        <span  style='color:red;text-align:right' id="message"></span>
                                    </label>



                                </div>
                            </div>
                            <div ng-transclude=""></div>*@

                        @*}*@
                    </div>
                </div>

                <div class="col-sm-12">
                    <div class="ng-isolate-scope">
                        <div class="ng-scope">
                            <div class="gridSection">
                                <table id="tblCaseFileList" class="table table-hover">

                                    <colgroup>
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 20%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 15%" />
                                    </colgroup>

                                    <thead>
                                        <tr>
                                            <th style="text-align: center">申请号/不受理编号</th>
                                            <th style="text-align: center">通知书名称</th>
                                            <th style="text-align: center">发明创造名称</th>
                                            <th style="text-align: center">发文序列号</th>
                                            <th style="text-align: center">电子发文日</th>
                                            <th style="text-align: center">下载状态</th>
                                            <th style="text-align: center">系统状态</th>
                                            <th style="text-align: center">案号</th>
                                            <th style="text-align: center">入库时间</th>
                                            <th style="text-align: center">错误消息</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>

                                        </tr>
                                    </tbody>
                                    <tfoot class="ng-scope" style="display: none">
                                        <tr>
                                            <td colspan="14">
                                                <div class="pull-left"></div>
                                                <div class="ng-scope">
                                                    <div class="pull-right page-box caseFileList">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

