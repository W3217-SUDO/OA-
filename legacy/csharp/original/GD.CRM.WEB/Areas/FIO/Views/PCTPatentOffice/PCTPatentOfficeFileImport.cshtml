@using Dchien.Legal.Common
@using Dchien.Legal.Web.Areas.IPR.ViewModels.Case
@using Dchien.Legal.Service
@using Dchien.Legal.Service.HR.Staff
@model Dchien.Legal.Web.Areas.FIO.ViewModels.PCTPatentOfficeFileImportModel


<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.index.console.css")" />


<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/FIO/FIO.PCT.Patent.OfficeFile.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>
<div class="viewFramework-product">

    <div class="viewFramework-product-body" style="overflow-y:hidden">
        <div class="console-container ng-scope">
            <div class="row ng-scope">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5 class="ng-binding">PCT官文导入</h5>
                        </div>
                    </div>
                    <div class="pull-left margin-top-1 col-sm-12">
                        @using (Html.BeginForm("PatentOfficeFileUploading", "PCTPatentOffice", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-inline ng-valid ng-valid-required" }))
                        {

                            <div class="simple-form-field ng-scope ng-isolate-scope">
                                <div class="form-group ng-scope">
                                    <label for="text3" class="control-label">
                                        <span class="text-danger ng-binding"></span>
                                        <span class="ng-binding">请选择上传文件：</span>
                                    </label>
                                    <div class="form-control-wrap">
                                        <input id="txtFilePath" ng-model="formData.file" placeholder="选择一个文件" disabled="disabled" class="form-control ng-pristine ng-valid" style="width: 150px; display: inline-block">
                                        <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px; border: 0px">
                                            <input type="file" value="" id="flZip" name="flFile" style="height: 40px; width: 150px; margin-left: 118px;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="simple-form-field ng-scope ng-isolate-scope">
                                <div class="form-group simple-form-submit ng-scope">
                                    <label for="submit4" class="control-label">
                                        <span class="ng-binding">
                                        </span>
                                    </label>
                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-isolate-scope" type="button" id="btnFileUpload" value="上传" />
                                    </div>
                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-binding" type="button" id="btnImport" value="导入" />
                                    </div>
                                </div>
                            </div>
                            <div ng-transclude=""></div>

                        }
                    </div>
                </div>

                <div class="col-sm-12">
                    <div class="ng-isolate-scope">
                        <div class="ng-scope">
                            <div class="gridSection">
                                <table class="aps-table aps-widget aps-ani-transition ">
                                    <colgroup>
                                        <col style="width: 10%" />
                                        <col style="width: 8%" />
                                        <col style="width: 8%" />
                                        <col style="width: 12%" />
                                        <col style="width: 12%" />
                                        <col style="width: 4%" />
                                        <col style="width: 12%" />
                                        <col style="width: 12%" />
                                        <col style="width: 8%" />
                                        <col style="width: 8%" />
                                        <col style="width: 5%" />
                                        <col style="width: 3%" />
                                        <col style="width: 17px" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th style="text-align: left">
                                                <input type="checkbox" id="chkCaseIdAll" class="ng-pristine ng-valid">&nbsp;&nbsp;选择(全选)
                                            </th>

                                            <th style="text-align: center">
                                                案号<span>
                                                    <span class="aps-state-hidden"></span>
                                                    <span data-field="T.caseNo" class="aps-widget aps-ani-transition aps-sort aps-state-visible">
                                                    </span>
                                                </span>
                                            </th>
                                            <th style="text-align: center">申请日</th>
                                            <th style="text-align: center">客户</th>
                                            <th style="text-align: center">申请人</th>
                                            <th style="text-align: center">状态</th>
                                            <th style="text-align: center">发明名称</th>
                                            <th style="text-align: center">通知书名称</th>
                                            <th style="text-align: center">通知书号</th>
                                            <th style="text-align: center">通知书编码</th>
                                            <th style="text-align: center">发文时间</th>
                                            <th style="text-align: center">费用</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                </table>

                                <div id="divCaseFileList" style="border-top: 0px; margin-top: -1px; overflow-x:hidden; overflow-y: scroll; " >
                                    <table id="tblCaseFileList" class="aps-table aps-widget aps-ani-transition ">
                                        <colgroup>
                                            <col style="width: 10%" />
                                            <col style="width: 8%" />
                                            <col style="width: 8%" />
                                            <col style="width: 12%" />
                                            <col style="width: 12%" />
                                            <col style="width: 4%" />
                                            <col style="width: 12%" />
                                            <col style="width: 12%" />
                                            <col style="width: 8%" />
                                            <col style="width: 8%" />
                                            <col style="width: 5%" />
                                            <col style="width: 3%" />

                                        </colgroup>

                                        <tbody>
                                            <tr style="display: none">
                                                <td style="text-align: left"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>

                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="divCaseTypeList"> </div>
            <div class="divCaseFeeTypeList"> </div>
        </div>
    </div>
</div>

