@model Dchien.Legal.Web.Areas.FIO.ViewModels.MetaFileModel
<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Legal/Case/Legal.Case.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script src="@Url.Content("~/Scripts/FIO/FIO.Legal.Official.File.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/FIO/FIO.Legal.Official.MetaFile.List.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<div class="viewFramework-product">
    <div class="viewFramework-product-body" style="background:#ffffff">
        <div class="console-container ng-scope">
            <div class="row ng-scope">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5 class="ng-binding">官文收文列表</h5>
                        </div>
                    </div>
                    <div class="pull-left  col-sm-12"  style="margin-top:1px">
                        <div class="pull-left  col-sm-12" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm">
                                @Html.HiddenFor(m => m.SearchCondition.PageId, new { name = "PageId" })
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageNo" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageSize" })
                                <table class="search_table" style="width: 600px">
                                    <colgroup>
                                        <col style="width: 60px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 180px" />
                                        <col style="width: 60px" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 180px" />
                                        <col>
                                    </colgroup>
                                    <tr>
                                        <th style="text-align:left">
                                           案件编号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseNos, new { @class = "form-control", @style = "" })
                                        </td>
                                        <th style="text-align:left">
                                            文件名称：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseFileName, new { @class = "form-control", style = "width:96.5%" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="text-align:left">
                                            导入状态：
                                        </th>
                                        <td>
                                            @Html.DropDownListFor(m => m.SearchCondition.Status, Dchien.Legal.Service.FIO.OfficalMetaFileService.Instance.GetMetaFileStatusList(true), new { @class = "form-control", style = "width:95.5%" })
                                        </td>
                                        <th style="text-align:left">
                                            上传日期：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.UpdateDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:80px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.UpdateDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:80px" })
                                        </td>
 
                                        <td colspan="2">
                                                <a href="javascript:void(0);" class="btn btn-primary " id="btnMetaFileSearch">
                                                    <span>查询</span>
                                                </a>
                                                <a href="javascript:void(0);" class="btn btn-default " id="btnFileUpload">
                                                    <span>上传</span>
                                                </a>
                                        </td>
                                        <td colspan="4">
                                            <label class="control-label">
                                                <span style='color:red;text-align:right' id="message"></span>
                                            </label>
                                        </td>
                                    </tr>
                                </table>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="ng-isolate-scope">
                        <div class="ng-scope">
                            <div class="gridSection">
                                <table id="tblMetaFileList" class="aps-table aps-widget aps-ani-transition ">
                                    <colgroup>
                                        <col style="width: 3%" />
                                        <col style="width: 10%" />
                                        <col style="width: 20%" />
                                        <col style="width: 30%" />
                                        <col style="width: 30%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                    </colgroup>

                                    <thead>
                                        <tr>
                                            <th width="10">
                                                <input type="checkbox" id="chkMetaFileAll" name="chkMetaFileAll">
                                            </th>
                                            <th style="text-align: center">案号</th>
                                            <th style="text-align: center">原告</th>
                                            <th style="text-align: center">被告</th>
                                            <th style="text-align: center">文件名称</th>
                                            <th style="text-align: center">文件日期</th>
                                            <th style="text-align: center">上传日期</th>
                                            <th style="text-align: center">上传人</th>
                                            <th style="text-align: center">状态</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td>
                                                &nbsp;
                                            </td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                        </tr>
                                        <tr style="display: none">
                                            <td>
                                                &nbsp;
                                            </td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="ng-scope" style="display: none">
                                        <tr>
                                            <td width="10">
                                                <input type="checkbox" id="chkMetaFileAll" name="chkMetaFileAll">
                                            </td>

                                            <td colspan="10">
                                                <div class="pull-left">
                                                    <input type="button" id="btnMetaFileDelete" class="btn btn-default" style="height:32px" value="删除" />
                                                    <input type="button" id="btnInformDateChange" class="btn btn-default" style="height:32px" value="修改收文日期">
                                                </div>
                                                <div class="ng-scope">
                                                    <div class="pull-right page-box metaFileList">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

