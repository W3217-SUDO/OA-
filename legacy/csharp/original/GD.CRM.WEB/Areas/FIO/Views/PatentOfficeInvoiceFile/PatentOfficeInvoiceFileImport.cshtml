@using Dchien.Legal.Common
@using Dchien.Legal.Web.Areas.IPR.ViewModels.Case
@using Dchien.Legal.Service
@using Dchien.Legal.Service.HR.Staff
@model Dchien.Legal.Web.Areas.FIO.ViewModels.PatentOfficeInvoiceFileImportModel


<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.index.console.css")" />


<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/FIO/FIO.Patent.Office.InvoiceFile.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>
<div class="viewFramework-product">

    <div class="viewFramework-product-body" style="overflow-y:hidden">
        <div class="console-container ng-scope">
            <div class="row ng-scope">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5 class="ng-binding">专利票据文件导入</h5>
                        </div>
                    </div>
                    <div class="pull-left margin-top-1 col-sm-12">
                        @using (Html.BeginForm("PatentOfficeInvoiceFileUpload", "PatentOfficeInvoiceFile", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-inline ng-valid ng-valid-required" }))
                        {

                            <div class="simple-form-field ng-scope ng-isolate-scope">
                                <div class="form-group ng-scope">
                                    <label for="text3" class="control-label">
                                        <span class="text-danger ng-binding"></span>
                                        <span class="ng-binding">请选择上传文件：</span>
                                    </label>
                                    <div class="form-control-wrap">
                                        <input id="txtFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control ng-pristine ng-valid" style="width: 150px; display: inline-block">
                                        <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px; border: 0px">
                                            <input type="file" value="" id="flZip" name="flFile" style="height: 40px; width: 150px; margin-left: 118px;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="simple-form-field ng-scope ng-isolate-scope">
                                <div class="form-group simple-form-submit ng-scope">
                                    <label for="submit4" class="control-label">
                                        <span class="ng-binding">
                                        </span>
                                    </label>
                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-isolate-scope" type="button" id="btnFileUpload" value="上传并导入" />
                                    </div>
                                    @*<div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-binding" type="button" id="btnImport" value="导入" />
                                    </div>*@
                                </div>
                            </div>
                            <div ng-transclude=""></div>

                        }


                    </div>
                </div>

                <div class="col-sm-12">
                    <div class="ng-isolate-scope">
                        <div class="ng-scope">
                            <div id="casegridSection" class="gridSection">
                                <table id="" class="aps-table aps-widget aps-ani-transition" style="width:100%">
                                    <colgroup>
                                        <col style="width: 3%" />
                                        <col style="width: 3%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 26%" />
                                        <col style="width: 8%" />
                                        <col style="width: 6%" />
                                        <col style="width: 8%" />
                                        <col style="width: 5%" />
                                        <col style="width: 5%" />
                                        <col style="width: 22%" />
                                        <col style="width: 8%" />
                                        <col style="width: 6%" />
                                        <col style="width:17px" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>
                                                <input type="checkbox" id="chkInvoiceFileAll" class="">
                                            </th>
                                            <th style="text-align: center">操<br/>作</th>
                                            <th style="text-align: center">导入状态</th>
                                            <th style="text-align: center;padding:0px">案件费用</th>
                                            <th style="text-align: center">文件名称</th>
                                            <th style="text-align: center">申请号</th>
                                            <th style="text-align: center">缴费日期</th>
                                            <th style="text-align: center">票据号码</th>
                                            <th style="text-align: center">开票<br />金额</th>
                                            <th style="text-align: center">状态</th>
                                            <th style="text-align: center">申请人</th>
                                            <th style="text-align: center">案号</th>
                                            <th style="text-align: center">案件<br />管理人</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                </table>
                                <div id="divCaseFileList" style="border-top: 0px; margin-top: -1px; overflow-x:hidden; overflow-y: scroll; ">
                                    <table id="tblInvoiceFileList" class="aps-table aps-widget aps-ani-transition ">
                                        <colgroup>
                                            <col style="width: 3%" />
                                            <col style="width: 3%" />
                                            <col style="width: 10%" />
                                            <col style="width: 10%" />
                                            <col style="width: 26%" />
                                            <col style="width: 8%" />
                                            <col style="width: 6%" />
                                            <col style="width: 8%" />
                                            <col style="width: 5%" />
                                            <col style="width: 5%" />
                                            <col style="width: 22%" />
                                            <col style="width: 8%" />
                                            <col style="width: 6%" />
                                        </colgroup>

                                        <tbody>
                                            <tr style="display: none">
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>

                                                <td style="text-align: left"></td>
                                                <td style="text-align: left"></td>

                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>

                                                <td style="text-align: left"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: left"></td>
                                                <td style="text-align: center"></td>
                                            </tr>
                                            <tr style="display: none">
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: left"></td>
                                                <td style="text-align: left"></td>

                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>

                                                <td style="text-align: left"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>

                                            </tr>
                                        </tbody>
                                        <tfoot class="ng-scope" style="display: none">
                                            <tr>
                                                <td width="1">
                                                    <input type="checkbox" id="chkInvoiceFileAll">
                                                </td>
                                                <td colspan="13">
                                                    <div class="pull-left">
                                                        <input type="button" id="btnInvoiceFileIn" class="btn btn-default" style="height:32px" value="批量导入" />
                                                        <input type="button" id="btnPacking" class="btn btn-default" style="height:32px" value="打包下载" />
                                                        <input type="button" id="btnPatentOfficeFileListExportToExcel" class="btn btn-default" style="height:32px" value="导出" />
                                                    </div>
                                                    <div class="">
                                                        <div class="pull-right page-box invoiceFileList">
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>

                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

