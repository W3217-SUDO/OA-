    <script type="text/javascript">
        var AP_ROOT = '@Url.Content("~/")';
        var showCounts = 1;
        var screen = {
            polling: function (show) {
                if (showCounts % 4 == 0) {
                    var url = AP_ROOT + 'REDACTED_ARCHIVE_ONLY';
                    $("#screen").attr("src", url);
                }
                else if (showCounts % 3 == 0) {
                    var url = AP_ROOT + 'REDACTED_ARCHIVE_ONLY';
                    $("#screen").attr("src", url);
                }
                else if (showCounts % 2 == 0) {
                    var url = AP_ROOT + 'REDACTED_ARCHIVE_ONLY';
                    $("#screen").attr("src", url);
                }
                else {
                    var url = AP_ROOT + 'REDACTED_ARCHIVE_ONLY';
                    $("#screen").attr("src", url);
                }

                if (showCounts >= 4) {
                    showCounts = 1
                }
                else {
                    showCounts++;
                }
            }
        }
        screen.polling(false);
        setInterval("screen.polling(true)", 1000*30);//半分钟刷新1次
    </script>
</head>

<body>
    <noscript>
        &lt;div id="noScript"&gt;
