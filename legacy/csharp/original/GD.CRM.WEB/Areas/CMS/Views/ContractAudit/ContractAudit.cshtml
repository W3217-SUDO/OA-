@using Dchien.Legal.Common
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.CMS.ViewModels.ContractAudit.AuditModel

<div class="modal fade" id="contractAuditModal" >
 
    <div class="modal-dialog" >
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("ContractAudit", "ContractAudit", FormMethod.Post, new { id = "contractAuditId", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.AuditId)
                    @Html.HiddenFor(m => m.ContractId)
                    @Html.HiddenFor(m => m.ContractNo)

                    <div class="modal-header">
                        <button type="button" class="close" id="btnContractAuditClose">×</button>
                        <h5 class="modal-title ng-binding">合同审批</h5>
                    </div>
                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label for="CaseLog_Content" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">审批意见</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextAreaFor(m => m.ContractAudit.AuditContent, new { @required = "true", maxlength = 1000, rows = 4, style = "width:120%" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnContractAuditApproved" value="同意" />
                        <input class="btn btn-primary ng-binding" type="button" id="btnContractAuditRejected" value="拒绝" />

                        <input class="btn btn-default ng-binding" type="button" id="btnContractAuditCancel" value="取消" />
                    </div>
                }
            </div>
        </div>
    </div>
   
</div>