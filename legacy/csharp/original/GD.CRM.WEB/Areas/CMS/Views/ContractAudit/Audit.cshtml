@using Dchien.Legal.Service.CMS.Contract
@using Dchien.Legal.Web.Areas.CMS.ViewModels.Contract
@model Dchien.Legal.Web.Areas.CMS.ViewModels.ContractAudit.AuditModel

<script type="text/javascript" src="@Url.Content("~/Scripts/CMS/Contract/CMS.Contract.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/CMS/Contract/CMS.Contract.View.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/CMS/Contract/CMS.Contract.Auditor.Audit.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/components.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/font-awesome.css")" />
<script type="text/javascript">

</script>
<style>
    input.input_text, textarea, select, input.input_time {
        border: 1px solid #ccc;
    }

    /*select {
        color: rgb(84, 84, 84);
        background-color: rgb(235, 235, 228);
    }*/

    input.input_text, textarea, input.input_time {
        padding: 2px 2px 2px 3px;
    }

    input.input_text, textarea, input.input_time {
        background-color: #fff;
    }

    .case-form-control {
        /*border-radius: 0px;*/
        -webkit-transition: none;
        transition: none;
        font-size: 12px;
        width: 100%;
        height: 24px;
    }

    .case-section-product .product-container .product-section .section-content .content-table td {
        padding-left: 1px;
    }

    table td, th {
        padding: 0px 0;
        /* border-bottom: 1px dotted #D6D6D6; */
        vertical-align: middle;
    }

    .input_table th {
        padding: 2px;
        font-weight: normal;
        text-align: right;
    }

    .input_table td {
        padding: 2px;
        text-align: left;
    }

    .case-section-wrap {
        padding: 2px;
    }

    .case-section-main {
        margin: 0 3px;
        padding: 0px;
        position: relative;
    }
</style>
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.index.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/case.createupdate.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/messageCenter.console.css")" />
<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <div class="product-nav-stage ng-scope product-nav-stage-main">
            <div class="product-nav-scene product-nav-main-scene">
                <div class="product-nav-title ng-binding">合同审批</div>
                <div class="ng-isolate-scope"></div>
                <div class="product-nav-list">
                    <ul class="top-level">
                        <li class='active'>
                            <div class="ng-isolate-scope">
                                <a href="javascript:void(0);" class="ng-scope">
                                    <div class="nav-icon"></div>
                                    <div class="nav-title ng-binding">合同审批</div>
                                    <div class="nav-extend">
                                        <span class="ng-isolate-scope">
                                            <span class="deadline-leftdays-normal ng-scope ng-binding"></span>
                                        </span>
                                    </div>
                                </a>
                            </div>
                        </li>
                        <li>
                            <div class="ng-isolate-scope">
                                <a  href=@Url.Content("~/CMS/ContractAudit/PendingList") class="ng-scope">
                                    <div class="nav-icon"></div>
                                    <div class="nav-title ng-binding">待审批合同</div>
                                    <div class="nav-extend">
                                        <span class="ng-isolate-scope">
                                            <span class="deadline-leftdays-normal ng-scope ng-binding"></span>
                                        </span>
                                    </div>
                                </a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>

    <div class="viewFramework-product-body">
        <div class="ng-scope">
            <div class="ng-scope">
                <div class="case-section-main clearfix" style="padding:0px">
                    <!-- 左侧 -->
                    <div class="case-section-left" style="padding-right: 0%;">

                        <div class="case-section-wrap" style="padding-bottom: 0%;">
                            <div class="case-section-product">
                                <!-- product section -->
                                <div class="product-container">
                                    <div class="product-section">
                                        @using (Html.BeginForm("Audit", "ContractAudit", FormMethod.Post, new { id = "auditForm", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                                        {
                                            <div class="section-content clearfix" style="padding: 0;">
                                                <div class="ng-scope">
                                                    @Html.HiddenFor(m => m.ContractAudit.AuditId)
                                                    @Html.HiddenFor(m => m.ContractId)
                                                    <table class="input_table" style='width:100%'>
                                                        <colgroup>
                                                            <col style="width: 8%;" />
                                                            <col style="width: 93%;" />
                                                        </colgroup>
                                                        <tr>
                                                            <th colspan="2" style="text-align:center">
                                                                <span style='font-weight: bold; font-size: 10pt; '>合同信息-审核</span>
                                                            </th>
                                                        </tr>
                                                        <tr>
                                                            <th>
                                                                审批意见
                                                            </th>
                                                            <td style="text-align:center">
                                                                @Html.TextAreaFor(m => m.ContractAudit.AuditContent, new { @required = "true", maxlength = 1000, rows = 3, style = "width:100%" })
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-align:center" colspan="2">
                                                                <input class="btn btn-primary ng-binding" type="button" id="btnContractAuditApproved" value="同意" />
                                                                <input class="btn btn-primary ng-binding" type="button" id="btnContractAuditRejected" value="拒绝" />
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        @{
                            var model = new ContractModel();
                            model.Contract = Model.Contract;

                            Html.RenderPartial("~/Areas/CMS/Views/Contract/ContractInfo.cshtml", model);
                        }
                    </div>
                    <div class="i_common_select" id="divAssociateUserList" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                    <div class="i_common_select" id="div_customer" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
