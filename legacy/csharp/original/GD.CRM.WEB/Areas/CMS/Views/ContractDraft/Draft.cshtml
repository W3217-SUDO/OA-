@using Dchien.Legal.BizModel.CMS.Contract
@model Dchien.Legal.Web.Areas.CMS.ViewModels.Contract.DraftModel
<script type="text/javascript" src="@Url.Content("~/Scripts/CMS/Contract/CMS.Contract.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/CMS/Contract/CMS.Contract.Draft.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/components.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/font-awesome.css")" />
<script type="text/javascript">

</script>
<style>
    input.input_text, textarea, select, input.input_time {
        border: 1px solid #ccc;
    }

    /*select {
        color: rgb(84, 84, 84);
        background-color: rgb(235, 235, 228);
    }*/

    input.input_text, textarea, input.input_time {
        padding: 2px 2px 2px 3px;
    }

    input.input_text, textarea, input.input_time {
        background-color: #fff;
    }

    .case-form-control {
        /*border-radius: 0px;*/
        -webkit-transition: none;
        transition: none;
        font-size: 12px;
        width: 100%;
        height: 24px;
    }

    .case-section-product .product-container .product-section .section-content .content-table td {
        padding-left: 1px;
    }

    table td, th {
        padding: 0px 0;
        /* border-bottom: 1px dotted #D6D6D6; */
        vertical-align: middle;
    }

    .input_table th {
        padding: 2px;
        font-weight: normal;
        text-align: right;
    }

    .input_table td {
        padding: 2px;
        text-align: left;
    }

    .case-section-wrap {
        padding: 2px;
    }

    .case-section-main {
        margin: 0 3px;
        padding: 0px;
        position: relative;
    }
</style>
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.index.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/case.createupdate.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/messageCenter.console.css")" />
<div class="viewFramework-product viewFramework-product-col-1">

    <div class="viewFramework-product-navbar ng-scope">
        <div class="product-nav-stage ng-scope product-nav-stage-main">
            <div class="product-nav-scene product-nav-main-scene">
                <div class="product-nav-title ng-binding">合同信息</div>
                <div class="ng-isolate-scope"></div>
                <div class="product-nav-list">
                    <ul class="top-level">

                        <li class='active'>
                            <div class="ng-isolate-scope">
                                <a href="javascript:void(0);" class="ng-scope">
                                    <div class="nav-icon"></div>
                                    <div class="nav-title ng-binding">@(string.IsNullOrEmpty(Request["contractId"]) ? "合同新建" : "合同修改")</div>
                                    <div class="nav-extend">
                                        <span class="ng-isolate-scope">
                                            <span class="deadline-leftdays-normal ng-scope ng-binding"></span>
                                        </span>
                                    </div>
                                </a>
                            </div>
                        </li>

                        <li>
                            <div class="ng-isolate-scope">
                                <a href=@Url.Content("~/CMS/Contract/ContractList/4001002") class="ng-scope">
                                    <div class="nav-icon"></div>
                                    <div class="nav-title ng-binding">我的合同</div>
                                    <div class="nav-extend">
                                        <span class="ng-isolate-scope">
                                            <span class="deadline-leftdays-normal ng-scope ng-binding"></span>
                                        </span>
                                    </div>
                                </a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>

    <div class="viewFramework-product-body">
        <div class="ng-scope">
            <div class="ng-scope">
                <div class="case-section-main clearfix" style="padding:0px">
                    <!-- 左侧 -->
                    <div class="case-section-left" style="padding-right: 0%;">
                        <div class="case-section-wrap">
                            <div class="case-section-product">
                                <!-- product section -->
                                <div class="product-container">
                                    <div class="product-section">
                                        @using (Html.BeginForm("Draft", "ContractDraft", FormMethod.Post, new { id = "contractForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                                        {
                                        <div class="section-content clearfix" style="padding: 0;">
                                            <div class="ng-scope">
                                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractGuid)
                                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractId)
                                                <table class="input_table" style='width:100%'>
                                                    <colgroup>
                                                        <col style="width: 8%;" />
                                                        <col style="width: 12%;" />
                                                        <col style="width: 8%;" />
                                                        <col style="width: 12%;" />
                                                        <col style="width: 8%;" />
                                                        <col style="width: 12%;" />
                                                        <col style="width: 8%;" />
                                                        <col style="width: 12%;" />
                                                        <col style="width: 8%;" />
                                                        <col style="width: 12%;" />
                                                    </colgroup>
                                                    @*<tr>
                                                            <th colspan="10" style="text-align: center">
                                                                <span style='font-weight: bold; font-size: 10pt; '>合同基本信息</span>
                                                            </th>
                                                        </tr>*@
                                    <tr>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.CustomerName)
                                        </th>
                                        <td colspan="3">
                                            @Html.HiddenFor(m => m.Contract.ContractBasicInfo.CustomerId)
                                            @if (Model.Contract != null && Model.Contract.ContractBasicInfo.CustomerId.HasValue)
                                                                {
                                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.CustomerName, new { @class = "input_text case-form-control", @unselectable = "on", @readonly = true })
                                                                }
                                                                else
                                                                {
                                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.CustomerName, new {@class = "input_text case-form-control", @unselectable = "on"})
                                                                }
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.CustomerNo)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.CustomerNo, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.AuditDate)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.AuditDate, "{0:yyyy-MM-dd}", new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                        </th>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.ContractName)
                                        </th>
                                        <td colspan="3">
                                            @if (Model.Contract != null && Model.Contract.ContractBasicInfo.CustomerId.HasValue)
                                                                {
                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.ContractName, new { @class = "input_text case-form-control", @unselectable = "on" })
                                                                }
                                                                else
                                                                {
                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.ContractName, new { @class = "input_text case-form-control", @unselectable = "on"})
                                                                }
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.ContractNo)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.ContractNo, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on",@placeholder="自动生成" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.BusinessOwnerName)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.BusinessOwnerName, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                        </th>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <th rowspan="2">
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.TotalAmount)
                                        </th>
                                        <td rowspan="2">
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.TotalAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.CaseOfficeFeeAmount)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.CaseOfficeFeeAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.CashedTimes)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.CashedTimes, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.PaidTimes)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.PaidTimes, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.InvoicedTimes)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.InvoicedTimes, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                    <tr>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.CaseNonOfficeFeeAmount)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.CaseNonOfficeFeeAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.CashedAmount)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.CashedAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.PaidCaseFeeAmount)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.PaidCaseFeeAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.InvoicedAmount)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.InvoicedAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.APAmount)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.APAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.CaseCommissionAmount)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.CaseCommissionAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.ARAmount)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.ARAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.UnPaidCaesFeeAmount)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.UnPaidCaesFeeAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                        <th>
                                            @Html.LabelFor(m => m.Contract.ContractBasicInfo.InvoiceAmount)
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.InvoiceAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                        </td>
                                    </tr>
                                    </table>
</div>
                                        </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="case-section-wrap" style="padding-top: 0;">
                            <div class="case-section-product">
                                <!-- product section -->
                                <div class="product-container">
                                    <div class="product-section">
                                        <ul class="nav nav-tabs">
                                            <li id="liContractObjectList" class='active'><a href="javascript:void(0);" id="btnContractObjectList">合同标的</a></li>
                                            <li id="liContractEventList"><a href="javascript:void(0);" id="btnContractEventList">事项记录</a></li>
                                            <li id="liContractFileList"><a href="javascript:void(0);" id="btnContractFileList">合同附件</a></li>
                                            <li class="pull-right" style=" border:none">
                                                <div style="margin-top:3px">
                                                    <div style="text-align: inherit;">
                                                        <div style="text-align: right; padding-right: 8px; padding-bottom: 3px; float: right; display: inline;">
                                                            <input class="btn btn-primary ng-binding" type="button" id="btnContractCreateUpdate" value="提交" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                        <div class="section-content clearfix">
                                            <div class="product-col ng-scope" style="width: 100%">
                                                <div id="dv_ContractObjectList">
                                                </div>
                                                <div id="dv_List">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="i_common_select" id="divAssociateUserList" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                    <div class="i_common_select" id="div_customer" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
