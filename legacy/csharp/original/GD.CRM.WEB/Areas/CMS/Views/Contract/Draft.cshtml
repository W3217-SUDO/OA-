@model Dchien.Legal.Web.Areas.CMS.ViewModels.Contract.DraftModel
@{
    object htmlAttribute = null;
}
<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/CMS/Contract/CMS.Contract.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>

<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("MenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body">
        <!-- product body -->
        <div>
            <div class="console-container ng-scope">
                <div class="basicinfo ng-scope">
                    <!--main table-->
                    <div class="console-title console-title-border drds-detail-title clearfix">
                        <h5>合同信息</h5>
                    </div>
                    <div class="basicinfo-bd">
                        <div class="alert alert-info">请正确填写以下合同信息.</div>

                        <form id="contractForm" enctype="multipart/form-data" method="post" class="form-horizontal">
                            <fieldset>
                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractId)

                                <div class="form-group">
                                    <label class="col-sm-4 control-label label-width">
                                        <span>@Html.LabelFor(m => m.Contract.ContractBasicInfo.ContractNo)</span>
                                    </label>
                                    <div class="col-sm-4 row">
                                        @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.ContractNo, new { @class = "form-control", @style = "width:80%", @placeholder = "编号自动生成", @readonly = true })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label label-width">
                                        <span>@Html.LabelFor(m => m.Contract.ContractBasicInfo.RefContractNo)</span>

                                    </label>
                                    <div class="col-sm-4 row">
                                        @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.RefContractNo, new { @class = "form-control", @style = "width:80%" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label label-width">
                                        <span class="text-danger">*</span>
                                        <span>@Html.LabelFor(m => m.Contract.ContractBasicInfo.CustomerName)</span>
                                    </label>
                                    <div class="col-sm-4 row">
                                        @Html.HiddenFor(m => m.Contract.ContractBasicInfo.CustomerId)
                                        @Html.HiddenFor(m => m.Contract.ContractBasicInfo.CustomerNo)
                                        @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.CustomerName, new { @class = "form-control", @style = "width:80%" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label label-width">
                                        <span class="text-danger">*</span>
                                        <span>@Html.LabelFor(m => m.Contract.ContractBasicInfo.ContractName)</span>

                                    </label>
                                    <div class="col-sm-4 row">
                                        @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.ContractName, new { @class = "form-control", @style = "width:80%" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label label-width">
                                        
                                        <span><label>合同附件一</label></span>
                                    </label>
                                    <div class="col-sm-4 row">
                                        <input id="txtCaseFilePathFirst" placeholder="选择一个文件" disabled="disabled" class=" form-control ng-valid" style="width:80%; display: inline-block">
                                        <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                            <input type="file" value="" id="flCaseFileFirst" name="flCaseFileFirst" style="height: 40px; width: 80%; margin-left: 10px;">
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label label-width">
                                        <span><label>合同附件二</label></span>
                                    </label>
                                    <div class="col-sm-4 row">
                                        <input id="txtCaseFilePathSecond" placeholder="选择一个文件" disabled="disabled" class=" form-control ng-valid" style="width:80%; display: inline-block">
                                        <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                            <input type="file" value="" id="flCaseFileSecond" name="flCaseFileSecond" style="height: 40px; width: 80%; margin-left: 10px;">
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                            <div class="form-group">
                                <label class="col-sm-4 control-label label-width"></label>
                                <div class="col-sm-8 row clearfix">
                                    @*<input class="btn btn-primary ng-binding" type="button" id="btnContractCreateUpdate" value="保存草稿" />*@
                                    <input class="btn btn-primary ng-binding" type="button" id="btnContractCreateUpdateSubmit" value="提交审批" />

                                </div>
                            </div>



                        </form>
                    </div>
                </div>
                
                <div class="i_common_select" id="div_customer" style="display: none;">
                    <div class="i_common_wrap">
                        <div class="i_common_list"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>