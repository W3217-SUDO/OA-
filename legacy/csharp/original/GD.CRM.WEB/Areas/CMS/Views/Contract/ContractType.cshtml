@using Dchien.Legal.Common
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.CMS.ViewModels.Contract.ContractTypeModel

<div class="modal fade" id="contractTypeModal">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("ContractType", "Contract", FormMethod.Post, new { id = "contractType", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CustomerId)
                    <div class="modal-header">
                        <button type="button" class="close" id="btnContractTypeClose">×</button>
                        <h5 class="modal-title ng-binding">选择合同类型</h5>
                    </div>
                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label for="CaseInstance_Deadline" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">合同类型:</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.DropDownListFor(m => m.ContractType, PublicMethod.ContractTypeList(), new { @class = "form-control" })

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnContractType" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnContractTypeCancel" value="取消" />

                    </div>
                }
            </div>
        </div>
    </div>
</div>







