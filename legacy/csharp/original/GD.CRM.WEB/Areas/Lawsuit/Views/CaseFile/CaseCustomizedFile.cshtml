@using Dchien.Legal.Common
@using Dchien.Legal.Service

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Common/bootstrap-treeview.js")"></script>
<script src="@Url.Content("~/Scripts/Lawsuit/CaseFile/Case.CaseFile.CustomizedFile.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>

<div class="viewFramework-product  ">
    <div class="viewFramework-product-body"  >
        <div class="console-container ng-scope">
            <div class="row ng-scope">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5 class="ng-binding">案件文件</h5>
                        </div>
                    </div>
                    <div class="pull-left margin-top-1 col-sm-12">
                        @using (Html.BeginForm("CaseFileCustomImportUploading", "CaseFile", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-inline ng-valid ng-valid-required" }))
                        {

                            <div class="simple-form-field ng-scope ng-isolate-scope">
                                <div class="form-group ng-scope">
                                    <label for="text3" class="  control-label">
                                        <span contenteditable="" class="text-danger ng-binding"></span>
                                        <span class="ng-binding">请选择上传文件：</span>
                                    </label>
                                    <div class="form-control-wrap">
                                        <input id="txtFilePath" ng-model="formData.file" placeholder="选择一个文件" disabled="disabled" class="form-control ng-pristine ng-valid" style="width: 150px; display: inline-block">
                                        <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px; border: 0px">
                                            <input type="file" value="" id="flZip" name="flFile" style="height: 40px; width: 150px; margin-left: 118px;">
                                            @*<span class="ng-binding" id="btnFileUpload">上传文件</span>*@
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="simple-form-field ng-scope ng-isolate-scope">
                                <div class="form-group simple-form-submit ng-scope">
                                    <label class="  control-label">
                                        <span class="ng-binding">
                                        </span>
                                    </label>
                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-isolate-scope" type="button" id="btnFileUpload" value="上传" />
                                    </div>
                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-binding" type="button" id="btnImport" value="导入" />
                                    </div>

                                </div>
                            </div>
                            <div ng-transclude=""></div>

                        }
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="ng-isolate-scope">
                        <div class="ng-scope">
                            <div class="gridSection">
                                <table id="tblCaseFileList" class="table table-hover">
                                    <colgroup>
                                        <col style="width: 3%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 9%">
                                        <col style="width: 9%">
                                        <col style="width: 9%">
                                        <col style="width: 9%">
                     
                                    </colgroup>

                                    <thead>
                                        <tr>
                                            <th width="10">
                                                <input type="checkbox" id="chkCaseFileAll" class="ng-pristine ng-valid">
                                            </th>
                                            <th style="text-align: center">文件名</th>
                                            <th style="text-align: center">文档类型</th>
                                            <th style="text-align: center">文档日期</th>
                                            <th style="text-align: center">我方案号</th>
                                            <th style="text-align: center">案件类型</th>
                                            <th style="text-align: center">案件名称</th>
                                            <th style="text-align: center">权利人</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="simple-grid-none-data-wrap" >
                                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left ng-binding"></span>从我的电脑中选择文件，上传后进行导入.
                                            <span class="ng-binding"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
