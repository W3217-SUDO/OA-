@using Dchien.Legal.Common
@using Dchien.Legal.Entity
@using Dchien.Legal.Entity.Lawsuit.Case
@using Dchien.Legal.Service
@using Dchien.Legal.Service.Lawsuit.Case

<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Common/bootstrap-treeview.js")"></script>

<div class="modal fade" id="caseFileModal"  >
    <div class="modal-dialog" style="width:750px">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">

                <div class="modal-header">
                    <button type="button" class="close" id="btnCaseFileClose">×</button>
                    <h5 class="modal-title ng-binding">批量文件上传</h5>
                </div>
                <div class="modal-body" style="height: 280px; padding: 10px;">
                    <div class="form-group">

@using (Html.BeginForm("MultiCaseFileUpload", "CaseFile", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-inline ng-valid ng-valid-required" }))
{

    <input type="hidden" value="" id="hidFileGuid" >

                        <label class="control-label" style="float: left; padding-left: 5px; padding-top: 5px; ">
                            <span class="text-danger ng-binding">*</span>
                            <span class="ng-binding">选择文件：</span>
                        </label>
                        <div  style="float: left;">
                            <input id="txtCaseFilePath" placeholder="请选择一个文件" disabled="disabled" class="form-control " style="width: 150px; display: inline-block">
                            <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px; border: 0px">
                                <input type="file" value="" id="flCaseFile" name="flCaseFile" style="height: 50px; width: 150px; margin-left: 88px;">
                                @*<span class="ng-binding" id="btnFileUpload">上传文件</span>*@
                            </div>
                        </div>

                        <div style="float: left;">
                            <input class="btn btn-primary ng-isolate-scope" type="button" id="btnFileUpload" value="上传" />
                            <input class="btn btn-primary ng-binding" type="button" id="btnImport" value="导入" />
                        </div>
}

                        </div>

                    <div class="form-group">
                        <div class="col-sm-12" style="padding: 10px">
                            <div class="gridSection" >

                                <table id='tblCaseFileHeader' class='table table-hover' style='width: 100%; margin-top: 0px; margin-bottom: 0px;'>
                                    <colgroup>
                                        <col style="width: 10%">
                                        <col style="width: 40%">
                                        <col style="width: 30%">
                                        <col style="width: 20%">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th width="10">
                                                <input type="checkbox" id="chkCaseFileAll" class="ng-pristine ng-valid">
                                            </th>
                                            <th style="text-align: center">文件名</th>
                                            <th style="text-align: center">文档类型</th>
                                            <th style="text-align: center">文档日期</th>
                                        </tr>
                                    </thead>
                                </table>
                                <div class="context" id='divCaseFileList' style="max-height:200px; overflow-y: auto; ">
                                    <table class="table table-hover" id="tblCaseFileList" style=' width:100%; margin-top: -1px; margin-bottom: 0px;'>
                                        <colgroup>
                                            <col style="width: 10%">
                                            <col style="width: 40%">
                                            <col style="width: 30%">
                                            <col style="width: 20%">

                                        </colgroup>
                                        <tbody>
                                            <tr style="display: none">
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>

                                            </tr>
                                        </tbody>

                                    </table>
                                    <div class="simple-grid-none-data-wrap">
                                        <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                                            <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                                <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                                <div class="text-size-16 tip-text inline-block">
                                                    <span class="margin-left ng-binding"></span>从我的电脑中选择 .zip 格式文件，上传后进行导入.
                                                    <span class="ng-binding"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                           
                        </div>
                    </div>
                    <div class="divCaseFileTypeList"></div>

                </div>
                <div class="modal-footer">
                    <input class="btn btn-default ng-binding" type="button" id="btnCaseFileCancel" value="取消" />

                </div>


            </div>
        </div>
    </div> 
   
</div>

