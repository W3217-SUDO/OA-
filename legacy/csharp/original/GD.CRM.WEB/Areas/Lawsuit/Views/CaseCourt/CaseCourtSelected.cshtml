@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseCourtSelectedModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />

<div class="modal fade" id="caseCourtModal">
    <div class="modal-dialog" style="width:65%">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" id="btnCaseCourtClose">×</button>
                <h5 class="modal-title">选择法院</h5>
            </div>
            <div class="modal-body" style='padding:10px'>
                <form id="caseCourtListForm" class="form-inline ng-valid " action="@Url.Content("~/Lawsuit/Case/CaseCourtSelected")">
                    @Html.HiddenFor(m => m.CaseId)
                    @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                    @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                    
                    @Html.Hidden("selectedId")
                    @Html.Hidden("selectedName")

                    <div class="simple-form-field">
                        <div class="form-group ">
                            <label class="control-label">
                                <span contenteditable="" class="text-danger "></span>
                                <span class="">法院名称：</span>
                            </label>
                            <div class="form-control-wrap">
                                @Html.TextBoxFor(m => m.SearchCondition.CourtName, new { @class = "form-control", @style = "width: 300px", @placeholder = "法院名称,多个请用逗号隔开" })
                            </div>
                        </div>
                    </div>
                    <div class="simple-form-field  ">
                        <div class="form-group  ">
                            <label class="  control-label">
                                <span class="">
                                </span>
                            </label>
                            <div class="form-control-wrap text-right">
                                <a href="javascript:void(0);" class="btn btn-primary " id="btnCourtSearch">
                                    <span>查询</span>
                                </a>
                            </div>

                        </div>
                    </div>
                </form>
                <div class="gridSection">
                    <table id="tblCourtList" class="table table-hover">
                        <thead>
                            <tr>
                                <th width="10">
                                    <input type="checkbox" id="chkCourtAll" class="ng-pristine ng-valid">
                                </th>
                                <th>
                                    法院编号
                                </th>
                                <th>
                                    法院名称
                                </th>
                                <th>
                                    地区代码
                                </th>

                                <th>
                                    地区名称
                                </th>
                                <th>
                                    法院类型
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr style="display: none">
                                <td>
                                    &nbsp;
                                </td>
                                <td></td>
                                <td style="text-align: left"></td>
                                <td style="text-align: left"></td>
                                <td></td>
                                <td></td>

                            </tr>
                        </tbody>
                        <tfoot class="ng-scope" style="display: none">
                            <tr>
                                <td colspan="6">
                                    <div class="pull-left"></div>
                                    <div class="ng-scope">
                                        <div class="pull-right page-box courts">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

            </div>
            <div class="modal-footer">
                <button class="btn btn-primary ng-binding" id="btnCaseCourtConfirm">确定</button>
                <button class="btn btn-default ng-binding" id="btnCaseCourtCancle">取消</button>
            </div>
        </div>
    </div>
</div>



