@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.AR.CaseFeeModel


<div class="modal fade" id="caseFeeInformYearlyModal">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseFeeInformAnnualYear", "ARCaseFee", FormMethod.Post, new { id = "caseFeeInformAnnualYear", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CaseId)
                    @Html.HiddenFor(m => m.CaseFeeId)
                    
                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseFeeInformYearlyClose">×</button>
                        <h5 class="modal-title ng-binding">设定年度</h5>
                    </div>
                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label for="CaseInstance_Deadline" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">年度:</span>
                                </label>
                                <div class="col-sm-6">
                                    <select class="form-control" id="Case_CaseFeeInformYearly" name="Case.CaseFeeInformYearly" unselectable="on">
                                        @{
                                            if (Model.CaseRequestDate.HasValue)
                                            {
                                                for (var i = 1; i <= 20; i++)
                                                {
                                                    <option value="@i" annualFrom="@Model.CaseRequestDate.Value.AddYears(i - 1).ToString("yyyy-MM-dd")" annualEnd="@Model.CaseRequestDate.Value.AddYears(@i).AddDays(-1).ToString("yyyy-MM-dd")">第 @i 年度 @Model.CaseRequestDate.Value.AddYears(i - 1).ToString("yyyy-MM-dd") ~ @Model.CaseRequestDate.Value.AddYears(@i).AddDays(-1).ToString("yyyy-MM-dd")</option>
                                                }
                                            }
                                            else
                                            {
                                                <option value="">申请日为空，请联系管理员.</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseFeeInformYearly" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseFeeInformYearlyCancel" value="取消" />

                    </div>
                }
            </div>
        </div>
    </div>
</div>







