@using SunHold.Legal.Common
@using SunHold.Legal.Service
@using Newtonsoft.Json.Linq

@model SunHold.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseFileUploadModel

@{
    object htmlAttribute = null;
}

<div class="modal fade" id="caseFileUploadingModal"  >
    <style>
        .btn-expense-file-upload input {
            position: absolute;
            top: 0px;
            right: 0px;
            left: 0px;
            bottom: 0px;
            opacity: 0;
            filter: alpha(opacity=0);
            overflow: hidden;
        }
    </style>

    <script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>

    <div class="modal-dialog">
        <div class="modal-content">

            @using (Html.BeginForm("CaseFileUploading", "Case", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
            {
                @Html.HiddenFor(m => m.CaseId)
                @Html.HiddenFor(m => m.CaseTypeId)
                @Html.HiddenFor(m => m.CaseNo)
                @Html.HiddenFor(m => m.IsTransformedFile)
                @Html.HiddenFor(m => m.CustomerId)

                <div class="modal-header">
                    <button type="button" class="close" id="btnCaseFileUploadingClose">×</button>
                    <h5 class="modal-title ">上传文档信息</h5>
                </div>

                <div class="modal-body">
                    <div>
                        <div class="form-group">
                            <label for="CaseFileTypeId" class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span class="">文档类型</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.HiddenFor(m => m.CaseFileTypeId)
                                @Html.TextBoxFor(m => m.CaseFileTypeName, new { @class = "form-control", @autocomplete = "off" })
                            </div>
                            <div style="float: left; padding-top: 7px; padding-left: 1px;">
                                <a id="lnkCaseFileTypeId"  href="javascript:void(0)">选择</a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger ">*</span>
                                <span class="">上传案件文档</span>
                            </label>
                            <div class="col-sm-6">
                                <div class="form-control-wrap">
                                    <input id="txtCaseFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control ng-valid" style=" display: inline-block">
                                    <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                        <input type="file" value="" id="flCaseFile" name="flCaseFile" style="height: 40px; width: 250px; margin-left: 10px;">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span class="spanreferencedate">参考日期</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.UploadingTime, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                            </div>
                        </div>
                    </div>

                    <div class="caserequestno" style='display:none'>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span>申请号</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.CaseRequestNo, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                    
                    <div class="caseHedgingFile" style='display:none'>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span>解除待转文文件</span>
                            </label>
                            <div class="col-sm-6">
                                @{
                                    var lst = new List<SelectListItem>();
                                    lst.Add( new SelectListItem()
                                    {
                                        Text = "全部",
                                        Value = "",
                                        Selected = true
                                    });
                                }

                                @Html.DropDownListFor(m => m.HedgingFileId, lst, new { @class = "form-control",@multiple="multiple"})
                            </div>
                            
                            <div style="float: left; padding-top: 7px; padding-left: 1px;">
                                <span>按 Ctrl 键可多选</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="caseHedgingFee" style='display:none'>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span>解除待转票费用通知</span>
                            </label>
                            <div class="col-sm-6">
                                @{
                                    var lst2 = new List<SelectListItem>();
                                    lst2.Add(new SelectListItem()
                                    {
                                        Text = "全部",
                                        Value = "",
                                        Selected = true
                                    });
                                }

                                @Html.DropDownListFor(m => m.HedgingFeeId, lst2, new { @class = "form-control",@multiple="multiple"})
                            </div>
                            <div style="float: left; padding-top: 7px; padding-left: 1px;">
                                <span>按 Ctrl 键可多选</span>
                            </div>
                        </div>
                    </div>

                    <div class="divCaseFileTypeList"></div>
                    
                    <div class="i_common_select" id="div_CaseFileTypeList" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">

                    @if (Model.IsTransformedFile)
                    {
                        <input class="btn btn-primary " type="button" id="btnCaseFileToWord" value="生成" />
                    }
                    <input class="btn btn-primary " type="button" id="btnCaseFileUploading" value="确定" />
                    <input class="btn btn-default " type="button" id="btnCaseFileUploadingCancel" value="取消" />
                </div>

            }
        </div>

    </div>
</div>


