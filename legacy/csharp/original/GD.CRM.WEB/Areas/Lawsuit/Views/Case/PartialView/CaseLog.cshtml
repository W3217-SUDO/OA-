@*<div tabindex="-1" class="modal fade  in" ng-class="{in: animate}" ng-style="{'z-index': 1050 + index*10, display: 'block'}" ng-click="close($event)" modal-window="" index="0" animate="animate" style="z-index: 1050; display: block;"><div class="modal-dialog"><div class="modal-content" ng-transclude=""><div class="console-message-dialog ng-scope"><div class="modal-header"><button type="button" class="close" data-dismiss="modal" data-ng-click="close(false)" z-index="-1" aria-hidden="true">×</button><h5 class="modal-title ng-binding">错误提示</h5></div><div class="modal-body clearfix"><div class="col-sm-1 text-center"><span class="text-size-32 icon-no-2 text-warning" ng-class="iconClass"></span></div><div class="col-sm-11 breakall"><p ng-bind-html="message" class="ng-binding">加急失败，请稍后再试！</p></div></div><div class="modal-footer"><!-- ngRepeat: btn in buttons --><button ng-repeat="btn in buttons" ng-click="eventHandler(btn.result)" class="btn ng-scope ng-binding btn-primary" ng-class="btn.cssClass">确定</button><!-- end ngRepeat: btn in buttons --></div></div></div></div></div>*@



