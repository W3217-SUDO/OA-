@using SunHold.Legal.Common
@using SunHold.Legal.Service

@model SunHold.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseLogModel

@{
    object htmlAttribute = null;
}

<div class="modal fade" id="caseLogModal" >
 
    <div class="modal-dialog" >
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseLog", "Case", FormMethod.Post, new { id = "caseLog", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CaseId)


                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseLogClose">×</button>
                        <h5 class="modal-title ng-binding">案件日志</h5>
                    </div>
                        @*<div style="padding-left:10px;padding-right:10px">
                            <div class="margin-top-2 alert alert-info">
                                <b>提醒：</b><span style="color:#F00" class="ng-binding"></span>
                            </div>
                        </div>*@
                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label for="CaseLog_Content" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">日志内容</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextAreaFor(m => m.CaseLog.Content, new { @required = "true", maxlength = 1000, rows=4,style = "width:120%" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseLog" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseLogCancel" value="取消" />
                    </div>
                }
            </div>
        </div>
    </div>
   
</div>

