@using Dchien.Legal.Common
@using Dchien.Legal.Entity
@using Dchien.Legal.Entity.Lawsuit.Case
@using Dchien.Legal.Service
@using Dchien.Legal.Service.Lawsuit.Case

@model Dchien.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseFeeModel

@{
    var displayYearly = (Model.DefaultCaseFee.FeeTypeId == (int)CaseFeeType.FeeType3) ? "" : "display:none";
    var staffs = Dchien.Legal.Service.HR.Staff.StaffService.Instance.GetStaffList();
}

<script type="text/javascript"></script>

<div class="modal fade" id="caseFeeInformModal"  >
        <div class="modal-dialog" >
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    
                    @using (Html.BeginForm("CaseFeeInform", "Case", FormMethod.Post, new { id = "caseFeeInform", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.CaseId)
                        @Html.HiddenFor(m => m.CaseTypeId)
                        @Html.HiddenFor(m => m.CaseNo)

                    <div class="modal-header">
                            <button type="button" class="close" id="btnFeeInformClose">×</button>
                            <h5 class="modal-title ng-binding">费用信息</h5>
                        </div>

                        <div class="modal-body">
                                <div class="form-group">
                                    <label for="CaseOfficeFeeTypeId" class="col-sm-2 control-label" style="width: 15%; padding-right: 5px;padding-left: 5px">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">费用类型</span>
                                    </label>
                                    <div class="col-sm-3" style="width: 25%">
                                        @Html.HiddenFor(m => m.DefaultCaseFee.FeeTypeId)
                                        @Html.TextBoxFor(m => m.DefaultCaseFee.FeeTypeName, new { @class = "form-control", @readonly = true })
                                    </div>
                                    
                                    <label for="RequestUser" class="col-sm-2 control-label" style="width: 11%; padding-right: 5px;padding-left: 5px">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">收费人</span>
                                    </label>
                                    <div class="col-sm-3" style="width: 25%">
                                        @Html.HiddenFor(m => m.DefaultCaseFee.ResponseUser)
                                        @Html.TextBoxFor(m => m.DefaultCaseFee.ResponseUserName, new { @class = "form-control", @readonly = true })
                                    </div>
                                    <div class="yearly" style="@displayYearly">
                                        <label for="RequestUser" class="col-sm-2 control-label" style="width: 11%; padding-right: 5px;padding-left: 5px">
                                            <span class="text-danger ng-binding">*</span>
                                            <span class="ng-binding">年限</span>
                                        </label>
                                        <div class="col-sm-1">
                                            @Html.TextBoxFor(m => m.DefaultCaseFee.Yearly, new
                                       {
                                           @class = "form-control",
                                           @style = "width:50px",
                                           @onkeyup = "javascript:this.value=this.value.replace(/\\D/g,'')",
                                           @onafterpaste = "this.value=this.value.replace(/\\D/g,'')"
                                       })
                                        </div>
                                    </div>
                                </div>
                        
                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="gridSection">
                                        <table id="tblCaseFeeItemList" class="table table-hover">
                                            <thead>
                                                <tr>
                                                    <th style="width: 15%">
                                                        费用类型
                                                    </th>
 
                                                    <th style="width: 15%">
                                                        收费金额(RMB)
                                                    </th>
                                                    
                                                    <th style="width: 10%">
                                                        是否减缓
                                                    </th>
 
                                                    <th style="width: 15%">
                                                        操作
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.CaseFee != null && Model.CaseFee.CaseFeeItems != null && Model.CaseFee.CaseFeeItems.Count > 0)
                                                {
                                                    var caseTypes = CaseTypeService.Instance.GetCaseTypeList();
                                                    var i = 0;
                                                    foreach (var item in Model.CaseFee.CaseFeeItems)
                                                    {
                                                        var display = string.Empty;
                                                        var id = "CaseFeeItem_FeeTypeName" + i;
                                                        var hid = "hidCaseFeeItem_FeeTypeId" + i;
                                                        var feeTypeName = item.FeeTypeId.HasValue ? "(" + item.FeeTypeId + ")" + item.FeeTypeName : string.Empty;

                                                        <tr>
                                                            @if (i == 0)
                                                            {
                                                                <td style="text-align: center">
                                                                    <span class='spanCaseFeeTypeName'>@feeTypeName</span>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td style="text-align: center">
                                                                    <input type="hidden" value="@item.FeeTypeId" id="@hid">
                                                                    <input class="CaseFeeItem_FeeTypeName form-control" sytle="text-align:center;width:100px" id=@id  readonly="" type="text" value=@feeTypeName>
                                                                </td>
                                                            }

                                                            <td >
                                                                @Html.TextBoxFor(m => item.Amount, new
                                                                {
                                                                    @class = "form-control",
                                                                    @onkeyup = "javascript:this.value=this.value.replace(/\\D/g,'')",
                                                                    @onafterpaste = "this.value=this.value.replace(/\\D/g,'')"
                                                                })
                                                            </td>

                                                            <td>
                                                                @Html.CheckBoxFor(m => item.IsFeeMitigation, new {@style = "height: 20px;width: 20px"})
                                                            </td>
     
                                                            <td>
                                                                <input type="button"  value="重写" class="btn_clear" />
                                                                <input type="button" disabled value="移除" class="btn_remove" />
                                                            </td>
                                                        </tr>

                                                        i++;
                                                    }
                                                }

                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="divCaseFeeTypeList"></div>

                            @*<div style="display: none;" id="divUsers">
                                @Html.Partial("~/Views/IPRBase/UserList.cshtml")
                            </div>*@
                            
                            <div style="display: none;" id="divUsers">
                                <div class="i_common_box">
                                    <div class="i_common_hd">
                                        从下列用户中选择
                                        <input type="hidden" id="hidUserId">
                                        <input type="hidden" id="hidUserName">
                                    </div>
                                    <div class="i_common_bd">
                                        <ul class="i_common_ul layoutfix">
                                            @if (staffs != null && staffs.Count > 0)
                                            {
                                                foreach (var staff in staffs.FindAll(x => x.StaffBasic.DepartmentId == 5))
                                                {
                                                    <li style='width:100px'><a href="javascript:void(0)" name="@staff.StaffBasic.StaffName">@staff.StaffBasic.StaffChName</a></li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer">
                            @*<input class="btn btn-primary ng-binding" type="button" id="btnFeeInformConfirmItemLinked" value="关联收费明细" />*@
                            <input class="btn btn-primary ng-binding" type="button" id="btnFeeInformConfirmItemAdd" value="新增收费明细" />
                            <input class="btn btn-primary ng-binding" type="button" id="btnFeeInformConfirm" value="保存" />
                            <input class="btn btn-default ng-binding" type="button" id="btnFeeInformCancel" value="取消" />
                        </div>

                    }
                </div>
            </div>
        </div><!-- /.modal -->
   
</div>

