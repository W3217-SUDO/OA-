@using Dchien.Legal.Service
@using Dchien.Legal.Service.HR.Staff

@model Dchien.Legal.Web.Areas.HR.ViewModels.Staff.StaffListModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<script src="@Url.Content("~/Scripts/Common/jquery.ui.position.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/HR/Staff/HR.Staff.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<div class="viewFramework-product ">
    <div class="viewFramework-product-body">
        <div ng-transclude="">
            <div class="console-container ng-scope">
                <div class="row ng-scope">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>员工列表</h5>
                            </div>

                        </div>


                        <div class="pull-left  col-sm-12" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm">
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageNo" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageSize" })


                                <table class="search_table" style="width: 600px">
                                    <colgroup>
                                        <col style="width: 60px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px;" />
                                        <col style="width: 160px" />
                                        <col>
                                    </colgroup>

                                    <tr>
                                        <th style="text-align: left">
                                            公司：
                                        </th>
                                        <td>
                                            @Html.DropDownListFor(m => m.SearchCondition.CompanyId, CompanyService.Instance.GetCompanyList(), new { @class = "form-control", @style = "width:95%" })
                                        </td>
                                        <th style="text-align: left">
                                            部门：
                                        </th>
                                        <td>
                                            @Html.DropDownListFor(m => m.SearchCondition.DepartmentId, DepartmentService.Instance.GetDepartmentList(LoginHelper.GetCompanyId()), new { @class = "form-control", @style = "width:95%" })
                                        </td>
                                        <th style="text-align: left">
                                            用户名：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.StaffName, new { @class = "form-control" })         
                                        </td>
                                    </tr>

                                    <tr>
                                        <th style="text-align: left">
                                            中文名：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.StaffChName, new { @class = "form-control" })
                                        </td>

                                        <th style="text-align: left">
                                            手机号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.StaffChName, new { @class = "form-control" })
                                        </td>

                                        <th style="text-align: left">
                                            是否可用：
                                        </th>
                                        <td>
                                            @Html.DropDownListFor(m => m.SearchCondition.IsActived, CommonService.Instance.GetTrueFalseList(true), new { @class = "form-control", @style = "width:95%" })
                                        </td>

                                    </tr>
                                    <tr>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left">
                                            <div class="form-group">
                                                <a href="javascript:void(0);" class="btn btn-primary " id="btnStaffSearch">
                                                    <span>查询</span>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </form>
                        </div>
                       

                    </div>
                    <div class="col-sm-12">
                        <div class="ng-scope">
                            <div class="gridSection">
                                <table class="aps-table aps-widget aps-ani-transition" id="tblStaffList" style="width:100%">
                                    <colgroup>
                                        <col style="width: 3%;" />
                                        <col style="width: 3%;" />
                                        <col style="width: 7%;" />
                                        <col style="width: 7%;" />
                                        <col style="width: 7%;" />
                                        <col style="width: 7%;" />
                                        <col style="width: 15%;" />
                                        <col style="width: 10%;" />
                                        <col style="width: 7%;" />
                                        <col style="width: 7%;" />
                                        <col style="width: 5%;" />
                                        <col style="width: 8%;" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <td><input type="checkbox" id="chkStaffAll" onclick="javascript:  staff.Staff.Selected(this);" name="chkStaffAll"></td>
                                            <th>序号</th>
                                            <th style="text-align: center">员工号</th>
                                            <th style="text-align: center">用户名</th>
                                            <th style="text-align: center">中文姓名</th>
                                            <th style="text-align: center">所属部门</th>
                                            <th style="text-align: center">所属公司</th>
                                            <th style="text-align: center">Email</th>
                                            <th style="text-align: center">手机号码</th>
                                            <th style="text-align: center">固定电话</th>
                                            <th style="text-align: center">是否可用</th>
                                            <th>操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td>
                                                &nbsp;
                                            </td>
                                            <td>
                                                &nbsp;
                                            </td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td></td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="ng-scope" style="display: none">
                                        <tr>
                                            <td><input type="checkbox" onclick="javascript: staff.Staff.Selected(this);" id="chkStaffAll" name="chkStaffAll"></td>
                                            <td colspan="11">

                                                <div class="pull-left">
                                                    <input type="button" id="btnStaffDelete" onclick="javascript: staff.Staff.Delete();" class="btn btn-default" style="height:32px" value="删除选中" />

                                                </div>
                                                <div class="ng-scope">
                                                    <div class="pull-right page-box stafflist">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left ng-binding" ng-bind-html="vm.msg">没有查询到符合条件的记录</span>

                                            <span class="ng-binding">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>