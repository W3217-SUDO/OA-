@using Dchien.Legal.Common
@using Dchien.Legal.Entity
@using Dchien.Legal.Entity.Account
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.HR.ViewModels.Staff.PerformanceListModel
@{
    var display = "display:block";

    if (@Model.PerformanceList != null && @Model.PerformanceList.Count > 0)
    {
        display = "display:none";
    }
}
<form id="postForm" action="">
    <div class="gridSection">
        <div id='divContextList' style="overflow-y: auto; margin-top: -1px; overflow-x: hidden; overflow-y: auto; ">
            <table class='table table-hover' id="tblPerformanceList" width="100%">
                <colgroup>
                    <col style="width:5%">
                    <col style="width:10%">
                    <col style="width:10%">
                    <col style="width: 10%">
                    <col style="width:10%">
                    <col style="width:10%">
                    <col style="width: 10%">
                    <col style="width:10%">
                    <col style="width:10%">
                    <col style="width:10%">
                    <col style="width: 10%">
                    <col style="width:10%">
                    <col style="width:10%">
                    <col style="width:10%">
                    <col style="width:10%">
                </colgroup>
                <thead>
                    <tr>
                        <th style="text-align: center">
                            序号
                        </th>
                        <th style="text-align: center">
                            开始日期
                        </th>
                        <th style="text-align: center">
                            结束日期
                        </th>
                        <th style="text-align: right">
                            基本工资
                        </th>
                        <th style="text-align: right">
                            开庭比例提成
                        </th>
                        <th style="text-align: right">
                            开庭固定提成
                        </th>
                        <th style="text-align: right">
                            文书比例提成
                        </th>
                        <th style="text-align: right">
                            文书固定提成
                        </th>
                        <th style="text-align: right">
                            案源比例提成
                        </th>
                        <th style="text-align: right">
                            案源固定提成
                        </th>
                        <th style="text-align: right">
                            调查比例提成
                        </th>
                        <th style="text-align: right">
                            调查固定提成
                        </th>
                        <th style="text-align: right">
                            品管比例提成
                        </th>
                        <th style="text-align: right">
                            品管固定提成
                        </th>
                        <th style="text-align: center">
                            操作
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PerformanceList != null && Model.PerformanceList.Any())
                    {
                        foreach (var item in Model.PerformanceList)
                        {
                            <tr>
                                <td style="text-align: center">
                                    <span>@(Model.PerformanceList.IndexOf(item) + 1)</span>
                                </td>
                                <td style="text-align: center">
                                    <span>@(item.AnnualFrom.HasValue ? item.AnnualFrom.Value.ToString("yyyy-MM-dd") : string.Empty)</span>
                                </td>
                                <td style="text-align: center">
                                    <span>@(item.AnnualEnd.HasValue ? item.AnnualEnd.Value.ToString("yyyy-MM-dd") : string.Empty)</span>
                                </td>
                                <td style="text-align: right">
                                    <span>@item.Salary</span>
                                </td>
                                <td style="text-align: right">
                                    <span>@item.KtRate</span>
                                </td>
                                <td style="text-align: right">
                                    <span>@item.KtFixed</span>
                                </td>
                                <td style="text-align: right; ">
                                    <span>@item.WsRate</span>
                                </td>  
                                <td style="text-align: right; ">
                                    <span>@item.WsFixed</span>
                                </td>  
                                <td style="text-align: right; ">
                                    <span>@item.AyRate</span>
                                </td>
                                <td style="text-align: right; ">
                                    <span>@item.AyFixed</span>
                                </td>
                                <td style="text-align: right; ">
                                    <span>@item.TcRate</span>
                                </td>
                                <td style="text-align: right; ">
                                    <span>@item.TcFixed</span>
                                </td>
                                <td style="text-align: right; ">
                                    <span>@item.PgRate</span>
                                </td>
                                <td style="text-align: right; ">
                                    <span>@item.PgFixed</span>
                                </td>
                                <td style="text-align: center">
                                    <a style="color:green;" href="javascript:void(0);">
                                        <span class="btn_staffperformance_add glyphicon glyphicon-plus"  onclick="javascript: staff.Staff.Performance.Create();"  seqId="@item.SettingId"></span>
                                    </a>
                                    <a style="color:red;" href="javascript:void(0);">
                                        <span class="btn_staffperformance_remove glyphicon glyphicon-remove" onclick="javascript: staff.Staff.Performance.Delete(@item.SettingId);" seqid="@item.SettingId"></span>
                                    </a>
                                    <a style="color:green;" href="javascript:void(0);">
                                        <span class="btn_staffperformance_edit glyphicon glyphicon-edit" onclick="javascript: staff.Staff.Performance.Edit(@item.SettingId);" seqId="@item.SettingId"></span>
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="ng-scope" style="@display">
                    <tr>
                        <td colspan="6">
                            <div class="pull-left"></div>
                            <div class="ng-scope">
                                <div class="pull-right page-box performance">
                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>

            @if (Model.PerformanceList != null && Model.PerformanceList.Any())
            {

            }
            else
            {
                <div class="simple-grid-none-data-wrap">
                    <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                        <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                            <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                            <div class="text-size-16 tip-text inline-block">
                                <span class="margin-left "></span>没有查询到记录，可以去
                                <a href="javascript:void(0);" class=""  style="color: #039"  onclick="javascript: staff.Staff.Performance.Create();"  >新建</a>
                                <span class=""></span>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</form>
