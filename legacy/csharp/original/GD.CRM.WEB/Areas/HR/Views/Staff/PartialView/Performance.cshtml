@using Dchien.Legal.Common
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.HR.ViewModels.Staff.PerformanceModel
<div class="modal fade" id="performanceModal" >
        <div class="modal-dialog">
            <div class="modal-content" style="width:700px">
                <div class="ng-scope">
                    @using (Html.BeginForm("Performance", "Performance", FormMethod.Post, new { id = "performanceForm", @class = "form-horizontal" }))
                    {
                       <link rel="stylesheet" href="@Url.Content("~/Resource/css/customer.createupdate.console.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" />

                        @Html.HiddenFor(m => m.Performance.SettingId)
                        @Html.HiddenFor(m => m.Performance.StaffName)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnPerformanceClose">×</button>
                            <h5 class="modal-title ng-binding">提成设定</h5>
                        </div>
                        <div class="modal-body" style="padding-top:20px">
                            <div style="background: #eaedf1;">
                                <div class="customer-section-main clearfix">
                                    <div class="customer-section-left" style="padding-right:0px">
                                        <div class="customer-section-wrap">
                                            <div class="customer-section-product">
                                                <div class="product-container">
                                                    <div class="product-section">
                        
                                                        <div class="section-content " >
                                                            <div class="ng-scope">
                                                                <div class="gridSection">
                                                                    <table   class="input_table" width="100%">
                                                                        <colgroup>
                                                                            <col style="width: 17%;" />
                                                                            <col style="width: 33%" />
                                                                            <col style="width: 17%" />
                                                                            <col style="width: 33%" />
                                                                        </colgroup>
                                                                        <tr>
                                                                            <th style="text-align:right"><span class="text-danger ng-binding">*</span>开始时间</th>
                                                                            <td>@Html.TextBoxFor(m => m.Performance.AnnualFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })</td>
                                                                            <th style="text-align:right"><span class="text-danger ng-binding">*</span>结束时间</th>
                                                                            <td>
                                                                               @Html.TextBoxFor(m => m.Performance.AnnualEnd, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th style="text-align:right">
                                                                                开庭比例提成
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.Performance.KtRate, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                            <th style="text-align:right">
                                                                                开庭固定提成
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.Performance.KtFixed, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th style="text-align:right">
                                                                                文书比例提成
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.Performance.WsRate, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                            <th style="text-align:right">
                                                                                文书固定提成
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.Performance.WsFixed, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th style="text-align:right">
                                                                                案源比例提成
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.Performance.AyRate, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                            <th style="text-align:right">
                                                                                案源固定提成
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.Performance.AyFixed, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th style="text-align:right">
                                                                                品管比例提成
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.Performance.PgRate, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                            <th style="text-align:right">
                                                                                品管固定提成
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.Performance.PgFixed, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th style="text-align:right">
                                                                                调查比例提成
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.Performance.TcRate, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                            <th style="text-align:right">
                                                                                调查固定提成
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.Performance.TcFixed, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th style="text-align:right">
                                                                                 基本工资
                                                                            </th>
                                                                            <td colspan="3">@Html.TextBoxFor(m => m.Performance.Salary, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                        </tr>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

 
                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnPerformanceCreateUpdate" value="确定" />
                           <input class="btn btn-default ng-binding" type="button" id="btnPerformanceCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div>
</div>



