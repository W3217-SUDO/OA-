@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.HR.ViewModels.RoleModel

@{
    object htmlAttribute = null;
}

<script type="text/javascript"></script>

<div class="modal fade" id="roleModal" >
  
        <div class="modal-dialog" style="width:560px">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("Role", "Role", FormMethod.Post, new { id = "Role", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.RoleId)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnRoleClose">×</button>
                            <h5 class="modal-title ng-binding">角色维护</h5>
                        </div>

                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label for="Role_RoleName" class="col-sm-4 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">角色名称</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.Role.RoleName, new { @class = "form-control" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="Role_RoleDesc" class="col-sm-4 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">角色名称描述</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.Role.RoleDesc, new { @class = "form-control" })
                                    </div>
                                </div>

                            </div>

                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnRole" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" id="btnRoleCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div><!-- /.modal -->
   
</div>

