
@model Dchien.Legal.Web.Areas.BAS.ViewModels.CourtOfficer.CourtOfficerModel

<style>
 
</style>

<div class="modal fade" id="courtOfficerModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="ng-scope">
                @using (Html.BeginForm("CourtOfficer", "Create", FormMethod.Post, new { id = "courtOfficer", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    <div class="modal-header">
                        <button type="button" class="close" onclick="javascript: $('#courtOfficerModal').modal('hide');">×</button>
                        <h5 class="modal-title ng-binding">法官(书记员)信息</h5>
                    </div>
                    <div class="modal-body">
                        <div class="">
                            <div class="form-horizontal margin-top-3 ">
 
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span>姓名：</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.HiddenFor(m => m.CourtOfficer.CourtNo)
                                        @Html.HiddenFor(m => m.CourtOfficer.OfficerNo)
                                        @Html.HiddenFor(m => m.CourtOfficer.OfficerId)
                                        @Html.TextBoxFor(m => m.CourtOfficer.OfficerName,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "姓名",
                                                   style = "height:28px;width:100%",
                                                   autocomplete = "off"
                                               })

                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span>联系电话：</span>
                                    </label>
                                    <div class="col-sm-6">

                                        @Html.TextBoxFor(m => m.CourtOfficer.Phone,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "联系电话",
                                                   style = "height:28px;width:100%",
                                                   autocomplete = "off"
                                               })

                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        
                                        <span>Email：</span>
                                    </label>
                                    <div class="col-sm-6">

                                        @Html.TextBoxFor(m => m.CourtOfficer.Email,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "Email",
                                                   style = "height:28px;width:100%",
                                                   autocomplete = "off"
                                               })

                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                         
                                        <span>备注：</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextAreaFor(m => m.CourtOfficer.Remark,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "备注",
                                                   rows = "3",
                                                   style = "width:100%"
                                               })

                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button"  id="btnCourtOfficerCreate"  value="确定" />
                            <input class="btn btn-default ng-binding" type="button" onclick="javascript:$('#courtOfficerModal').modal('hide');" value="取消" />
                        </div>
                }
            </div>
        </div>
    </div>
</div>

