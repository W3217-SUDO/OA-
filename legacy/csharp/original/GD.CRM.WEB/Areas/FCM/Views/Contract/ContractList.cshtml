@using Dchien.Legal.BizModel.FCM.Contract
@using Dchien.Legal.Service
@using Dchien.Legal.Entity.Account
@using Dchien.Legal.Entity.System
@using Dchien.Legal.Service.BAS.Type

@model Dchien.Legal.Web.Areas.FCM.ViewModels.Contract.ListModel
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<script src="@Url.Content("~/Scripts/AWS/OfficialDocument/AWS.OfficialDocument.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/FCM/Contract/FCM.Contract.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/FCM/Contract/FCM.Contract.List.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<div class="viewFramework-product ">
    <div class="viewFramework-product-body" style="overflow-y:hidden">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>合同查询</h5>
                            </div>
                        </div>
                        <div class="pull-left  col-sm-12" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm" action="@Url.Content("~/FCM/Contract/ContractList")">
                                @Html.HiddenFor(m => m.SearchCondition.PageId, new { name = "PageId" })
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                                <table class="search_table" style="width: 600px">
                                    <colgroup>
                                        <col style="width: 80px;" />
                                        <col style="width: 220px" />
                                        <col style="width: 80px" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px" />
                                        <col style="width: 160px" />
                                    </colgroup>
                                    <tr>

                                        <th>
                                            合同名称：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.ContractName, new { @class = "form-control", @placeholder = "合同名称", @style = "width:97.2%" })
                                        </td>
                                        <th>
                                            合同编号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.ContractNo, new { @class = "form-control", @placeholder = "合同编号", @style = "" })
                                        </td>

                                        <th>
                                            合同类型：
                                        </th>
                                        <td>
                                            @Html.DropDownListFor(m => m.SearchCondition.ContractType, ContractTypeService.Instance.GetContractTypeList(true), new { maxlength = 60, @class = "form-control select", @style = "width:100%" })
                               
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>
                                            客户名称：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CustomerName, new { @class = "form-control", @placeholder = "客户名称", @style = "width:97.2%" })
                                        </td>
                                        <th>
                                            案件编号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseNo, new { @class = "form-control", @placeholder = "案号", @style = "" })
                                        </td>
                                        <th>
                                            收费类型：
                                        </th>
                                        <td>
                                            @Html.DropDownListFor(m => m.SearchCondition.ChargingType, ContractTypeService.Instance.GetContractChargingTypeList(true), new { maxlength = 60, @class = "form-control select", @style = "width:100%" })
                                        </td>
                                    </tr>
                                    <tr>

                                        <th>
                                            合同日期：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.ContractBeginDate, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.ContractEndDate, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </td>

                                        @if (Model.SearchCondition.PageId != Dchien.Legal.Entity.System.PageId.PageId_4001002)
                                        {
                                            <th>
                                                案源人：
                                            </th>
                                            <td>
                                                @Html.HiddenFor(m => m.SearchCondition.BusinessOwner, new { @class = "form-control", @style = "" })
                                                @Html.TextBoxFor(m => m.SearchCondition.BusinessOwnerName, new { @class = "form-control", @style = "" })

                                                <div class="i_common_select" id="divAssociateUserList" style="display: none;">
                                                    <div class="i_common_wrap">
                                                        <div class="i_common_list"></div>
                                                    </div>
                                                </div>
                                            </td>
                                        }
                                        else
                                        {
                                            <th>
                                                案源人：
                                            </th>
                                            <td>
                                                @Html.HiddenFor(m => m.SearchCondition.BusinessOwner, new { @class = "form-control", @style = "" })
                                                @Html.TextBoxFor(m => m.SearchCondition.BusinessOwnerName, new { @class = "form-control", @disabled = true, @style = "" })
                                            </td>
                                        }
                                        @*<th>
                                            合同状态：
                                        </th>
                                        <td>
                                            @Html.DropDownListFor(m => m.SearchCondition.ContractStatus, ContractTypeService.Instance.GetContractStatusList(true), new { maxlength = 60, @class = "form-control select", @style = "width:100%" })
                                        </td>*@
                                        <th>
                                            合同主体：
                                        </th>
                                        <td>
                                            @Html.DropDownListFor(m => m.SearchCondition.GroupId, ContractTypeService.Instance.GetContractGroupList(true), new { maxlength = 60, @class = "form-control select", @style = "width:100%" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>
                                            
                                        </th>
                                        <td >
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnContractSearch">
                                                <span>查询</span>
                                            </a>
 
                                        </td>
                                    </tr>
                                </table>
                            </form>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="">
