                                                </tr>

                                            </tbody>
                                            <tfoot class="" style="display: none">
                                                <tr>
                                                    <td><input type="checkbox" onclick="javascript: contract.Contract.Selected(this);" id="chkContractAll" name="chkContractAll"></td>
                                                    <td colspan="18">
                                                        <div class="pull-left">

                                                            <input type="button" id="btnContractListExportToExcel" class="btn btn-default" style="height:32px" value="导出Excel" />

                                                            <input type="button"  id="btnContractView"  class="btn btn-default" style="height:32px" value="合同查看" />

                                                           @if (PageId.PageId_4001002 == Model.SearchCondition.PageId || CommonService.Instance.CheckPermission((int)Permission.Contract_Edit))
                                                           {
                                                                <input type="button" id="btnContractEdit" class="btn btn-default" style="height:32px" value="合同变更" />
                                                                <input type="button" id="btnContractToOfficialDocumentAudit" class="btn btn-default" style="height:32px" value="合同用印" />
                                                           }
                                                            @if (PageId.PageId_4001002 == Model.SearchCondition.PageId || CommonService.Instance.CheckPermission((int)Permission.Contract_PaymentApply))
                                                            {
                                                                <input type="button" id="btnContractPaymentApply" class="btn btn-default" style="height:32px" value="合同付款" />
                                                            }
                                                            @if (PageId.PageId_4001002 == Model.SearchCondition.PageId || CommonService.Instance.CheckPermission((int)Permission.Contract_InvoiceApply))
                                                            {
                                                                <input type="button" id="btnContractInvoiceApply" class="btn btn-default" style="height:32px" value="合同开票" />
                                                            }

                                                            @if (PageId.PageId_4001002 == Model.SearchCondition.PageId)
                                                            {
                                                                <input type="button" id="btnCaseCreate" class="btn btn-default" style="height:32px" value="新建案件" />
                                                                <input type="button" id="btnTaskCreate" class="btn btn-default" style="height:32px" value="新建调查任务" />
                                                            }

                                                            @if (PageId.PageId_4001007 == Model.SearchCondition.PageId)
                                                            {
                                                                <input type="button" id="btnContractDelete" class="btn btn-default" style="height:32px" value="删除合同" />
                                                            }

                                                            <input type="button" id="btnContractArchive" class="btn btn-default" style="height:32px" value="合同归档" />

