                            {
                               <li id="edit">合同变更</li>
                            }
                            @if (PageId.PageId_4001002 == Model.SearchCondition.PageId || CommonService.Instance.CheckPermission((int)Permission.Contract_PaymentApply))
                            {
                                <li id="paymentapply">合同付款</li>
                            }
                    
                            @if (PageId.PageId_4001002 == Model.SearchCondition.PageId || CommonService.Instance.CheckPermission((int)Permission.Contract_InvoiceApply))
