                                            <th style="text-align: center">代理费<br>到账金额</th>
                                            <th style="text-align: center">代理费<br>待收金额</th>
                                            <th style="text-align: center">其他金额</th>
                                            <th style="text-align: center">其他金额<br>已支付</th>
                                            <th style="text-align: center">其他金额<br>待支付</th>
                                            <th style="text-align: center">发票<br>已开金额</th>
                                            <th style="text-align: center">发票<br>应开金额</th>
                                            <th style="text-align: center">发票<br>高开金额</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                </table>
                                <div class="simple-grid-none-data-wrap">
                                    <div class="simple-grid-none-data text-center  ">
                                        <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                            <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                            <div class="text-size-16 tip-text inline-block">
                                                <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                                <span class="">。</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="divList" style="border-top: 0;margin-top: -1px; overflow-x:hidden; overflow-y: scroll;">
                                        <table id="tblContractList" class="aps-table aps-widget aps-ani-transition ">
                                            <colgroup>
                                                <col style="width: 4%">
                                                <col style="width: 9%">
                                                <col style="width: 20%">
                                                <col style="width: 8%">
                                                <col style="width: 8%">
                                                <col style="width: 8%">
                                                <col style="width: 8%">
                                                <col style="width: 8%">
                                                <col style="width: 8%">
                                                <col style="width: 8%">
