@using Dchien.Legal.BizModel.CMS.Contract

@model Dchien.Legal.Web.Areas.CMS.ViewModels.GL.IndexModel

<script type="text/javascript" src="@Url.Content("~/Scripts/CMS/GL/CMS.GL.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/components.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/font-awesome.css")" />

<script type="text/javascript">

</script>

<style>
    input.input_text, textarea, select, input.input_time {
        border: 1px solid #ccc;
    }

    /*select {
        color: rgb(84, 84, 84);
        background-color: rgb(235, 235, 228);
    }*/

    input.input_text, textarea, input.input_time {

        padding: 2px 2px 2px 3px;
    }

    input.input_text, textarea, input.input_time {
        background-color: #fff;
    }

    .case-form-control {
        /*border-radius: 0px;*/
        -webkit-transition: none;
        transition: none;
        font-size: 12px;
        width: 100%;
        height: 24px;
    }

    .case-section-product .product-container .product-section .section-content .content-table td {
        padding-left: 1px;
    }

    table td, th {
        padding: 0px 0;
        /* border-bottom: 1px dotted #D6D6D6; */
        vertical-align: middle;
    }

    .input_table th {
        font-weight: normal;
        text-align: right;
    }

    .input_table td {
        text-align: left;
    }

    .case-section-wrap {
        padding: 4px;
    }

    .case-section-main {
        margin: 0 6px;
        padding: 8px 0;
        position: relative;
    }
</style>

<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.index.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/case.createupdate.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/messageCenter.console.css")" />

<div class="viewFramework-product viewFramework-product-col-1" style='background: #eaedf1;'>
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("MenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body">
        <div class="ng-scope">
            <div class="ng-scope">
                <div class="case-section-main clearfix">
                    <!-- 左侧 -->
                    <div class="case-section-left" style="padding-right: 0%;">
                        <div class="case-section-wrap">
                            <div class="case-section-product">
                                <!-- product section -->
                                <div class="product-container">
                                    <div class="product-section">
                                        @using (Html.BeginForm("Index", "GL", FormMethod.Post, new { id = "contractForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                                        {

                                            <div class="section-content clearfix">
                                                <div class="ng-scope">
                                                    @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractId)

                                                    <table class="input_table" style='width:100%'>
                                                        <colgroup>
                                                            <col style="width: 10%;" />
                                                            <col style="width: 10%;" />
                                                            <col style="width: 10%;" />
                                                            <col style="width: 10%;" />
                                                            <col style="width: 10%;" />
                                                            <col style="width: 10%;" />
                                                            <col style="width: 10%;" />
                                                            <col style="width: 10%;" />
                                                            <col style="width: 10%;" />
                                                            <col style="width: 10%;" />

                                                        </colgroup>
                                                        <tr>
                                                            <th colspan="10" style="text-align: center">
                                                                <span style='font-weight: bold; font-size: 10pt; '>合同台账</span>
                                                            </th>
                                                        </tr>
                                                        <tr>
                                                            <th>
                                                                @Html.LabelFor(m => m.Customer.CustomerNo)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.Customer.CustomerNo, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Customer.CustomerName)
                                                            </th>
                                                            <td colspan="3">
                                                                @Html.TextBoxFor(m => m.Customer.CustomerName, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>

                                                            <th>
                                                                @Html.LabelFor(m => m.Contract.ContractBasicInfo.AuditDate)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.AuditDate, "{0:yyyy-MM-dd}", new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Contract.ContractBasicInfo.ContractNo)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.ContractNo, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <th>
                                                                @Html.LabelFor(m => m.GeneralLedger.TotalAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.GeneralLedger.TotalAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.GeneralLedger.ARCaseOfficeFeeAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.GeneralLedger.ARCaseOfficeFeeAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            

                                                            <th>
                                                                @Html.LabelFor(m => m.GeneralLedger.ARCaseNonOfficeFeeAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.GeneralLedger.ARCaseNonOfficeFeeAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            
                                                            <th>
                                                                @Html.LabelFor(m => m.GeneralLedger.CashedAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.GeneralLedger.CashedAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            

                                                            <th>
                                                                @Html.LabelFor(m => m.GeneralLedger.CashedTimes)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.GeneralLedger.CashedTimes, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
            
                                                        </tr>
 
                                                        <tr>
                                                            <th>
                                                                @Html.LabelFor(m => m.GeneralLedger.APCaseOfficeFeeAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.GeneralLedger.APCaseOfficeFeeAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.GeneralLedger.PaidCaseOfficeFeeAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.GeneralLedger.PaidCaseOfficeFeeAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>

       
                                                            <th>
                                                                @Html.LabelFor(m => m.GeneralLedger.APCommissionAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.GeneralLedger.APCommissionAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.GeneralLedger.PaidAPCommissionAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.GeneralLedger.PaidAPCommissionAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            
                                                            <th>
                                                                @Html.LabelFor(m => m.Contract.ContractBasicInfo.BusinessOwnerName)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.BusinessOwnerName, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                        </tr>
                          
                                                        
                                                        <tr>
                                                            <th>
                                                                @Html.LabelFor(m => m.GeneralLedger.ARCaseFeeAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.GeneralLedger.ARCaseFeeAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>

                                                            <th>
                                                                @Html.LabelFor(m => m.GeneralLedger.InvoiceAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.GeneralLedger.InvoiceAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.GeneralLedger.InvoicedAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.GeneralLedger.InvoicedAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            
                                                            <th>
                                                                @Html.LabelFor(m => m.Contract.ContractBasicInfo.ContractName)
                                                            </th>
                                                            <td colspan="3">
                                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.ContractName, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="case-section-wrap">
                            <div class="case-section-product">
                                <!-- product section -->
                                <div class="product-container">
                                    <div class="product-section">
                                        <ul class="nav nav-tabs">
                                            <li id="liARCaseFeeList" class='active'><a href="javascript:void(0);" id="btnARCaseFeeList">应收款信息</a></li>
                                            <li id="liAPCaseFeeList"><a href="javascript:void(0);" id="btnAPCaseFeeList">应付款信息</a></li>
                                            @*<li id="liCaseFeeInvoiceList"><a href="javascript:void(0);" id="btnCaseFeeInvoiceList">发票信息</a></li>*@
                                            <li class="pull-right" style=" border:none">
                                                <div style="margin-top:3px">
                                                    <div style="text-align: inherit;">
                                                        <div style="text-align: right; padding-right: 8px; padding-bottom: 3px; float: right; display: inline;">
                                                            @*<input class="btn btn-primary ng-binding" type="button" id="btnCaseCreateUpdate" value="保存" />*@
                                                        </div>
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                        <div class="section-content clearfix">
                                            <div class="product-col ng-scope" style="width: 100%">
                                                <div id="dv_List">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="i_common_select" id="divAssociateUserList" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




