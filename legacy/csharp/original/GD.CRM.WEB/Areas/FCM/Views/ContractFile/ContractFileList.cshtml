@using Dchien.Legal.Common
@using Dchien.Legal.Entity
@using Dchien.Legal.Entity.Account
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.FCM.ViewModels.ContractFile.ContractFileListModel


<form id="postForm" action="">
    <div class="gridSection">
        <div id='divContextList' style="overflow-y: auto; margin-top: -1px; overflow-x: hidden; overflow-y: auto; ">
            <table class='table table-hover' id="tblContractFileList" width="100%">
                <colgroup>
                    <col style="width: 5%">
                    <col style="width: 5%">
                    <col style="width: 15%">
                    <col style="width: 45%">
                    <col style="width: 15%">
                    <col style="width: 10%">
                    <col style="width: 10%">
                </colgroup>
                <thead>
                    <tr>
                        <th><input type="checkbox" onclick="javascript: contract.Draft.Files.Selected(this);" id="chkContractFileAll" name="chkContractFileAll"></th>
                        <th style="text-align: center">
                            序号
                        </th>
                        <th style="text-align: center">
                            上传人
                        </th>
                        <th style="text-align: center">
                            文件名称
                        </th>
                        <th style="text-align: center">
                            文档日期
                        </th>
                        <th style="text-align: center">
                            查看
                        </th>
                        <th style="text-align: center">
                            操作
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="display: none">
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                    </tr>
                </tbody>
                <tfoot class="ng-scope" style="display:none">
                    <tr>
                        <td colspan="7">
                            <div class="pull-left"></div>
                            <div class="ng-scope">
                                <div class="pull-right page-box contractfile">
                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>
            <div class="simple-grid-none-data-wrap">
                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                        <div class="text-size-16 tip-text inline-block">
                            <span class="margin-left ng-binding"></span>没有查询到合同文件，可以去
                            <a href="javascript:void(0);" class="ng-binding"  style="color: #039" id="btnContractFileCreate">上传合同文件</a>
                            <span class="ng-binding"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  
</form>

