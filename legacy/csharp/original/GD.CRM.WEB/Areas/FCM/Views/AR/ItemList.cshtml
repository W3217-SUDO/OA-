                                            <div class="pull-right">
                                                <input class='btn btn-primary' type='button' id='btnCaseFeeTypeSelected' value='确定' />
                                                <input class='btn btn-default' type='button' id='btnCaseFeeTypeCancel' value='取消' />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </form>
                        </div>
