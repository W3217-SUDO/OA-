@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.FCM.ViewModels.ContractPayment.PaymentType.ListModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />

<div class="modal fade" id="paymentTypeModal">
    <div class="modal-dialog" style='width:60%' >
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" id="btnPaymentTypeClose">×</button>
                <h5 class="modal-title">选择付款类型</h5>
            </div>
            <div class="modal-body" >
                <form id="paymentTypeListForm" class="form-inline ng-valid">
                    @Html.HiddenFor(m => m.SearchCondition.PageNo)
                    @Html.HiddenFor(m => m.SearchCondition.PageSize)
                    <div class="simple-form-field">
                        <div class="form-group ">
                            <label class="control-label">
                                <span contenteditable="" class="text-danger "></span>
                                <span class="">付款类型：</span>
                            </label>
                            <div class="form-control-wrap">
                                @Html.TextBoxFor(m => m.SearchCondition.PaymentTypeName, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                    <div class="simple-form-field  ">
                        <div class="form-group  ">
                            <label class="control-label">
                                <span class="">
                                </span>
                            </label>
                            <div class="form-control-wrap text-right">
                                <input class="btn btn-primary " type="button" id="btnPaymentTypeSearch" value="查询" />
                            </div>
                            <div class="form-control-wrap text-right">
                                <input class="btn btn-primary " type="button" id="btnPaymentTypeSelected" value="选择" />
                            </div>
                        </div>
                    </div>
                </form>
                <div class="gridSection">
                    <table id="tblPaymentTypeList" class="table table-hover" style="padding-bottom:0px">
                        <colgroup>
                            <col style="width: 10%">
                            <col style="width: 20%">
                            <col style="width: 30%">
                            <col style="width: 40%">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>
                                    选择
                                </th>
                                <th>
                                    付款类型
                                </th>
                                <th>
                                    收款单位
                                </th>
                                <th>
                                    备注
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="display: none">
                                <td>
                                    &nbsp;
                                </td>
                                <td style="text-align: left"></td>
                                <td style="text-align: left"></td>
                                <td style="text-align: left"></td>
                            </tr>
                        </tbody>
                        <tfoot class="ng-scope" style="display: none">
                            <tr>
                                <td colspan="4">
                                    <div class="pull-left"></div>
                                    <div class="ng-scope">
                                        <div class="pull-right page-box paymenttype">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                </div>
            </div>
            <div class="modal-footer">
                @*<input type="button" class="btn btn-primary" id="btnPaymentTypeSelected" value="确定" />
                <input type="button" class="btn btn-default" id="btnPaymentTypeCancel" value="取消" />*@
            </div>
        </div>
    </div>
</div>

