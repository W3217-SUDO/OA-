@using Dchien.Legal.BizModel.FCM.Contract
@using Dchien.Legal.Entity.System
@using Dchien.Legal.Service.BAS.Type
@model Dchien.Legal.Web.Areas.FCM.ViewModels.Contract.DraftModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/font-awesome.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/citys/city.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/bootstrap-tagsinput.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" />
<link type="text/css" rel="stylesheet" href=@Url.Content("~/Resource/css/ticketSystem/add.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"]) />

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Common/citys/jquery.citys.json.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Common/citys/jquery.citys.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Common/bootstrap-tagsinput.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/FCM/Contract/FCM.Contract.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/FCM/Contract/FCM.Contract.Draft.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>


<style>
    .bootstrap-tagsinput {
        width: 100%;
        border-radius: 0px;
        padding: 2px 4px;
    }

        .bootstrap-tagsinput input {
            padding: 0px;
            width: 50px;
        }
</style>
<div class="viewFramework-product">
    <div class="viewFramework-product-body">
        <div class="console-container ">
            <div class="row ">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5>@(Model.Contract.ContractBasicInfo.ContractId.HasValue ? "变更合同" : "新建合同")</h5>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12">

                    <div style="margin-top:24px">
                        <div class="create-ticket-step clearfix ">
                            <div class="create-ticket-step-item active" style="width:25%">
                                <div class="item-wrap">
                                    <span class="icon-step">1</span>
                                    <span class="dingding-text">合同基本信息</span>
                                </div>
                            </div>
                            <div class="create-ticket-step-item" style="width:25%">
                                <div class="item-wrap">
                                    <span class="icon-step">2</span>
                                    <span class="dingding-text">提交审核</span>
                                </div>
                            </div>
                            <div class="create-ticket-step-item" style="width:25%">
                                <div class="item-wrap">
                                    <span class="icon-step">3</span>
                                    <span class="dingding-text">合同审批</span>
                                </div>
                            </div>
                            <div class="create-ticket-step-item" style="width:25%">
                                <div class="item-wrap">
                                    <span class="icon-step">4</span>
                                    <span class="dingding-text">合同用印</span>
                                </div>
                            </div>
                        </div>
                        <div class="table-viewer-header clearfix" style="margin-top: 10px;height:40px;line-height:40px">
                            <span class="table-viewer-topbar-title">
                                @(Model.Contract.ContractBasicInfo.ContractId.HasValue ? "变更合同" : "新建合同")

                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.CustomerNo)
                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.CustomerId)
                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractId)
                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractNo)
                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.AuditDate)
                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractGuid)

                            </span>
                            <div class="pull-right table-viewer-topbar-content"></div>

                        </div>
                        <div class="console-box-border ">
                            <div class="form-horizontal margin-top-3 " novalidate="">
                                <div class="form-group">
                                    <label class="col-sm-2 control-label">
                                        <span class="text-danger">*</span>
                                        <span>客户：</span>
                                    </label>
                                    <div class="col-sm-5">
                                        @if (!Model.Contract.ContractBasicInfo.ContractId.HasValue)
                                        {
                                            <div class="bootstrap-tagsinput">
                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.CustomerName,
                                                new
                                                {
                                                    placeholder = "客户名称",
                                                    style = "height:22px;width:90%",
                                                    autocomplete = "off"
                                                })

                                                <div style="float:right;margin-top:4px;background-color:white; important" class="label">
                                                    <a style="color:green;" title="新增客户" data-toggle="tooltip" data-container="body" href="javascript:void(0);">
                                                        <span class="btn_customer_add fa fa-user-plus"></span>
                                                    </a>
                                                </div>
                                            </div>
                                            <div class="i_common_select" id="div_customer" style="display: none;">
                                                <div class="i_common_wrap">
                                                    <div class="i_common_list"></div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.CustomerName,
                                            new
                                            {
                                                @readonly = true,
                                                @class="form-control",
                                                placeholder = "客户名称",
                                                style = "height:29px;width:100%",
                                                autocomplete = "off"
                                            })
                                        }
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-2 control-label">
                                        <span class="text-danger">*</span>
                                        <span>合同主体：</span>
                                    </label>
                                    <div class="col-sm-5">
                                        @Html.DropDownListFor(m => m.Contract.ContractBasicInfo.GroupId, ContractTypeService.Instance.GetContractGroupList(false), new { maxlength = 60, @class = "form-control select", style = "height:29px; " })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-2 control-label">
                                        <span class="text-danger">*</span>
                                        <span>合同类别：</span>
                                    </label>
                                    <div class="col-sm-5">
                                        @Html.DropDownListFor(m => m.Contract.ContractBasicInfo.ContractType, ContractTypeService.Instance.GetContractTypeList(false), new { maxlength = 60, @class = "form-control select", style = "height:29px; " })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-2 control-label">
                                        <span class="text-danger">*</span>
                                        <span>收费模式：</span>
                                    </label>
                                    <div class="col-sm-5">
                                        @Html.DropDownListFor(m => m.Contract.ContractBasicInfo.ChargingType, ContractTypeService.Instance.GetContractChargingTypeList(false), new { maxlength = 60, @class = "form-control select", style = "height:29px; " })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-2 control-label">
                                        <span class="text-danger">*</span>
                                        <span>合同名称：</span>
                                    </label>
                                    <div class="col-sm-5">
                                        @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.ContractName, new { placeholder = "合同名称", @class = "form-control", style = "height:29px; " })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-2 control-label">
                                        <span class="text-danger"></span>
                                        <span>外部合同号：</span>
                                    </label>
                                    <div class="col-sm-5">
                                        @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.RefContractNo, new { placeholder = "外部合同号", @class = "form-control", style = "height:29px; " })
                                    </div>
                                </div>


                                <div class="form-group">
                                    <label class="col-sm-2 control-label">
                                        <span class="text-danger">*</span>
                                        <span>备注：</span>
                                    </label>
                                    <div class="col-sm-5">

                                        @Html.TextAreaFor(m => m.Contract.ContractBasicInfo.Remark,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "备注",
                                                   rows = "5",
                                                   style = "width:100%"
                                               })

                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-2 control-label">
                                        <span class="text-danger">*</span>
                                        <span>合同附件：</span>
                                    </label>
                                    <div class="col-sm-10">
                                        <input class="btn btn-default btn-xs " id="btnFileUpload" style="width:80px;overflow: hidden;" value="上传附件" />
                                        @using (Html.BeginForm("DarftContractFileUpload", "ContractFile", FormMethod.Post, new { id = "uploadForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                                        {
                                            <input id="contractGuid" name="contractGuid" type="hidden" value="@Model.Contract.ContractBasicInfo.ContractGuid">
                                            <input type="file" multiple="multiple" id="flDraftContractFile" name="flDraftContractFile" accept=".jpg, .jpeg, .bmp, .png, .gif,.txt, .rar, .zip, .doc, .docx, .ini, .conf, .eml, .xlsx, .xls, .pdf" tabindex="-1"
                                                   style="width: 1px; height: 1px; opacity: 0; position: absolute; padding: 0px; margin: 0px; overflow: hidden;">
                                        }

                                        <p class="help-block">
                                            <span class="ng-binding">
                                                <div class="text-muted">
                                                    附件支持的格式有:'jpg', 'bmp', 'png','gif','txt','rar','zip','doc','docx','ini','conf','eml','pdf', 'xlsx', 'xls'
                                                </div>
                                            </span>
                                        </p>
                                        <div id="attachments"> </div>
                                        <div class="help-block" style="display:none">上传失败</div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-sm-5 col-sm-offset-2">
                                        <input type="button" id="btnContractCreateUpdate" class="btn btn-primary ng-binding" style="height: 32px; line-height: 14px;    padding: 8px 16px;" value="下一步" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
