@using Dchien.Legal.Common
@using Dchien.Legal.Service.Lawsuit.Case
@model Dchien.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseModel

@{
    object htmlAttribute = null;
}

@using (Html.BeginForm("CaseInfo", "Case", FormMethod.Post, new { id = "caseForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
{
    <div class="ng-scope">

        @Html.HiddenFor(m => m.CaseId)
        @Html.HiddenFor(m => m.Case.CaseBasicInfo.CompanyId)
        @Html.HiddenFor(m => m.Case.CaseBasicInfo.DeadlineLeftDays)
        @Html.TextBoxFor(m => m.Case.CaseBasicInfo.ReminderDate, "{0:yyyy-MM-dd}", new { @style = "display:none" })

        <table class="content-table" id='tabCase'>
            <colgroup>
                <col style="width: 8%;" />
                <col style="width: 18%" />
                <col style="width: 8%;" />
                <col style="width: 18%" />
                <col style="width: 8%;" />
                <col style="width: 18%" />
                <col style="width: 8%;" />
                <col style="width: 18%" />
            </colgroup>
            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CaseInvestigation.CaseNo)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.CaseNo, new { @class = "case-form-control", @readonly = true, @unselectable = "on" })
                </td>


                <th>
                    @Html.LabelFor(m => m.Case.CasePart.CauseName)
                </th>
                <td>
                    @Html.HiddenFor(m => m.Case.CasePart.Cause)
                    @Html.TextBoxFor(m => m.Case.CasePart.CauseName, new { @class = "case-form-control", @readonly = true, @unselectable = "on" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.CasePhaseId)
                </th>
                <td>
                    @{
    htmlAttribute = new { maxlength = 60, @class = "case-form-control" };
                    }

                    @Html.DropDownListFor(m => m.Case.CaseBasicInfo.CasePhaseId, CaseTypeService.Instance.GetCasePhaseList(@Model.Case.CaseBasicInfo.CaseTypeId), htmlAttribute)

                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.CaseOriginPeople)
                    @Html.HiddenFor(m => m.Case.CaseBasicInfo.CaseOriginPeople)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.CaseOriginPeopleName, new { @class = "case-form-control", @readonly = true, @unselectable = "on" })
                </td>
            </tr>
            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CasePart.Court)
                    @Html.HiddenFor(m => m.Case.CasePart.Court)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.CourtName, new { @class = "case-form-control", @readonly = true, @unselectable = "on" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CasePart.CaseJudge)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.CaseJudge, new { @class = "case-form-control", @unselectable = "on" })
                </td>


                <th>
                    @Html.LabelFor(m => m.Case.CasePart.CourtCasetNo)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.CourtCasetNo, new { @class = "case-form-control", @unselectable = "on" })

                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CasePart.CaseRegisterDate)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.CaseRegisterDate, "{0:yyyy-MM-dd}", new { @class = "case-form-control input_time ", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                </td>


            </tr>
            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CasePart.Procurator)
                    @Html.HiddenFor(m => m.Case.CasePart.Procurator)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.ProcuratorName, new { @class = "case-form-control ", @readonly = true, @unselectable = "on" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CasePart.Assistant)
                    @Html.HiddenFor(m => m.Case.CasePart.Assistant)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.AssistantName, new { @class = "case-form-control ", @readonly = true, @unselectable = "on" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.Investigator)
                    @Html.HiddenFor(m => m.Case.CaseBasicInfo.Investigator)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.InvestigatorName, new { @class = "case-form-control ", @readonly = true, @unselectable = "on" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CasePart.CaseEvidenceDate)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.CaseEvidenceDate, "{0:yyyy-MM-dd}", new { @class = "case-form-control input_time ", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                </td>
            </tr>
            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CasePart.CaseIndicter)
                    @Html.HiddenFor(m => m.Case.CasePart.CaseIndicter)
                </th>

                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.CaseIndicterName, new { @readonly = true, @class = "case-form-control " })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CasePart.HolderOfRelationship)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.HolderOfRelationship, new { @class = "case-form-control " })
                </td>
                <th>
                    @Html.LabelFor(m => m.Case.CasePart.CaseIndictee)
                    @Html.HiddenFor(m => m.Case.CasePart.CaseIndictee)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.CaseIndicteeName, new { @readonly = true, @class = "case-form-control " })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CasePart.DetermineTheway)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.DetermineTheway, new { @class = "case-form-control " })
                </td>


            </tr>
            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CasePart.CaseLawfulDate)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.CaseLawfulDate, "{0:yyyy-MM-dd}", new { @class = "case-form-control input_time ", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.Deadline)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.Deadline, "{0:yyyy-MM-dd}", new { @class = "case-form-control input_time ", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.CaseSubmitter)
                    @Html.HiddenFor(m => m.Case.CaseBasicInfo.CaseSubmitter)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.CaseSubmitterName, new { @readonly = true, @class = "case-form-control " })
                </td>


                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.CaseOfficer)
                    @Html.HiddenFor(m => m.Case.CaseBasicInfo.CaseOfficer)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.CaseOfficerName, new { @readonly = true, @class = "case-form-control " })
                </td>
            </tr>
            <tr style='display:none'>
                <th>
                    @Html.LabelFor(m => m.Case.CasePart.TheThird)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.TheThird, new { @class = "case-form-control " })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CasePart.TheThirdRelationship)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CasePart.TheThirdRelationship, new { @class = "case-form-control " })
                </td>

            </tr>
        </table>
    </div>
}
