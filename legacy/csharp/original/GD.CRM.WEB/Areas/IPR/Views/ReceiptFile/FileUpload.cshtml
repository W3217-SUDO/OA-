@using Dchien.Legal.Common
@using Dchien.Legal.Service

@model  Dchien.Legal.Web.Areas.IPR.ViewModels.ReceiptFile.FileUploadModel
<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>

<div class="modal fade" id="receiptFile">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="ng-scope">
                @using (Html.BeginForm("ReceiptFileUpload", "ReceiptFile", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                        <div class="modal-header">
                            <button type="button" class="close" onclick="javascript:receipt.File.Close();">×</button>
                            <h5 class="modal-title ng-binding">上传专利收据文件</h5>
                        </div>
                        <div class="modal-body">

                            <div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span >参考日期</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.ReceiptDate, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                    </div>
                                </div>
                            </div>

                            <div>
                 
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger ">*</span>
                                        <span class="">专利收据文件</span>
                                    </label>
                                    <div class="col-sm-6">
                                        <div class="form-control-wrap">
                                            <input id="txtReceiptFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control ng-valid" style="display: inline-block">
                                            <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                                <input type="file" value="" id="flReceiptFile" name="flReceiptFile" style="height: 40px; width: 250px; margin-left: 10px;">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnReceiptUpload" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" onclick="javascript:receipt.File.Close();" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>







