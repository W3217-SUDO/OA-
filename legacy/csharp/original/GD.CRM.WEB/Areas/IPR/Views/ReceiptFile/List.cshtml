@using Dchien.Legal.Common
@using Dchien.Legal.Web.Areas.IPR.ViewModels.Case
@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.IPR.ViewModels.ReceiptFile.ListModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/index.css")" />

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/IPR/Receipt/IPR.Receipt.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("~/Areas/IPR/Views/CaseFile/CaseFileMenuList.cshtml");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body">
        <div class="console-container ng-scope">
            <div class="row ng-scope">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5 class="ng-binding">专利规则文件</h5>
                        </div>
                    </div>
                    <div class="pull-left margin-top-1 col-sm-12">

                        <div class="pull-left margin-top-1 col-sm-12" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm">
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })

                                <table class="search_table" style="width: 100%">
                                    <colgroup>
                                        <col style="width: 80px;" />
                                        <col style="width: 238px" />
                                        <col style="width: 80px" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 60px" />
                                        <col style="width: 60px" />
                                        <col style="width: 60px" />
                                        <col style="width: 60px" />
                                        <col>
                                    </colgroup>

                                    <tr>

                                        <th style="text-align:left">
                                            文件名：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.FileName, new { @class = "form-control", @style = "width:90%" })
                                        </td>

                                        <th style="text-align:left">
                                            申请号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.OfficialNo, new { @class = "form-control", @style = "" })
                                        </td>


                                    </tr>
                                    <tr>
                                        <th style="text-align:left">
                                            日期：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.InDateStart, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.InDateEnd, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </td>

                                        <th style="text-align:left">
                                            状态：
                                        </th>
                                        <td>
                                            @Html.DropDownListFor(m => m.SearchCondition.Status, Dchien.Legal.Service.IPR.Receipt.ReceiptRuleFileService.Instance.GetReceiptRuleFileStatusList(), new { @class = "form-control", style = "width:95%" })

                                        </td>

                                        <td colspan="4">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnSearch">
                                                <span>查询</span>
                                            </a>
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnFileUpload">
                                                <span>上传</span>
                                            </a>
                                        </td>

                                        <td colspan="4">
                                            <label class="control-label">
                                                <span style='color:red;text-align:right' id="message"></span>
                                            </label>
                                        </td>
                                    </tr>
                                </table>
                            </form>
                        </div>


                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="ng-isolate-scope">
                        <div class="ng-scope">
                            <div class="gridSection">
                                <table id="tblReceiptFileList" class="aps-table aps-widget aps-ani-transition ">
                                    <colgroup>
                                        <col style="width: 3%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 9%">
                                        <col style="width: 9%">
                                        <col style="width: 9%">
                                        <col style="width: 15%">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th width="10">
                                                <input type="checkbox" id="chkReceiptFileAll" class="ng-pristine ng-valid">
                                            </th>
                                            <th style="text-align: center">文件名</th>
                                            <th style="text-align: center">状态</th>
                                            <th style="text-align: center">申请号</th>
                                            <th style="text-align: center">案件编号</th>
                                            <th style="text-align: center">案件类型</th>
                                            <th style="text-align: center">费用短写</th>
                                            <th style="text-align: center">费用类型</th>
                                            <th style="text-align: center">票据金额</th>
                                            <th style="text-align: center">票据日期</th>
                                            <th style="text-align: center">错误信息</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center;color:red"></td>
                                        </tr>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center;color:red"></td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="ng-scope" style="display: none">
                                        <tr>
                                            <th width="10">
                                                <input type="checkbox" id="chkReceiptFileAll" class="ng-pristine ng-valid">
                                            </th>
                                            <td colspan="10">
                                                <div class="pull-left">
                                                    <input type="button" id="btnReceiptFileDelete" class="btn btn-default" style="height:32px" value="删除" />
                                                </div>
                                                <div class="ng-scope">
                                                    <div class="pull-right page-box receiptFileList">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
