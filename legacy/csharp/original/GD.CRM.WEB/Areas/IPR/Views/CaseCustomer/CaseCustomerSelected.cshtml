@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseCustomerSelectedModel

<script type="text/javascript">

</script>

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />

<div class="modal fade" id="caseCustomerModal">
    <div class="modal-dialog" style="width:45%">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" id="btnCustomerClose">×</button>
                <h5 class="modal-title">选择客户</h5>
            </div>
            <div class="modal-body" style='padding:10px'>
                <form id="caseCustomerListForm" class="form-inline ng-valid">
                    @Html.HiddenFor(m => m.CaseId, new { name = "CaseId" })
                    @Html.HiddenFor(m => m.SearchCondition.PageNo)
                    @Html.HiddenFor(m => m.SearchCondition.PageSize)
                    <div class="simple-form-field">
                        <div class="form-group ">
                            <label class="control-label">
                                <span contenteditable="" class="text-danger "></span>
                                <span class="">客户名称：</span>
                            </label>
                            <div class="form-control-wrap">
                                @Html.TextBoxFor(m => m.SearchCondition.CustomerName, new { @class = "form-control", @placeholder = "客户名称，多个用逗号隔开.", style = "width: 300px" })
                            </div>
                        </div>
                    </div>
                    <div class="simple-form-field  ">
                        <div class="form-group  ">
                            <label class="control-label">
                                <span class="">
                                </span>
                            </label>
                            <div class="form-control-wrap text-right">
                                <input class="btn btn-primary " type="button" id="btnCustomerSearch" value="查询" />
                             </div>

                            <div class="form-control-wrap text-right">
                                 <input type="button" class="btn btn-default-active ng-binding" id="btnCustomerConfirm" value="选择" />
                            </div>
        
                        </div>
                    </div>
                </form>
                <div class="gridSection">
                    <table id="tblCustomerList" class="table table-hover" style="padding-bottom:0px">
                        
                        <colgroup>
                            <col style="width: 10%">
                            <col style="width: 10%">
                            <col style="width: 20%">
                            <col style="width: 60%">
                        </colgroup>
                        <thead>
                            <tr>
                                <th width="100px">
                                    选择申请人
                                </th>
                                <th width="100px">
                                    第一申请人
                                </th>
                                <th>
                                    客户编号
                                </th>
                                <th>
                                    客户名称
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="display: none">
                                <td>
                                    &nbsp;
                                </td>
                                <td></td>
                                <td></td>
                                <td style="text-align: left"></td>
                            </tr>
                        </tbody>
                        <tfoot class="ng-scope" style="display: none">
                            <tr>
                                <td colspan="4">
                                    <div class="pull-left"></div>
                                    <div class="ng-scope">
                                        <div class="pull-right page-box">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                    <div class="simple-grid-none-data-wrap" style="">
                        <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                            <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                <div class="text-size-16 tip-text inline-block">
                                    <span class="margin-left ng-binding"></span>请先查询客户，再选择申请人.
                                    <span class="ng-binding"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                @*<input type="button" class="btn btn-primary ng-binding" id="btnCustomerConfirm" value="确定" />
                <input type="button" class="btn btn-default ng-binding" id="btnCustomerCancle" value="取消" />*@
            </div>
        </div>
    </div>
</div>

