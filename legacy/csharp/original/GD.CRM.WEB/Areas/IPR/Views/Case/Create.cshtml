                                            <div class="i_common_list"></div>
                                        </div>
                                    </div>

                                    <div class="i_common_select" id="divAssociateApplicantList" style="display: none;">
                                        <div class="i_common_wrap">
                                            <div class="i_common_list"></div>
                                        </div>
                                    </div>

                                    <div style="display: none;" id="divUserList">
                                        <div class="i_common_box" style='width:300px'>
                                            <div class="i_common_hd">
                                                从下列用户中选择
                                                <input type="hidden" id="hidUserId">
                                                <input type="hidden" id="hidUserName">
                                            </div>
                                            <div class="i_common_bd">
                                                <ul class="i_common_ul layoutfix">
                                                    @if (staffs != null && staffs.Count > 0)
                                                    {
                                                        foreach (var staff in staffs.FindAll(x => !string.IsNullOrEmpty(x.StaffBasic.PatentAgentLicenceNo)))
                                                        {
                                                            <li style='width: 80px'><div><input type='checkbox' userid="@staff.StaffBasic.StaffName" username="REDACTED_ARCHIVE_ONLY" /><lable>@staff.StaffBasic.StaffChName</lable></div></li>
                                                        }

                                                        <li id="btnClear" style='width: 80px'><a href="javascript:void(0)" name="">清空</a></li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>

                                    <div style="display: none;" id="div_Case_CaseBasicInfo_Deadline"> </div>

                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <input class="btn btn-default ng-binding" type="button" id="btnCaseCopy" value="导入案件" />
                    <input class="btn btn-primary ng-binding" type="button" id="btnCaseCreateUpdateNext" value="保存并新建" />
                    <input class="btn btn-primary ng-binding" type="button" id="btnCaseCreateUpdate" value="保存" />
                    <button class="btn btn-default ng-binding" id="btnCaseCancle">关闭</button>
                </div>

            </div>
        </div>
    </div>
</div>
