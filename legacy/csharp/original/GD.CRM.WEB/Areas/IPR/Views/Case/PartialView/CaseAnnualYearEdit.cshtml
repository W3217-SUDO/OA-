@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseAnnualYearEditModel


<div class="modal fade" id="caseAnnualYearEditModal">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseAnnualYearEdit", "Case", FormMethod.Post, new { id = "caseAnnualYearEdit", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    var caseIdList = (Model.CaseIds != null && Model.CaseIds.Any()) ? string.Join(",",Model.CaseIds) : string.Empty;
                    @Html.HiddenFor(m => caseIdList, new { @id = "caseIdList"})
 
                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseAnnualYearEditClose">×</button>
                        <h5 class="modal-title ng-binding">批量处理</h5>
                    </div>
                    <div class="modal-body">
                        
                        <div >
                            <div class="form-group">
                                <label for="CaseInstance_Deadline" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">首年缴费年度:</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.DropDownListFor(m => m.FirstAnnualYear, CaseAnnualYearService.Instance.GetAnnualYearList(true,null), new { @class = "form-control" })
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="form-group">
                                <label for="PaymentDate" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">减缓比例:</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.DropDownListFor(m => m.CostSlowRate, CaseAnnualYearService.Instance.GetCostSlowRateList(true), new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
 

                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseAnnualYearEditCreate" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseAnnualYearEditCancel" value="取消" />

                    </div>
                }
            </div>
        </div>
    </div>
</div>







