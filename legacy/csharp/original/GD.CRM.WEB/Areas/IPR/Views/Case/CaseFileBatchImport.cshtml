@{
    ViewBag.Title = "new case";
}


@using Dchien.Legal.Service
@using Dchien.Legal.Service.HR.Staff

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseBatchFileUploadModel
           
@{
    var staffs = StaffService.Instance.GetStaffList();
}

<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.index.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/case.createupdate.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bootstrap-treeview.min.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Common/bootstrap-treeview.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/IPR/Case/Case.CaseFile.BatchImport.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<style>
    input.input_text, textarea, select, input.input_time {
        border: 1px solid #ccc;
    }

    input.input_text, textarea, input.input_time {
        padding: 2px 0 0px 0px;
    }

    input.input_text, input.input_time {
        background-color: #fff;
    }

    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }

    .table tbody tr td {
        padding: 12px 2px;
    }
</style>

<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("CaseFileMenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body" style="background:#ffffff">
        <div class="console-container ng-scope">
            <div class="row ng-scope">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5 class="ng-binding">专利局文件导入</h5>
                        </div>
                    </div>
                    <div class="pull-left margin-top-1 col-sm-12">
                        @using (Html.BeginForm("CaseBatchFileUploading", "Case", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-inline ng-valid ng-valid-required" }))
                        {

                            <div class="simple-form-field ng-scope ng-isolate-scope">
                                <div class="form-group ng-scope">
                                    <label for="text3" class="  control-label">
                                        <span contenteditable="" class="text-danger ng-binding"></span>
                                        <span class="ng-binding">请选择上传文件：</span>
                                    </label>
                                    <div class="form-control-wrap">
                                        <input id="txtFilePath" ng-model="formData.file" placeholder="选择一个文件" disabled="disabled" class="form-control ng-pristine ng-valid" style="width: 150px; display: inline-block">
                                        <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                            <input type="file" value="" id="flZip" name="flFile" style="height: 40px; width: 150px; margin-left: 118px;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="simple-form-field ng-scope ng-isolate-scope">
                                <div class="form-group simple-form-submit ng-scope">
                                    <label for="submit4" class="  control-label">
                                        <span class="ng-binding">
                                        </span>
                                    </label>
                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-isolate-scope" type="button" id="btnFileUpload" value="上传文件" />
                                    </div>
                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-binding" type="button" id="btnImport" value="开始导入" />
                                    </div>
                                </div>
                            </div>
                            <div ng-transclude=""></div>

                        }
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="ng-isolate-scope">
                        <div class="ng-scope">
                            <div class="gridSection">
                                <table id="tblCaseList" class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th width="10">
                                                <input type="checkbox" id="chkCaseAll" class="ng-pristine ng-valid">
                                            </th>
                                            <th style="text-align: center">案卷号</th>
                                            <th style="text-align: center">案号</th>
                                            <th style="text-align: center">申请号</th>
                                            <th style="text-align: center">文档类型</th>
                                            <th style="text-align: center">处理日期</th>
                                            <th style="text-align: center">处理期限</th>
                                            <th style="text-align: center">处理人</th>
                                            <th style="text-align: center">金额</th>
                                            <th style="text-align: center">费用类型</th>
                                            <th style="text-align: center">结算人</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div style="display: none;" id="divUserList">
                @Html.Partial("~/Areas/IPR/Views/IPRBase/UserList.cshtml")
            </div>

            <div style="display: none;" id="divUsers">
                <div class="i_common_box">
                    <div class="i_common_hd">
                        从下列用户中选择
                        <input type="hidden" id="hidUserId">
                        <input type="hidden" id="hidUserName">
                    </div>
                    <div class="i_common_bd">
                        <ul class="i_common_ul layoutfix">
                            @if (staffs != null && staffs.Count > 0)
                            {
                                foreach (var staff in staffs.FindAll(x => x.StaffBasic.DepartmentId == 5))
                                {
                                    <li style='width:100px'><a href="javascript:void(0)" name="@staff.StaffBasic.StaffName">@staff.StaffBasic.StaffChName</a></li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <div class="divCaseTypeList"> </div>
            <div class="divCaseFeeTypeList"> </div>
        </div>
    </div>
</div>
