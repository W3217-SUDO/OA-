@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseRateModel

<div class="modal fade" id="caseRateModal">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseRateCreateUpdate", "Case", FormMethod.Post, new { id = "caseReate", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                     @Html.HiddenFor(m => m.CaseId)
 
                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseRateClose">×</button>
                        <h5 class="modal-title ng-binding">提成比例设置</h5>
                    </div>
                    <div class="modal-body">
                        
                        <div>
                            <div class="form-group">
                                <label  class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">案源提成比:</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.LeadRate, new { @class = "form-control",@onkeyup = "javascript:this.value=this.value.replace(/\\D/g,'')",@onafterpaste = "this.value=this.value.replace(/\\D/g,'')"})
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">撰稿提成比:</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.CopyRate, new{@class = "form-control",@onkeyup = "javascript:this.value=this.value.replace(/\\D/g,'')",@onafterpaste = "this.value=this.value.replace(/\\D/g,'')"})
                                </div>
                            </div>
                        </div>
                       
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseRateCreate" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseRateCancel" value="取消" />

                    </div>
                }
            </div>
        </div>
    </div>
</div>







