@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseBatchEditModel

<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>

<div class="modal fade" id="caseBatchEditModal">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseBatchEditCreate", "Case", FormMethod.Post, new { id = "caseBatchEdit", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    var caseIdList = (Model.CaseIds != null && Model.CaseIds.Any()) ? string.Join(",",Model.CaseIds) : string.Empty;
                    @Html.HiddenFor(m => caseIdList, new { @id = "caseIdList"})
 
                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseBatchEditClose">×</button>
                        <h5 class="modal-title ng-binding">批量处理</h5>
                    </div>
                    <div class="modal-body">
                        
                        <div style="display:none">
                            <div class="form-group">
                                <label for="CaseInstance_Deadline" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">案件编号:</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.CaseNo, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>

                        <div style="display:none">
                            <div class="form-group">
                                <label for="CaseInstance_Deadline" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">案件阶段:</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.DropDownListFor(m => m.CasePhaseId, CaseTypeService.Instance.GetAllCasePhaseList(true), new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="form-group">
                                <label for="PaymentDate" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">截止日期:</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.Deadline, "{0:yyyy-MM-dd}", new { @class = "form-control input_time", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="form-group">
                                <label for="ActualAmount" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">处理人:</span>
                                </label>
                                <div class="col-sm-6">

                                    @Html.HiddenFor(m => m.CaseOfficer)
                                    @Html.TextBoxFor(m => m.CaseOfficerName,new { @class = "form-control"})
                                </div>
                            </div>
                        </div>

                        <div style="display: none;" id="divUsers">
                            @Html.Partial("~/Areas/IPR/Views/IPRBase/UserList.cshtml")
                        </div>

                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseBatchEdit" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseBatchEditCancel" value="取消" />

                    </div>
                }
            </div>
        </div>
    </div>
</div>







