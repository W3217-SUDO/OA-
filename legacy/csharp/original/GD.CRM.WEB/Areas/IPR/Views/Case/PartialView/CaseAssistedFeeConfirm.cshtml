@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseAssistedFeeModel

<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>

<div class="modal fade" id="caseAssistedFeeConfirmModal">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseAssistedFeeTransact", "Case", FormMethod.Post, new { id = "caseAssistedFeeTransact", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CaseId)
                    @Html.HiddenFor(m => m.CaseNo)
                    @Html.HiddenFor(m => m.CaseAssistedFeeId)
                    

                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseAssistedFeeConfirmClose">×</button>
                        <h5 class="modal-title ng-binding">办理费用资助</h5>
                    </div>
                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label for="CaseInstance_Deadline" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">资费类型:</span>
                                </label>
                                <div class="col-sm-6">
                                    <select class="form-control" id="Case_CaseAssistedFeeType" name="Case.CaseAssistedFeeType" disabled unselectable="on">
                                        @{
                                            var lst = CaseAssistedFeeTypeService.Instance.GetAllAssistedFeeTypes();
                                            foreach (var feeType in lst)
                                            {
                                                if (Model.CaseAssistedFeeTypeId == feeType.AssistedFeeTypeId)
                                                {
                                                    <option selected value="@feeType.AssistedFeeTypeId">@feeType.AssistedFeeTypeName</option>
                                                }
                                                else
                                                {
                                                    <option value="@feeType.AssistedFeeTypeId">@feeType.AssistedFeeTypeName</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="form-group">
                                <label for="PaymentDate" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">办理日期</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.ResponseDate, "{0:yyyy-MM-dd}", new { @class = "form-control input_time", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", required = "true" })
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="form-group">
                                <label for="ActualAmount" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">回执文件</span>
                                </label>
                                <div class="col-sm-6">
                                    <div class="form-control-wrap">
                                        <input id="txtCaseAssistedFeeFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control ng-pristine ng-valid" style="display: inline-block">

                                        <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                            <input type="file" value="" id="flCaseAssistedFeeFile" name="flCaseAssistedFeeFile" style="height: 40px; width: 250px; margin-left: 10px;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseAssistedFeeConfirm" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseAssistedFeeConfirmCancel" value="取消" />

                    </div>
                }
            </div>
        </div>
    </div>
</div>







