@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case
@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.QuickCreateModel
<div class="modal fade" id="quickCreateModel">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("QuickCreate", "Case", FormMethod.Post, new { id = "quickCreateCase", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CustomerId)
                    <div class="modal-header">
                        <button type="button" class="close" id="btnQuickCreateCaseClose">×</button>
                        <h5 class="modal-title ng-binding">新建案件</h5>
                    </div>
                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">案件类型:</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.DropDownListFor(m => m.CaseInfo.CaseBasicInfo.CaseTypeId, CaseTypeService.Instance.GetCaseTypeList(), new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnQuickCreateCase" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnQuickCreateCaseCancel" value="取消" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>


