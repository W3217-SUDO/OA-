@using IntellectualProperty.Common
@using IntellectualProperty.Service

@model IntellectualProperty.Mvc.Models.Case.CaseModel

<div class="modal fade" id="caseDeadLineModal" tabindex="-10">
    <div class="modal-dialog" style="width:560px">
        <div class="modal-content" ng-transclude="">
            @using (Html.BeginForm("CaseDeadLine", "Case", FormMethod.Post, new { id = "caseDeadLineForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
            {
                @Html.HiddenFor(m => m.CaseId)
                <div class="modal-header">
                    <button type="button" class="close" id="btnCaseDeadLineClose">×</button>
                    <h5 class="modal-title ng-binding">案件截止日期设定</h5>
                </div>
                <div class="modal-body">
                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger ng-binding">*</span>
                                <span class="ng-binding">截止日期</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.Case.CaseBasicInfo.Deadline, "{0:yyyy-MM-dd}", new { @id = "Case_Deadline", @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", required = "true" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <input class="btn btn-primary ng-binding" type="button" id="btnCaseDeadLine" value="确定" />
                    <input class="btn btn-default ng-binding" type="button" id="btnCaseDeadLineCancel" value="取消" />
                </div>
            }
        </div>
    </div>
</div>

