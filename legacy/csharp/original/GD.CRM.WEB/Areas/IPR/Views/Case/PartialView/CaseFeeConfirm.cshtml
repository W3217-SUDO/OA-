@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseFeeModel

@{
    object htmlAttribute = null;
}

<script type="text/javascript"></script>

<div class="modal fade" id="caseFeeConfirmModal"  >
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseFeeConfirm", "Case", FormMethod.Post, new { id = "caseFeeConfirm", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CaseId)
                    @Html.HiddenFor(m => m.CaseTypeId)
                    @Html.HiddenFor(m => m.CaseNo)
                    @Html.HiddenFor(m => m.CaseFeeId)
                    @Html.HiddenFor(m => m.DefaultCaseFee.FeeItemId)

                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseFeeConfirmClose">×</button>
                        <h5 class="modal-title ng-binding">财务到帐确认</h5>
                    </div>

                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label for="CaseOfficeFeeTypeId" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">费用类型</span>
                                </label>
                                <div class="col-sm-6">

                                    @Html.DropDownListFor(m => m.DefaultCaseFee.FeeTypeId, CaseTypeService.Instance.GetCaseFeeTypeList(Model.CaseTypeId), new { @class = "form-control", @disabled = true })

                                    @*<select id="CaseOfficeFeeTypeId" class="form-control" >
                                            @{
                                                if (Model.CaseFeeTypeList != null)
                                                {
                                                    foreach (var item in Model.CaseFeeTypeList)
                                                    {

                                                        <option value=@item.FeeTypeId>@item.FeeTypeName</option>
                                                    }
                                                }
                                            }
                                        </select>*@

                                </div>
                            </div>
                        </div>
                        
                        <div>
                            <div class="form-group">
                                <label for="CaseOfficeFeeTypeId" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">到账方式</span>
                                </label>
                                <div class="col-sm-6">

                                    @Html.DropDownListFor(m => m.DefaultCaseFee.PaymentBank, BankService.Instance.GetPaymentModeList(), new { @class = "form-control" })

                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="form-group">
                                <label for="Amount" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">需交金额</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.DefaultCaseFee.Amount, new { @class = "form-control", @readonly = true })
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="form-group">
                                <label for="ActualAmount" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">实交金额</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.DefaultCaseFee.ActualAmount, new
                                    {
                                        @class = "form-control",
                                        //@onkeyup = "javascript:this.value=this.value.replace(/\\D/g,'')",
                                        //@onafterpaste = "this.value=this.value.replace(/\\D/g,'')"
                                    })
                                    <div class="help-block ng-scope ng-binding ng-hide">请输入正确的金额</div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="form-group">
                                <label for="IsFeeMitigation" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding"></span>
                                    <span class="ng-binding">到帐日期</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.DefaultCaseFee.GainedDate, "{0:yyyy-MM-dd}", new { @class = "form-control input_time", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", required = "true" })
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseFeeConfirm" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseFeeConfirmCancel" value="取消" />
                    </div>

                }
            </div>
        </div>
    </div>

</div>

