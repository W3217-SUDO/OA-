@{
    ViewBag.Title = "new case";
}

@using Dchien.Legal.Common
@using Dchien.Legal.Web.Areas.IPR.ViewModels.Case
@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseFeeReceiptCustomizedFileUploadModel

<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.index.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/case.createupdate.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bootstrap-treeview.min.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Common/bootstrap-treeview.js")"></script>
<script src="@Url.Content("~/Scripts/IPR/Case/Case.CaseFee.Invoice.Customized.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<style>
    input.input_text, textarea, select, input.input_time {
        border: 1px solid #ccc;
    }

    input.input_text, textarea, input.input_time {
        padding: 2px 0 0px 0px;
    }

    input.input_text, input.input_time {
        background-color: #fff;
    }

    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }

</style>
<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("~/Areas/IPR/Views/CaseFile/CaseFileMenuList.cshtml");

        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body" style="background:#ffffff">
        <div class="console-container ng-scope">
            <div class="row ng-scope">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5 class="ng-binding">发票文件导入</h5>
                            <label>
                                <span class="ng-binding">
                                    文件命名规则 ：根据系统开具的发票号命名的文件(发票号:888888),例:888888.jpg
                                </span>
                            </label>
                        </div>
                    </div>
                    <div class="pull-left margin-top-1 col-sm-12">
                        @using (Html.BeginForm("ContractInvoiceCustomizedFileImport", "CaseFeeInvoice", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-inline ng-valid ng-valid-required" }))
                        {
                          <input id="txtPrimaryFile" style="display:none">
                          <div class="simple-form-field ng-scope ng-isolate-scope">
                                <div class="form-group ng-scope">
                                    <label for="text3" class="control-label">
                                        <span contenteditable="" class="text-danger ng-binding"></span>
                                        <span class="ng-binding">请选择上传文件：</span>
                                    </label>
                                    <div class="form-control-wrap">
                                        <input id="txtFilePath"placeholder="选择一个文件" disabled="disabled" class="form-control ng-pristine ng-valid" style="width: 150px; display: inline-block">
                                        <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px; border: 0px">
                                            <input type="file" value="" id="flZip" name="flFile" style="height: 40px; width: 150px; margin-left: 118px;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="simple-form-field ng-scope ng-isolate-scope">
                                <div class="form-group simple-form-submit ng-scope">
                                    <label class="control-label">
                                        <span class="ng-binding">
                                        </span>
                                    </label>
                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-isolate-scope" type="button" id="btnContractInvoiceFileUpload" value="上传文件" />
                                    </div>
                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-binding" type="button" id="btnContractInvoiceImport" value="开始导入" />
                                    </div>

                                </div>
                            </div>
                            <div ng-transclude=""></div>
                        }
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="">
                        <div class="gridSection" id="invoicegridSection">
                            <table id="tblInvoiceList" class="table table-hover">
                                <colgroup>
                                    <col style="width: 3%">
                                    <col style="width: 10%">
                                    <col style="width: 8%">
                                    <col style="width: 10%">
                                    <col style="width: 6%">
                                    <col style="width: 6%">
                                    <col style="width: 8%">
                                    <col style="width: 6%">
                                    <col style="width: 8%">
                                    <col style="width: 6%">
                                    <col style="width: 10%">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th width="10">
                                            <input type="checkbox" id="chkInvoiceAll" class="ng-pristine ng-valid">
                                        </th>
                                        <th style="text-align: center">请票单号</th>
                                        <th style="text-align: center">合同编号</th>
                                        <th style="text-align: center">客户名称</th>
                                        <th style="text-align: center">开票金额</th>
                                        <th style="text-align: center">高开金额</th>
                                        <th style="text-align: center">发票编号</th>
                                        <th style="text-align: center">领票人</th>
                                        <th style="text-align: center">开票日期</th>
                                        <th style="text-align: center">票据状态</th>
                                        <th style="text-align: center">备注</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="display: none">
                                        <td style="text-align: center"></td>
                                        <td style="text-align: center"></td>
                                        <td style="text-align: center"></td>
                                        <td style="text-align: center"></td>
                                        <td style="text-align: center"></td>
                                        <td style="text-align: center"></td>
                                        <td style="text-align: center"></td>
                                        <td style="text-align: center"></td>
                                        <td style="text-align: center"></td>
                                        <td style="text-align: center"></td>
                                        <td style="text-align: center"></td>
                                    </tr>
                                </tbody>
 
                            </table>
                        </div>
                     
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
