@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Entity
@using Dchien.Legal.Entity.Account

@model Dchien.Legal.Web.Areas.IPR.ViewModels.CaseEvent.CaseEventDisabledModel

<div class="modal fade" id="caseEventDisabledModal" >
        <div class="modal-dialog">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("CaseEventDisabled", "CaseEvent", FormMethod.Post, new { id = "caseEventDisabled", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        <div class="modal-header">
                            <button type="button" class="close" id="btnCaseEventDisabledClose">×</button>
                            <h5 class="modal-title ng-binding">取消提醒</h5>
                        </div>
                        <div class="modal-body">
                            @*<div>
                                <div class="form-group">
                                    <label for="CaseEvent_Deadline" class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">验证码</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.OperatingTime, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", required = "true" })
                                    </div>
                                </div>
                            </div>*@

                            <div>
                                <div class="form-group">
                                    <label for="CaseEvent_EventContent" class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">取消原因</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextAreaFor(m => m.Remark, new { @required = "true", maxlength = 1000, rows = 4, style = "width:120%" })
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnCaseEventDisabledCreate" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" id="btnCaseEventDisabledCancel" value="取消" />

                        </div>
                    }
                </div>
            </div>
        </div>
</div>



