@using Dchien.Legal.Common
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseEventNotInModel

<div class="modal fade" id="caseEventNotInModal" >
    <div class="modal-dialog" style="width:55%">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseEventNotIn", "CaseEvent", FormMethod.Post, new { id = "caseEventNot", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CaseId)
                    @Html.HiddenFor(m => m.CaseNo)

                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseEventNotInClose">×</button>
                        <h5 class="modal-title ng-binding">案件提醒不监控</h5>
                    </div>

                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                @{if (Model.CaseEventTypes != null && Model.CaseEventTypes.Count > 0)
                                {
                                    foreach (var item in Model.CaseEventTypes)
                                    {
                                        var isChecked = Model.EventTypeIds.Contains(item.EventTypeId) ? "checked=" : "";
                                        <div class="col-sm-4" style="padding-left: 20px">
                                            <span>
                                                <input value="@item.EventTypeId" @isChecked id="chkCaseEventTypeId" name="chkCaseEventTypeId" style="vertical-align:middle" type="checkbox"><label for=@("EventTypeId" + @item.EventTypeId)>@item.EventTypeName</label>
                                                </span>
                                            </div>
                                    }
                                }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseEventNotIn" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseEventNotInCancel" value="取消" />
                    </div>

                }
            </div>
        </div>
    </div>

</div>



