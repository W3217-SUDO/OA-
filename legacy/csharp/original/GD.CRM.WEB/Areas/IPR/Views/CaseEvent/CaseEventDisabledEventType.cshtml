@using Dchien.Legal.Common
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.IPR.ViewModels.CaseEvent.CaseEventDisabledEventTypeModel

<div class="modal fade" id="caseEventDisabledEventTypeModal" >
    <div class="modal-dialog" style="width:800px">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseEventDisabledEventType", "CaseEvent", FormMethod.Post, new { id = "CaseEventDisabledEventType", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
       
                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseEventDisabledEventTypeClose">×</button>
                        <h5 class="modal-title ng-binding">取消提醒</h5>
                    </div>

                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                @{if (Model.CaseEventTypes != null && Model.CaseEventTypes.Count > 0)
                                {
                                    foreach (var item in Model.CaseEventTypes)
                                    {
                                        <div class="col-sm-3" style="padding-left: 20px">
                                            <span>
                                                <input value="@item.EventTypeId" checked id="chkCaseEventTypeId" name="chkCaseEventTypeId" style="vertical-align:middle" type="checkbox"><label for=@("EventTypeId" + @item.EventTypeId)>@item.EventTypeName</label>
                                                </span>
                                         </div>
                                    }
                                }
                                }
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="CaseEvent_EventContent" class="col-sm-3 control-label">
                                <span class="text-danger ng-binding">*</span>
                                <span class="ng-binding">取消原因</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextAreaFor(m => m.Remark, new { @required = "true", maxlength = 1000, rows = 4, style = "width:120%" })
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseEventDisabledEventTypeCreate" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseEventDisabledEventTypeCancel" value="取消" />
                    </div>

                }
            </div>
        </div>
    </div>

</div>



