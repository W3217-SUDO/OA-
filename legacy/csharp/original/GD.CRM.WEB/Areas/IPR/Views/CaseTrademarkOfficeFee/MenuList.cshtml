                                @{
                                    var serach = new CaseFeeFileSearchCondition();
                                    serach.UserId = LoginHelper.GetUserName();
                                    serach.AccessLevel = (Dchien.Legal.Entity.Account.AccessLevel)LoginHelper.GetAccesslevel();
                                    serach.FeeTypeIds.Add((int)CaseFeeType.FeeType41001);
                                    serach.PageId = PageId.PageId_1001011001;
                                    //serach.IsTransmitted = false;
                                    serach.IsCashed = false;

