@using SunHold.Legal.Common

@model SunHold.Legal.Web.Areas.IPR.ViewModels.LawFirm.LicenseModel
<div class="modal fade" id="licenseModal">
    
    <style>
        .btn-expense-file-upload input {
            position: absolute;
            top: 0px;
            right: 0px;
            left: 0px;
            bottom: 0px;
            opacity: 0;
            filter: alpha(opacity=0);
            overflow: hidden;
        }
    </style>

    <div class="ng-scope" >
        <div class="modal-dialog" >
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("LicenseUpload", "LawFirm", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.LawFirmId)
                        @Html.HiddenFor(m => m.LawFirmNo)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnUploadingClose">×</button>
                            <h5 class="modal-title ng-binding">上传营业执照</h5>
                        </div>
                        <div style="padding-left:10px;padding-right:10px">
                            <div class="margin-top-2 alert alert-info">
                                <b>提醒：</b><span style="color:#F00" class="ng-binding">重新上传后，原营业执照将被替换。</span>
                            </div>
                        </div>
                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">上传营业执照</span>
                                    </label>
                                    <div class="col-sm-6">
                                        <div class="form-control-wrap">
                                            <input id="txtLicenseFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control ng-valid" style=" display: inline-block">
                                            <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                                <input type="file" value="" id="flLicenseFile" name="flLicenseFile" style="height: 40px; width: 250px; margin-left: 10px;">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer">

                            @*<button >确定</button>*@
                            <input class="btn btn-primary ng-binding" type="button" id="btnUploading" value="确定" />
                            @*<button class="btn btn-default ng-binding" id="btnUploadingCanel" >取消</button>*@
                            <input class="btn btn-default ng-binding" type="button" id="btnUploadingCanel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div><!-- /.modal -->
    </div>
</div>
