@using Dchien.Legal.Service
@using Dchien.Legal.Entity.System;
@using Dchien.Legal.Service.TP;

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseListModel

@{
    var controller = ViewContext.RouteData.Values["controller"].ToString().ToLower();
    var action = ViewContext.RouteData.Values["action"].ToString().ToLower();
    var id = string.Empty;
    if (ViewContext.RouteData.Values.ContainsKey("id"))
    {
        id = ViewContext.RouteData.Values["id"].ToString().ToLower();
    }
    var actived = "active";

}

<script type="text/javascript">

</script>
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<script src="@Url.Content("~/Scripts/IPR/Case/Case.List.Search.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/IPR/Case/Case.List.AnnualYearFeeList.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
                Html.RenderPartial("AnnualYearFeeMenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>案件列表</h5>
                            </div>
                        </div>
                        <div class="pull-left margin-top-1 col-sm-12" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm" action="@Url.Content("~/IPR/PatentCaseList/List")">
                                @Html.HiddenFor(m => m.SearchCondition.PageId, new { name = "PageId" })
                                @Html.HiddenFor(m => m.SearchCondition.PageName, new { name = "PageName" })
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                                @Html.HiddenFor(m => m.SearchCondition.BusinessOwnerName)
                                <table class="search_table" style="width: 100%">
                                    <colgroup>
                                        <col style="width: 80px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 85px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px;" />
                                        <col style="width: 80px;" />
                                        <col style="width: 80px;" />
                                        <col style="width: 80px;" />
                                        <col>
                                    </colgroup>
                                    <tr>
                                        <th>
                                            客户名称：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CustomerName, new { @class = "form-control", @placeholder = "客户名称" })
                                        </td>
                                        <th>
                                            案号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseNos, new { @class = "form-control", @placeholder = "案号", @style = "" })
                                        </td>
                                        <th>
                                            案件类型：
                                        </th>
                                        <td>
                                            @Html.HiddenFor(m => m.SearchCondition.CaseTypeId)
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseTypeName, new { @class = "form-control", @placeholder = "案件类型", @style = "" })
                                        </td>

                                    </tr>

                                    <tr>
                                        <th>
                                            案件阶段：
                                        </th>
                                        <td>
                                            @Html.HiddenFor(m => m.SearchCondition.CasePhaseId)
                                            @Html.TextBoxFor(m => m.SearchCondition.CasePhaseName, new { @class = "form-control", @placeholder = "案件阶段", @style = "" })
                                        </td>
                                        <th>
                                            撰稿人：
                                        </th>
                                        <td>
                                            @*@Html.HiddenFor(m => m.SearchCondition.CaseCopywriterName)*@
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseCopywriterName, new { @class = "form-control", @placeholder = "撰稿人", @style = "" })
                                        </td>
                                        <th>
                                            代理人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseProcuratorName, new { @class = "form-control", @placeholder = "代理人", @style = "" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>
                                            案源人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseOriginPeopleName, new { @class = "form-control", @placeholder = "案源人", @style = "" })
                                        </td>
                                       
                                        <th>
                                            申请日：
                                        </th>
                                        <td colspan="2">
                                            @if (Model.SearchCondition.PageId == PageId.PageId_1001015001)
                                            {
                                                @Html.TextBoxFor(m => m.SearchCondition.CaseRequestDateFrom, "{0:yyyy-MM-dd}",
                                                             new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                                <span>-</span>

                                                @Html.TextBoxFor(m => m.SearchCondition.CaseRequestDateTo, "{0:yyyy-MM-dd}",
                                                             new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(m => m.SearchCondition.CaseRequestDateFrom, "{0:yyyy-MM-dd}",
                                                             new { @class = "input_time form-control",  @readonly=true, @style = "width:100px" })
                                                 
                                                <span>-</span>

                                                @Html.TextBoxFor(m => m.SearchCondition.CaseRequestDateTo, "{0:yyyy-MM-dd}",
                                                             new { @class = "input_time form-control",  @readonly = true, @style = "width:100px" })
                                            }
                                        </td>
                                        <td colspan="3">
                                            @*<label class="control-label">
                                                @Html.CheckBoxFor(m => m.SearchCondition.SearchByMonthAndDay, new { @disabled = true, style = "vertical-align:middle" })<span class="">按月日</span>
                                            </label>*@

                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnCaseAnnualYearFeeSearch">
                                                <span>过滤</span>
                                            </a>
                                            <a href="javascript:void(0);" class="btn btn-default " id="btnCaseSearchReset">
                                                <span>重置</span>
                                            </a>
                                        </td>

                                        @*<td colspan="3">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnCaseAnnualYearFeeSearch">
                                                <span>过滤</span>
                                            </a>
                                            <a href="javascript:void(0);" class="btn btn-default " id="btnCaseSearchReset">
                                                <span>重置</span>
                                            </a>
                                        </td>*@
                                    </tr>

          

                                </table>
                                <div class='divcaseconditioncasephases'></div>
                                <div class='divcaseconditioncasetypes'></div>
                                <div class="i_common_select" id="divAssociateUserList" style="display: none;">
                                    <div class="i_common_wrap">
                                        <div class="i_common_list"></div>
                                    </div>
                                </div>
                                <div style="display: none;" id="divUserList">
                                    @Html.Partial("~/Areas/IPR/Views/IPRBase/UserList.cshtml")
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="">
                            <div class="gridSection">
                                <table id="tblCaseList" class="table table-hover">
                                    <colgroup>
                                        <col style="width: 2%">
                                        <col style="width: 12%">
                                        <col style="width: 18%">
                                        <col style="width: 8%">
                                        <col style="width: 7%">
                                        <col style="width: 7%">
                                        <col style="width: 5%">
                                        <col style="width: 5%">
                                        <col style="width: 15%">
                                      
                                        <col style="width: 8%">
                              
                                        <col style="width: 6%">
                                        <col style="width: 4%">
                                        <col style="width: 8%">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th width="10">
                                                <input type="checkbox" id="chkCaseAll" class="ng-pristine ng-valid">
                                            </th>
                                            <th style="text-align: center">申请人</th>
                                            <th style="text-align: center">专利名称</th>
                                            <th style="text-align: center">案件类型</th>
                                            <th style="text-align: center">案件编号</th>
                                            <th style="text-align: center">申请号</th>
                                            <th style="text-align: center">申请日</th>
                                            <th style="text-align: center">授权日</th>
                                            <th style="text-align: center">年度</th>
                                            <th style="text-align: center">100%/85%/70%</th>
                                            <th style="text-align: center">本案需缴金额</th>
                                            <th style="text-align: center">本案比例</th>
                                            <th style="text-align: center">本案通/回/付)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td>
                                                &nbsp;
                                            </td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="" style="display: none">
                                        <tr>
                                            <td width="1">
                                                <input type="checkbox" id="chkCaseAll">
                                            </td>
                                            <td colspan="12">
                                                <div class="pull-left">
                                                    <input type="button" id="btnCaseAnnualYearExportToExcel" class="btn btn-default" style="height:32px" value="生成年费清单" />
                                                    <input type="button" id="btnCaseAnnualYearEdit" class="btn btn-default" style="height:32px" value="修改首年度及缓减比例" />
                                                </div>
                                                <div class="">
                                                    <div class="pull-right page-box Caselist">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>


                            </div>
                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="i_common_select" id="div_customer" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

     
    </div>
</div>
