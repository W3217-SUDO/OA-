                @*<li id="push">多案件批量处理</li>*@
                <li id="fileImport">多案件上传文档</li>

                @if (CommonService.Instance.CheckPermission((int)Dchien.Legal.Entity.Account.Permission.CreateCaseEvent))
                {
                    <li id="addEvent">新增自定义提醒</li>
                }
                @if (CommonService.Instance.CheckPermission((int)Dchien.Legal.Entity.Account.Permission.DeleteCaseEvent))
                {
                    <li id="removeEvent">删除自定义提醒</li>
                }
                @{
                    if (id == PageId.PageId_1001001010)
                    {
                        <li id="addInAfm">加入年费监控</li>
                        <li id="removeAfm">放弃年费监控</li>

                        
                    }

                    if (id == PageId.PageId_1001001011)
                    {
                        <li id="removeAfm">放弃年费监控</li>
                    }

                    if (id == PageId.PageId_1001001004)
                    {
                        <li id="taskFinished">标记已处理</li>
