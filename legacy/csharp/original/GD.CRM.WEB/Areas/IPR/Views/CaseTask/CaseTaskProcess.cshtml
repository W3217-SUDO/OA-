@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.TP;
@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseTaskModel

<div class="modal fade" id="caseTaskModal" >
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            @using (Html.BeginForm("CaseTask", "Case", FormMethod.Post, new { id = "caseTaskForm",  @class = "form-horizontal ng-invalid ng-invalid-required" }))
            {
                <div class="modal-header">
                    <button type="button" class="close" id="btnCaseTaskClose">×</button>
                    <h5 class="modal-title ng-binding">案件任务</h5>
                </div>
                <div class="modal-body">

                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger ng-binding">*</span>
                                <span class="ng-binding">任务标题</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.CaseTask.TaskTitle,  new { @autocomplete = "off", @disabled=true, @class = "form-control" })
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger ng-binding">*</span>
                                <span class="ng-binding">优先级</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.DropDownListFor(m => m.CaseTask.TaskPriority, CaseTaskService.Instance.GetCaseTaskPriorityList(), new { @class = "form-control", @disabled = true})
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger ng-binding">*</span>
                                <span class="ng-binding">开始日期</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.CaseTask.TaskBeginTime, "{0:yyyy-MM-dd}", new {  @autocomplete = "off", @class = "input_time form-control", @disabled = true, onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", required = "true" })
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger ng-binding">*</span>
                                <span class="ng-binding">结束日期</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.CaseTask.TaskEndTime, "{0:yyyy-MM-dd}", new { @autocomplete = "off", @class = "input_time form-control", @disabled = true, onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", required = "true" })
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="form-group">
                            <label  class="col-sm-3 control-label">
                                <span class="text-danger ng-binding"></span>
                                <span class="ng-binding">任务内容</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextAreaFor(m => m.CaseTask.TaskContent, new { @required = "true", maxlength = 1000, rows = 4, @disabled = true, style = "width:120%" })
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger ng-binding"></span>
                                <span class="ng-binding">处理备注</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextAreaFor(m => m.CaseTask.TaskContent, new { @required = "true", maxlength = 1000, rows = 4, style = "width:120%" })
                            </div>
                        </div>
                    </div>

                </div>
                
                <div class="modal-footer">
                    <input class="btn btn-primary ng-binding" type="button" id="btnCaseTaskFinished" value="完成" />
                    <input class="btn btn-primary ng-binding" type="button" id="btnCaseTaskRejected" value="拒绝" />
                    <input class="btn btn-default ng-binding" type="button" id="btnCaseTaskCancel" value="取消" />
                </div>
            }
        </div>
 
    </div>
    

</div>

