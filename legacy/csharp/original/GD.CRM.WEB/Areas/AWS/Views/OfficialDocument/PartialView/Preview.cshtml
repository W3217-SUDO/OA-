<div class="slide-panels">
    <div class="slide-panel active medium">
        <div class="slide-panel-content">
            <div class="panel-header">
                <h5>用印查看</h5>
                <a class="panel-close" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');">
                    <i class="next-icon next-icon-close next-small" style="font-size: 0px;">close</i>
                </a>
                <div class="head-custom"></div>
            </div>
            <div class="placeholder">...</div>
            <div class="panel-body">
                <div class="panel-body-content">
                    <div class="page-overview-panel-apply">
                        <div ui-view="myTicket">
                            <div class="ticket-detail ">

                                <div role="grid" class="next-form next-medium">
                                    @Html.HiddenFor(m => m.OfficialDocument.Basic.OfficialDocumentNo)
                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label >用印类型：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-text-align">
                                            <label >@Html.DisplayTextFor(m => m.OfficialDocument.Basic.OfficialDocumentTypeName)</label>
                                        </div>
                                    </div>

                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label >合同编号：</label>
                                        </div>
                                        <div class="next-col next-col-18  next-form-text-align">
                                                @Html.DisplayTextFor(m => m.OfficialDocument.Basic.ContractNo)
                                        </div>
                                    </div>

                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label >客户编号：</label>
                                        </div>
                                        <div class="next-col next-col-18  next-form-text-align">
                                                @Html.DisplayTextFor(m => m.OfficialDocument.Basic.CustomerNo)
                                        </div>
                                    </div>
                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label >客户名称：</label>
                                        </div>
                                        <div class="next-col next-col-18  next-form-text-align">
                                                @Html.DisplayTextFor(m => m.OfficialDocument.Basic.CustomerName)
                                        </div>
                                    </div>
                                    <div class="s_st next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label >是否电章：</label>
                                        </div>
                                        <div class="next-col next-col-18  next-form-text-align">
                                            @(Model.OfficialDocument.Basic.IsElectronicSeal ? "是" : "否")
                                        </div>
                                        
                                    </div>

                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label >印章类型：</label>
                                        </div>
                                        <div class="next-col next-col-18  next-form-text-align">
                                                @Html.DisplayTextFor(m => m.OfficialDocument.Basic.SealTypeName)
                                        </div>
                                         
                                    </div>
                                    <div class="s_st next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label >是否打印盖章：</label>
                                        </div>
                                        <div class="next-col next-col-18  next-form-text-align">
                                            @(Model.OfficialDocument.Basic.IsOfflinePrint ? "需要" : "不需要")
                                        </div>
                                    </div>

                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label>盖章份数：</label>
                                        </div>
                                        <div class="next-col next-col-18  next-form-text-align">
                                                @Html.DisplayTextFor(m => m.OfficialDocument.Basic.PrintQuantity)
                                        </div>
                                    </div>


                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label>用印备注：</label>
                                        </div>
                                        <div class="next-col next-col-18  next-form-text-align">
                                                @Html.DisplayTextFor(m => m.OfficialDocument.Basic.Remark)
                                        </div>
                                    </div>
                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label>用印文件：</label>
                                        </div>
                                        <div class="next-col next-col-18  next-form-text-align">
                                            <div id="attachments">
                                                @if (Model.OfficialDocument.OfficialDocumentFileList != null && Model.OfficialDocument.OfficialDocumentFileList.Any())
                                                {
                                                    foreach (var file in Model.OfficialDocument.OfficialDocumentFileList)
                                                    {
                                                        <a href="javascript:void(0);" onclick="javascript:officialDocument.OfficialDocuments.OfficialDocument.Files.File.View('@file.FileId','@file.OfficialDocumentGuid', '@file.FileName')">@file.FileName</a>
                                                    }
                                                }
                                                else
                                                {
                                                    <label>无</label>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="panel-footer">
                <div class="btn-con">


                    <input type="button" class="btn  btn-normal" style="border-radius: 0;
                                                                        padding: 0 16px;
                                                                        height: 32px;
                                                                        line-height: 30px;
                                                                        font-size: 12px;
                                                                        border-width: 1px;" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');" value="关闭" />
                </div>
            </div>
        </div>
    </div>
</div>


