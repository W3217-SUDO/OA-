@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.FAM.ViewModels.AR.DetailsModel


<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />

<script src="@Url.Content("~/Scripts/FAM/AR/FAM.AR.Detail.List.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("MenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>应收账款明细</h5>
                            </div>

                        </div>
                        <div class="pull-left margin-top-1 col-sm-12">

                            <form class="form-inline ng-valid " id="postForm" action="@Url.Content("~/FAM/AR/List")">
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                                <div class="simple-form-field">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">客户名称：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.CustomerName, new { @class = "form-control", @placeholder = "客户名称", @style = "" })
                                        </div>
                                    </div>

                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">合同编号：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.ContractNo, new { @class = "form-control", @placeholder = "合同编号", @style = "" })

                                        </div>
                                    </div>


                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span class="">合同日期：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.ContractBeginDate, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </div>

                                        <label class="control-label">
                                            <span class="">-</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.ContractEndDate, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </div>

                                    </div>
                                </div>
                                <div class="simple-form-field  ">
                                    <div class="form-group  ">
                                        <label class="  control-label">
                                            <span class="">
                                            </span>
                                        </label>
                                        <div class="form-control-wrap text-right">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnSearch">
                                                <span>查询</span>
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="">
                            
                            <div class="gridSection" >
                                <table id="tblARListHeader" class="table table-hover" style="width:100%; margin-bottom: 0px;">
                                    <colgroup>
                                        <col style="width: 10%" />
                                        <col style="width: 13%" />
                                        <col style="width: 8%" />
                                        <col style="width: 10%" />
                                        <col style="width: 8%" />
                                        <col style="width: 8%" />
                                        <col style="width: 8%" />
                                        <col style="width: 8%" />
                                        <col style="width: 8%" />
                                        <col style="width: 8%" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th style="text-align: center">合同号</th>
                                            <th style="text-align: center">客户名称</th>
                                            <th style="text-align: center">案号</th>
                                            <th style="text-align: center">应到总结额</th>
                                            <th style="text-align: center">应收帐款</th>
                                            <th style="text-align: center">应收官费</th>
                                            <th style="text-align: center">应收代理费</th>
                                            <th style="text-align: center">回款累计</th>
                                            <th style="text-align: center">案源人</th>
                                            <th style="text-align: center">合同日期</th>
                                        </tr>

                                    </thead>
                                </table>
                                <div id='divContextList' style="height: 555px; overflow-y: auto; margin-top: -1px; overflow-x: hidden; overflow-y: auto; ">
                                    <table id="tblARList" class="table table-hover" style=' width:100%; margin-top: -1px; margin-bottom: 0px;'>
                                        <colgroup>
                                            <col style="width: 10%" />
                                            <col style="width: 13%" />
                                            <col style="width: 8%" />
                                            <col style="width: 10%" />
                                            <col style="width: 8%" />
                                            <col style="width: 8%" />
                                            <col style="width: 8%" />
                                            <col style="width: 8%" />
                                            <col style="width: 8%" />
                                            <col style="width: 8%" />
                                        </colgroup>

                                        <tbody>
                                            <tr style="display: none">
                                                <td>
                                                    &nbsp;
                                                </td>
                                                <td style="text-align: left"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                            </tr>
                                        </tbody>
                                        <tfoot class="" style="display: none">
                                            <tr>
                                                <td colspan="10">
                                                    <div class="pull-left"></div>
                                                    <div class="">
                                                        <div class="pull-right page-box ARCaseFeelist">
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                                </div>
                            <div class="simple-grid-none-data-wrap" style="display:none">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="i_common_select" id="div_customer" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>

                    <div class='divcaseconditioncasephases'></div>
                </div>
            </div>
        </div>
    </div>
</div>

