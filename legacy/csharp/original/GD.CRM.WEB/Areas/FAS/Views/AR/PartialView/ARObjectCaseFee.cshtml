@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case

@model Dchien.Legal.Web.Areas.FAM.ViewModels.AR.ARObjecCaseFeeModel

<script type="text/javascript"></script>

<div class="modal fade" id="ARObjectCaseFeeModal">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("ARObjectCaseFee", "AR", FormMethod.Post, new { id = "ARObjectCaseFee", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CaseId)

                    <div class="modal-header">
                        <button type="button" class="close" id="btnARObjectCaseFeeClose">×</button>
                        <h5 class="modal-title ng-binding">费用信息</h5>
                    </div>

                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label for="CaseOfficeFeeTypeId" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">费用类型</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.DropDownListFor(m => m.CaseFeeTypeId, CaseTypeService.Instance.GetCaseFeeTypeList(Model.CaseFeeTypeId), new { @class = "form-control", @disabled = true })
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="form-group">
                                <label for="Amount" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">金额</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", @readonly = true })
                                </div>
                            </div>
                        </div>

                        <div class="yearly" >
                            
                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">年限:</span>
                                </label>
                                <div class="col-sm-6">
                                    @*@Html.TextBoxFor(m => m.DefaultCaseFee.Yearly, new
                {
                    @class = "form-control",
                    @onkeyup = "javascript:this.value=this.value.replace(/\\D/g,'')",
                    @onafterpaste = "this.value=this.value.replace(/\\D/g,'')"
                })*@
                                    <select class="form-control" id="Case_CaseFeeInformYearly" name="Case.CaseFeeInformYearly" unselectable="on">
                                        @{
                    if (Model.CaseRequestDate.HasValue)
                    {
                        for (var i = 1; i <= 20; i++)
                        {
                            <option value="@i" annualfrom="@Model.CaseRequestDate.Value.AddYears(i - 1).ToString("yyyy-MM-dd")" annualend="@Model.CaseRequestDate.Value.AddYears(@i).AddDays(-1).ToString("yyyy-MM-dd")">第 @i 年度 @Model.CaseRequestDate.Value.AddYears(i - 1).ToString("yyyy-MM-dd") ~ @Model.CaseRequestDate.Value.AddYears(@i).AddDays(-1).ToString("yyyy-MM-dd")</option>
                        }
                    }
                    else
                    {
                        <option value="">该案件未有申请日，不存在年费.</option>
                    }
                                        }
                                    </select>
                                </div>
                            </div>



                            </div>
                        
                        <div class="yearly">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">是否首年:</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.CheckBoxFor(m => Model.IsFirstYear, new { @class = "form-control", style = "height: 20px;width: 20px" })
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnARObjectCaseFee" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnARObjectCaseFeeCancel" value="取消" />
                    </div>

                }
            </div>
        </div>
    </div>
</div>


