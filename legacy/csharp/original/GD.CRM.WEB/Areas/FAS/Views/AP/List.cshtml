@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.FAS.ViewModels.AP.ListModel


<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />

@*<script src="@Url.Content("~/Scripts/IPR/Case/Case.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>*@
<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("MenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>应付款申请</h5>
                            </div>

                        </div>
                        <div class="pull-left margin-top-1 col-sm-12">

                            <form class="form-inline ng-valid " id="postForm" action="@Url.Content("~/FAS/AP/List")">
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                                <div class="simple-form-field">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">案号：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.CustomerNo, new { @class = "form-control", @placeholder = "案号", @style = "" })
                                        </div>
                                    </div>

                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">合同编号：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.ContractNo, new { @class = "form-control", @placeholder = "合同编号", @style = "" })

                                        </div>
                                    </div>
                                    
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">客户名称：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.CustomerName, new { @class = "form-control", @placeholder = "客户名称", @style = "" })
                                        </div>
                                    </div>


                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span class="">提交日期：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.SubmitDateStart, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </div>

                                        <label class="control-label">
                                            <span class="">-</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.SubmitDateEnd, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </div>

                                    </div>
                                    
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span class="">状态：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.InvoiceStatus, new { @class = "form-control", @placeholder = "状态", @style = "" })
                                        </div>
                                    </div>

                                    
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span class="">提交人：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.Submitter, new { @class = "form-control", @placeholder = "提交人", @style = "" })
                                        </div>
                                    </div>

                                </div>
                                <div class="simple-form-field  ">
                                    <div class="form-group  ">
                                        <label class="  control-label">
                                            <span class="">
                                            </span>
                                        </label>
                                        <div class="form-control-wrap text-right">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnSearch">
                                                <span>查询</span>
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="">
                            <div class="gridSection">
                                <table id="tblARList" class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th width="10">
                                                <input type="checkbox" id="chkARAll" class="ng-pristine ng-valid">
                                            </th>
                                            <th style="text-align: center">费用类型</th>
                                            <th style="text-align: left">金额</th>
                                            <th style="text-align: center">案件号</th>
                                            <th style="text-align: center">合同号</th>
                                            <th style="text-align: center">提交人</th>
                                            <th style="text-align: center">到账时间</th>
                                            <th style="text-align: center">到账金额</th>
                                            <th style="text-align: center">确认人</th>
                                            <th style="text-align: center">支付时间</th>
                                            <th style="text-align: center">支付金额</th>
                                            <th style="text-align: center">票据号</th>
                                            <th style="text-align: center">上传人</th>
                                         </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td>
                                                &nbsp;
                                            </td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                         </tr>
                                    </tbody>
                                    <tfoot class="" style="display: none">
                                        <tr>
                                            <td colspan="13">
                                                <div class="pull-left"></div>
                                                <div class="">
                                                    <div class="pull-right page-box Caselist">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="i_common_select" id="div_customer" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>

                    <div class='divcaseconditioncasephases'></div>
                </div>
            </div>
        </div>

        <div class="contextMenu" id="batchEditMenu" style="display: none;">
            <ul>
                <li id="batchEdit">批量修改</li>
                <li id="caseFileBatchImport">批量导入文件</li>
            </ul>
        </div>
    </div>
</div>

