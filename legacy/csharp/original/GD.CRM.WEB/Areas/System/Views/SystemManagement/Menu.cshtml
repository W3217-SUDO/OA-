@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.System.ViewModels.SystemManagement.MenuModel

@{
    object htmlAttribute = null;
}

<script type="text/javascript"></script>

<div class="modal fade" id="menuModal" >
  
        <div class="modal-dialog" style="width:560px">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("Menu", "SystemManagement", FormMethod.Post, new { id = "Menu", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.MenuId)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnMenuClose">×</button>
                            <h5 class="modal-title ng-binding">菜单维护</h5>
                        </div>

                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label for="Menu_MenuName" class="col-sm-4 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">菜单名称</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.Menu.MenuName, new { @class = "form-control" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="Menu_MenuDesc" class="col-sm-4 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">菜单名称描述</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.Menu.Comments, new { @class = "form-control" })
                                    </div>
                                </div>

                            </div>

                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnMenu" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" id="btnMenuCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div><!-- /.modal -->
   
</div>

