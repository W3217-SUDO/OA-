@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.System.ViewModels.SystemManagement.ConfigSettingListModel

<script src="@Url.Content("~/Scripts/System/SystemManagement/ConfigAppSetting.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        @{
            Html.RenderPartial("List");
        }
    </div>
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>

    <div class="viewFramework-product-body">
        <div class="console-container ng-scope">
            <div class="row ng-scope">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5>系统配置</h5>
                        </div>
                        <div class="pull-right">
                        </div>
                    </div>
                    <div class="pull-left margin-top-1 col-sm-12">
                        <form id="postForm" action="@Url.Content("~/System/SystemManagement/ConfigAppSettingList")">
                            @Html.HiddenFor(m => m.PageNo, new { name = "PageSize" })
                            @Html.HiddenFor(m => m.PageSize, new { name = "PageNo" })
                        </form>
                    </div>

                </div>
                <div class="col-sm-12">
                    <div class="ng-scope">

                        <div class="gridSection">
                            <table id="tblAppSettingList" class="table table-hover">
                                <colgroup>
                                    <col style="width: 5%" />
                                    <col style="width: 15%" />
                                    <col style="width: 15%" />
                                    <col style="width: 15%" />
                                    <col style="width: 15%" />
                                    <col style="width: 10%" />
                                    
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>序号</th>
                                        <th>配置项组</th>
                                        <th>配置项名称</th>
                                        <th>配置项主键</th>
                                        <th>键值</th>
                                        <th>是否可用</th>
                                       
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="display: none">
                                        <td>
                                            &nbsp;
                                        </td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                       

                                    </tr>
                                </tbody>
                                <tfoot class="ng-scope" style="display: none">
                                    <tr>
                                        <td colspan="6">
                                            <div class="pull-left"></div>
                                            <div class="ng-scope">
                                                <div class="pull-right page-box appSetting">

                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="simple-grid-none-data-wrap">
                            <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                                <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                    <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                    <div class="text-size-16 tip-text inline-block">
                                        <span class="margin-left ng-binding" ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                        <span class="ng-binding">。</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>

</div>
