        <div class="ng-isolate-scope"></div>

        <div class="product-nav-list">
            <ul class="top-level">


                @{ actived = action == "CaseTypeList".ToLower() ? "class=active" : "";}
                <li @actived>
                    <div class="ng-isolate-scope">

                        <a href=@Url.Content(string.Format("~/{0}/System/SystemCenter/CaseTypeList", PageId.PageId_7001005)) class="ng-scope">
                            <div class="nav-icon"></div>
                            <div class="nav-title ng-binding">案件类型</div>
                        </a>
                    </div>
                </li>


                @{ actived = action == "CaseFeeTypeList".ToLower() ?  "class=active" : "";}
