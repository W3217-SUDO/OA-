@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.System.ViewModels.SystemCenter.NotaryOfficeModel

<div class="modal fade" id="NotaryOfficeModal">
  
        <div class="modal-dialog">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("NotaryOffice", "SystemCenter", FormMethod.Post, new { id = "NotaryOffice", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.NotaryOffice.NotaryOfficeId)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnNotaryOfficeClose">×</button>
                            <h5 class="modal-title ng-binding">公证处</h5>
                        </div>
 
                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label for="NotaryOffice_NotaryOfficeName" class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">公证处名称:</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.NotaryOffice.NotaryOfficeName, new { @class = "form-control"})
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="NotaryOffice_NotaryOfficeName" class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">公证处代码:</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.NotaryOffice.NotaryOfficeCode, new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="NotaryOffice_DistrictCode" class="col-sm-3 control-label">

                                        <span class="ng-binding">公证书样号:</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.NotaryOffice.TemplateName, new { @class = "form-control" })
                                    </div>
                                </div>
      
                            </div>
                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnNotaryOffice" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" id="btnNotaryOfficeCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div><!-- /.modal -->
    
</div>

