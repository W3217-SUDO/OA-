@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.System.ViewModels.SystemCenter.CaseType.CaseFileTypeCaseFeeTypeListModel

@{
    object htmlAttribute = null;
}

<script  type="text/javascript"></script>

<div class="modal fade" id="CaseFeeTypeModal" >
    
        <div class="modal-dialog" style="width:50%">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("CaseFileTypeCaseFeeTypeList", "SystemCenter", FormMethod.Post, new { id = "CaseFileType", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m =>m.CaseFileTypeId)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnCaseFeeTypeClose">×</button>
                            <h5 class="modal-title ng-binding">关联费用类型</h5>
                        </div>
                        
                        @*<div style="padding-left:10px;padding-right:10px">
                                <div class="margin-top-2 alert alert-info">
                                    <b>提醒：</b><span style="color:#F00" class="ng-binding"></span>
                                </div>
                            </div>*@

                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    @{if (Model.CaseFeeTypesAll != null && Model.CaseFeeTypesAll.Count > 0)
                                      {
                                          foreach (var item in Model.CaseFeeTypesAll)
                                          {
                                              var isChecked = Model.CaseFeeTypes.Contains(item.FeeTypeId) ? "checked=" : "";
                                              <div class="col-sm-4" style="padding-left: 60px">
                                                  <span>
                                                      <input value="@item.FeeTypeId" @isChecked id="chkCaseFeeTypeId" name="chkCaseOfficeFeeTypeId" style="vertical-align:middle" type="checkbox"><label for=@("CaseOfficeFeeTypeId" + @item.FeeTypeId)>@item.FeeTypeName</label>
                                                  </span>
                                              </div>
                                          }
                                      }
                                    }
                                </div>
                            </div>
                        </div>
                        
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnCaseFeeTypeCreate" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" id="btnCaseFeeTypeCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div><!-- /.modal -->
   
</div>

