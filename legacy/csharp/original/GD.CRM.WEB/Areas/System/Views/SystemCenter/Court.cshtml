@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.System.ViewModels.SystemCenter.CourtModel

<div class="modal fade" id="CourtModal">
  
        <div class="modal-dialog">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("Court", "SystemCenter", FormMethod.Post, new { id = "Court", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.Court.CourtId)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnCourtClose">×</button>
                            <h5 class="modal-title ng-binding">法院名称</h5>
                        </div>
 
                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label for="Court_CourtName" class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">法院名称:</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.Court.CourtName, new { @class = "form-control"})
                                    </div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="Court_CourtCode" class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">法院代码:</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.Court.CourtCode, new
                                   {
                                       @onkeyup = "javascript:this.value=this.value.replace(/\\D/g,'')",
                                       @onafterpaste = "this.value=this.value.replace(/\\D/g,'')",
                                       @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnCourt" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" id="btnCourtCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div><!-- /.modal -->
    
</div>

