@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.System.ViewModels.SystemCenter.CaseFileType.CaseTypeListModel

@{
    object htmlAttribute = null;
}

<script type="text/javascript"></script>

<div class="modal fade" id="CaseTypeModal" >
   
        <div class="modal-dialog" style="width:50%">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("CaseFileTypeCaseTypeList", "SystemCenter", FormMethod.Post, new { id = "CaseType", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.CaseFileTypeId)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnCaseTypeClose">×</button>
                            <h5 class="modal-title ng-binding">关联案件类型</h5>
                        </div>
                        
                        @*<div style="padding-left:10px;padding-right:10px">
                                <div class="margin-top-2 alert alert-info">
                                    <b>提醒：</b><span style="color:#F00" class="ng-binding"></span>
                                </div>
                            </div>*@

                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    @{if (Model.CaseTypesAll != null && Model.CaseTypesAll.Count > 0)
                                      {
                                          foreach (var item in Model.CaseTypesAll)
                                          {
                                              var isChecked = Model.CaseTypes.Contains(item.CaseTypeId) ? "checked=" : "";
                                              <div class="col-sm-4" style="padding-left: 60px">
                                                  <span>
                                                      <input value="@item.CaseTypeId" @isChecked id="chkCaseTypeId" name="chkCaseTypeId" style="vertical-align:middle" type="checkbox"><label for=@("CaseTypeId" + @item.CaseTypeId)>@item.CaseTypeName</label>
                                                  </span>
                                              </div>
                                          }
                                      }
                                    }
                                </div>
                            </div>
                        </div>
                        
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnCaseTypeCreate" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" id="btnCaseTypeCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div><!-- /.modal -->
  
</div>

