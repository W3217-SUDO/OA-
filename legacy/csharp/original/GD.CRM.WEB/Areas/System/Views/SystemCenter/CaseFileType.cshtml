@using Dchien.Legal.Common


@model Dchien.Legal.Web.Areas.System.ViewModels.SystemCenter.CaseFileType.CaseFileTypeModel

<script type="text/javascript"></script>

<div class="modal fade" id="caseFileTypeModal" >
    
        <div class="modal-dialog" style="width:560px">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("CaseFileType", "SystemCenter", FormMethod.Post, new { id = "CaseFileType", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.CaseFileType.FileTypeId)
                        @Html.HiddenFor(m => m.IsNew)
                        <div class="modal-header">
                            <button type="button" class="close" id="btnCaseFileTypeClose">×</button>
                            <h5 class="modal-title ng-binding">类型名称</h5>
                        </div>

                        <div class="modal-body">
                            <div>
                                @if (Model.CaseFileTypeId.HasValue)
                                {
                                    <div class="form-group">
                                        <label for="CaseFileType_DirId" class="col-sm-4 control-label">
                                            <span class="text-danger ng-binding">*</span>
                                            <span class="ng-binding">类型ID</span>
                                        </label>
                                        <div class="col-sm-6">
                                            @Html.TextBoxFor(m => m.CaseFileTypeId, new
                                       {
                                           @readonly = true,
                                           @maxlength = "7",
                                           @class = "form-control",
                                           @onkeyup = "javascript:this.value=this.value.replace(/\\D/g,'')",
                                           @onafterpaste = "this.value=this.value.replace(/\\D/g,'')",
                                           @placeholder = "小于7位数字类型."
                                       })
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="form-group">
                                        <label for="CaseFileType_DirId" class="col-sm-4 control-label">
                                            <span class="text-danger ng-binding">*</span>
                                            <span class="ng-binding">类型ID</span>
                                        </label>
                                        <div class="col-sm-6">
                                            @Html.TextBoxFor(m => m.CaseFileTypeId, new
                                       {
                                           @maxlength = "7",
                                           @class = "form-control",
                                           @onkeyup = "javascript:this.value=this.value.replace(/\\D/g,'')",
                                           @onafterpaste = "this.value=this.value.replace(/\\D/g,'')",
                                           @placeholder = "小于7位数字类型."
                                       })
                                        </div>
                                    </div>
                                }


                                <div class="form-group">
                                    <label for="CaseFileType_FileTypeName" class="col-sm-4 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">类型名称</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.CaseFileType.FileTypeName, new { @class = "form-control" })
                                    </div>
                                </div>


                                <div class="form-group">
                                    <label for="CaseFileType_CanBatchUpload" class="col-sm-4 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">案件类型</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.DropDownListFor(m => m.CaseFileType.CaseTypeId, CaseFileTypeService.Instance.GetCaseTypeList(), new { @class = "form-control", @style = "width:100%" })
                                    </div>
                                </div>


                                <div class="form-group">
                                    <label for="CaseFileType_CanBatchUpload" class="col-sm-4 control-label">
                                        <span class="text-danger ng-binding"></span>
                                        <span class="ng-binding">不可重复上传</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.CheckBoxFor(m => m.CaseFileType.CanBatchUpload, new { @style = "height: 32px;width: 10%;font-size: 12px" })
                                    </div>
                                </div>

                                
                                <div class="form-group">
                                    <label for="CaseFileType_IsTransformed" class="col-sm-4 control-label">
                                        <span class="text-danger ng-binding"></span>
                                        <span class="ng-binding">是否专文文档</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.CheckBoxFor(m => m.CaseFileType.IsTransformed, new { @style = "height: 32px;width: 10%;font-size: 12px" })
                                    </div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="CaseFileType_TransformedFileName" class="col-sm-4 control-label">
                                        <span class="text-danger ng-binding"></span>
                                        <span class="ng-binding">转文模板文件名</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.CaseFileType.TransformedFileName, new { @class = "form-control" })
                                    </div>
                                </div>

                            </div>

                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnCaseFileType" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" id="btnCaseFileTypeCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div><!-- /.modal -->
    
</div>

