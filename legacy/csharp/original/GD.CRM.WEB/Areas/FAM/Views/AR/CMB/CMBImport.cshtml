@using Dchien.Legal.Common
@using Dchien.Legal.Service

<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>

<div class="modal fade" id="CMBImport">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CMBFileUploading", "AR", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-inline ng-valid ng-valid-required" }))
                    {
                        <div class="modal-header">
                            <button type="button" class="close" id="btnImportClose">×</button>
                            <h5 class="modal-title ng-binding">上传招行到账文件</h5>
                        </div>
                        <div class="modal-body">

                            <div>
                                <div class="form-group">
                                </div>
                            </div>

                            <div>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label">
                                        <span class="text-danger ">*</span>
                                        <span class="">招行到账文件</span>
                                    </label>
                                    <div class="col-sm-5">
                                        <div class="form-control-wrap">
                                            <input id="txtCMBFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control ng-valid" style="display: inline-block">
                                            <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                                <input type="file" value="" id="flCMBFile" name="flCMBFile" style="height: 40px; width: 250px; margin-left: 10px;">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnCMBImport" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" id="btnCMBImportCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>







