@model Dchien.Legal.Web.Areas.FAM.ViewModels.AR.ReceivedPayment.PaymentListModel

<div class="modal fade" id="paymentListModal">
    <div class="modal-dialog" style="width:60%">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("List", "Payment", FormMethod.Post, new { id = "invoiceForm", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {

                    <div class="modal-header">
                        <button type="button" class="close" id="btnPaymentListClose" onclick="javascript: $('#paymentListModal').modal('hide');">×</button>
                        <h5 class="modal-title ">回款信息</h5>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div class="gridSection">
                                    <table id="tblList" class="table table-hover" style='width:100%'>
                                        <colgroup>
                                            <col style="width: 12%">
                                            <col style="width: 10%">
                                            <col style="width: 15%">
                                            <col style="width: 15%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>回款流水号</th>
                                                <th>合同编号</th>
                                                <th>客户名称</th>
                                                <th>回款单位</th>
                                                <th>回款日期</th>
                                                <th>
                                                    回款金额
                                                </th>
                                                <th>
                                                    回款官费
                                                </th>
                                                <th>
                                                    回款代理费
                                                </th>
                                                <th>
                                                    回款方式
                                                </th>
                                                <th>  银行单据号</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.PaymentList != null && Model.PaymentList.Any())
                                            {
                                                foreach (var item in Model.PaymentList)
                                                {
                                                    <tr>
                                                        <td>
                                                            <a class="popover-show" style="color:#06C; width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" href="~/5001001005/FAM/AR/PaymentAppliedView?paymentId=@item.PaymentBasic.PaymentId" target="_blank" >@item.PaymentBasic.SequenceNo</a>
                                                        </td>
                                                        <td>
                                                            @item.PaymentBasic.ContractNo
                                                        </td>
                                                        <td>
                                                            @item.PaymentBasic.CustomerName
                                                        </td>
                                                        <td>
                                                            @item.PaymentBasic.PayerName
                                                        </td>
                                                        <td>
                                                            @(item.PaymentBasic.CashedDate.HasValue ? item.PaymentBasic.CashedDate.Value.ToString("yyyy-MM-dd") : string.Empty)
                                                        </td>
                                                        <td>
                                                            @item.PaymentBasic.CashedAmount
                                                        </td>
                                                        <td>
                                                            @item.PaymentBasic.CaseOfficeFeeAppliedAmount
                                                        </td>
                                                        <td>
                                                            @item.PaymentBasic.CaseNonOfficeFeeAppliedAmount
                                                        </td>
                                                        <td>
                                                            @item.PaymentBasic.PaymentModeName
                                                        </td>

                                                        <td>
                                                            @item.PaymentBasic.InvoiceNo
                                                        </td>
                                    
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-default " type="button" id="btnPaymentListCancel" onclick="javascript: $('#paymentListModal').modal('hide');" value="关闭" />
                    </div>

                }
            </div>
        </div>
    </div>
</div>
