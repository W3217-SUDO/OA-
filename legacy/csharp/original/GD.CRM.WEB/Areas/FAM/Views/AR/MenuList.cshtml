@using Dchien.Legal.Service
@using Dchien.Legal.Entity.System

@{
    var controller = ViewContext.RouteData.Values["controller"].ToString().ToLower();
    var action = ViewContext.RouteData.Values["action"].ToString().ToLower();

    var actived = "active";

    var id = string.Empty;
    if (ViewContext.RouteData.Values.ContainsKey("id"))
    {
        id = ViewContext.RouteData.Values["id"].ToString().ToLower();
    }

    var menus = MenuService.Instance.GetMenusByCurrentUser();

}
<div class="product-nav-stage ng-scope product-nav-stage-main">
    <div class="product-nav-scene product-nav-main-scene">
        <div class="product-nav-title ng-binding">回款管理</div>
        <div class="ng-isolate-scope"></div>
        <div class="product-nav-list">
            <ul class="top-level">
                @{

                    if (menus.FirstOrDefault(m => m.MenuCode == PageId.PageId_5001001001) != null)
                    {
                        actived = action == "PaymentCreate".ToLower() ? "class=active" : "";
                        <li @actived>
                            <div class="ng-isolate-scope">
                                <a href=@Url.Content(string.Format("~/{0}/FAM/AR/PaymentCreate",PageId.PageId_5001001001)) class="ng-scope">
                                    <div class="nav-icon"></div>
                                    <div class="nav-title ng-binding">新增回款</div>
                                </a>
                            </div>
                        </li>

                        if (action == "PaymentEdit".ToLower())
                        {
                            <li class='active'>
                                <div class="ng-isolate-scope">
                                    <a href='javascript:void(0);' class="ng-scope">
                                        <div class="nav-icon"></div>
                                        <div class="nav-title ng-binding">修改回款</div>
                                    </a>
                                </div>
                            </li>
                        }
                        else if (action == "PaymentPush".ToLower())
                        {
                            <li class='active'>
                                <div class="ng-isolate-scope">
                                    <a href='javascript:void(0);' class="ng-scope">
                                        <div class="nav-icon"></div>
                                        <div class="nav-title ng-binding">领取回款</div>
                                    </a>
                                </div>
                            </li>
                        }
                    }


                    if (menus.FirstOrDefault(m => m.MenuCode == PageId.PageId_5001001002) != null)
                    {
                        actived = id == PageId.PageId_5001001002 ? "class=active" : "";


                        <li @actived>
                            <div class="ng-isolate-scope">
                                <a href=@Url.Content(string.Format("~/{0}/FAM/AR/PaymentList", PageId.PageId_5001001002)) class="ng-scope">
                                    <div class="nav-icon"></div>
                                    <div class="nav-title ng-binding">回款管理</div>
                                </a>
                            </div>
                        </li>
                    }

                    if (menus.FirstOrDefault(m => m.MenuCode == PageId.PageId_5001001003) != null)
                    {
                        actived = id == PageId.PageId_5001001003 ? "class=active" : "";

                        <li @actived>
                            <div class="ng-isolate-scope">
                                <a href=@Url.Content(string.Format("~/{0}/FAM/AR/PaymentList", PageId.PageId_5001001003)) class="ng-scope">
                                    <div class="nav-icon"></div>
                                    <div class="nav-title ng-binding">回款领取</div>
                                </a>
                            </div>
                        </li>
                    }

                    if (menus.FirstOrDefault(m => m.MenuCode == PageId.PageId_5001001004) != null)
                    {
                        actived = id == PageId.PageId_5001001004 ? "class=active" : "";

                        <li @actived>
                            <div class="ng-isolate-scope">
                                <a href=@Url.Content(string.Format("~/{0}/FAM/AR/PaymentList", PageId.PageId_5001001004)) class="ng-scope">
                                    <div class="nav-icon"></div>
                                    <div class="nav-title ng-binding">待分配回款</div>
                                </a>
                            </div>
                        </li>
                    }

                    if (menus.FirstOrDefault(m => m.MenuCode == PageId.PageId_5001001005) != null)
                    {
                        actived = id == PageId.PageId_5001001005 ? "class=active" : "";

                        <li @actived>
                            <div class="ng-isolate-scope">
                                <a href=@Url.Content(string.Format("~/{0}/FAM/AR/PaymentList", PageId.PageId_5001001005)) class="ng-scope">
                                    <div class="nav-icon"></div>
                                    <div class="nav-title ng-binding">已分配回款</div>
                                </a>
                            </div>
                        </li>
                    }
                }

            </ul>
        </div>
    </div>
    <div class="product-nav-scene product-nav-sub-scene">
        <div class="product-nav-title">xxx</div>
        <div class="product-nav-list">
            <ul></ul>
        </div>
    </div>
</div>
