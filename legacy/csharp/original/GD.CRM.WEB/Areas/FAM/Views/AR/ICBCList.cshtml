
@model Dchien.Legal.Web.Areas.FAM.ViewModels.AR.ReceivedPayment.ICBCListModel


<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />


<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/FAM/AR/FAM.ICBC.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<div class="viewFramework-product">
 
    <div class="viewFramework-product-body" style="background:#ffffff">
        <div class="console-container ng-scope">
            <div class="row ng-scope">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5 class="ng-binding">工行银行到账列表</h5>
                        </div>
                    </div>
                    <div class="pull-left margin-top-1 col-sm-12">
 
                        <div class="pull-left margin-top-1 col-sm-12" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm">
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                               
                                <table class="search_table" style="width: 100%">
                                    <colgroup>
                                        <col style="width: 80px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 60px" />
                                        <col style="width: 60px" />
                                        <col style="width: 60px" />
                                        <col style="width: 60px" />
                                        <col>
                                    </colgroup>
 
                                    <tr>
                                        <th style="text-align:right">
                                            发文序列号：
                                        </th>
                                        <td>
                                            
                                        </td>

                                        <th style="text-align:right">
                                            申请人：
                                        </th>
                                        <td>
                                          
                                        </td>

                                        <th style="text-align:right">
                                            入库日期：
                                        </th>
                                        <td colspan="2">
                                            @*@Html.TextBoxFor(m => m.SearchCondition.InDateStart, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.InDateEnd, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })*@
                                        </td>

                                        <td colspan="4">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnSearch">
                                                <span>查询</span>
                                            </a>
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnFileUpload">
                                                <span>上传</span>
                                            </a>
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnExport">
                                                <span>导出</span>
                                            </a>

                                        </td>


                                        <td colspan="4">
                                            <label class="control-label">
                                                <span style='color:red;text-align:right' id="message"></span>
                                            </label>
                                        </td>
                                    </tr>
                                </table>
                            </form>
                        </div>

  
                    </div>
                </div>

                <div class="col-sm-12">
                    <div class="ng-isolate-scope">
                        <div class="ng-scope">
                            <div class="gridSection">
                                <table id="tblCaseFileList" class="table table-hover">

                                    <colgroup>
                                        <col style="width: 8%" />
                                        <col style="width: 8%" />
                                        <col style="width: 8%" />
                                        <col style="width: 8%" />
                                        <col style="width: 20%" />
                                        <col style="width: 8%" />
                                        <col style="width: 20%" />
                                        <col style="width: 8%" />
                                        <col style="width: 8%" />
                                        <col style="width: 8%" />
                                    </colgroup>

                                    <thead>
                                        <tr>
                                            <th style="text-align: center">日期</th>
                                            <th style="text-align: center">交易类型</th>
                                            <th style="text-align: center">凭证种类</th>
                                            <th style="text-align: center">凭证号</th>
                                            <th style="text-align: center">对方户名</th>
                                            <th style="text-align: center">对方账号</th>
                                            <th style="text-align: center">摘要</th>
                                            <th style="text-align: center">借方发生额</th>
                                            <th style="text-align: center">贷方发生额</th>
                                            <th style="text-align: center">余额</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>

                                        </tr>
                                    </tbody>
                                    <tfoot class="ng-scope" style="display: none">
                                        <tr>
                                            <td colspan="14">
                                                <div class="pull-left"></div>
                                                <div class="ng-scope">
                                                    <div class="pull-right page-box caseFileList">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

