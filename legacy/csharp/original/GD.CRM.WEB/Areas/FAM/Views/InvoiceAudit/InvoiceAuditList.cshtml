@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.ServiceStack.Common.Extensions

@model Dchien.Legal.Web.Areas.FAS.ViewModels.AR.Invoice.Audit.AuditListModel
<div class="modal fade" id="invoiceAuditListModal">

    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">

                <div class="modal-header">
                    <button type="button" class="close" id="btnInvoiceAuditListClose">×</button>
                    <h5 class="modal-title ng-binding">开票审批信息</h5>
                </div>

                <div class="modal-body">
                    <div>
                        <div class="ng-isolate-scope">
                            <div class="ng-scope">
                                <div class="gridSection">
                                    <table id="tblInvoiceAuditList" class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>
                                                    序号
                                                </th>
                                                <th>
                                                    审批人
                                                </th>
                                                <th>
                                                    审批日期
                                                </th>
                                                <th>
                                                    审批状态
                                                </th>
                                                <th>
                                                    审批内容
                                                </th>

                                            </tr>
                                        </thead>
                                        <tbody>


                                            @if (Model.InvoiceAuditList != null)
                                            {
                                                var i = 1;
                                                foreach (var item in Model.InvoiceAuditList)
                                                {
                                                    <tr>
                                                        <td style="text-align: center">
                                                            @(i++)
                                                        </td>
                                                        <td style="text-align: center">
                                                            @item.AuditorName
                                                        </td>
                                                        <td style="text-align: center">
                                                            @(item.AuditDate.HasValue ? item.AuditDate.Value.ToString("yyyy-MM-dd") : string.Empty)
                                                        </td>
                                                        <td style="text-align: center">
                                                            @item.AuditStatus.ToDescription()
                                                        </td>
                                                        <td style="text-align: left; ">
                                                            @item.AuditContent
                                                        </td>
                  

                                                    </tr>
                                                }
                                            }

                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">

                    <input class="btn btn-default ng-binding" type="button" id="btnInvoiceAuditListCancel" value="关闭" />
                </div>

            </div>
        </div>
    </div>

</div>