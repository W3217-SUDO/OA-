@using Dchien.Legal.Service.Lawsuit.Case
@model Dchien.Legal.Web.Areas.FAM.ViewModels.AR.ReceivedPayment.PaymentAppliedModel
<script type="text/javascript" src="@Url.Content("~/Scripts/FAM/AR/FAM.AR.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/FAM/AR/FAM.AR.AppliedList.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/components.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/font-awesome.css")" />
<style>
    input.input_text, textarea, select, input.input_time {
        border: 1px solid #ccc;
    }

    /*select {
        color: rgb(84, 84, 84);
        background-color: rgb(235, 235, 228);
    }*/

    input.input_text, textarea, input.input_time {
        padding: 2px 2px 2px 3px;
    }

    input.input_text, textarea, input.input_time {
        background-color: #fff;
    }

    .case-form-control {
        /*border-radius: 0px;*/
        -webkit-transition: none;
        transition: none;
        font-size: 12px;
        width: 100%;
        height: 24px;
    }

    .case-section-product .product-container .product-section .section-content .content-table td {
        padding-left: 1px;
    }


    .input_table th {
        padding: 2px;
        font-weight: normal;
        text-align: right;
    }

    .input_table td {
        padding: 2px;
        text-align: left;
    }

    .case-section-wrap {
        padding: 2px;
    }

    .case-section-main {
        margin: 0 3px;
        padding: 0px;
        position: relative;
    }
</style>
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.index.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/case.createupdate.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/messageCenter.console.css")" />
<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("~/Areas/FAM/Views/AR/MenuList.cshtml");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body">
        <div class="ng-scope">
            <div class="ng-scope">
                <div class="case-section-main clearfix" style="padding:0px">
                    <!-- 左侧 -->
                    <div class="case-section-left" style="padding-right: 0%;">
                        <div class="case-section-wrap">
                            <div class="case-section-product">
                                <!-- product section -->
                                <div class="product-container">
                                    <div class="product-section">
                                        <div class="section-content clearfix" style="padding: 0;">
                                            <div class="ng-scope">
                                                <div class="table-viewer-header clearfix" style="margin-top: 0px">
                                                    <span class="table-viewer-topbar-title">
                                                        回款信息
                                                    </span>
                                                    <div class="pull-right table-viewer-topbar-content"></div>
                         
                                                </div>
                                                <div id="divStaffBasic" class="gridSection"  >
                                                    @Html.HiddenFor(m => m.Payment.PaymentBasic.PaymentId)
                                                    <table class="input_table" style='width:100%'>
                                                        <colgroup>
                                                            <col style="width: 5%;" />
                                                            <col style="width: 15%;" />
                                                            <col style="width: 5%;" />
                                                            <col style="width: 8%;" />
                                                            <col style="width: 5%;" />
                                                            <col style="width: 8%;" />
                                                            <col style="width: 5%;" />
                                                            <col style="width: 8%;" />
                                                            <col style="width: 5%;" />
                                                            <col style="width: 8%;" />
                                                            <col style="width: 5%;" />
                                                            <col style="width: 10%;" />
                                                        </colgroup>

                                                        <tr>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.PayerName)
                                                            </th>
                                                            <td>
                                                                @Html.DisplayFor(m => m.Payment.PaymentBasic.PayerName)
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.CashedDate)
                                                            </th>
                                                            <td>
                                                                @Html.DisplayFor(m => m.Payment.PaymentBasic.CashedDate)
                                                            </td>

                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.InvoiceNo)
                                                            </th>
                                                            <td>
                                                                @Html.DisplayFor(m => m.Payment.PaymentBasic.InvoiceNo)
                                                            </td>

                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.PaymentModeName)
                                                            </th>
                                                            <td>
                                                                @Html.DisplayFor(m => m.Payment.PaymentBasic.PaymentModeName)
                                                            </td>

                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.ContractNo)
                                                            </th>
                                                            <td>
                                                                @Html.DisplayFor(m => m.Payment.PaymentBasic.ContractNo)
                                                            </td>

                                                            <td rowspan="2" colspan="2">
                                                                @Html.DisplayFor(m => m.Payment.PaymentBasic.Remark)
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.CustomerName)
                                                            </th>
                                                            <td>
                                                                @Html.DisplayFor(m => m.Payment.PaymentBasic.CustomerName)
                                                            </td>
                           
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.CashedAmount)
                                                            </th>
                                                            <td>
                                                                @Html.DisplayFor(m => m.Payment.PaymentBasic.CashedAmount)
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.AppliedAmount)
                                                            </th>
                                                            <td>
                                                                <label id="Payment_PaymentBasic_AppliedAmount"> @Html.DisplayFor(m => m.Payment.PaymentBasic.AppliedAmount)</label>
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.UnAppliedAmount)
                                                            </th>
                                                            <td>
                                                                <label id="Payment_PaymentBasic_UnAppliedAmount"> @Html.DisplayFor(m => m.Payment.PaymentBasic.UnAppliedAmount)</label>
                                                            </td>

                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.ReceiverName)
                                                            </th>
                                                            <td>
                                                                @Html.DisplayFor(m => m.Payment.PaymentBasic.ReceiverName)
                                                            </td>

                                                        </tr>

                                                    </table>
                                                </div>

                                                <div class="table-viewer-header clearfix" style="margin-top: 4px" >
                                                    <span class="table-viewer-topbar-title">
                                                        费用分配明细
                                                    </span>
                                                    <div class="pull-right table-viewer-topbar-content"></div>
                                
                                                </div>

                                                <div id="divStaffExperience" class="gridSection" style="padding-top: 4px;">
                                                    <form class="form-inline ng-valid " id="postForm">
                                                        @Html.HiddenFor(m => m.SearchCondition.PaymentId, new { name = "PaymentId" })
                                                        @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageNo" })
                                                        @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageSize" })
                                                      
                                                        <table class="search_table" style="width: 100%">
                                                            <colgroup>
                                                                <col style="width: 60px;" />
                                                                <col style="width: 160px" />
                                                                <col style="width: 60px" />
                                                                <col style="width: 160px" />
                                                                <col style="width: 60px" />
                                                                <col style="width: 160px" />
                                                                <col style="width: 80px" />
                                                                <col style="width: 160px" />
                                                                <col style="width: 80px" />
                                                                <col style="width: 160px" />
                                                                <col style="width: 80px" />
                                                                <col style="width: 160px" />
                                                                <col>
                                                            </colgroup>
                                                            <tr>
                                                                <th>
                                                                    案件编号：
                                                                </th>
                                                                <td colspan="5">
                                                                    @Html.TextAreaFor(m => m.SearchCondition.CaseNo, new { @class = "form-control", @style = "width:100%" })
                                                                </td>
                                                            </tr>

                                                            <tr>
                                                                <th>
                                                                    客户名称：
                                                                </th>
                                                                <td colspan='3'>
                                                                    @Html.TextBoxFor(m => m.SearchCondition.CustomerName, new { @class = "form-control", @style = "width:97%" })
                                                                </td>
                                                                <th>
                                                                    合同编号：
                                                                </th>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SearchCondition.ContractNo, new { @class = "form-control", @style = "width:100%" })
                                                                </td>

                                                            </tr>
                                                            <tr>
                                                                <th>
                                                                    案件类型：
                                                                </th>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SearchCondition.CaseTypeName, new { @class = "form-control", @placeholder = "案件类型" })
                                                                    @Html.HiddenFor(m => m.SearchCondition.CaseTypeId)
                                                                </td>
                                                                <th>
                                                                    案件阶段：
                                                                </th>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SearchCondition.CasePhaseName, new { @class = "form-control", @placeholder = "案件阶段" })
                                                                    @Html.HiddenFor(m => m.SearchCondition.CasePhaseId)
                                                                </td>
                                                                <th>
                                                                    费用类型：
                                                                </th>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SearchCondition.CaseFeeTypeName, new { @class = "form-control", @placeholder = "费用类型", @style = "width:100%" })
                                                                    @Html.HiddenFor(m => m.SearchCondition.CaseFeeTypeId)
                                                                </td>

                                                                <td colspan="3">
                                                                    <a href="javascript:void(0);" class="btn btn-default " id="btnPaymentSearchClear">
                                                                        <span>清空</span>
                                                                    </a>
                                                                    <a href="javascript:void(0);" class="btn btn-primary " id="btnPaymentObjectAppliedSearch">
                                                                        <span>查询</span>
                                                                    </a>
                                                                    <a href="javascript:void(0);" class="btn btn-primary " id="btnPaymentAppliedCancel">
                                                                        <span>取消分配</span>
                                                                    </a>
                                                                </td>
                                                            </tr>

                                                        </table>

                                                    </form>

                                                    <div id="dv_List"></div>
                                                    </div>

                                                <div class='divcaseconditioncasetypes'></div>
                                                <div class='divcaseconditioncasephases'></div>
                                                <div class='divcaseconditioncasefeetypes'></div>
                                                
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                       
                    </div>
 
                </div>
            </div>
        </div>
    </div>
</div>
