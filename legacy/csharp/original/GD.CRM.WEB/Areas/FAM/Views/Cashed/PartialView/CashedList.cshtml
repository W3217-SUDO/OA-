@using Dchien.Legal.Entity.Account
@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.FAS.ViewModels.Cashed.CashedListModel
           
@{
    var display = "display:block";

    if (@Model.CashedList != null && @Model.CashedList.Count > 0)
    {
        display = "display:none";
    }
}

<div id="casegridSection" class="gridSection">
    <div id='divLeftContextList' style="overflow-y: auto; margin-top: -1px; overflow-x: hidden; overflow-y: auto; ">
        <table class='table table-hover' id="tblCashedList" width="100%">
            <colgroup>
                <col style="width: 5%">
                <col style="width: 5%">
                <col style="width: 10%">
                <col style="width: 10%">
                <col style="width: 10%">
                <col style="width: 10%">
                <col style="width: 10%">
            </colgroup>
            <thead>
                <tr>
                    <th>选项</th>
                    <th>序号</th>
                    <th>到账日期</th>
                    <th>到账金额</th>
                    <th>未分配额</th>
                    <th>已分配额</th>
                    <th>登记人</th>
                </tr>
            </thead>
          
            <tbody>
                @if (Model.CashedList != null)
                {
                    foreach (var item in Model.CashedList)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" name="chkCashedId" value="@item.CashedId">
                            </td>
                            
                            <td>
                                <span>@item.SortingIndex</span>
                            </td>
    
                            <td >
                                <span>@item.CashedDate.ToString("yyyy-MM-dd")</span>
                            </td>

                            <td>
                                <span> @(item.Amount.HasValue ? item.Amount.Value.ToString() : "0") </span>
                            </td>
                            <td>
                                <span>@(item.Amount - item.AppliedAmount)</span>
                            </td>
                            <td>
                                <span>@(item.AppliedAmount)</span>
                            </td>
                            <td>
                                <span>@item.ConfirmorName</span>
                            </td>
                        </tr>
                    }
                }

            </tbody>
            <tfoot class="ng-scope" style="display:none">
                <tr>
                    <td colspan="7">
                        <div class="pull-left"></div>
                        <div class="ng-scope">
                            <div class="pull-right page-box cashedlist">
                            </div>
                        </div>
                    </td>
                </tr>
            </tfoot>
        </table>
        <div class="simple-grid-none-data-wrap cashedlist" style="@display">
            <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                    <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                    <div class="text-size-16 tip-text inline-block">
                        <span class="margin-left ng-binding"></span>没有查询到到账信息.
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Html.HiddenFor(m => m.CashedSearchCondition.PageNo, new { name = "PageNo" })
    @Html.HiddenFor(m => m.CashedSearchCondition.PageSize, new { name = "PageSize" })
    @Html.HiddenFor(m => m.CashedSearchCondition.TotalCount, new { name = "TotalCount" })
</div>


