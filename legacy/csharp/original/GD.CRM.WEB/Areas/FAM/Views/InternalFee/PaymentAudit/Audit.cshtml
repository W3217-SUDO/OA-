@using Dchien.Legal.Service.FAM.InternalFee;

@model Dchien.Legal.Web.Areas.FAM.ViewModels.InternalFee.Payment.PaymentAuditModel

<script type="text/javascript" src="@Url.Content("~/Scripts/FAM/InternalFee/Payment/FAM.InternalFee.Payment.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<div class="viewFramework-product ">
    <div class="viewFramework-product-body">
        <div>
            <div class="console-container ">
                <div class="">
                    <div class="row ">
                        <div class="col-sm-12">
                            <div ui-view="myTicket">
                                <div class="ticket-detail ">
                                    <div class="console-title console-title-border clearfix">
                                        <h5 class="pull-left">付款审批</h5>
                                    </div>
                                    <div class="margin-top-3"></div>

                                    @if (Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.InternalFee.Payment.PaymentStatus.R
|| Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.InternalFee.Payment.PaymentStatus.D
|| Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.InternalFee.Payment.PaymentStatus.Approved
|| Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.InternalFee.Payment.PaymentStatus.ApplicaionCanceled
)
                                    {
                                        <div class="case-notice-margin">
                                            <div class="console-global-notice">
                                                <div class="console-global-notice-list">
                                                    <div class="alert alert-success console-global-notice-item">
                                                        <div class="clearfix console-global-notice-item-inner">
                                                            <div class="console-global-notice-content ng-binding">
                                                                付款状态为 @Model.Payment.PaymentBasic.PaymentStatusName ,不能审批.
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div style="margin-top:12px" class="ng-isolate-scope">
                                        <div class="console-step row step-bar">
                                            <div class="step col-md-3  step-first ">
                                                <span class="">付款信息填写</span>
                                            </div>
                                            <div class="step col-md-3   ">
                                                <span class="">提交申请</span>
                                            </div>
                                            <div class="step col-md-3  step-active">
                                                <span class="">财务审批</span>
                                            </div>
                                            <div class="step col-md-3  step-end">
                                                <span class="">财务付款</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="table-viewer-header clearfix">
                                        <span class="table-viewer-topbar-title">
                                            <span>付款审批</span>
                                        </span>
                                    </div>

                                    <div class="table-content">
                                        <form class="chat-form form-horizontal form-horizontal ng-invalid ng-invalid-required">
                                            <div class="simple-form-field ng-scope ng-isolate-scope hide">
                                                <input type="hidden" class="ng-scope">
                                            </div>
                                            <div class="simple-form-field ng-scope ng-isolate-scope">
                                                <div class="form-group ng-scope">

                                                    <div class="col-sm-8">
                                                        <textarea id="Audit_AuditContent" type="text" class="form-control ng-pristine ng-invalid ng-invalid-required ng-valid-maxlength"
                                                                  rows="3" placeholder="审批意见"
                                                                  name="Audit_AuditContent" required="required"></textarea>
                                                    </div>
                                                </div>
                                            </div><div class="simple-form-field ng-scope ng-isolate-scope">
                                                <div secret-content-check=""
                                                     data="result.content"
                                                     class="ng-scope ng-isolate-scope"></div>
                                            </div>
                                            <div class="simple-form-field ng-scope ng-isolate-scope">

                                                <div class="form-group simple-form-submit ng-scope" style="margin-bottom:0px">
                                                    <label for="submit5" class="col-sm-12 control-label"><span class="ng-binding"></span></label>
                                                    <div class="col-sm-4">
                                                        @{if (Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.InternalFee.Payment.PaymentStatus.R
                        || Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.InternalFee.Payment.PaymentStatus.D
                        || Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.InternalFee.Payment.PaymentStatus.Approved
                        || Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.InternalFee.Payment.PaymentStatus.ApplicaionCanceled
)
                                                            {
                                                                
                                                            }
                                                            else
                                                            {

                                                                <input class="btn btn-primary" type="button" id="btnPaymentApplicationApproved" value="同意" />
                                                                <input class="btn btn-default" type="button" id="btnPaymentApplicationRejected" value="拒绝" />
                                                                 
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>

                                    <div class="info-panel" style="margin-top:12px">
                                        <div class="row" style="margin-top:4px">
                                            <div class="col-sm-2 ">
                                                <span class="text-explode">
                                                    <span>案件编号</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Case.Basic.CaseNo)
                                                </span>
                                            </div>

                                            <div class="col-sm-3 ">
                                                <span class="text-explode">
                                                    <span>案件名称</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Case.Basic.CaseName)
                                                </span>
                                            </div>
                                        </div>
                                        <div class="row" style="margin-top:4px">
                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>合同编号</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.HiddenFor(m => m.Case.Basic.CaseId)
                                                    @Html.HiddenFor(m => m.Case.Basic.CaseNo)
                                                    @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractId)
                                                    @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractNo)
                                                    @Html.HiddenFor(m => m.Customer.CustomerBasic.CustomerId)
                                                    @Html.HiddenFor(m => m.Customer.CustomerBasic.CustomerNo)
                                                    @Html.HiddenFor(m => m.Payment.PaymentBasic.ApplicationNo)
                                                    @Html.HiddenFor(m => m.Payment.PaymentBasic.ApplicationDate)
                                                    @Html.HiddenFor(m => m.Payment.Audit.AuditId)
                                                    @Html.HiddenFor(m => m.Audit.AuditId)
                                                    @Html.HiddenFor(m => m.Payment.PaymentBasic.PaymentId)
                                                    @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.ContractNo)

                                                </span>
                                            </div>

                                            <div class="col-sm-3 ">
                                                <span class="text-explode">
                                                    <span>合同名称</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.ContractName)
                                                </span>
                                            </div>
                                        </div>
                                        <div class="row" style="margin-top:4px">
                                            <div class="col-sm-2 ">
                                                <span class="text-explode">
                                                    <span>客户编号</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Customer.CustomerBasic.CustomerNo)
                                                </span>
                                            </div>

                                            <div class="col-sm-3 ">
                                                <span class="text-explode">
                                                    <span>客户名称</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Customer.CustomerBasic.CustomerName)
                                                </span>
                                            </div>

                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>客户管理人</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Case.Basic.BusinessOwnerName)
                                                </span>
                                            </div>
                                        </div>
                                        <div class="row" style="margin-top:4px">
                                            <div class="col-sm-2 ">
                                                <span class="text-explode">
                                                    <span>调查提成(已付)</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Payment.PaymentBasic.Total_Amount_11040070)
                                                </span>
                                            </div>


                                            <div class="col-sm-2 ">
                                                <span class="text-explode">
                                                    <span>案源提成(已付)</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Payment.PaymentBasic.Total_Amount_11040020)
                                                </span>
                                            </div>
                                        </div>
                                        <div class="row" style="margin-top:4px">
                                            <div class="col-sm-2 ">
                                                <span class="text-explode">
                                                    <span>文书提成(已付)</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Payment.PaymentBasic.Total_Amount_11040030)
                                                </span>
                                            </div>

                                            <div class="col-sm-2 ">
                                                <span class="text-explode">
                                                    <span>开庭提成(已付)</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Payment.PaymentBasic.Total_Amount_11040040)
                                                </span>
                                            </div>

                                        </div>

                                        <div class="row" style="margin-top:4px">
                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>申请编号</span>
                                                    <span>:</span>
                                                </span>
                                                <span class="">
                                                    @Html.DisplayTextFor(m => m.Payment.PaymentBasic.ApplicationNo)
                                                </span>
                                            </div>


                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>申请日期</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    <span class=""> @Html.DisplayFor(m => m.Payment.PaymentBasic.ApplicationDate) </span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
              
                            <div class="case-section-wrap" style="padding-top: 12px;">
                                <div class="case-section-product">
                                    <!-- product section -->
                                    <div class="product-container">
                                        <div class="product-section">
                                            <ul class="nav nav-tabs">
                                                <li id="liContractObjectList" class='active'><a href="javascript:void(0);" id="btnContractObjectList">付款信息</a></li>
                                                <li class="pull-right" style="border:none">
                                                    <div style="margin-top:3px">
                                                        <div style="text-align: inherit;">
                                                            <div style="text-align: right; padding-right: 8px; padding-bottom: 3px; float: right; display: inline;">

                                                            </div>
                                                        </div>
                                                    </div>
                                                </li>
                                            </ul>
                                            <div class="section-content clearfix">
                                                <div class="product-col " style="width: 100%">

                                                    <div id="dv_List">
                                                        <div class="gridSection">
                                                            <div id='divContextList' style="overflow-y: auto; overflow-x: hidden; overflow-y: auto; ">
                                                                <table class='table table-hover' id="tblAPObjectList" width="100%">
                                                                    <colgroup>
                                                                        <col style="width: 4%">
                                                                        <col style="width: 10%">
                                                                        <col style="width: 10%">
                                                                        <col style="width: 8%">
                                                                        <col style="width: 8%">
                                                                        <col style="width: 20%">
                                                                    </colgroup>
                                                                    <thead>
                                                                        <tr>
                                                                            <th>序号</th>
                                                                            <th>支付对象</th>
                                                                            <th>提成类型</th>
                                                                            <th>金额</th>
                                                                            <th>本次支付</th>
                                                                            <th>备注</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @{ var i = 1; }
                                                                        @if (Model.Payment != null && Model.Payment.PaymentObjects != null)
                                                                        {
                                                                            foreach (var item in Model.Payment.PaymentObjects.OrderBy(x => x.CaseNo))
                                                                            {
                                                                                var internalFee = InternalFeeService.Instance.GetInternalFee(item.InternalFeeId.Value);

                                                                                <tr>
                                                                                    <td>
                                                                                        <span>@(i++)</span>
                                                                                    </td>
                                                                                    <td style="text-align: center">
                                                                                        <span>@internalFee.PaymentObjectName</span>
                                                                                    </td>

                                                                                    <td style="text-align: center;">
                                                                                        <span>@internalFee.FeeTypeName</span>
                                                                                    </td>

                                                                                    <td style="text-align: center;">
                                                                                        <span>@(item.InternalFeeAmount.HasValue ? item.InternalFeeAmount.Value : 0)</span>
                                                                                    </td>
                                                                                    <td style="text-align: center; padding:0px">
                                                                                        <span style="color:blue">@(item.InternalFeePaidAmount.HasValue ? item.InternalFeePaidAmount.Value : 0)</span>
                                                                                    </td>

                                                                                    <td style="text-align: center">
                                                                                        <span id="item_PaymentRemark" style="color:red">@(internalFee.Remark)</span>
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        }
                                                                    </tbody>


                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
