@using Dchien.Legal.Entity.Account
@using Dchien.Legal.Entity.System
@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.FAM.ViewModels.InternalFee.ListModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/index.css")" />

<script src="@Url.Content("~/Scripts/Legal/Case/Legal.Case.InternalFee.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Common/ztree/jquery.ztree.core.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Common/ztree/jquery.ztree.excheck.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Common/ztree/jquery.ztree.exedit.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/zTree/zTreeStyle.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" />

<style type="text/css">
    ul.ztree {
        margin-top: 0px;
        border-right: 0px solid #e1e6eb;
        overflow-y: auto;
        overflow-x: auto;
    }

    .ztree li {
        line-height: 20px;
    }

        .ztree li a {
            width: 150px;
            height: 20px;
            padding-top: 0px;
        }

            .ztree li a:hover {
                text-decoration: none;
                background-color: #E7E7E7;
            }

            .ztree li a span.button.switch {
                visibility: hidden;
            }

    .ztree.showIcon li a span.button.switch {
        visibility: hidden;
    }

    .ztree li a.curSelectedNode {
        background-color: #D4D4D4;
        border: 0;
        height: 20px;
    }

    .ztree li span {
        line-height: 20px;
    }

        .ztree li span.button {
            margin-top: 2px;
        }

            .ztree li span.button.switch {
                width: 15px;
                height: 10px;
                margin-bottom: 2px;
            }

            .ztree li span.button.add {
                margin-left: 2px;
                margin-right: -1px;
                background-position: -144px 0;
                vertical-align: top;
                *vertical-align: middle;
            }


            /*.ztree li span.button {background-image:url("./left_menuForOutLook.png"); *background-image:url("./left_menuForOutLook.gif")}*/

            .ztree li span.button.ico_docu {
                background-position: -110px -16px;
            }

            .ztree li span.button.switch.level0 {
                width: 15px;
                height: 10px;
                margin-bottom: 2px;
            }

            .ztree li span.button.switch.level1 {
                width: 15px;
                height: 10px;
                margin-bottom: 2px;
            }
    /*.ztree li span.button.noline_open {background-position: 0 0;}
    .ztree li span.button.noline_close {background-position: -18px 0;}
    .ztree li span.button.noline_open.level0 {background-position: 0 -18px;}
    .ztree li span.button.noline_close.level0 {background-position: -18px -18px;}
    .ztree li span.button.noline_close.level0 {background-position: -18px -18px;}*/

    .node_name {
        margin-left: 10px;
    }

    div#rMenu {
        position: absolute;
        visibility: hidden;
        top: 0;
        background-color: #555;
        text-align: left;
        padding: 2px;
    }

        div#rMenu ul li {
            margin: 1px 0;
            padding: 0 5px;
            cursor: pointer;
            list-style: none outside none;
            background-color: #DFDFDF;
        }
</style>
<div class="viewFramework-product ">
    <div class="viewFramework-product-body" style="overflow-y:hidden">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>内部费用查询</h5>
                            </div>
                        </div>
                        <div class="pull-left col-sm-12" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm">
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageNo" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageSize" })
                                <table class="search_table" style="width: 800px">
                                    <colgroup>
                                        <col style="width: 60px;" />
                                        <col style="width: 180px" />
                                        <col style="width: 80px" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 160px" />
                                        <col>
                                    </colgroup>
                                    <tr>
                                        <th>
                                            案件编号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseNo, new { @class = "form-control", @style = "width:97%" })
                                        </td>

                                        <th>
                                            经办律师：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseLawyer, new { @class = "form-control", @style = "" })
                                        </td>
                                        <th>
                                            律师助理：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseAssistant, new { @class = "form-control", @style = "" })
                                        </td>
                                        <th>
                                            案源人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.BusinessOwnerName, new { @class = "form-control", @style = "" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>
                                            客户名称：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CustomerName, new { @class = "form-control", @style = "width:97%" })
                                        </td>

           
                                        <th>
                                            客户管理人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.BusinessOwnerName, new { @class = "form-control", @style = "" })
                                        </td>
                                        <th>
                                            调查人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.InvestigatorName, new { @class = "form-control", @style = "" })
                                        </td>

                                        <th>
                                            付款状态：
                                        </th>
                                        <td>
                                            @Html.DropDownListFor(m => m.SearchCondition.PaymentPaidStatus, CommonService.Instance.GetInternalFeePaymentPaidStatusList(true), new { @class = "form-control", @style = "width:95.5%" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>
                                            付款时间：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.PaidDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:80px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.PaidDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:80px" })
                                        </td>
                                        <th>
                                            收款人：
                                        </th>
                                        <td>
                                            @if (Model.SearchCondition.PageId == PageId.PageId_5001004007)
                                            {
                                                @Html.TextBoxFor(m => m.SearchCondition.PaymentObject, new { @class = "form-control", @readonly = true, @style = "" })
                                            }
                                            else
                                            {
                                                @Html.TextBoxFor(m => m.SearchCondition.PaymentObject, new { @class = "form-control", @style = "" })
                                            }
                                        </td>
                                        <th>
                                            案件阶段：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CasePhaseName, new { @class = "form-control", @autocomplete = "off", @placeholder = "案件阶段" })
                                            @Html.HiddenFor(m => m.SearchCondition.CasePhaseId)
                                            <div class='divcaseconditioncasephases' style='overflow-y: scroll; '>
                                                <div id="divCasePhaseCheckBoxList" style="display:none" class='i_common_box'>
                                                    <div class='i_common_hd'>
                                                        从下列案件阶段中选择
                                                        <input type='hidden' id='hidCasePhaseId'>
                                                        <input type='hidden' id='hidCasePhaseName'>
                                                    </div>
                                                    <div class='i_common_bd'>
                                                        <ul id='casePhaseTree' class='ztree' style="max-height:600px"></ul>
                                                        <div class="pull-right">
                                                            <input class='btn btn-primary' type='button' id='btnCasePhaseSelected' value='确定' />
                                                            <input class='btn btn-default' type='button' id='btnCasePhaseCancel' value='取消' />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <th>
                                            费用类型：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.FeeTypeName, new { @class = "form-control", @autocomplete = "off", @placeholder = "费用类型" })
                                            @Html.HiddenFor(m => m.SearchCondition.FeeTypeId)
                                            <div class='divcaseconditioncasefeetypes' style='overflow-y: scroll; '>
                                                <div id="divCaseFeeTypeCheckBoxList" style="display:none" class='i_common_box'>
                                                    <div class='i_common_hd'>
                                                        从下列案件费用中选择
                                                        <input type='hidden' id='hidCaseFeeTypeId'>
                                                        <input type='hidden' id='hidCaseFeeTypeName'>
                                                    </div>
                                                    <div class='i_common_bd'>
                                                        <ul id='caseFeeTypeTree' class='ztree' style="max-height:600px"></ul>
                                                        <div class="pull-right">
                                                            <input class='btn btn-primary' type='button' id='btnCaseFeeTypeSelected' value='确定' />
                                                            <input class='btn btn-default' type='button' id='btnCaseFeeTypeCancel' value='取消' />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>
                                        </th>
                                        <td>
                                            <div class="form-group">
                                                <a href="javascript:void(0);" class="btn btn-primary " id="btnSearch">
                                                    <span>查询</span>
                                                </a>
                                                <a href="javascript:void(0);" class="btn btn-default " id="btnSearchClear">
                                                    <span>清空</span>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                </table>

                            </form>
                        </div>

                    </div>
                    <div class="col-sm-12">
                        <div class="">
                            <div class="gridSection" id="paymentgridSection">
                                <table class="aps-table aps-widget aps-ani-transition" style="width:100%">
                                    <colgroup>
                                        <col style="width: 3%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 15%">
                                        <col style="width: 20%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 6%">
                                        <col style="width: 17px">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>
                                                <input type="checkbox" id="chkInternalFeeAll" name="chkInternalFeeAll">
                                            </th>
                                            <th style="text-align: center">案号 </th>
                                            <th style="text-align: center">案件阶段 </th>
                                            <th style="text-align: center">原告</th>
                                            <th style="text-align: center">被告</th>
                                            <th style="text-align: center">经办律师</th>
                                            <th style="text-align: center">律师助理</th>
                                            <th style="text-align: center">案源人</th>
                                            <th style="text-align: center">调查人</th>
                                            <th style="text-align: center">归档时间</th>
                                            <th style="text-align: center">申请时间</th>
                                            <th style="text-align: center">内部费用类型</th>
                                            <th style="text-align: center">金额</th>
                                            <th style="text-align: center">收款人</th>
                                            <th style="text-align: center">支付状态</th>
                                            <th></th>
                                        </tr>
                                    </thead>


                                </table>
                                <div id="divList" style="border-top: 0;margin-top: -1px; overflow-x:hidden; overflow-y: scroll;">
                                    <table id="tblInternalFeeList" class="aps-table aps-widget aps-ani-transition" style="width:100%">
                                        <colgroup>
                                            <col style="width: 3%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 15%">
                                            <col style="width: 20%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 8%">
                                            <col style="width: 6%">

                                        </colgroup>
                                        <tbody>
                                            <tr style="display: none">
                                                <td>
                                                    &nbsp;
                                                </td>

                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: left"></td>
                                                <td style="text-align: left"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: right"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>

                                            </tr>
                                            <tr style="display: none">
                                                <td>
                                                    &nbsp;
                                                </td>

                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: left"></td>
                                                <td style="text-align: left"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
                                                <td style="text-align: center"></td>
