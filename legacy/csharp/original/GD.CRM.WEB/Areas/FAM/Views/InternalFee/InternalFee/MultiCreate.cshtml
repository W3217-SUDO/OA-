@using Dchien.Legal.BizModel.FCM.Contract
@using Dchien.Legal.Service.Legal.Case
@using Dchien.Legal.Service.BAS.Type
@using Dchien.Legal.Service.FAM.InternalFee;
@using Dchien.Legal.Service.FAM.InternalFee.Payment;

<div class="slide-panels">
    <div class="slide-panel active " style="width:700px">
        <div class="slide-panel-content" style="width:700px">
            <div class="panel-header">
                <h5>新增内部费用</h5>
                <a class="panel-close" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');">
                    <i class="next-icon next-icon-close next-small" style="font-size: 0px;">close</i>
                </a>
                <div class="head-custom"></div>
            </div>
            <div class="placeholder">...</div>
            <div class="panel-body">
                <div class="panel-body-content">
                    <div class="page-overview-panel-apply">
                        <div ui-view="myTicket">
                            <div class="ticket-detail ">

                                <div class="">
                                    <div class="">
                                        <div class="">
                                            <style type="text/css" class="">
                                                .tableWrapper .table {
                                                    margin-bottom: 0px;
                                                }

                                                .table-hover tbody tr.trWarapper:hover td {
                                                    background-color: #FCF8E2;
                                                }
                                            </style>
                                            <div class="">
                                                <div class="alert alert-info clearfix" style="padding: 8px 12px 0px;line-height: 18px;margin-bottom: 6px;border-radius: 0px">
                                                    <div class="pull-left">
                                                        <span>温馨提示</span> ：
                                                    </div>
                                                    <div class="pull-left">
                                                        <p>1. <span>申请付款按照每个案号生成一个申请单.</span> </p>
                                                        <p>2. <span>点击表格头部(费用类型,金额,备注)会把第一行数据同步到各行.</span> </p>
                                                        <p>3. <span>基数用于计算提成的分母数,点击基数会把第一行数据同步到各行,同时自动计算提成.</span> </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
 
                                <div class="form-group">
                                    <div class="col-sm-12" style="padding:0px">
                                        <div class="gridSection">
                                            <table class="aps-table aps-widget aps-ani-transition " id="tblInternalFeeObjects" width="100%">
                                                <colgroup>
                                                    <col style="width: 9%">
                                                    <col style="width: 12%">
                                                    <col style="width: 13%">
                                                    <col style="width: 6%">
                                                    <col style="width: 7%">
                                                    <col style="width: 7%">
                                                    <col style="width: 12%">
                                                    <col style="width: 5%">
                                                </colgroup>
                                                <thead>
                                                    <tr>
                                                        <th>案号</th>
                                                        <th><span><a href="javascript:void(0);" onclick="javascript: c.Cases.Case.InternalFees.InternalFee.Objects.ObjectItem.SyncPaymentType();">费用类型</a></span></th>
                                                        <th>支付对象</th>
                                                        <th><span><a href="javascript:void(0);" onclick="javascript: c.Cases.Case.InternalFees.InternalFee.Objects.ObjectItem.SyncPaymentBaseAmount();">基数</a></span></th>
                                                        <th>参考提成</th>
                                                        <th><span><a href="javascript:void(0);" onclick="javascript: c.Cases.Case.InternalFees.InternalFee.Objects.ObjectItem.SyncPaymentAmount();">实际金额</a></span></th>
                                                        <th><span><a href="javascript:void(0);" onclick="javascript: c.Cases.Case.InternalFees.InternalFee.Objects.ObjectItem.SyncPaymentRemark();">备注</a></span></th>
                                                        <th>操作</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <div class="i_common_select" id="divAssociateUserList_InternalFee" style="position:absolute;z-index: 1000;display: none;">
                                        <div class="i_common_wrap">
                                            <div class="i_common_list"></div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="panel-footer">
            <div class="btn-con">
                <input type="button"  class="btn   btn-primary" style="border-radius: 0;padding: 0 16px; height: 32px;line-height: 30px; font-size: 12px; border-width: 1px;" onclick="javascript: c.Cases.Case.InternalFees.InternalFee.MultiCreateUpdate(c.Cases.Case.InternalFees.Payment.Application.CreateUpdateCallBack);"    value="申请付款" />
                <input type="button" class="btn  btn-normal" style="border-radius: 0;
                                                                        padding: 0 16px;
                                                                        height: 32px;
                                                                        line-height: 30px;
                                                                        font-size: 12px;
                                                                        border-width: 1px;" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');" value="取消" />
            </div>
        </div>
    </div>
</div>

