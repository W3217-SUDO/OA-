@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Newtonsoft.Json.Linq
@model Dchien.Legal.Web.Areas.FAM.ViewModels.Invoice.InvoiceModel 

<div class="modal fade" id="invoiceDateChangeModal">
    <div class="modal-dialog" >
        <div class="modal-content">
            @using (Html.BeginForm("InvoiceDateChange", "Invoice", FormMethod.Post, new {id = "invoiceNoChangeForm", @class = "form-horizontal ng-invalid ng-invalid-required"}))
            {
                <div class="modal-header">
                    <button type="button" class="close" id="btnInvoiceDateChangeClose">×</button>
                    <h5 class="modal-title ">修改发票日期</h5>
                </div>

                <div class="modal-body">

                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger"></span>
                                <span class="">请票单号</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.HiddenFor(m => m.Invoice.InvoiceBasic.InvoiceId)
                                @Html.TextBoxFor(m => m.Invoice.InvoiceBasic.InvoiceApplicationNo, new { @class = "input_text form-control", @readonly = true, @autocomplete = "off" })
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger"></span>
                                <span class="">发票申请日期</span>
                            </label>
                            <div class="col-sm-6">
                                
                                @Html.TextBoxFor(m => m.Invoice.InvoiceBasic.InvoiceApplicationDate, "{0:yyyy-MM-dd}", new { @style = "width:100%", @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger"></span>
                                <span>发票开票日期</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.Invoice.InvoiceBasic.InvoiceDate, "{0:yyyy-MM-dd}", new { @style = "width:100%", @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                            </div>
                        </div>
                    </div>
 

                </div>

                <div class="modal-footer">

                    <input class="btn btn-primary " type="button" id="btnInvoiceDateChange" value="确定" />
                    <input class="btn btn-default " type="button" id="btnInvoiceDateChangeCancel" value="取消" />
                </div>
            }

        </div>
    </div>
</div>

