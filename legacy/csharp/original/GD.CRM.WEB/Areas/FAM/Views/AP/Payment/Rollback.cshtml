@using Dchien.Legal.BizModel.FCM.Contract
@using Dchien.Legal.Service.IPR.Case
@model Dchien.Legal.Web.Areas.FAM.ViewModels.AP.Payment.PaymentModel
<script type="text/javascript" src="@Url.Content("~/Scripts/FAM/AP/FAM.AP.Payment.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/components.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/font-awesome.css")" />
<script type="text/javascript">

</script>
<style>
    input.input_text, textarea, select, input.input_time {
        border: 1px solid #ccc;
    }

    /*select {
        color: rgb(84, 84, 84);
        background-color: rgb(235, 235, 228);
    }*/

    input.input_text, textarea, input.input_time {
        padding: 2px 2px 2px 3px;
    }

    input.input_text, textarea, input.input_time {
        background-color: #fff;
    }

    .case-form-control {
        /*border-radius: 0px;*/
        -webkit-transition: none;
        transition: none;
        font-size: 12px;
        width: 100%;
        height: 24px;
    }

    .case-section-product .product-container .product-section .section-content .content-table td {
        padding-left: 1px;
    }


    .input_table th {
        padding: 2px;
        font-weight: normal;
        text-align: right;
    }

    .input_table td {
        padding: 2px;
        text-align: left;
    }

    .case-section-wrap {
        padding: 2px;
    }

    .case-section-main {
        margin: 0 3px;
        padding: 0px;
        position: relative;
    }
</style>
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/case.index.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/case.createupdate.console.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/messageCenter.console.css")" />
<div class="viewFramework-product " style='background: #eaedf1;'>
    @*<div class="viewFramework-product-navbar ng-scope">
        
        @{
            Html.RenderPartial("~/Areas/FAM/Views/AP/Payment/MenuList.cshtml");
        }
    </div> 
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>*@
    <div class="viewFramework-product-body">
        <div class="console-container ng-scope">
            <div class="ng-scope">
                 <div class="case-section-main clearfix" style="padding:0px">
                    <!-- 左侧 -->
                    <div class="case-section-left" style="padding-right: 0%;">
                        <div class="case-section-wrap">
                            <div class="case-section-product">
                                <!-- product section -->
                                <div class="product-container">
                                    <div class="product-section">
                                        <div class="section-content clearfix" style="padding: 0;">
                                            <div class="ng-scope">
                                                @Html.HiddenFor(m => m.Payment.PaymentBasic.PaymentId)
                                                <table class="input_table" style='width:100%; align-content:center'>
                                                    <tr>
                                                        <th colspan="8" style="text-align: center">
                                                            <span style='font-weight: bold; font-size: 10pt; '>付款信息-回滚</span>
                                                        </th>
                                                    </tr>
                                                    <tr>
                                                        <th>
                                                            <label for="Payment_PaymentBasic_CancelCause">回滚原因</label>
                                                        </th>
                                                        <td colspan="7" rowspan="1">
                                                            @Html.TextAreaFor(m => m.Payment.PaymentBasic.CancelCause, new { @class = "input_text case-form-control", style = "width:100%; height:42px", @rows = 4, @unselectable = "on" })
                                                        </td>
                                                    </tr>
  
                                                            <tr>
                                                                <th style="text-align:center" colspan="8" rowspan="1">
                                                                    <input class="btn btn-primary ng-binding" type="button" id="btnPaymentApplicationRollback" value="回滚" />
                                                                </th>
                                                            </tr>
                                                  
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="case-section-wrap">
                            <div class="case-section-product">
                                <!-- product section -->
                                <div class="product-container">
                                    <div class="product-section">
                                        @using (Html.BeginForm("PaymentView", "AP", FormMethod.Post, new { id = "paymentForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                                        {
                                            <div class="section-content clearfix" style="padding: 0;">
                                                <div class="ng-scope">
                                                    @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractId)
                                                    @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractNo)
                                                    @Html.HiddenFor(m => m.Customer.CustomerBasic.CustomerId)
                                                    @Html.HiddenFor(m => m.Customer.CustomerBasic.CustomerNo)
                                                    <table class="input_table" style='width:100%'>
                                                        <colgroup>
                                                            <col style="width: 8%;" />
                                                            <col style="width: 12%;" />
                                                            <col style="width: 8%;" />
                                                            <col style="width: 12%;" />
                                                            <col style="width: 8%;" />
                                                            <col style="width: 12%;" />
                                                            <col style="width: 8%;" />
                                                            <col style="width: 12%;" />
                                                            <col style="width: 8%;" />
                                                            <col style="width: 12%;" />
                                                        </colgroup>
                                                        <tr>
                                                            <th colspan="10" style="text-align: center">
                                                                <span style='font-weight: bold; font-size: 10pt; '>付款信息-查看</span>
                                                            </th>
                                                        </tr>

                                                        <tr>
                                                            <th>
                                                                @Html.LabelFor(m => m.Contract.ContractBasicInfo.ContractNo)
                                                            </th>
                                                            <td>
                                                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractId)
                                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.ContractNo, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Contract.ContractBasicInfo.ContractName)
                                                            </th>
                                                            <td colspan="3">
                                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.ContractName, new { @class = "input_text case-form-control", @unselectable = "on", @readonly = true })
                                                            </td>
                                                            <th>
                                                                缴费抬头
                                                            </th>
                                                            <td colspan="3">
                                                                @Html.TextBoxFor(m => m.Payment.PaymentBasic.PayerName, new { @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.ApplicationNo)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.Payment.PaymentBasic.ApplicationNo, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.ApplicantName)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.Payment.PaymentBasic.ApplicantName, new { @class = "input_text case-form-control", @unselectable = "on", @readonly = true })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.ApplicationDate)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.Payment.PaymentBasic.ApplicationDate, "{0:yyyy-MM-dd}", new { @class = "input_time case-form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @readonly = true })
                                                            </td>
                                                            <th>
                                                                最后期限
                                                            </th>
                                                            <td colspan="3"></td>
                                                        </tr>
                                                        <tr>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.Remark)
                                                            </th>
                                                            <td colspan="5" rowspan="1">
                                                                @Html.TextBoxFor(m => m.Payment.PaymentBasic.Remark, new { @class = "input_text case-form-control", @unselectable = "on", @readonly = true })
                                                             </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.OrganizationCode)
                                                            </th>
                                                            <th colspan="3">
                                                                @Html.TextBoxFor(m => m.Payment.PaymentBasic.OrganizationCode, new { @class = "input_text case-form-control", @unselectable = "on", @readonly = true })
                                                            </th>
                                                        </tr>
                                                        <tr>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentType.PaymentTypeName)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.Payment.PaymentType.PaymentTypeName, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                                @Html.HiddenFor(m => m.Payment.PaymentType.PaymentTypeId, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentType.OrganizationName)
                                                            </th>
                                                            <td colspan="3">
                                                                @Html.TextBoxFor(m => m.Payment.PaymentType.OrganizationName, new { @class = "input_text case-form-control", @unselectable = "on", @readonly = true })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentType.Account)
                                                            </th>
                                                            <td colspan="3">
                                                                @Html.TextBoxFor(m => m.Payment.PaymentType.Account, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>
                                                                @Html.LabelFor(m => m.Contract.ContractBasicInfo.APTotalAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.APTotalAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Contract.ContractBasicInfo.PaidCaseFeeAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.PaidCaseFeeAmount, new { @class = "input_text case-form-control", @unselectable = "on", @readonly = true })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Contract.ContractBasicInfo.UnPaidCaesFeeAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.UnPaidCaesFeeAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            <th>
                                                                @Html.LabelFor(m => m.Payment.PaymentBasic.PaidAmount)
                                                            </th>
                                                            <td>
                                                                @Html.TextBoxFor(m => m.Payment.PaymentBasic.PaidAmount, new { @readonly = true, @class = "input_text case-form-control", @unselectable = "on" })
                                                            </td>
                                                            <th>
                                                            </th>
                                                            <td></td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="case-section-wrap" style="padding-top: 0;">
                            <div class="case-section-product">
                                <!-- product section -->
                                <div class="product-container">
                                    <div class="product-section">
                                        <ul class="nav nav-tabs">
                                            <li id="liContractObjectList" class='active'><a href="javascript:void(0);" id="btnContractObjectList">付款信息</a></li>
                                            <li class="pull-right" style=" border:none">
                                                <div style="margin-top:3px">
                                                    <div style="text-align: inherit;">
                                                        <div style="text-align: right; padding-right: 8px; padding-bottom: 3px; float: right; display: inline;">
                                                        </div>
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                        <div class="section-content clearfix">
                                            <div class="product-col ng-scope" style="width: 100%">
                                                <div id="dv_List">
                                                    <div class="gridSection">
                                                        <div id='divContextList' style="overflow-y: auto; margin-top: -1px; overflow-x: hidden; overflow-y: auto; ">
                                                            <table class='table table-hover' id="tblAPObjectList" width="100%">
                                                                <colgroup>
                                                                    <col style="width: 4%">
                                                                    <col style="width: 6%">
                                                                    <col style="width: 15%">
                                                                    <col style="width: 10%">
                                                                    <col style="width: 10%">
                                                                    @if (Model.Payment != null && Model.Payment.PaymentType.CaseFeeTypeId == (int)Dchien.Legal.Entity.IPR.Case.CaseFeeTypeId.Office)
                                                                    {
                                                                        <col style="width: 10%">
                                                                        <col style="width: 5%">
                                                                    }
                                                                    else if (Model.Payment != null && Model.Payment.PaymentType.CaseFeeTypeId == (int)Dchien.Legal.Entity.IPR.Case.CaseFeeTypeId.Commission)
                                                                    {
                                                                        <col style="width: 5%">
                                                                    }

                                                                    <col style="width: 5%">
                                                                    <col style="width: 5%">
                                                                    <col style="width: 5%">
                                                                    <col style="width: 15%">
                                                                </colgroup>
                                                                <thead>
                                                                    <tr>
                                                                        <th>序号</th>
                                                                        <th>案件类型</th>
                                                                        <th>案件名称</th>
                                                                        <th>案号</th>
                                                                        <th>申请号</th>
                                                                        @if (Model.Payment != null && Model.Payment.PaymentType.CaseFeeTypeId == (int)Dchien.Legal.Entity.IPR.Case.CaseFeeTypeId.Office)
                                                                        {
                                                                            <th>官费类型</th>
                                                                            <th>官费</th>
                                                                        }
                                                                        else if (Model.Payment != null && Model.Payment.PaymentType.CaseFeeTypeId == (int)Dchien.Legal.Entity.IPR.Case.CaseFeeTypeId.Commission)
                                                                        {
                                                                            <th>其他费用</th>
                                                                        }

                                                                        <th>已收</th>
                                                                        <th>已付</th>
                                                                        <th>本次支付</th>
                                                                        <th>备注</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @{ var i = 1; }
                                                                    @if (Model.Payment != null && Model.Payment.PaymentObjects != null)
                                                                    {
                                                                        var caseFeeTypes = CaseTypeService.Instance.GetAllCaseFeeTypes();

                                                                        foreach (var item in Model.Payment.PaymentObjects)
                                                                        {
                                                                            var caseInfo = CaseService.Instance.GetCaseBasic(item.CaseId);

                                                                            <tr>
                                                                                <td>
                                                                                    <span>@(i++)</span>
                                                                                </td>
                                                                                <td style="text-align: center">
                                                                                    <span>@CaseTypeService.Instance.GetCaseType(caseInfo.CaseBasicInfo.CaseTypeId).CaseTypeName</span>
                                                                                </td>
                                                                                <td style="text-align: center">
                                                                                    <span>@caseInfo.CaseBasicInfo.CaseName</span>
                                                                                </td>
                                                                                <td style="text-align: center;">
                                                                                    <span>@caseInfo.CaseBasicInfo.CaseNo</span>
                                                                                </td>
                                                                                <td style="text-align: center;">
                                                                                    <span>@caseInfo.CaseBasicInfo.CaseRequestNo</span>
                                                                                </td>
                                                                                @if (Model.Payment.PaymentType.CaseFeeTypeId == (int)Dchien.Legal.Entity.IPR.Case.CaseFeeTypeId.Office)
                                                                                {
                                                                                    <td style="text-align: center;">
                                                                                        <span>@(item.CaseOfficeFeeTypeId.HasValue ? caseFeeTypes.FirstOrDefault(x => x.FeeTypeId == item.CaseOfficeFeeTypeId).FeeTypeName : "")</span>
                                                                                    </td>
                                                                                    <td style="text-align: center;">
                                                                                        <span>@(item.CaseOfficeFeeAmount.HasValue ? item.CaseOfficeFeeAmount.Value : 0)</span>
                                                                                    </td>
                                                                                    <td style="text-align: center;">
                                                                                        <span>@(item.CaseOfficeFeeCashedAmount.HasValue ? item.CaseOfficeFeeCashedAmount.Value : 0)</span>
                                                                                    </td>
                                                                                    <td style="text-align: center;">
                                                                                        <span>@(item.CaseOfficeFeePaidTotalAmount.HasValue ? item.CaseOfficeFeePaidTotalAmount.Value : 0)</span>
                                                                                    </td>
                                                                                    <td style="text-align: center;">
                                                                                        <span style="color:blue">@(item.CaseOfficeFeePaidAmount.HasValue ? item.CaseOfficeFeePaidAmount.Value : 0)</span>
                                                                                    </td>
                                                                                    if (item.CaseOfficeFeePrePaidTotalAmount > 0)
                                                                                    {
                                                                                        <td style="text-align: center"><span style="color:red">官费累计垫付  @(item.CaseOfficeFeePrePaidTotalAmount) 元</span></td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td style="text-align: center"></td>
                                                                                    }
                                                                                }
                                                                                else if (Model.Payment.PaymentType.CaseFeeTypeId == (int)Dchien.Legal.Entity.IPR.Case.CaseFeeTypeId.Commission)
                                                                                {
                                                                                    <td style="text-align: center">
                                                                                        <span>@(item.CaseCommissionFeeAmount.HasValue ? item.CaseCommissionFeeAmount.Value : 0)</span>
                                                                                    </td>
                                                                                    <td style="text-align: center">
                                                                                        <span>@(item.CaseCommissionFeeCashedAmount.HasValue ? item.CaseCommissionFeeCashedAmount.Value : 0)</span>
                                                                                    </td>
                                                                                    <td style="text-align: center">
                                                                                        <span>@(item.CaseCommissionFeePaidTotalAmount.HasValue ? item.CaseCommissionFeePaidTotalAmount.Value : 0)</span>
                                                                                    </td>
                                                                                    <td style="text-align: center">
                                                                                        <span>@(item.CaseCommissionFeePaidAmount.HasValue ? item.CaseCommissionFeePaidAmount.Value : 0)</span>
                                                                                    </td>

                                                                                    if (item.CaseCommissionFeePrePaidTotalAmount > 0)
                                                                                    {
                                                                                        <td style="text-align: center"><span style="color:red">其他费用累计垫付  @(item.CaseCommissionFeePrePaidTotalAmount) 元</span></td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td style="text-align: center"></td>
                                                                                    }
                                                                                }
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="i_common_select" id="divAssociateUserList" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                    <div class="i_common_select" id="div_customer" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
