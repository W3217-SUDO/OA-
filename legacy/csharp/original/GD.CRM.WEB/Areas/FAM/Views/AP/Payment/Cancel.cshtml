@using Dchien.Legal.BizModel.FCM.Contract
@using Dchien.Legal.Service.Legal.Case
@using Dchien.Legal.Service.BAS.Type

@model Dchien.Legal.Web.Areas.FAM.ViewModels.AP.Payment.PaymentModel
<link type="text/css" rel="stylesheet" href="https://g.alicdn.com/aliyun/ticketsystem/1.6.17//styles/ticketSystem/detail.css" />
<link type="text/css" rel="stylesheet" href="https://g.alicdn.com/aliyun/ticketsystem/1.6.17//styles/ticketSystem/tip.css" />
<link type="text/css" rel="stylesheet" href="https://g.alicdn.com/aliyun/ticketsystem/1.6.17//styles/ticketSystem/common.css" />
<script type="text/javascript" src="@Url.Content("~/Scripts/FAM/AP/FAM.AP.Payment.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<div class="viewFramework-product ">
    <div class="viewFramework-product-body">
        <div>
            <div class="console-container ">
                <div class="">
                    <div class="row ">
                        <div class="col-sm-12">
                            <div ui-view="myTicket">
                                <div class="ticket-detail ">
                                    <div class="console-title console-title-border clearfix">
                                        <h5 class="pull-left">付款撤回</h5>
                                    </div>
                                    <div class="margin-top-3"></div>

                                    @if (Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.AP.Payment.PaymentStatus.P
|| Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.AP.Payment.PaymentStatus.D
|| Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.AP.Payment.PaymentStatus.IA
|| Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.AP.Payment.PaymentStatus.Approved
|| Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.AP.Payment.PaymentStatus.R)
                                    {

                                    }
                                    else
                                    {
                                        <div class="case-notice-margin">
                                            <div class="console-global-notice">
                                                <div class="console-global-notice-list">
                                                    <div class="alert alert-success console-global-notice-item">
                                                        <div class="clearfix console-global-notice-item-inner">
                                                            <div class="console-global-notice-content ng-binding">
                                                                付款状态为 @Model.Payment.PaymentBasic.PaymentStatusName ,不能撤回.
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div style="margin-top:12px" class="ng-isolate-scope">
                                        <div class="console-step row step-bar">
                                            <div class="step col-md-3  step-first ">
                                                <span class="">付款信息填写</span>
                                            </div>
                                            <div class="step col-md-3  ">
                                                <span class="">提交申请</span>
                                            </div>
                                            <div class="step col-md-3   step-active">
                                                <span class="">财务审批</span>
                                            </div>
                                            <div class="step col-md-3  step-end">
                                                <span class="">财务付款</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="table-viewer-header clearfix">
                                        <span class="table-viewer-topbar-title">
                                            <span>付款撤回</span>
                                        </span>
                                    </div>

                                    <div class="table-content">
                                        <form class="chat-form form-horizontal form-horizontal ng-invalid ng-invalid-required">
                                            <div class="simple-form-field ng-scope ng-isolate-scope hide">
                                                <input type="hidden" class="ng-scope">
                                            </div>
                                            <div class="simple-form-field ng-scope ng-isolate-scope">
                                                <div class="form-group ng-scope">
                                                    <div class="col-sm-8">
                                                        @Html.TextAreaFor(m => m.Payment.PaymentBasic.CancelCause, new { @class = "form-control", placeholder = "撤回原因", style = "width:100%;", @rows = 3, @unselectable = "on" })
                                                    </div>
                                                </div>
                                            </div><div class="simple-form-field ng-scope ng-isolate-scope">
                                                <div secret-content-check=""
                                                     data="result.content"
                                                     class="ng-scope ng-isolate-scope"></div>
                                            </div>
                                            <div class="simple-form-field ng-scope ng-isolate-scope">

                                                <div class="form-group simple-form-submit ng-scope" style="margin-bottom:0px">
                                                    <label for="submit5" class="col-sm-12 control-label"><span class="ng-binding"></span></label>
                                                    <div class="col-sm-4">
                                                        @{if (Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.AP.Payment.PaymentStatus.P
    || Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.AP.Payment.PaymentStatus.D
    || Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.AP.Payment.PaymentStatus.IA
    || Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.AP.Payment.PaymentStatus.Approved
    || Model.Payment.PaymentBasic.PaymentStatus == Dchien.Legal.Entity.FAM.AP.Payment.PaymentStatus.R)
                                                            {
                                                              
                                                                     <input class="btn btn-primary ng-binding" type="button" id="btnPaymentApplicationCancel" value="撤回" />
                                                                
                                                            }

                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>

                                    <div class="info-panel" style="margin-top:12px">
                                        <div class="row" style="margin-top:4px">
                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>合同编号</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractId)
                                                    @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractNo)
                                                    @Html.HiddenFor(m => m.Customer.CustomerBasic.CustomerId)
                                                    @Html.HiddenFor(m => m.Customer.CustomerBasic.CustomerNo)
                                                    @Html.HiddenFor(m => m.Payment.PaymentBasic.ApplicationNo)
                                                    @Html.HiddenFor(m => m.Payment.PaymentBasic.ApplicationDate)
                                                    @Html.HiddenFor(m => m.Payment.Audit.AuditId)
                                                    @Html.HiddenFor(m => m.Payment.PaymentBasic.PaymentId)
                                                    @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.ContractNo)
                                                </span>
                                            </div>

                                            <div class="col-sm-2 ">
                                                <span class="text-explode">
                                                    <span>合同名称</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.ContractName)
                                                </span>
                                            </div>

                                            <div class="col-sm-2 ">
                                                <span class="text-explode">
                                                    <span>客户名称</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Customer.CustomerBasic.CustomerName)
                                                </span>
                                            </div>

                                            <div class="col-sm-4 ">
                                                <span class="text-explode">
                                                    <span>交款人</span>
                                                    <span>:</span>
                                                </span>
                                                <span> @Html.DisplayTextFor(m => m.Payment.PaymentBasic.PayerName) </span>
                                            </div>

                                        </div>
                                        <div class="row" style="margin-top:4px">
                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>申请编号</span>
                                                    <span>:</span>
                                                </span>
                                                <span class="">
                                                    @Html.DisplayTextFor(m => m.Payment.PaymentBasic.ApplicationNo)
                                                </span>
                                            </div>

                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>销售代表</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.BusinessOwnerName)
                                                </span>
                                            </div>
                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>申请日期</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    <span class=""> @Html.DisplayFor(m => m.Payment.PaymentBasic.ApplicationDate) </span>
                                                </span>
                                            </div>

                                            <div class="col-sm-4 ">
                                                <span class="text-explode">
                                                    <span>备&nbsp&nbsp&nbsp注</span>
                                                    <span>:</span>
                                                </span>
                                                <span> @Html.DisplayTextFor(m => m.Payment.PaymentBasic.Remark) </span>
                                            </div>

                                        </div>

                                        <div class="row" style="margin-top:4px">
                                            <div class="col-sm-2 ">
                                                <span class="text-explode">
                                                    <span>
                                                        <input id="Payment_PaymentType_PaymentTypeName" name="Payment.PaymentType.PaymentTypeName" type="hidden" value="">
                                                        <input id="Payment_PaymentType_PaymentTypeId" name="Payment.PaymentType.PaymentTypeId" type="hidden" value="">
                                                        <input id="Payment_PaymentType_CaseFeeTypeId" name="Payment.PaymentType.CaseFeeTypeId" type="hidden" value="">
                                                        <input id="Payment_PaymentType_OrganizationName" name="Payment.PaymentType.OrganizationName" type="hidden" value="">
                                                        <input id="Payment_PaymentType_AccountBank" name="Payment.PaymentType.AccountBank" type="hidden" value="">
                                                        <input id="Payment_PaymentType_Account" name="Payment.PaymentType.Account" type="hidden" value="">
                                                        收款单位
                                                    </span>
                                                    <span>:</span>
                                                </span>
                                                <span> @Html.DisplayTextFor(m => m.Payment.PaymentType.OrganizationName) </span>
                                            </div>

                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>开户行</span>
                                                    <span>:</span>
                                                </span>
                                                <span> @Html.DisplayTextFor(m => m.Payment.PaymentType.AccountBank) </span>
                                            </div>

                                            <div class="col-sm-2 ">
                                                <span class="text-explode">
                                                    <span>帐号信息</span>
                                                    <span>:</span>
                                                </span>
                                                <span> @Html.DisplayTextFor(m => m.Payment.PaymentType.Account) </span>
                                            </div>
                                            <div class="col-sm-5">
                                                <span>


                                                </span>
                                            </div>
                                        </div>


                                    </div>

                                </div>

                            </div>

                            <div class="case-section-wrap" style="padding-top: 12px;">
                                <div class="case-section-product">
                                    <!-- product section -->
                                    <div class="product-container">
                                        <div class="product-section">
                                            <ul class="nav nav-tabs">
                                                <li id="liContractObjectList" class='active'><a href="javascript:void(0);" id="btnContractObjectList">付款信息</a></li>
                                                <li class="pull-right" style="border:none">
                                                    <div style="margin-top:3px">
                                                        <div style="text-align: inherit;">
                                                            <div style="text-align: right; padding-right: 8px; padding-bottom: 3px; float: right; display: inline;">

                                                            </div>
                                                        </div>
                                                    </div>
                                                </li>
                                            </ul>
                                            <div class="section-content clearfix">
                                                <div class="product-col " style="width: 100%">

                                                    <div id="dv_List">
                                                        <div class="gridSection">
                                                            <div id='divContextList' style="overflow-y: auto; overflow-x: hidden; overflow-y: auto; ">
                                                                <table class='table table-hover' id="tblAPObjectList" width="100%">
                                                                    <colgroup>
                                                                        <col style="width: 4%">
                                                                        <col style="width: 10%">
                                                                        <col style="width: 15%">

                                                                        <col style="width: 8%">
                                                                        <col style="width: 15%">
                                                                        <col style="width: 8%">
                                                                        <col style="width: 6%">
                                                                        <col style="width: 6%">
                                                                        <col style="width: 6%">
                                                                        <col style="width: 12%">
                                                                    </colgroup>
                                                                    <thead>
                                                                        <tr>
                                                                            <th>序号</th>
                                                                            <th>案件类型</th>
                                                                            <th>案件名称</th>
                                                                            <th>案号</th>
                                                                            <th>费用类型</th>
                                                                            <th>费用金额</th>
                                                                            <th>已收</th>
                                                                            <th>已付</th>
                                                                            <th>本次支付</th>
                                                                            <th>备注</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @{ var i = 1; }
                                                                        @if (Model.Payment != null && Model.Payment.PaymentObjects != null)
                                                                        {
                                                                            var caseFeeTypes = CaseTypeService.Instance.GetAllCaseFeeTypes();

                                                                            foreach (var item in Model.Payment.PaymentObjects.OrderBy(x => x.CaseNo))
                                                                            {
                                                                                var caseInfo = CaseService.Instance.GetCaseBasic(item.CaseNo);

                                                                                <tr>
                                                                                    <td>
                                                                                        <span>@(i++)</span>
                                                                                    </td>
                                                                                    <td style="text-align: center">
                                                                                        <span>@CaseTypeService.Instance.GetCaseType(caseInfo.Basic.CaseTypeId.Value).CaseTypeName</span>
                                                                                    </td>
                                                                                    <td style="text-align: center">
                                                                                        <span>@caseInfo.Basic.CaseName</span>
                                                                                    </td>
                                                                                    <td style="text-align: center;">
                                                                                        <span>@caseInfo.Basic.CaseNo</span>
                                                                                    </td>

                                                                                    <td style="text-align: center;">
                                                                                        <span>@(item.CaseFeeTypeId.HasValue ? caseFeeTypes.FirstOrDefault(x => x.FeeTypeId == item.CaseFeeTypeId).FeeTypeName : "")</span>
                                                                                    </td>
                                                                                    <td style="text-align: center;">
                                                                                        <span>@(item.CaseFeeAmount.HasValue ? item.CaseFeeAmount.Value : 0)</span>
                                                                                    </td>
                                                                                    <td style="text-align: center;">
                                                                                        <span>@(item.CaseFeeCashedAmount.HasValue ? item.CaseFeeCashedAmount.Value : 0)</span>
                                                                                    </td>
                                                                                    <td style="text-align: center;">
                                                                                        <span>@(item.CaseFeePaidTotalAmount.HasValue ? item.CaseFeePaidTotalAmount.Value : 0)</span>
                                                                                    </td>
                                                                                    <td style="text-align: center;">
                                                                                        <span style="color:blue">@(item.CaseFeePaidAmount.HasValue ? item.CaseFeePaidAmount.Value : 0)</span>
                                                                                    </td>

                                                                                    @if (item.CaseFeePrePaidTotalAmount > 0)
                                                                                    {
                                                                                        <td style="text-align: center"><span style="color:red">费用累计垫付  @(item.CaseFeePrePaidTotalAmount) 元</span></td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td style="text-align: center"></td>
                                                                                    }


                                                                                </tr>
                                                                            }
                                                                        }
                                                                    </tbody>

                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


