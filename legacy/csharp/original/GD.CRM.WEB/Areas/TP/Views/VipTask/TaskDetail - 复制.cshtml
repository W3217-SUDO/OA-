@using Dchien.Legal.Entity.System
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.TP.ViewModels.Task.TaskModel

<link type="text/css" rel="stylesheet" href="https://g.alicdn.com/aliyun/ticketsystem/1.6.17//styles/ticketSystem/detail.css" />
<link type="text/css" rel="stylesheet" href="https://g.alicdn.com/aliyun/ticketsystem/1.6.17//styles/ticketSystem/tip.css" />
<link type="text/css" rel="stylesheet" href="https://g.alicdn.com/aliyun/ticketsystem/1.6.17//styles/ticketSystem/common.css" />

@*<script src="@Url.Content("~/Scripts/TP/Task/TP.Task.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/TP/Task/TP.Task.Message.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>*@

<div class="viewFramework-product">
 
    <div class="viewFramework-product-body">
        <div>
            <div class="console-container ng-scope">
                <div class="ng-scope">
                    <div class="row ng-scope">
                        <div class="col-sm-12">
                            <div ui-view="myTicket">
                                <div class="ticket-detail ng-scope">
                                    <div class="console-title console-title-border clearfix">
                                        <h5 class="pull-left">任务详情</h5>
                                        @*<a class="btn btn-xs btn-toinstlist pull-left" href="#/ticket/list/">
                                            <span class="icon-toinstlist"></span>
                                            <span>返回列表</span>
                                        </a>*@
                                    </div>
                                    <div class="margin-top-3"></div>
                                    <div style="margin-top:12px" class="ng-isolate-scope">
                                        <div class="console-step row step-bar">
                                            @if (Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Pending)
                                            {
                                                <div class="step col-md-3 ng-scope step-first step-active">
                                                    <span class="ng-binding">任务已分派</span>
                                                </div>

                                                <div class="step col-md-3 ng-scope  ">
                                                    <span class="ng-binding">任务处理中</span>
                                                </div>

                                                <div class="step col-md-3 ng-scope ">
                                                    <span class="ng-binding">任务完成</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope step-end">
                                                    <span class="ng-binding">待确认处理结果</span>
                                                </div>
                                              
                                            }
                                            else if (Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Processing)
                                            {
                                                <div class="step col-md-3 ng-scope step-first step-pass ">
                                                    <span class="ng-binding">任务已分派</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope  step-active">
                                                    <span class="ng-binding">任务处理中</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope">
                                                    <span class="ng-binding">任务完成</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope step-end">
                                                    <span class="ng-binding">待确认处理结果</span>
                                                </div>
                                            }
                                            else if (Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Finished)
                                            {
                                                <div class="step col-md-3 ng-scope step-first step-pass ">
                                                    <span class="ng-binding">任务已分派</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope  step-pass">
                                                    <span class="ng-binding">任务处理中</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope  step-pass">
                                                    <span class="ng-binding">任务完成</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope  step-active step-end">
                                                    <span class="ng-binding">待确认处理结果</span>
                                                </div>
                                            }

                                            else if (Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Rejected)
                                            {
                                                <div class="step col-md-3 ng-scope step-first step-pass ">
                                                    <span class="ng-binding">任务已分派</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope step-pass">
                                                    <span class="ng-binding">任务处理中</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope   step-pass ">
                                                    <span class="ng-binding">任务已拒绝</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope  step-active step-end">
                                                    <span class="ng-binding">待确认处理结果</span>
                                                </div>
                                            }

                                            else if (Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Checked)
                                            {
                                                <div class="step col-md-3 ng-scope step-first step-pass ">
                                                    <span class="ng-binding">任务已分派</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope step-pass">
                                                    <span class="ng-binding">任务处理中</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope step-pass">
                                                    <span class="ng-binding">任务完成</span>
                                                </div>
                                                <div class="step col-md-3 ng-scope  step-active step-end">
                                                    <span class="ng-binding">任务已验收</span>
                                                </div>
                                            }

                                            @*<div class="step col-md-3 ng-scope step-end">
                                                <span class="ng-binding">待评价</span>
                                            </div>*@
                                        </div>
                                    </div>
                                    <div class="info-panel" style="margin-top:12px">
                                        <div class="row" style="margin-top:4px">
                                            <div class="col-sm-6 ng-binding">
                                                <span class="text-explode">
                                                    <span>任务标题</span>
                                                    <span>:</span>
                                                </span>  @Html.DisplayTextFor(m => m.Task.TaskTitle)
                                            </div>

                                        </div>
                                        <div class="row" style="margin-top:4px">
                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>任务编号 @Html.HiddenFor(m => m.Task.TaskId)</span>
                                                    <span>:</span>
                                                </span>
                                                <span class="ng-binding"> @Html.DisplayTextFor(m => m.Task.TaskNo)</span>
                                            </div>

                                            <div class="col-sm-2 ng-binding">
                                                <span class="text-explode">
                                                    <span>负责人</span>
                                                    <span>:</span>
                                                </span> @Html.DisplayTextFor(m => m.Task.OfficerName)
                                            </div>

                                            <div class="col-sm-2 ng-binding">
                                                <span class="text-explode">
                                                    <span>发布人</span>
                                                    <span>:</span>
                                                </span> @Html.DisplayTextFor(m => m.Task.InitiatorName)
                                            </div>
                                        </div>
                                        <div class="row" style="margin-top:4px">
                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>关联案号</span>
                                                    <span>:</span>
                                                </span>
                                                <span class="ng-binding">
                                                    <a href="javascript:void(0);" onclick="javascript: caseInfo.View(@Model.Task.CaseId,'@Model.Task.CaseNo');">@Html.DisplayTextFor(m => m.Task.CaseNo)</a>
                                                </span>
                                            </div>

                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>截止日期</span>
                                                    <span>:</span>
                                                </span> @Html.DisplayFor(m => m.Task.TaskEndTime)
                                            </div>
                                            <div class="col-sm-2">
                                                <span class="text-explode">
                                                    <span>状态</span>
                                                    <span>:</span>
                                                </span>
                                                <span>
                                                    <span class="">@Html.DisplayTextFor(m => m.Task.TaskStatusName)</span>
                                                </span>
                                            </div>
                                            <div class="col-sm-6">
                                                <span class="pull-right">



                                                    @if (Model.Task.IsActived  && Model.Task.Initiator.Equals(LoginHelper.GetUserName())
                                                        && (Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Pending
                                                        || Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Processing
                                                        || Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Finished
                                                        ))
                                                    {
                                                        if (Model.Task.IsActived && Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Finished)
                                                        {
                                                            <a class="operation-link ng-scope" href="javascript:void(0);" onclick="javascript: task.Task.ReOpen();">重新打开</a>
                                                            <a class="operation-link ng-scope" href="javascript:void(0);" onclick="javascript: task.Task.Checked();">确认已完成</a>
                                                        }
                                                        <a class="operation-link ng-scope" href="javascript:void(0);" onclick="javascript: task.Task.Delete();" >删除任务</a>
                                                    }

                                                    else if (Model.Task.IsActived && Model.Task.Initiator.Equals(LoginHelper.GetUserName())
                                                      && (Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Rejected))

                                                    {
                                                        <a class="operation-link ng-scope" href="javascript:void(0);" onclick="javascript: task.Task.ReOpen();">重新打开</a>
                                                        <a class="operation-link ng-scope" href="javascript:void(0);" onclick="javascript: task.Task.Delete();">删除任务</a>
                                                    }

                                                    else if (Model.Task.IsActived && Model.Task.Officer.Equals(LoginHelper.GetUserName())
                                                        && (Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Pending))
                                                    {
                                                        <a class="operation-link ng-scope" href="javascript:void(0);" onclick="javascript: task.Task.Process();" >处理任务</a>
                                                        <a class="operation-link ng-scope" href="javascript:void(0);" onclick="javascript: task.Task.Finished();">任务完成</a>
                                                        <a class="operation-link ng-scope" href="javascript:void(0);" onclick="javascript: task.Task.Rejected();" >拒绝任务</a>
                                                    }

                                                    else if (Model.Task.IsActived && Model.Task.Officer.Equals(LoginHelper.GetUserName())
                                                      && (Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Processing))
                                                    {
                                                        <a class="operation-link ng-scope" href="javascript:void(0);" onclick="javascript: task.Task.Finished();">任务完成</a>
                                                        <a class="operation-link ng-scope" href="javascript:void(0);" onclick="javascript: task.Task.Rejected();">拒绝任务</a>
                                                    }

                                                    @if (CommonService.Instance.CheckPermission((int)Dchien.Legal.Entity.Account.Permission.Task_FinishedChecking))
                                                    {
                                                        <a class="operation-link ng-scope" href="javascript:void(0);" onclick="javascript: task.Task.Checked();">后台确认已完成</a>
                                                    }

                                                 </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="table-viewer-header clearfix">
                                <span class="table-viewer-topbar-title">
                                    <span>沟通记录</span>
                                </span>
                            </div>
                            <div class="table-content">
                                <div class="ng-scope">
                                    <div class="clearfix ng-scope">
                                            <div  id="taskMessags"></div>
                                    </div>
                                </div>
                            </div>

                            @if ((Model.Task.IsActived) && (Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Pending 
                                || Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Processing 
                                || Model.Task.TaskStatus == Dchien.Legal.Entity.TP.Task.TaskStatus.Finished))
                            {
                                <div class="ng-scope">
                                    <div class="table-viewer-header clearfix">
                                        <span class="table-viewer-topbar-title">
                                            <span>我要反馈</span>
                                        </span>
                                    </div>
                                    <div class="table-content">
                                        <form class="chat-form form-horizontal form-horizontal ng-invalid ng-invalid-required">
                                            <div class="simple-form-field ng-scope ng-isolate-scope hide">
                                                <input type="hidden" class="ng-scope">
                                            </div>
                                            <div class="simple-form-field ng-scope ng-isolate-scope">
                                                <div class="form-group ng-scope">
                                                    <label for="textarea1" class="col-sm-12 control-label">
                                                        <span class="text-danger ng-binding"></span> <span class="ng-binding">留言</span>
                                                    </label>
                                                    <div class="col-sm-8">
                                                        <textarea id="message_content" type="text" class="form-control ng-pristine ng-invalid ng-invalid-required ng-valid-maxlength"
                                                                  rows="5" placeholder="此处限定5000字符"
                                                                  name="message.content" required="required"></textarea>
                                                        <div class="help-block ng-scope ng-binding ng-hide">此处限定5000字符</div>

                                                    </div>
                                                </div>
                                            </div><div class="simple-form-field ng-scope ng-isolate-scope">
                                                <div secret-content-check=""
                                                     data="result.content"
                                                     class="ng-scope ng-isolate-scope"></div>
                                            </div>
                                            <div class="simple-form-field ng-scope ng-isolate-scope">

                                                <div class="form-group simple-form-submit ng-scope">
                                                    <label for="submit5" class="col-sm-12 control-label"><span class="ng-binding"></span></label>
                                                    <div class="col-sm-4">
                                                        <a href="javascript:void(0);" class="btn btn-primary " id="btnMessageCreate">
                                                            <span>提交</span>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            }
                           
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



