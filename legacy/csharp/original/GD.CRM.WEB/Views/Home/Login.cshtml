                                        <div id="idNumber" class="sf"><span class="mini-textbox sf" id="idNumber_mini" style="border-width: 0px; padding: 0px; width: 100%;"><span class="mini-textbox-border"><input type="text" class="mini-textbox-input" autocomplete="off" placeholder="" id="idNumber$text"></span><input type="hidden" id="idNumber$value" name="idNumber"></span></div>
                                    </div>
                                </div>*@
                                <div id="loginPanel">
                                    <div class="login-field">
                                        <label for="username" class="login-label"> 账户：</label>
                                        <div id="username" class="sf"><span class="mini-textbox sf" id="username_mini" style="border-width: 0px; padding: 0px; width: 100%;"><span class="mini-textbox-border"><input type="text" class="mini-textbox-input" autocomplete="off" placeholder="用户名" id="fm-login-id"></span><input type="hidden" name="yhm"></span></div>
                                    </div>
                                </div>
                                <div class="login-field">
                                    <label for="password" class="login-label"> 密码：</label>
                                    <div id="password" class="sf"><span class="mini-textbox mini-password sf" id="password_mini" style="border-width: 0px; padding: 0px; width: 125px;"><span class="mini-textbox-border"><input type="password" class="mini-textbox-input" autocomplete="off" placeholder="" id="fm-login-password"></span><input type="hidden" name="mm"></span></div>
                                </div>
                                <div class="login-field auth">
                                    <label for="authCode" class="login-label"> 验证码：</label>
                                    <i class="auth-pass"></i>
                                    <div id="authCode" class="sf"><span class="mini-textbox sf" id="authCode_mini" style="border-width: 0px; padding: 0px; width: 100%;"><span class="mini-textbox-border"><input type="text" class="mini-textbox-input" autocomplete="off" placeholder="" id="fm-login-authCode" maxlength="4"></span><input type="hidden" name="authCode"></span></div>
                                    @Html.Captcha()
                                </div>
                                <a class="mini-button login-btn" href="javascript:void(0)" id="loginBtn"><span class="mini-button-text">登录</span></a>
                                <div class="ctn-link clearfix">
                                    <a id="toRegister" class="login-reg" href="javascript:void(0);">没有账号？<em class="em">立即注册</em></a>
                                    <a class="login-forget" href="javascript:void(0);">忘记密码？</a>
                                </div>
                                <div id="redirect_uri"><input type="hidden" class="mini-hidden" id="redirect_uri_mini" value="" name="redirect_uri"></div>
                                <div id="response_type"><input type="hidden" class="mini-hidden" id="response_type_mini" value="" name="response_type"></div>
                                <div id="client_id"><input type="hidden" class="mini-hidden" id="client_id_mini" value="" name="client_id"></div>
                                <div id="sign"><input type="hidden" class="mini-hidden" id="sign_mini" value="" name="sign"></div>
                                <div id="st" data-param-rsapubkey="REDACTED_ARCHIVE_ONLY" data-param-token="REDACTED_ARCHIVE_ONLY"><input type="hidden" class="mini-hidden" id="st_mini" value="" name="st"></div>
