@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.CRM.ViewModels.LawFirm.EditModel

@{
    object htmlAttribute = null;
}

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>

@{
    var title = Model.LawFirm.LawFirmId > 0 ? "修改律所" : "新增律所";
}

<div class="modal fade" id="lawFirmModal" tabindex="-1">
    <div class="modal-dialog" style="width:850px">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" data-ng-click="close(false)" aria-hidden="true" id="btnClose">×</button>
                    <h5 class="modal-title ng-binding">@title</h5>
                </div>
                @*<div style="padding-left:10px;padding-right:10px">
                    <div class="margin-top-2 alert alert-info">
                        <b>提醒：</b><span style="color:#F00" class="ng-binding">@title</span>
                    </div>
                </div>*@
                <div class="modal-body">
                    @*<form class="form-horizontal ng-invalid ng-invalid-required" id="contactListAddForm">*@
                    <form class="form-horizontal ng-invalid ng-invalid-required" id="lawFirmForm">
                        <link rel="stylesheet" href="@Url.Content("~/Resource/css/lawfirm.createupdate.console.css")" />
                        @Html.HiddenFor(m => m.LawFirm.LawFirmId)
                        @Html.HiddenFor(m => m.LawFirm.DefaultContacts.ContactsId)
                        <div style="background: #eaedf1;">

                            <div class="ng-scope">

                                <div class="lawfirm-section-main clearfix">
                                    <!-- 左侧 -->
                                    <div class="lawfirm-section-left">
                                        <div class="lawfirm-section-wrap">
                                            <div class="lawfirm-section-product">
                                                <!-- product section -->
                                                <div class="product-container">
                                                    <div class="product-section">
                                                        <!--</div>--><!--</div>-->
                                                        <div class="section-head lawfirm-cursor-pointer">
                                                            <a class="ng-binding">
                                                                <span class="list-title-em">基本信息</span>
                                                            </a>
                                                        </div>
                                                        <div class="section-content clearfix">
                                                            <div class="ng-scope">
                                                                <div class="gridSection">
                                                                    <table id="tblLawFirm" class="content-table">
                                                                        <colgroup>
                                                                            <col style="width: 15%;" />
                                                                            <col style="width: 30%" />
                                                                            <col style="width: 20%" />
                                                                            <col style="width: 30%" />
                                                                        </colgroup>
                                                                        <tr>
                                                                            <th>@Html.LabelFor(m => m.LawFirm.LawFirmNo) </th>
                                                                            <td>
                                                                                @Html.TextBoxFor(m => m.LawFirm.LawFirmNo, new { @readonly = true })
                                                                            </td>

                                                                            <th>@Html.LabelFor(m => m.LawFirm.LawFirmName) </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.LawFirmName, new { @required = "true" })</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.Zip)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.Zip, htmlAttribute)</td>

                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.Telphone)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.Telphone, htmlAttribute)</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.Fax)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.Fax, htmlAttribute)</td>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.Email)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.Email, htmlAttribute)</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.LawFirmCode)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.LawFirmCode, htmlAttribute)</td>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.CompanyCode)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.CompanyCode, htmlAttribute)</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>@Html.LabelFor(m => m.LawFirm.RegisteredAddress)</th>
                                                                            <td colspan="3">@Html.TextBoxFor(m => m.LawFirm.RegisteredAddress, new { maxlength = 250, style = "width:99%" })</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.BusinessAddress)
                                                                            </th>
                                                                            <td colspan="3">@Html.TextBoxFor(m => m.LawFirm.BusinessAddress, new { maxlength = 250, style = "width:99%" })</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.DetailAddress)
                                                                            </th>
                                                                            <td colspan="3">@Html.TextBoxFor(m => m.LawFirm.DetailAddress, new { maxlength = 250, style = "width:99%" })</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.DefaultContacts.ContactAddress)
                                                                            </th>
                                                                            <td colspan="3">@Html.TextBoxFor(m => m.LawFirm.DefaultContacts.ContactAddress, new { maxlength = 250, style = "width:99%" })</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.DefaultContacts.Contacts)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.DefaultContacts.Contacts,  new { @required = "true" })</td>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.DefaultContacts.ContactZip)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.ContactZip, htmlAttribute)</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.DefaultContacts.OfficePhone)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.ContactTelphone, htmlAttribute)</td>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.DefaultContacts.ContactFax)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.ContactFax, htmlAttribute)</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.DefaultContacts.ContactEmail)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.ContactEmail, htmlAttribute)</td>

                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.Country)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.Country, htmlAttribute)</td>
                                                                        </tr>
                                                                    </table>
                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div><!-- 右侧 --><!-- ngIf: !hideBusinessPart -->
                                    <div class="lawfirm-section-right ng-scope">
                                        <!-- banner区域 -->
                                        <div class="lawfirm-section-wrap">
                                            <div class="lawfirm-section-product">
                                                <!-- product section -->
                                                <div class="product-container">
                                                    <div class="product-section">
                                                        <!--</div>--><!--</div>-->
                                                        <div class="section-head lawfirm-cursor-pointer">
                                                            <a class="ng-binding">
                                                                <span class="list-title-em">@Html.LabelFor(m => m.LawFirm.LicenseFileName)</span>
                                                            </a>

                                                            @*<a href="javascript:void(0)" id="btnUploading">上传执照</a>*@

                                                            <span class="ng-scope" style="float: right; ">
                                                                <a href="javascript:void(0);" id="btnLicenseUploading" class="ng-scope" style="color: #06C; cursor: pointer;">
                                                                    <span class="icon-add"></span>
                                                                    <span>上传执照</span>
                                                                </a>
                                                                @*<button id="btnUploadingLicense">上传执照</button>*@
                                                                @*<span style="color: #666666">（最多保存5个地址）</span>*@
                                                            </span>
                                                        </div>


                                                        <div class="section-content clearfix">
                                                            <div class="ng-scope">
                                                                <div class="gridSection">
                                                                    <table class="content-table">
                                                                        <tr>
                                                                            <td align="center" style=" padding-left: 5px; padding-right: 5px">
                                                                                <input type="image" id="imgLicense" src="@Url.Content(Model.LawFirm.LicenseFullPath)" disabled style="width: 90%; height: 210px; " />
                                                                            </td>
                                                                        </tr>
                                                                    </table>
                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="lawfirm-section-wrap">
                                            <div class="lawfirm-section-product">
                                                <!-- product section -->
                                                <div class="product-container">
                                                    <div class="product-section">
                                                        <div class="section-content clearfix">
                                                            <div class="ng-scope">
                                                                <div class="gridSection">
                                                                    <table class="content-table">
                                                                        <colgroup>
                                                                            <col style="width: 30%;" />
                                                                            <col style="width: 60%" />

                                                                        </colgroup>
                                                                        <tr>
                                                                            <th>@Html.LabelFor(m => m.LawFirm.LawFirmTypeId) </th>
                                                                            <td>@Html.DropDownListFor(m => m.LawFirm.LawFirmTypeId, PublicMethod.LawFirmTypeList(), htmlAttribute)</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.LawFirmLevelId)
                                                                            </th>
                                                                            <td>@Html.DropDownListFor(m => m.LawFirm.LawFirmLevelId, PublicMethod.LawFirmLevelList(), htmlAttribute)</td>
                                                                        </tr>
                                                                        <tr>
                                                                            <th>
                                                                                @Html.LabelFor(m => m.LawFirm.CreateUser)
                                                                            </th>
                                                                            <td>@Html.TextBoxFor(m => m.LawFirm.CreateUser, htmlAttribute)</td>
                                                                        </tr>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary ng-binding" id="btnCreateUpdate">确定</button>
                    <button class="btn btn-default ng-binding" id="btnCancle">取消</button>
                </div>

            </div>
        </div>
    </div><!-- /.modal -->
</div>

<div id="licenseUploading" class="licenseUploading"></div>
