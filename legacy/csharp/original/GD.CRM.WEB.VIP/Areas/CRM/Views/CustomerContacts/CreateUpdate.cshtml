@using Dchien.Legal.Common
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.CRM.ViewModels.Customer.ContactsModel

@{
    var title = Model.Contacts != null ? "修改联系人" : "新增联系人";
}

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>

<div class="modal fade" id="customerContactsModal">
    <div class="modal-dialog" style="width:850px">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                <div class="modal-header">
                    <button type="button" class="close" id="btnCustomerContactsClose">×</button>
                    <h5 class="modal-title ng-binding">@title</h5>
                </div>

                <div class="modal-body" style="padding:10px;">
                    <form class="form-horizontal ng-invalid ng-invalid-required" id="customerContactsForm">
                        <link rel="stylesheet" href="@Url.Content("~/Resource/css/customer.createupdate.console.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" />
                        @Html.HiddenFor(m => m.Contacts.CustomerId)
                        @Html.HiddenFor(m => m.Contacts.CustomerNo)
                        @Html.HiddenFor(m => m.Contacts.ContactsId)
                        @Html.HiddenFor(m => m.Contacts.ContactsGuid)
                        @Html.HiddenFor(m => m.Contacts.PhotoFileName)
                        <div style="background: #eaedf1;">
                            <div class="customer-section-main clearfix">
                                <div class="customer-section-left" style="padding-right:220px">
                                    <div class="customer-section-wrap" >
                                        <div class="customer-section-product" >
                                            <div class="product-container">
                                                <div class="product-section">
                                                    <div class="section-head customer-cursor-pointer">
                                                        <a class="ng-binding">
                                                            <span class="list-title-em">基本信息</span>
                                                        </a>
                                                    </div>
                                                    <div class="section-content " style="margin-bottom: 15px; ">
                                                        <div class="ng-scope">
                                                            <div class="gridSection">
                                                                <table id="tblCustomerContacts" class="input_table" width="100%">
                                                                    <colgroup>
                                                                        <col style="width: 17%;" />
                                                                        <col style="width: 33%" />
                                                                        <col style="width: 17%" />
                                                                        <col style="width: 33%" />
                                                                    </colgroup>
                                                                    <tr>
                                                                        <th style="text-align:right"><span class="text-danger ng-binding">*</span>@Html.LabelFor(m => m.Contacts.Contacts) </th>
                                                                        <td>@Html.TextBoxFor(m => m.Contacts.Contacts, new { @class = "input_text form-control", @unselectable = "on" })</td>

                                                                        <th style="text-align:right">@Html.LabelFor(m => m.Contacts.ContactsTitle) </th>
                                                                        <td>
                                                                            @Html.TextBoxFor(m => m.Contacts.ContactsTitle, new { @class = "input_text form-control", @unselectable = "on" })
                                                                        </td>
                                                                    </tr>
                                                                    <tr>
                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.ProjectRole)
                                                                        </th>
                                                                        <td>@Html.TextBoxFor(m => m.Contacts.ProjectRole, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.Intention)
                                                                        </th>
                                                                        <td>@Html.TextBoxFor(m => m.Contacts.Intention, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.FocusPoint)
                                                                        </th>
                                                                        <td>@Html.TextBoxFor(m => m.Contacts.FocusPoint, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                        <th style="text-align:right">
                                                                            <span class="text-danger ng-binding">*</span> @Html.LabelFor(m => m.Contacts.Email)
                                                                        </th>
                                                                        <td>@Html.TextBoxFor(m => m.Contacts.Email, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.OfficePhone)
                                                                        </th>
                                                                        <td>@Html.TextBoxFor(m => m.Contacts.OfficePhone, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.HomePhone)
                                                                        </th>
                                                                        <td>@Html.TextBoxFor(m => m.Contacts.HomePhone, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                    </tr>

                                                                    <tr>
                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.IsReceivedEmail)
                                                                        </th>
                                                                        <td>
                                                                            @Html.DropDownListFor(m => m.Contacts.IsReceivedEmail, CommonService.Instance.GetTrueFalseList(), new { @class = "form-control", @style = "width:100%" })
                                                                        </td>
                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.IM)
                                                                        </th>
                                                                        <td>@Html.TextBoxFor(m => m.Contacts.IM, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <th style="text-align:right">
                                                                            <span class="text-danger ng-binding">*</span> @Html.LabelFor(m => m.Contacts.ContactAddress)
                                                                        </th>
                                                                        <td colspan="3">
                                                                            @Html.TextBoxFor(m => m.Contacts.ContactAddress, new { @class = "input_text form-control", @unselectable = "on" })
                                                                        </td>

                                                                    </tr>

                                                                    <tr>
                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.ContactZip)
                                                                        </th>
                                                                        <td>
                                                                            @Html.TextBoxFor(m => m.Contacts.ContactZip, new { @class = "input_text form-control", @unselectable = "on" })
                                                                        </td>
                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.IsContacted)
                                                                        </th>
                                                                        <td>
                                                                            @Html.DropDownListFor(m => m.Contacts.IsContacted, CommonService.Instance.GetTrueFalseList(), new { @class = "form-control", @style = "width:100%" })
                                                                        </td>
                                                                    </tr>

                                                                    <tr>
                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.IsPeopleBASE)
                                                                        </th>
                                                                        <td>
                                                                            @Html.DropDownListFor(m => m.Contacts.IsPeopleBASE, CommonService.Instance.GetTrueFalseList(), new { @class = "form-control", @style = "width:100%" })
                                                                        </td>
                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.IsActived)
                                                                        </th>
                                                                        <td>
                                                                            @Html.DropDownListFor(m => m.Contacts.IsActived, CommonService.Instance.GetTrueFalseList(), new { @class = "form-control", @style = "width:100%" })
                                                                        </td>
                                                                    </tr>

                                                                    <tr>
                                             

                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.MobilePhone)
                                                                        </th>
                                                                        <td>@Html.TextBoxFor(m => m.Contacts.MobilePhone, new { @class = "input_text form-control", @unselectable = "on" })</td>
                                                                        <th style="text-align:right">
                                                                            @Html.LabelFor(m => m.Contacts.OrgPassword)
                                                                        </th>
                                                                        <td>
                                                                            @Html.TextBoxFor(m => m.Contacts.OrgPassword, new { @class = "input_text form-control", @unselectable = "on" })
                                                                        </td>
                                                                    </tr>

                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="customer-section-right" style="width: 220px">
                                    <div class="customer-section-wrap">
                                        <div class="customer-section-product">
                                            <div class="product-container">
                                                <div class="product-section">
                                                    <div class="section-head customer-cursor-pointer">
                                                        <a class="ng-binding">
                                                            <span class="list-title-em">@Html.LabelFor(m => m.Contacts.PhotoFileName)</span>
                                                        </a>
                                                        <span class="ng-scope" style="float: right; ">
                                                            <a href="javascript:void(0);" id="btnCustomerContactsPhotoCreate" class="ng-scope" style="color: #06C; cursor: pointer;">
                                                                <span class="icon-add"></span>
                                                                <span>上传照片</span>
                                                            </a>
                                                        </span>
                                                    </div>

                                                    <div class="section-content clearfix">
                                                        <div class="ng-scope">
                                                            <div class="gridSection">
                                                                <table class="content-table">
                                                                    <tr>
                                                                        <td align="center" style="padding-top: 5px; padding-left: 5px; padding-right: 5px; padding-bottom: 5px; ">
                                                                            <a id="aimgContactsPhoto" href="@Url.Content(Model.Contacts.PhotoFileFullPath)" target="_blank">
                                                                                <img id="imgContactsPhoto" width="100%" height="225px" src="@Url.Content(Model.Contacts.PhotoFileFullPath)">
                                                                            </a>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary ng-binding" id="btnCustomerContactsCreateUpdate">保存</button>
                    <button class="btn btn-default ng-binding" id="btnCustomerContactsCancel">取消</button>
                    <div class="i_common_select" id="divUserList" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- /.modal -->
</div>
