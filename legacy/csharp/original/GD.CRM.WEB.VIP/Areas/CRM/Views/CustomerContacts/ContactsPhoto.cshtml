@using Dchien.Legal.Common

@model Dchien.Legal.Web.Areas.CRM.ViewModels.Customer.ContactsPhotoModel

<div class="modal fade" id="contactsPhotoModal"  >
    <style>
        .btn-expense-file-upload input {
            position: absolute;
            top: 0px;
            right: 0px;
            left: 0px;
            bottom: 0px;
            opacity: 0;
            filter: alpha(opacity=0);
            overflow: hidden;
        }
    </style>

   
        <div class="modal-dialog" style="width:560px">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("ContactsPhotoUpload", "CustomerContacts", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.ContactsId)
                        @Html.HiddenFor(m => m.CustomerNo)
                        @Html.HiddenFor(m => m.ContactsGuid)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnContactsPhotoUploadClose">×</button>
                            <h5 class="modal-title ng-binding">上传联系人照片</h5>
                        </div>
                        <div style="padding-left:10px;padding-right:10px">
                            <div class="margin-top-2 alert alert-info">
                                <b>提醒：</b><span style="color:#F00" class="ng-binding">重新上传后，原上传联系人照片将被替换。</span>
                            </div>
                        </div>
                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">上传联系人照片</span>
                                    </label>
                                    <div class="col-sm-6">
                                        <div class="form-control-wrap">
                                            <input id="txtContactsPhotoFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control ng-valid" style=" display: inline-block">
                                            <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                                <input type="file" value="" id="flContactsPhotoFile" name="flContactsPhotoFile" style="height: 40px; width: 250px; margin-left: 10px;">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnContactsPhotoUpload" value="上传" />
                            <input class="btn btn-default ng-binding" type="button" id="btnContactsPhotoUploadCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div>
</div>
