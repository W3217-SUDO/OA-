@model Dchien.Legal.Web.Areas.CRM.ViewModels.CustomerFile.CustomerFileUpload

<div class="modal fade" id="customerFileUploadModal"  >
    <style>
        .btn-expense-file-upload input {
            position: absolute;
            top: 0px;
            right: 0px;
            left: 0px;
            bottom: 0px;
            opacity: 0;
            filter: alpha(opacity=0);
            overflow: hidden;
        }
    </style>

    <script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>

    <div class="modal-dialog">
        <div class="modal-content">

            @using (Html.BeginForm("CustomerFileUploading", "CustomerFile", FormMethod.Post, new { id = "uploadForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
            {
                @Html.HiddenFor(m => m.CustomerGuid)
 
                <div class="modal-header">
                    <button type="button" class="close" id="btnCustomerFileUploadClose">×</button>
                    <h5 class="modal-title ">上传客户文件</h5>
                </div>

                <div class="modal-body">
                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger ">*</span>
                                <span class="">客户文件</span>
                            </label>
                            <div class="col-sm-5">
                                <div class="form-control-wrap">
                                    <input id="txtCustomerFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control ng-valid" style=" display: inline-block">
                                    <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                        <input type="file" value="" id="flCustomerFile" name="flCustomerFile" style="height: 40px; width: 200px; margin-left: 10px;">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span class="text-danger">*</span>
                                    <span class="spanreferencedate">是否营业执照</span>
                                </label>
                                <div class="col-sm-6">
                                     @Html.CheckBoxFor(m => m.IsLicense, new { @style = "height: 28px;width: 10%;font-size: 12px" })
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <input class="btn btn-primary " type="button" id="btnCustomerFileUpload" value="上传" />
                    <input class="btn btn-default " type="button" id="btnCustomerFileUploadCancel" value="取消" />
                </div>

            }
        </div>

    </div>
</div>


