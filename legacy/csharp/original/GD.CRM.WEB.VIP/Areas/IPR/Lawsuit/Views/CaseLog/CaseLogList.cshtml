@using Dchien.Legal.Common
@using Dchien.Legal.Entity
@using Dchien.Legal.Entity.Account
@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseLogListModel

@{
    var display = "display:block";

    if (@Model.CaseLogs != null && @Model.CaseLogs.Count > 0)
    {
        display = "display:none";
    }
}

<form id="postForm" action="">
    <div id="casegridSection" class="gridSection">
        <table id='tblCaseLogHeader' class="list_table" style='width:100%;margin-top: 0px; margin-bottom: 0px;'>
            <colgroup>
                <col style="width: 5%" />
                <col style="width: 75%" />
                <col style="width: 10%" />
                <col style="width: 10%" />
            </colgroup>
            <thead>
                <tr>
                    <th style="text-align: center">
                        序号
                    </th>
                    
                    <th style="text-align: left">
                        内容
                    </th>
 
                    <th style="text-align: center">
                        操作人
                    </th>
                    <th style="text-align: center">
                        操作时间 
                    </th>
                </tr>
            </thead>

        </table>
        <div class="context" id='divContextList' style="height:555px; overflow-y: auto; ">
            <table class="list_table" id="tblCaseLog" style='width:100%; margin-top: -1px; margin-bottom: 0px;'>
                <colgroup>
                    <col style="width: 5%" />
                    <col style="width: 75%" />
                    <col style="width: 10%" />
                    <col style="width: 10%" />
                </colgroup>

                <tbody>
                    @if (Model.CaseLogs != null)
                    {
                        foreach (var item in Model.CaseLogs)
                        {
                            <tr>
                                <td>
                                    <span >@item.LogId</span>
                                </td>
                                <td>
                                    <span>@item.Content</span>
                                </td>
                                <td>
                                    <span>@item.Operator</span>
                                </td>
                                <td>
                                    <span>@(item.OperatorDate.HasValue ? item.OperatorDate.Value.ToString("yyyy-MM-dd") : "")</span>
                                </td>
          
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="ng-scope" style="display:none">
                    <tr>
                        <td colspan="4">
                            <div class="pull-left"></div>
                            <div class="ng-scope">
                                <div class="pull-right page-box caselog">

                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>

            </table>
            <div class="simple-grid-none-data-wrap" style="@display">
                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                        <div class="text-size-16 tip-text inline-block">
                            <span class="margin-left ng-binding"></span>没有查询到案件日志
                            <span class="ng-binding">.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    @Html.HiddenFor(m => m.TotalCount, new { name = "TotalCount" })
    @Html.HiddenFor(m => m.PageNo, new { name = "PageNo" })
    @Html.HiddenFor(m => m.PageSize, new { name = "PageSize" })

</form>

