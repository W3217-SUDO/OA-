@using Dchien.Legal.Common
@using Dchien.Legal.Service.Lawsuit.Case
@model Dchien.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseModel

@{
    object htmlAttribute = null;
}

@using (Html.BeginForm("CaseInfo", "Case", FormMethod.Post, new { id = "caseForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
{
    <div class="ng-scope">

        @Html.HiddenFor(m => m.CaseId)
        @Html.HiddenFor(m => m.Case.CaseBasicInfo.CompanyId)
        @Html.HiddenFor(m => m.Case.CaseBasicInfo.CaseNo)
        @Html.HiddenFor(m => m.Case.CaseBasicInfo.DeadlineLeftDays)
        @Html.TextBoxFor(m => m.Case.CaseBasicInfo.ReminderDate, "{0:yyyy-MM-dd}", new { @style = "display:none" })
        @Html.HiddenFor(m => m.Case.CaseFirstInstance.CaseFirstInstanceId)
        @Html.HiddenFor(m => m.Case.CaseBasicInfo.CaseOriginPeople)

        <table class="input_table" style="width:100%" id='tabCase'>
            <colgroup>
                <col style="width: 8%;" />
                <col style="width: 17%" />
                <col style="width: 8%;" />
                <col style="width: 17%" />
                <col style="width: 8%;" />
                <col style="width: 17%" />
                <col style="width: 8%;" />
                <col style="width: 17%" />
            </colgroup>
            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.CauseId)
                    @Html.HiddenFor(m => m.Case.CaseBasicInfo.CauseId)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.CauseName, new { @class = "case-form-control", @readonly = true, @unselectable = "on" })
                </td>
                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.CasePhaseId)
                </th>
                <td>
                    @{
    htmlAttribute = new { maxlength = 60, @class = "case-form-control" };
                    }

                    @Html.DropDownListFor(m => m.Case.CaseBasicInfo.CasePhaseId, CaseTypeService.Instance.GetCasePhaseList(), htmlAttribute)

                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.CaseLawyer)
                    @Html.HiddenFor(m => m.Case.CaseFirstInstance.CaseLawyer)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.CaseLawyerName, new { @class = "case-form-control",  @unselectable = "on" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.Assistant)
                    @Html.HiddenFor(m => m.Case.CaseFirstInstance.Assistant)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.AssistantName, new { @class = "case-form-control",  @unselectable = "on" })
                </td>


            </tr>
            <tr>

                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.CourtId)
                    @Html.HiddenFor(m => m.Case.CaseFirstInstance.CourtId)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.CourtName, new { @class = "case-form-control", @unselectable = "on" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.CaseJudge)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.CaseJudge, new { @class = "case-form-control", @unselectable = "on" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.CourtCasetNo)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.CourtCasetNo, new { @class = "case-form-control", @unselectable = "on" })

                </td>


                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.CaseRegisterDate)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.CaseRegisterDate, "{0:yyyy-MM-dd}", new { @class = "case-form-control input_time ", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                </td>

            </tr>

            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.CaseProsecutor)
                    @Html.HiddenFor(m => m.Case.CaseFirstInstance.CaseProsecutor)
                </th>

                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.CaseProsecutorName, new { @readonly = true, @class = "case-form-control " })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.HolderOfRelationship)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.HolderOfRelationship, new { @class = "case-form-control " })
                </td>
                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.CaseDefendant)
                    @Html.HiddenFor(m => m.Case.CaseFirstInstance.CaseDefendant)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.CaseDefendantName, new { @readonly = true, @class = "case-form-control " })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.DetermineTheway)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.DetermineTheway, new { @class = "case-form-control " })
                </td>
            </tr>
            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.CaseLawfulDate)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.CaseLawfulDate, "{0:yyyy-MM-dd}", new { @class = "case-form-control input_time ", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.Deadline)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.Deadline, "{0:yyyy-MM-dd}", new { @class = "case-form-control input_time ", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.CaseSubmitter)
                    @Html.HiddenFor(m => m.Case.CaseBasicInfo.CaseSubmitter)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.CaseSubmitterName, new { @readonly = true, @class = "case-form-control " })
                </td>


                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.CaseOfficer)
                    @Html.HiddenFor(m => m.Case.CaseBasicInfo.CaseOfficer)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.CaseOfficerName, new {  @class = "case-form-control " })
                </td>
            </tr>

            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.TheThird)
                    @Html.HiddenFor(m => m.Case.CaseFirstInstance.TheThird)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.TheThirdName, new { @class = "case-form-control " })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.TheThirdRelationship)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseFirstInstance.TheThirdRelationship, new { @class = "case-form-control " })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseFirstInstance.CaseCustomerAs)
                </th>
                <td>
                    @Html.DropDownListFor(m => m.Case.CaseFirstInstance.CaseCustomerTypeId, CaseTypeService.Instance.GetCaseCustomerTypeList(), htmlAttribute)
                </td>
            </tr>
        </table>

    </div>
}
