@using Dchien.Legal.Service
@using Dchien.Legal.Entity.System;

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseListModel
<script type="text/javascript">

</script>
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<script src="@Url.Content("~/Scripts/IPR/Case/Case.Patent.List.Search.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("MenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>案件列表</h5>
                            </div>
                        </div>


                        <div class="pull-left margin-top-1 col-sm-12" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm" action="@Url.Content("~/IPR/CaseList/List")">
                                @Html.HiddenFor(m => m.SearchCondition.PageId, new { name = "PageId" })
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                                <table class="search_table" style="width: 100%">
                                    <colgroup>
                                        <col style="width: 80px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 85px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px;" />
                                        <col style="width: 80px;" />
                                        <col style="width: 80px;" />
                                        <col style="width: 80px;" />
                                        <col>
                                    </colgroup>
                                    <tr>
                                        <th>
                                            客户名称：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CustomerName, new { @class = "form-control", @placeholder = "客户名称" })
                                        </td>
                                        <th>
                                            案号/申请号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseNos, new { @class = "form-control", @placeholder = "案号/申请号", @style = "" })
                                        </td>
                                        <th>
                                            案件类型：
                                        </th>
                                        <td>
                                            @Html.HiddenFor(m => m.SearchCondition.CaseTypeId)
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseTypeName, new { @class = "form-control", @placeholder = "案件类型", @style = "" })
                                        </td>

                                    </tr>

                                    <tr>
                                        <th>
                                            案件阶段：
                                        </th>
                                        <td>
                                            @Html.HiddenFor(m => m.SearchCondition.CasePhaseId)
                                            @Html.TextBoxFor(m => m.SearchCondition.CasePhaseName, new { @class = "form-control", @placeholder = "案件阶段", @style = "" })
                                        </td>

                                        <th>
                                            撰稿人：
                                        </th>
                                        <td>
                       
                                                @Html.TextBoxFor(m => m.SearchCondition.CaseCopywriterName, new { @class = "form-control", @placeholder = "撰稿人", @style = "" })
                                            

                                        </td>

                                        <th>
                                            代理人：
                                        </th>
                                        <td>
                  
                                                @Html.TextBoxFor(m => m.SearchCondition.CaseProcuratorName, new { @class = "form-control", @placeholder = "代理人", @style = "" })
                                           
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>
                                            案源人：
                                        </th>
                                        <td>
                               
                                                @Html.TextBoxFor(m => m.SearchCondition.CaseOriginPeopleName, new { @class = "form-control", @placeholder = "案源人", @style = "" })
                                            
                                        </td>
                                        <th>
                                            申请日：
                                        </th>
                                        <td colspan="2">
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseRequestDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseRequestDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </td>
                                        <td>
                                            <label class="control-label">
                                                @Html.CheckBoxFor(m => m.SearchCondition.SearchByMonthAndDay, new { style = "vertical-align:middle" })<span class="">按月日</span>
                                            </label>
                                        </td>
                                    </tr>

                                    <tr>

                                        <th>
                                            处理人：
                                        </th>
                                        <td>
                                                @Html.TextBoxFor(m => m.SearchCondition.CaseOfficerName, new { @class = "form-control", @placeholder = "处理人", @style = "" })
                                        </td>

                                        <th>
                                            处理日期：
                                        </th>
                                        <td colspan="2">
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseDeadlineFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseDeadlineTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </td>

                                        <td colspan="3">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnCaseSearch">
                                                <span>过滤</span>
                                            </a>
                                            <a href="javascript:void(0);" class="btn btn-default " id="btnCaseSearchReset">
                                                <span>重置</span>
                                            </a>
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnCaseExportToExcel">
                                                <span>导出Excel</span>
                                            </a>
                                            @*<a href="javascript:void(0);" class="btn btn-primary " id="btnCaseExportToExcel">
                                                <span>查询条件保存</span>
                                            </a>*@
                                        </td>
                                    </tr>

                                    <tr style="display:none">

                                        <th>
                                            文件类型：
                                        </th>
                                        <td>
                                            @Html.HiddenFor(m => m.SearchCondition.CaseFileTypeId)
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseFileTypeName, new { @class = "form-control", @placeholder = "文件类型", @style = "" })
                                        </td>

                                        <th>
                                            文档日期：
                                        </th>
                                        <td colspan="2">
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseFileDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseFileDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </td>

                                    </tr>

                                    <tr style="display:none">
                                        <th>
                                            费用类型：
                                        </th>
                                        <td>
                                            @Html.HiddenFor(m => m.SearchCondition.CaseFeeTypeId)
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseFeeTypeName, new { @class = "form-control", @placeholder = "费用类型", @style = "" })
                                        </td>
                                        <th>
                                            通知日期：
                                        </th>
                                        <td colspan="2">
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseFeeInformDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseFeeInformDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </td>
                                    </tr>

                                    <tr style="display:none">
                                        <th>
                                            资助类别：
                                        </th>
                                        <td>
                                            @Html.HiddenFor(m => m.SearchCondition.CaseAssistedTypeId)
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseAssistedTypeName, new { @class = "form-control", @placeholder = "资助类别", @style = "" })
                                        </td>
                                        <th>
                                            资助办理日期：
                                        </th>
                                        <td colspan="2">
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseAssistedDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseAssistedDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </td>

                                    </tr>

                                </table>
                                <div class='divcaseconditioncasephases'></div>
                                <div class='divcaseconditioncasetypes'></div>
                                <div style="display: none;" id="divUserList">
                                    @Html.Partial("~/Areas/IPR/Views/IPRBase/UserList.cshtml")
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="">
                            <div class="gridSection">
                                <table id="tblCaseList" class="table table-hover">
                                    <colgroup>
                                        <col style="width: 3%">
                                        <col style="width: 8%">
                                        <col style="width: 15%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th width="10">
                                                <input type="checkbox" id="chkCaseAll" class="ng-pristine ng-valid">
                                            </th>
                                            <th style="text-align: center">案件编号</th>
                                            <th style="text-align: center">客户名称</th>
                                            <th style="text-align: center">案件类型</th>
                                            <th style="text-align: center">案件阶段</th>
                                            <th style="text-align: center">申请号</th>
                                            <th style="text-align: center">申请日</th>
                                            <th style="text-align: center">案源人</th>
                                            <th style="text-align: center">代理人</th>
                                            <th style="text-align: center">撰稿人</th>
                                            <th style="text-align: center">处理人</th>
                                            <th style="text-align: center">截止日</th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td>
                                                &nbsp;
                                            </td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="" style="display: none">
                                        <tr>
                                            <td colspan="12">
                                                <div class="pull-left"></div>
                                                <div class="">
                                                    <div class="pull-right page-box Caselist">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>


                            </div>
                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="i_common_select" id="div_customer" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>



                </div>
            </div>
        </div>

        <div class="contextMenu" id="menu" style="display: none;">
            <ul>
                <li id="treeView">案件树形显示</li>
                <li id="transfer">转文(同一客户)</li>
                <li id="push">多案件批量处理</li>
                <li id="fileImport">多案件上传文档</li>
            </ul>
        </div>
    </div>
</div>
