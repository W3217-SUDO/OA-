@using Dchien.Legal.Entity.System
@using Dchien.Legal.Service.IPR.Case
@using Dchien.Legal.Service
@using Dchien.Legal.Entity.IPR.Case
@using Dchien.Legal.Service.FAM.AR.CaseFee
@{
    var controller = ViewContext.RouteData.Values["controller"].ToString().ToLower();
    var action = ViewContext.RouteData.Values["action"].ToString().ToLower();
    var id = string.Empty;
    if (ViewContext.RouteData.Values.ContainsKey("id"))
    {
        id = ViewContext.RouteData.Values["id"].ToString().ToLower();
    }
    var actived = "active";

    var menus = MenuService.Instance.GetMenusByCurrentUser();
}
<div class="product-nav-stage ng-scope product-nav-stage-main" >
    <div class="product-nav-scene product-nav-main-scene"  >
        <div class="product-nav-title ng-binding"  >商标转票</div>
        <div class="ng-isolate-scope"></div>
        <div class="product-nav-list">
            <ul class="top-level">
                @if (menus.FirstOrDefault(m => m.MenuCode == PageId.PageId_1001012001) != null)
                {
                    actived = id == PageId.PageId_1001012001 ? "class=active" : "";

                    <li @actived>
                        <div class="ng-isolate-scope">
                            <a href=@Url.Content(string.Format("~/{0}/IPR/CaseTrademarkOfficeInvoiceFile/List", PageId.PageId_1001012001)) class="ng-scope" style="width:220px">
                                <div class="nav-icon"></div>
                                @{
                                    var serach = new CaseFeeFileSearchCondition();
                                    serach.UserId = LoginHelper.GetUserName();
                                    serach.AccessLevel = (Dchien.Legal.Entity.Account.AccessLevel)LoginHelper.GetAccesslevel();
                                    serach.FeeTypeIds.Add((int)CaseFeeType.FeeType41001);

                                    serach.PageId = PageId.PageId_1001012001;
                                    serach.IsTransmitted = false;
                                    serach.HasInvocieFile = true;

                                    var totalCount = CaseFeeFileSearchService.Instance.GetCaseFeeFileListTotalCount(serach);
                                }
                                <div class="nav-title ng-binding" >转申请费收据(@totalCount)</div>
                            </a>

                        </div>
                    </li>
                }

                @if (menus.FirstOrDefault(m => m.MenuCode == PageId.PageId_1001012002) != null)
                {
                    actived = id == PageId.PageId_1001012002 ? "class=active" : "";

                    <li @actived>
                        <div class="ng-isolate-scope">
                            <a href=@Url.Content(string.Format("~/{0}/IPR/CaseTrademarkOfficeInvoiceFile/List", PageId.PageId_1001012002)) class="ng-scope" style="width:220px">
                                <div class="nav-icon"></div>
                                @{
                                    var serach = new CaseFeeFileSearchCondition();
                                    serach.UserId = LoginHelper.GetUserName();
                                    serach.AccessLevel = (Dchien.Legal.Entity.Account.AccessLevel)LoginHelper.GetAccesslevel();
                                    serach.FeeTypeIds.Add((int)CaseFeeType.FeeType42001);
                                    serach.PageId = PageId.PageId_1001012002;
                                    serach.IsTransmitted = false;
                                    serach.HasInvocieFile = true;

                                    var totalCount = CaseFeeFileSearchService.Instance.GetCaseFeeFileListTotalCount(serach);
                                }
                                <div class="nav-title ng-binding" style="width:188px">转代理费发票(@totalCount)</div>
                            </a>
                        </div>
                    </li>
                }

                @if (menus.FirstOrDefault(m => m.MenuCode == PageId.PageId_1001012099) != null)
                {
                    actived = id == PageId.PageId_1001012099 ? "class=active" : "";

                    <li @actived>
                        <div class="ng-isolate-scope">
                  
                                    <a href=@Url.Content(string.Format("~/{0}/IPR/CaseTrademarkOfficeInvoiceFile/List", PageId.PageId_1001012099)) class="ng-scope" style="width:220px">
                                        <div class="nav-icon"></div>
                                        <div class="nav-title ng-binding" style="width:188px">转商标官费收据</div>
                                    </a>
                             
                        </div>
                    </li>
                }
      
            </ul>
        </div>
    </div>
 
</div>