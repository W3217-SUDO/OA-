@{
    ViewBag.Title = "客户列表";
}

@using SunHold.Legal.Common
@model SunHold.Legal.Web.Areas.IPR.ViewModels.Customer.IndexModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />

<script src="@Url.Content("~/Scripts/IPR/Customer/Customer.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div ng-transclude="">
    <div class="console-container ng-scope">
        <div class="row ng-scope">
            <div class="col-sm-12">
                <div class="console-title console-title-border clearfix">
                    <div class="pull-left">
                        <h5 class="ng-binding">客户列表</h5>
                    </div>
                </div>
                <div class="pull-left margin-top-1 col-sm-12">
                    <form class="form-inline ng-valid ng-valid-required" id="postForm" action="@Url.Content("~/IPR/Customer/List")">
                        @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                        @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                        @Html.HiddenFor(m => m.CustomerTypeId)
                        
                        <div class="simple-form-field">
                            <div class="form-group ">
                                <label class="control-label">
                                    <span contenteditable="" class="text-danger "></span>
                                    <span class="">客户名称：</span>
                                </label>
                                <div class="form-control-wrap">
                                    @Html.TextBoxFor(m => m.SearchCondition.CustomerName, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="simple-form-field  ">
                            <div class="form-group  ">
                                <label class="  control-label">
                                    <span class="">
                                    </span>
                                </label>
                                <div class="form-control-wrap text-right">
                                    <a href="javascript:void(0);" class="btn btn-primary " id="btnCustomerSearch">
                                        <span>查询</span>
                                    </a>
                                </div>
                                <div class="form-control-wrap text-right">
                                    <a href="javascript:void(0);" class="btn btn-primary " id="btnCustomerCreate">
                                        <span>新增客户</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-sm-12">

                <div class="ng-scope">
                    <div class="gridSection">
                        <table id="tblCustomerList" class="table table-hover" style="margin-bottom: 57px;">
                            <thead>
                                <tr>
                                    <th>
                                        客户编号
                                    </th>
                                    <th>
                                        客户名称
                                    </th>
                                    <th>
                                        注册地址
                                    </th>
           
                                    <th>
                                        客户电话
                                    </th>
                                    
                                    <th>
                                        机构代码
                                    </th>
                                    <th>
                                        用户代码
                                    </th>
                                    <th>
                                        操作
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="display: none">
                                    <td>
                                        &nbsp;
                                    </td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                            <tfoot class="ng-scope" style="display: none">
                                <tr>
                                    <td colspan="7">
                                        <div class="pull-left"></div>
                                        <div class="ng-scope">
                                            <div class="pull-right page-box customer">

                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                    </div>

                    <div class="contactsList"></div>

                    <div class="contacts"></div>

                    <div class="simple-grid-none-data-wrap">
                        <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                            <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                <div class="text-size-16 tip-text inline-block">
                                    <span class="margin-left ng-binding">没有查询到符合条件的记录，可以去</span>
                                    <a href="javascript:void(0);" class="customerCreate ng-binding">新增客户</a>
                                    <span class="ng-binding">。</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>


