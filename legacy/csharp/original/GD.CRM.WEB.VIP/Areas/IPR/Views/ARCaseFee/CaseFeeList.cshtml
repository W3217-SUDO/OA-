@using Dchien.Legal.Common
@using Dchien.Legal.Entity
@using Dchien.Legal.Entity.Account
@using Dchien.Legal.Entity.FAM.AR.CaseFee
@using Dchien.Legal.Entity.IPR.Case
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.AR.CaseFeeListModel

<form id="postForm" action="">
    <div id="casegridSection" class="gridSection">
        <div class="context" id='divContextList' style="overflow-y: auto; ">
            <table class="table table-hover " id="tblCaseFee" style='width: 100%; margin-top: 0px; margin-bottom: 0px;'>
                <colgroup>
                    <col style="width: 3%">
                    <col style="width: 12%">
                    <col style="width: 18%">
                    <col style="width: 7%">
                    <col style="width: 8%">
                    <col style="width: 9%">
                    <col style="width: 8%">
                    <col style="width: 9%">
                    <col style="width: 7%">
                    <col style="width: 7%">
                    <col style="width: 9%">
                    <col style="width: 7%">
                    <col style="width: 7%">
                 </colgroup>

                <thead>
                    <tr>
                        <th>
                        </th>
                        <th>
                            合同编号
                        </th>
                        <th style="text-align: left">
                            费用类型
                        </th>
                        <th>
                            金额
                        </th>
                        <th>
                            提交人
                        </th>
   
                        <th>
                            通知日期
                        </th>
                        <th>
                            回款确认人
                        </th>
                        <th>
                            回款日期
                        </th>
                        <th>
                            回款金额
                        </th>
                        <th>
                            票据确认人
                        </th>
                        <th>
                            开票/交费日期
                        </th>
                        <th>
                            发票号
                        </th>
                        <th>
                            付款金额
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.CaseFeeList != null)
                        {
                            var c = CaseService.Instance.GetCaseBasic(Model.CaseId);

                            foreach (var item in Model.CaseFeeList)
                            {
                            <tr class="caseFee">
                                <td>
                                    <input type="checkbox" name="chkCaseFeeId" casefeetypeid="@item.CaseFeeTypeId" contractid="@item.ContractId" batchNo="@item.BatchNo" casefeetypename="@item.CaseFeeTypeName" value="@item.CaseFeeId">
                                </td>
                                <td>
                                   @if (c.CaseBasicInfo.BusinessOwner == LoginHelper.GetUserName())
                                   {
                                        <a style='color: #039' href="javascript:void(0);" onclick="javascript:contract.Contract.View('@item.ContractId'); "><span>@item.ContractNo </span></a>
                                   }
                                   else {
                                        <span>@item.ContractNo </span> 
                                   }

                                </td>
                                <td class="feeId" style="display:none">
                                    @Html.HiddenFor(m => item.CaseFeeId)
                                    @Html.HiddenFor(m => item.ContractId)
                                    @Html.HiddenFor(m => item.CaseNo)
                                    @Html.HiddenFor(m => item.BatchNo)
                                    @Html.HiddenFor(m => item.InvoiceFile.InvoiceFileName)
                                    @*@(Model.CaseFees.IndexOf(item) + 1)*@
                                    @item.CaseFeeId
                                </td>
                                @*<td>
                                <span>@item.CaseNo</span>
                            </td>*@
                                <td style="text-align: left">
                                    
                                        (@item.CaseFeeTypeId) 
                                        @{
                                            var feeTypeName = string.Empty;
                                            if ((item.CaseFeeTypeId == (int)CaseFeeType.FeeType11020
                                                || item.CaseFeeTypeId == (int)CaseFeeType.FeeType21020
                                                || item.CaseFeeTypeId == (int)CaseFeeType.FeeType31020) && item.IsFirstYear)
                                            {
                                                feeTypeName = "首年年费" + "[" + item.AnnualYear + "]";
                                            }else if (item.CaseFeeTypeId == (int)CaseFeeType.FeeType11020
                                                || item.CaseFeeTypeId == (int)CaseFeeType.FeeType21020
                                                || item.CaseFeeTypeId == (int)CaseFeeType.FeeType31020)
                                            {
                                                feeTypeName = item.CaseFeeTypeName + "[" + item.AnnualYear + "]";
                                            }
                                            else
                                            {
                                                feeTypeName = item.CaseFeeTypeName;
                                            }
                                        }
          
                                        @feeTypeName
                                     
                                </td>
          
                                <td>
                                    <span> @(item.Amount.HasValue ? item.Amount.Value.ToString() : "0") </span>
                                </td>
                                <td>
                                    <span>@item.RequestUserName</span>
                                </td>
                                <td>
                                    <span>@(item.InformDate.HasValue ? item.InformDate.Value.ToString("yyyy-MM-dd") : "")</span>
                                </td>
                                <td>
                                    <span>@item.CashedResponseUserName</span>
                                </td>
                                <td>
                                    <span>@(item.CashedDate.HasValue ? item.CashedDate.Value.ToString("yyyy-MM-dd") : "")</span>
                                </td>
                                
                                <td>
                                    <span> @(item.CashedAmount.HasValue ? item.CashedAmount.Value.ToString() : "") </span>
                                </td>

           

                                <td>
                                    <span>@(item.InvoiceFile != null ? item.InvoiceFile.InvoiceResponseUserName : string.Empty)</span>

                                </td>
                                <td>
                                    <span>@(item.InvoiceFile != null && item.InvoiceFile.InvoiceDate.HasValue ? item.InvoiceFile.InvoiceDate.Value.ToString("yyyy-MM-dd") : string.Empty)</span>

                                </td>
                                <td>
                                    @{
                                        if (item.PaymentMode == (int)CaseFeePaymentMode.ByCustomer )
                                        {
                                                <span>客户自缴</span>
                                        }
                                        else if (item.InvoiceFile != null)
                                        {
                                            <a style='color: #039' href="javascript:void(0);" onclick="javascript:caseInfo.ARCaseFee.Invoice.File.Open('@item.CaseFeeGuid'); "><span>@item.InvoiceFile.InvoiceNo </span></a>
                                        }
                                    }
                                </td>
                                <td>
                                    <span> @(item.PaidAmount.HasValue ? item.PaidAmount.Value.ToString() : "") </span>
                                </td>
                       
                            </tr>
                        }
                    }

                </tbody>

                <tfoot class="ng-scope" style="display: none">
                    <tr>
                        <td colspan="13">
                            <div class="pull-left"><span style="display: inline-block; vertical-align: middle; zoom: 1; padding: 8px 16px; color: red; "></span></div>
                            <div class="ng-scope">
                                <div class="pull-right page-box casefee">

                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>
            <div class="simple-grid-none-data-wrap">
                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                        <div class="text-size-16 tip-text inline-block">
                            <span class="margin-left ng-binding"></span>没有查询到应到账款信息。

                            @*@if (CommonService.Instance.CheckPermission((int)Permission.CreateCaseFeeInform))
                            {
                                <a href="javascript:void(0);" class="ng-binding"  style="color: #039" id="btnCaseFeeInformCreate">新建应收账款</a>
                            }*@

                            <span class="ng-binding"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="contextMenu" id="feeMenu" style="display: none;">
        <ul>
            @if (CommonService.Instance.CheckPermission((int)Permission.CaseFee_Create))
            {
                <li id="create">新增</li>
            }

            @if (CommonService.Instance.CheckPermission((int)Permission.CaseFee_Update))
            {
                <li id="edit">修改</li>
            }

            @if (CommonService.Instance.CheckPermission((int)Permission.CaseFee_PaymentApply))
            {
                <li id="paymentapply">付款申请</li>
            }

            <li id="contractfileview">合同文件</li>
            <li id="refresh">刷新</li>
        </ul>
    </div>

    @Html.HiddenFor(m => Model.TotalCount, new { name = "TotalCount" })
    @Html.HiddenFor(m => Model.PageNo, new { name = "PageNo" })
    @Html.HiddenFor(m => Model.PageSize, new { name = "PageSize" })
</form>
