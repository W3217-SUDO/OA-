@using Dchien.Legal.Common
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.AP.PaymentApplyModel

 
<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
 
</style>

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>

<div class="modal fade" id="paymentApplyModal">

    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("PaymentApplyCreate", "APCaseFee", FormMethod.Post, new { id = "paymentApply", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CaseFeeIds)
                    var caseFeeItemIds = (Model.CaseFeeIds != null && Model.CaseFeeIds.Any()) ? string.Join(",", Model.CaseFeeIds) : string.Empty;
                    @Html.HiddenFor(m => caseFeeItemIds, new { @id = "caseFeeItemIds" })

                    <div class="modal-header">
                        <button type="button" class="close" id="btnPaymentApplyClose">×</button>
                        <h5 class="modal-title ng-binding">预付申请</h5>
                    </div>
                    <div style="padding-left:10px;padding-right:10px">
                        <div class="margin-top-2 alert alert-info">
                            <b>提醒：</b>
                            <span style="color:#F00" class="ng-binding">
                                执行垫付申请前，请认真审核该客户的指示信息和资质， 如果垫付后1个月未能到款，财务将从请款人工资中扣除该款项。
                            </span>
                        </div>
                    </div>

                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label for="CaseEvent_EventContent" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">备注</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextAreaFor(m => m.Remark, new { @required = "true", maxlength = 1000, rows = 4, style = "width:120%" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnPaymentApply" value="申请" />
                        <input class="btn btn-default ng-binding" type="button" id="btnPaymentApplyCancel" value="取消" />
                    </div>
                }
            </div>
        </div>
    </div>

</div>





