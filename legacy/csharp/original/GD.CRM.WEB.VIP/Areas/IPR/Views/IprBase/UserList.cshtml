@using Dchien.Legal.Common

@using Dchien.Legal.Service.HR.Staff

 @{
     var staffs = StaffService.Instance.GetStaffList();
     var lst = staffs.FindAll(x=>x.StaffBasic.IsActived).GroupBy(x => x.StaffBasic.DepartmentId)
     .ToList();

     var departments = Dchien.Legal.Service.DepartmentService.Instance.GetAllDepartments();

 }

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
 

<div class="i_common_box" style='width:600px'>
    <input type="hidden" id="hidUserId">
    <input type="hidden" id="hidUserName">
    @if (lst != null && lst.Count > 0)
    {
        foreach (var x in lst.OrderBy(d=>d.Key))
        {
            <div class="i_common_hd">
                @(departments.FirstOrDefault(d=>d.DepartmentId == x.Key) == null ? String.Empty : departments.FirstOrDefault(d=>d.DepartmentId == x.Key).DepartmentName )
            </div>
            <div class="i_common_bd">
                <ul class="i_common_ul layoutfix">
                    @foreach (var staff in x.ToList<Dchien.Legal.BizModel.HR.BizStaff>().OrderBy(t=>t.StaffBasic.StaffName))
                    {
                        <li style='width:80px'><a href="javascript:void(0)" name="@staff.StaffBasic.StaffName">@staff.StaffBasic.StaffChName</a></li>
                    }
                </ul>
            </div>
        }
    }
</div>





