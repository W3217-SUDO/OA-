@model SunHold.Legal.Web.Areas.IPR.ViewModels.Communication.CommunicationListModel

@{
    object htmlAttribute = null;
}

<script src="@Url.Content("~/Scripts/IPR/Communication/Communication.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product">
    <div class="viewFramework-product-body">
        <div ng-transclude="">
            <div class="console-container ng-scope">
                <div class="row ng-scope">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5 class="ng-binding">沟通记录列表</h5>
                            </div>
                            <div class="pull-right">
                                <a href="javascript:void(0);" class="btn btn-primary ng-isolate-scope" id="btnCommunicationCreate">
                                    <span id="btnCommunicationCreate">新增沟通记录</span>
                                </a>
                            </div>
                            <div class="communicationCreateUpdate"></div>
                        </div>
                        <div class="pull-left margin-top-1 col-sm-12">
                            <form class="form-inline ng-valid ng-valid-required" id="postForm" action="@Url.Content("~/IPR/Communication/List")">
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                            </form>
                        </div>
                    </div>

                    <div class="col-sm-12">

                        <div class="ng-scope">
                            <div class="gridSection">
                                <table id="tblCommunicationList" class="table table-hover" style="margin-bottom: 57px;">
                                    <colgroup>
                                        <col style="width: 5%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 40%" />
                                        <col style="width: 5%" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>
                                                用户
                                            </th>
                                            <th>
                                                记录时间
                                            </th>
                                            <th>
                                                客户ID
                                            </th>
                                            <th>
                                                客户名称
                                            </th>
                                            <th>
                                                联系人
                                            </th>
                                            <th>
                                                联系电话
                                            </th>
                                            <th>
                                                内容
                                            </th>
                                            <th>
                                                操作
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td>
                                                &nbsp;
                                            </td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="ng-scope" style="display: none">
                                        <tr>
                                            <td colspan="8">
                                                <div class="pull-left"></div>
                                                <div class="ng-scope">
                                                    <div class="pull-right page-box communication">

                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>

                            </div>

                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left ng-binding">没有查询到符合条件的记录，可以去</span>
                                            <a href="javascript:void(0);" class="communicationCreate ng-binding">新增沟通记录</a>
                                            <span class="ng-binding">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>