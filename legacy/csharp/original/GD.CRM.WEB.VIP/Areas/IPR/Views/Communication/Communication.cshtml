@using CServiceStack.Common.Utils
@using SunHold.Legal.BizModel
@using SunHold.Legal.Common
@using SunHold.Legal.Service
@model SunHold.Legal.Web.Areas.IPR.ViewModels.Communication.CommunicationModel

<script src="@Url.Content("~/Scripts/IPR/Communication/Communication.Create.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="modal fade" id="communicationModal" >
  
        <div class="modal-dialog" style="width:860px">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("Communication", "Communication", FormMethod.Post, new { id = "communicationForm", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        <link rel="stylesheet" href="@Url.Content("~/Resource/css/customer.createupdate.console.css")" />

                        @Html.HiddenFor(m => m.Communication.CommunicationId)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnCommunicationClose">×</button>
                            <h5 class="modal-title ng-binding">沟通记录</h5>
                        </div>

                        <div class="modal-body">
                            <div style="background: #eaedf1;">
                          

                                    <div class="customer-section-main clearfix">
                                        <!-- 左侧 -->
                                        <div class="customer-section-left">
                                            <div class="customer-section-wrap">
                                                <div class="customer-section-product">
                                                    <!-- product section -->
                                                    <div class="product-container">
                                                        <div class="product-section">

                                                            <div class="form-group">
                                                                <label class="col-sm-3 control-label">
                                                                    <span class="text-danger ng-binding">*</span>
                                                                    <span class="ng-binding">客户编号:</span>
                                                                </label>
                                                                <div class="col-sm-6">
                                                                    @Html.HiddenFor(m => m.Communication.CustomerId)
                                                                    @(Model.Communication.CommunicationId > 0 ? Html.TextBoxFor(m => m.Communication.CustomerNo, new { @class = "form-control", @disabled = true }) : Html.TextBoxFor(m => m.Communication.CustomerNo, new { @placeholder = "客户编号或客户名称", @class = "form-control" }))
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="col-sm-3 control-label">
                                                                    <span class="text-danger ng-binding">*</span>
                                                                    <span class="ng-binding">客户名称:</span>
                                                                </label>
                                                                <div class="col-sm-6">
                                                                    @(Model.Communication.CommunicationId > 0 ? Html.TextBoxFor(m => m.Communication.CustomerName, new { @class = "form-control", @disabled = true }) : Html.TextBoxFor(m => m.Communication.CustomerName, new { @class = "form-control", @readonly = true }))
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="col-sm-3 control-label">
                                                                    <span class="text-danger ng-binding">*</span>
                                                                    <span class="ng-binding">联系人:</span>
                                                                </label>
                                                                <div class="col-sm-6">
                                                                    @(Model.Communication.CommunicationId > 0 ? Html.TextBoxFor(m => m.Communication.Contacts, new { @class = "form-control", @disabled = true }) : Html.TextBoxFor(m => m.Communication.Contacts, new { @class = "form-control" }))
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="col-sm-3 control-label">
                                                                    <span class="text-danger ng-binding">*</span>
                                                                    <span class="ng-binding">联系电话:</span>
                                                                </label>
                                                                <div class="col-sm-6">
                                                                    @(Model.Communication.CommunicationId > 0 ? Html.TextBoxFor(m => m.Communication.ContactPhone, new { @class = "form-control", @disabled = true }) : Html.TextBoxFor(m => m.Communication.ContactPhone, new { @class = "form-control" }))
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="col-sm-3 control-label">
                                                                    <span class="text-danger ng-binding">*</span>
                                                                    <span class="ng-binding">内容:</span>
                                                                </label>
                                                                <div class="col-sm-6">
                                                                    @(Model.Communication.CommunicationId > 0 ? Html.TextAreaFor(m => m.Communication.Content, new { @disabled = true, @class = "form-control", @required = "true", maxlength = 1000, rows = 4, style = "width:120%" }) : Html.TextAreaFor(m => m.Communication.Content, new { @class = "form-control", @required = "true", maxlength = 1000, rows = 4, style = "width:120%" }))
                                                                </div>
                                                            </div>

                                                            <div class="i_common_select" id="div_customer" style="display: none;">
                                                                <div class="i_common_wrap">
                                                                    <div class="i_common_list"></div>
                                                                </div>
                                                            </div>

                                                        </div>

                                                        @*<div class="modal-footer">
                                                                <input class="btn btn-primary ng-binding" type="button" id="btnCommunicationSend" value="保存" />
                                                                <input class="btn btn-default ng-binding" type="button" id="btnCommunicationCancel" value="取消" />
                                                            </div>*@
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="customer-section-right ng-scope">
                                            <!-- banner区域 -->
                                            <div class="customer-section-wrap">
                                                <div class="customer-section-product">
                                                    <!-- product section -->
                                                    <div class="product-container">
                                                        <div class="product-section">
                                                            <div class="section-content clearfix">
                                                                <div class="ng-scope">
                                                                    <!-- exported styles -->
                                                                    <link rel="stylesheet" href="//g.alicdn.com/ali-mod/aliyun-lego-console-product-update/0.0.9/index.css">
                                                                    <div class="aliyun-lego-console-product-update J_Module">
                                                                        <div class="module-wrap J_tb_lazyload">
                                                                            <div class='communicationlogs'>
                                                                                @{
                                                                                    @Html.Partial(Url.Content("~/Areas/IPR/Views/Communication/CommunicationLogList.cshtml"), Model)
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                 
                            </div>
                        </div>
                        <div class="modal-footer">
                            @if (Model.Communication.CommunicationId > 0)
                            {
                                <input class="btn btn-default ng-binding" type="button" id="btnCommunicationCancel" value="取消" />
                            }
                            else
                            {
                                <input class="btn btn-primary ng-binding" type="button" id="btnCommunicationCreateUpdate" value="保存" />
                                <input class="btn btn-default ng-binding" type="button" id="btnCommunicationCancel" value="取消" />
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    
</div>
