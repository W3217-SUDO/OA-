                    else if (id == PageId.PageId_1001009010)
                    {
                        <li id="transmit" filetypeid="4220011">转商标驳回通知书</li>
                    }
                    else if (id == PageId.PageId_1001009011)
                    {
                        <li id="transmit" filetypeid="4220027">转商标部分驳回通知书</li>
                    }
                    else if (id == PageId.PageId_1001009012)
                    {
                        <li id="transmit" filetypeid="4220015">转商标复审受理通知</li>
                    }
                    else if (id == PageId.PageId_1001009013)
                    {
                        <li id="transmit" filetypeid="4220019">转商标核准转让证明</li>
                    }
                    else if (id == PageId.PageId_1001009014)
                    {
                        <li id="transmit" filetypeid="4220020">转商标注册申请初步审定公告通知书</li>
                    }
                    else if (id == PageId.PageId_1001009015)
