                    }
                    else if (id == PageId.PageId_1001009028)
                    {
                        <li id="transmit" filetypeid="4220391"> 转无效宣告请求裁定书 </li>
                    }

                }

                <li id="transmitTag" >标记已转</ li >
            </ul>
        </div>
    </div>

</div>
