                        <li id="transmit" filetypeid="4220002">转商标注册申请补正通知书</li>
                    }
                    else if (id == PageId.PageId_1001009016)
                    {
                        <li id="transmit" filetypeid="4220022">转许可备案通知书</li>
                    }
                    else if (id == PageId.PageId_1001009017)
                    {
                        <li id="transmit" filetypeid="4220021">转商标变更证明</li>
                    }
                    else if (id == PageId.PageId_1001009018)
