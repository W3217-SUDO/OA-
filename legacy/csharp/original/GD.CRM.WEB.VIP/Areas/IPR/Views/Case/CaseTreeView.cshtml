@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseTreeModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bootstrap-treeview.min.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" />
<script type="text/javascript" src="@Url.Content("~/Scripts/Common/bootstrap-treeview.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" />

<script type="text/javascript">

    $(document).ready(function() {
        caseInfo.BulidCaseTreeView();
    });

</script>

<div class="modal fade" id="treeviewModal" >
  
        <div class="modal-dialog" style="width:560px">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("CaseTreeView", "Case", FormMethod.Post, new { id = "Role", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.CustomerId)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnCustomerCaseClose">×</button>
                            <h5 class="modal-title ng-binding">选择案件</h5>
                        </div>
 
                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label for="Role_RoleName" class="col-sm-2 control-label">
                                        <span class="text-danger ng-binding"></span>
                                        <span class="ng-binding">案件</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.SearchKeyword, new { @class = "form-control" })
                                    </div>
                                    <div class="form-control-wrap ">
                                        <input class="btn btn-primary " type="button" id="btnCaseSearch" value="查询" />
                                    </div>
                                </div>

                                @*<form id="caseCustomerListForm" class="form-inline ng-valid">
                                    <div class="simple-form-field">
                                        <div class="form-group ">
                                            <label class="control-label">
                                                <span contenteditable="" class="text-danger "></span>
                                                <span class="">客户：</span>
                                            </label>
                                            <div class="form-control-wrap">
                                                @Html.TextBoxFor(m => m.Customer.CustomerBasic.CustomerName, new { @class = "form-control", @readonly = true })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="simple-form-field  ">
                                        <div class="form-group  ">
                                            <label class="  control-label">
                                                <span class="">
                                                </span>
                                            </label>
                                            <div class="form-control-wrap text-right">
                                                <input class="btn btn-primary " type="button" id="btnCustomerSearch" value="查询" />
                                            </div>
                                        </div>
                                    </div>
                                </form>*@

                                <div class="form-group">
                                    
                                    <label for="Role_RoleDesc" class="col-sm-2 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">案件列表</span>
                                    </label>
                                    <div class="col-sm-10">
                                        <div class="gridSection" style="height: 245px;overflow-y: scroll; ">
                                            <div id="treeview" class="treeview"></div>
                                        </div>

                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnCustomerCase" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" id="btnCustomerCaseCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div><!-- /.modal -->
  
</div>

