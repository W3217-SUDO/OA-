@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case
@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.QuickCopyModel
<div class="modal fade" id="quickCopyModel">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("QuickCopy", "Case", FormMethod.Post, new { id = "quickCopyCase", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CustomerId)
                    <div class="modal-header">
                        <button type="button" class="close" id="btnQuickCopyCaseClose">×</button>
                        <h5 class="modal-title ng-binding">复制案件</h5>
                    </div>
                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">原案件号:</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.OrgCaseInfo.CaseBasicInfo.CaseNo, new { @class = "input_text case-form-control" })
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    
                                </label>
                                <div class="col-sm-6">
                                   <span id="casecopymessage" style="color:red"/>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnQuickCopyCase" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnQuickCopyCaseCancel" value="取消" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>


