@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseAssistedFeeModel


<div class="modal fade" id="caseAssistedFeeModal">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseAssistedFee", "Case", FormMethod.Post, new { id = "caseAssistedFee", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CaseId)
                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseAssistedFeeClose">×</button>
                        <h5 class="modal-title ng-binding">新建费用资助</h5>
                    </div>
                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label for="CaseInstance_Deadline" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">资费类型:</span>
                                </label>
                                <div class="col-sm-6">
                                    <select class="form-control" id="Case_CaseAssistedFeeType" name="Case.CaseAssistedFeeType" unselectable="on">
                                        @{
                                            var lst = CaseAssistedFeeTypeService.Instance.GetAllAssistedFeeTypes();
                                            foreach (var feeType in lst)
                                            {
                                                <option value="@feeType.AssistedFeeTypeId">@feeType.AssistedFeeTypeName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseAssistedFee" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseAssistedFeeCancel" value="取消" />

                    </div>
                }
            </div>
        </div>
    </div>
</div>







