@using Dchien.Legal.Common
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseModel

<div class="modal fade" id="caseDeadLineModal" >
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            @using (Html.BeginForm("CaseDeadLine", "Case", FormMethod.Post, new { id = "caseDeadLineForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
            {
                @Html.HiddenFor(m => m.CaseId)
                <div class="modal-header">
                    <button type="button" class="close" id="btnCaseDeadLineClose">×</button>
                    <h5 class="modal-title ng-binding">案件截止日期设定</h5>
                </div>
                <div class="modal-body">
                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger ng-binding">*</span>
                                <span class="ng-binding">截止日期</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.Case.CaseBasicInfo.Deadline, "{0:yyyy-MM-dd}", new { @id = "Case_Deadline", @autocomplete = "off", @class = "input_time form-control"})
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger ng-binding">*</span>
                                <span class="ng-binding">处理人</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.HiddenFor(m => m.Case.CaseBasicInfo.CaseOfficer, new { @id = "Case_CaseOfficer", @class = "form-control" })
                                @Html.TextBoxFor(m => m.Case.CaseBasicInfo.CaseOfficer, new { @id = "Case_CaseOfficerName", @autocomplete = "off", @class = "form-control" })
                                <div class="i_common_select" id="divAssociateUserList_DeadLine" style="display: none;">
                                    <div class="i_common_wrap">
                                        <div class="i_common_list"></div>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>
                    <div>
                        <div class="form-group">
                            <label for="CaseEvent_EventContent" class="col-sm-3 control-label">
                                <span class="text-danger ng-binding"></span>
                                <span class="ng-binding">备注</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextAreaFor(m => m.Case.CaseBasicInfo.PushOfficerRemak, new { @id = "Case_PushOfficerRemak", @required = "true", maxlength = 1000, rows = 4, style = "width:120%" })
                            </div>
                        </div>
                    </div>
                    <div style="display: none;" id="divUsers">
                      @Html.Partial("~/Areas/IPR/Views/IPRBase/UserList.cshtml")
                    </div>

  

                </div>
                
                <div class="modal-footer">
                    <input class="btn btn-primary ng-binding" type="button" id="btnCaseDeadLine" value="确定" />
                    <input class="btn btn-default ng-binding" type="button" id="btnCaseDeadLineCancel" value="取消" />
                </div>
            }
        </div>
        

        <div style="display: none;" id="Cfg_Case_CaseBasicInfo_Deadline">

            @*@Html.Partial("~/Views/IPRBase/CfgCaseDeadline.cshtml")*@

        </div>
    </div>
    

</div>

