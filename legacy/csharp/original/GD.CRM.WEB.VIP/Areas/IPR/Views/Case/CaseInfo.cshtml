                                                                               data-container="body" href="javascript:void(0);"
                                                                               target="_blank">
                                                                                @Model.Case.CaseBasicInfo.CustomerName
                                                                            </a>
                                                                        }
                                                                    </span>
                                                                </div>
                                                            }

