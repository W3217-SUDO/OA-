                                                                                   href="javascript:caseInfo.CaseCustomer.ViewCustomer(@customer.CustomerBasic.CustomerId);"
                                                                                   target="_blank">@customer.CustomerBasic.CustomerName</a>
                                                                                }
                                                                                else
                                                                                {
                                                                                <a name="casecustomer" style='color:white;width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;'
                                                                                   customerid="@customer.CustomerBasic.CustomerId" customerno="@customer.CustomerBasic.CustomerNo" customername="@customer.CustomerBasic.CustomerName"
                                                                                   title="@customer.CustomerBasic.CustomerName" data-toggle="tooltip" data-container="body"
                                                                                   href="javascript:void(0);" target="_blank">@customer.CustomerBasic.CustomerName</a>
                                                                                }
                                                                        <span class="customerremove" data-role="remove"></span>
                                                                    </span>

                                                                        }

                                                                        foreach (var customerT in Model.Case.CaseCustomers.FindAll(x => x.CustomerBasic.CustomerId != Model.Case.CaseBasicInfo.FirstApplicantId))
                                                                        {
                                                                    <span class="tag label label-info" style="margin-right:8px">
                                                                        @if (CommonService.Instance.CheckPermission((int)Permission.ViewCaseCustomer))
                                                                                {
                                                                                <a name="casecustomer" style='color:white;width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;'
                                                                                   customerid="@customerT.CustomerBasic.CustomerId" customerno="@customerT.CustomerBasic.CustomerNo" customername="@customerT.CustomerBasic.CustomerName"
                                                                                   title="@customerT.CustomerBasic.CustomerName" data-toggle="tooltip" data-container="body"
                                                                                   href="javascript:caseInfo.CaseCustomer.ViewCustomer(@customerT.CustomerBasic.CustomerId);" target="_blank">@customerT.CustomerBasic.CustomerName</a>
                                                                                }
                                                                                else
                                                                                {
                                                                                <a name="casecustomer" style='color:white;width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;'
                                                                                   customerid="@customerT.CustomerBasic.CustomerId" customerno="@customerT.CustomerBasic.CustomerNo" customername="@customerT.CustomerBasic.CustomerName"
                                                                                   title="@customerT.CustomerBasic.CustomerName" data-toggle="tooltip" data-container="body"
