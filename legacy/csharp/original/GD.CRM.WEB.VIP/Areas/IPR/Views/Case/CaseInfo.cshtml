                                                                               href="javascript:caseInfo.CaseCustomer.ViewCustomer(@Model.Case.CaseBasicInfo.CustomerId);"
                                                                               target="_blank">@Model.Case.CaseBasicInfo.CustomerName</a>
                                                                        }
