@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseListModel

@{
    var searchConditionJosn = Newtonsoft.Json.JsonConvert.SerializeObject(Model.Search);
}

<script type="text/javascript">

    var GV_IPRSearch = {
        Condition: @Html.Raw(searchConditionJosn)
        };

</script>

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />

<script src="@Url.Content("~/Scripts/IPR/Case/Case.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product ">
    <div class="viewFramework-product-body">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>案件列表</h5>
                            </div>
                            @*<div class="pull-right">
                                <a href="javascript:void(0);" class="btn btn-primary " id="btnCaseCreate">
                                    <span id="btnLawFirmCreate">新增案件</span>
                                </a>
                            </div>*@
                        </div>
                        <div class="pull-left margin-top-1 col-sm-12">
                          
                            <form class="form-inline ng-valid " id="postForm" action="@Url.Content("~/IPR/Case/CaseList")">

                                @Html.HiddenFor(m => m.SearchCondition.Keyword, new { name = "Keyword" })
                                @Html.HiddenFor(m => m.SearchCondition.ReminderTypeId, new { name = "ReminderTypeId" })
                                @Html.HiddenFor(m => m.SearchCondition.CategoryTypeId, new { name = "CategoryTypeId" })
                                @Html.HiddenFor(m => m.SearchCondition.CustomerId, new { name = "CustomerId" })
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })

                                <div class="simple-form-field">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">案号：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            <input type="text" class="form-control ng-valid" placeholder="案件编号(多个用逗号分隔)" id="txtCaseNo">
                                        </div>
                                    </div>
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">客户：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            <input type="text" class="form-control ng-valid" placeholder="客户编号或客户名称" id="txtCustomerNo">
                                        </div>
                                    </div>
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">案件类型：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseTypeName, new { @class = "form-control" })
                                            @Html.HiddenFor(m => m.SearchCondition.CaseTypeId)
                                        </div>
                                    </div>
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">案件阶段：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.CasePhaseName,new { @class = "form-control"})
                                            @Html.HiddenFor(m =>  m.SearchCondition.CasePhaseId)
                                        </div>
                                    </div>
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span class="">申请日：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseRequestDateStart, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </div>
                                            
                                        <label class="control-label">
                                            <span class="">-</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseRequestDateEnd, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" ,@style="width:100px"})
                                        </div>
                                            
                                        <div class="form-control-wrap">
                                            @Html.CheckBoxFor(m => m.SearchCondition.SearchByMonthAndDay, new { style = "vertical-align:middle" })
                                        </div>
                                        <label class="control-label">
                                            <span class="">按月日</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="simple-form-field  ">
                                    <div class="form-group  ">
                                        <label class="  control-label">
                                            <span class="">
                                            </span>
                                        </label>
                                        <div class="form-control-wrap text-right">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnCaseSearch">
                                                <span>查询</span>
                                            </a>
                                        </div>
                                        <div class="form-control-wrap text-right">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnCaseSearchReset">
                                                <span>重置</span>
                                            </a>
                                        </div>
                                        
                                        <div class="form-control-wrap text-right">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnCaseExportToExcel">
                                                <span>导出Excel</span>
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="col-sm-12">
                        <div class="">
                            <div class="gridSection">
                                <table id="tblCaseList" class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th width="10">
                                                <input type="checkbox" id="chkCaseAll" class="ng-pristine ng-valid">
                                            </th>
                                            <th style="text-align: center">案件编号</th>
                                            <th style="text-align: left">客户名称</th>
                                            <th style="text-align: center">案件类型</th>
                                            <th style="text-align: center">案件阶段</th>
                                            <th style="text-align: center">申请号</th>
                                            <th style="text-align: center">申请日</th>
                                            <th style="text-align: center">受理日</th>
                                            <th style="text-align: center">案源人</th>
                                            <th style="text-align: center">案源日</th>
                                            <th style="text-align: center">代理人</th>
                                            <th style="text-align: center">撰稿人</th>
                                            <th style="text-align: center">处理人</th>
                                            <th style="text-align: center">截止日</th>

                                            <th>操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td>
                                                &nbsp;
                                            </td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td></td>
                                    
                                        </tr>
                                    </tbody>
                                    <tfoot class="" style="display: none">
                                        <tr>
                                            <td colspan="15">
                                                <div class="pull-left"></div>
                                                <div class="">
                                                    <div class="pull-right page-box Caselist">

                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    
                    <div class="i_common_select" id="div_customer" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                    
                    <div class='divcaseconditioncasephases'></div>
                    <div class='divcaseconditioncasetypes'></div>


                </div>

            </div>
        </div>
        
        <div class="contextMenu" id="batchEditMenu" style="display: none;">
            <ul>
                <li id="batchEdit">批量修改</li>
                <li id="caseFileBatchImport">批量导入文件</li>
            </ul>
        </div>

    </div>
</div>

