@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case
@using Dchien.Legal.Entity.Account;

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseCustomerContactsSelectedModel
@{
    var display = "display:none";

    if (Model.ContactsList != null && Model.ContactsList.Count > 0)
    {
        display = "display:block";
    }
}
<form id="postForm" action="">
    <div id="customerContactsGridSection" class="gridSection">
        <div id='divContextList' style="overflow-y: auto; margin-top: -1px; overflow-x: hidden; overflow-y: auto; ">
            <table class='table table-hover' id="tblContactsList" width="100%">
                <colgroup>
                    <col style="width: 4%">
                    <col style="width: 8%">
                    <col style="width: 10%">
                    <col style="width: 15%">
                    <col style="width: 15%">
                    <col style="width: 15%">
                    <col style="width: 30%">
                </colgroup>
                <thead>
                    <tr>
                        <th>序号</th>
                        <th>角色</th>
                        <th>姓名 </th>
                        <th>办公电话</th>
                        <th>移动电话</th>
                        <th>邮箱</th>
                        <th>地址</th>

                    </tr>
                </thead>
                <tbody>
                    @if (Model.ContactsList != null)
                    {
                        foreach (var item in Model.ContactsList)
                        {
                            <tr>
                                <td>
                                    <span>@(Model.ContactsList.IndexOf(item) + 1)</span>
                                </td>
                                <td style="text-align: center">
                                    <span>@item.ContactsTypeName</span>
                                </td>
                                <td style="text-align: center">
                                    <span>@item.Contacts</span>
                                </td>
                                <td style="text-align: center">
                                    <span>@item.OfficePhone</span>
                                </td>
                                <td style="text-align: center; ">
                                    <span>@item.MobilePhone</span>
                                </td>

                                <td style="text-align: center">
                                    <span>@item.Email</span>
                                </td>
                                <td style="text-align: center">
                                    <span>@item.ContactAddress</span>
                                </td>

                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="ng-scope" style="display:none">
                    <tr>
                        <td colspan="7">
                            <div class="pull-left"></div>
                            <div class="ng-scope">
                                <div class="pull-right page-box contacts">
                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>
            <div class="simple-grid-none-data-wrap" style="@display">
                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                        <div class="text-size-16 tip-text inline-block">
                            <span class="margin-left ng-binding">没有查询到案件联系人</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @{ var c = CaseService.Instance.GetCaseBasic(Model.CaseId);
        if (c.CaseBasicInfo.BusinessOwner == LoginHelper.GetUserName() || CommonService.Instance.CheckPermission((int)Permission.CreateCustomerContacts))
        {
            <div class="contextMenu" id="contactsMenu" style="display: none;">
                <ul style="width:150px">
                    <li id="select">添加案件联系人</li>
                </ul>
            </div>
        }
    }
    @Html.HiddenFor(m => m.TotalCount, new { name = "TotalCount" })
    @Html.HiddenFor(m => m.PageNo, new { name = "PageNo" })
    @Html.HiddenFor(m => m.PageSize, new { name = "PageSize" })
</form>