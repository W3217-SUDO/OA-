@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.IPR.Case

@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CaseFileBatchImportModel

<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>

<div class="modal fade" id="caseFileBatchImportModal">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseFileBatchImportProcess", "CaseFile", FormMethod.Post, new { id = "caseFileBatchImportProcess", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    var caseIdList = (Model.CaseIds != null && Model.CaseIds.Any()) ? string.Join(",", Model.CaseIds) : string.Empty;
                    @Html.HiddenFor(m => caseIdList, new { @id = "caseIdList" })

                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseFileBatchImportClose">×</button>
                        <h5 class="modal-title ng-binding">上传案件文档</h5>
                    </div>
                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label for="CaseFileTypeId" class="col-sm-3 control-label">
                                    <span class="text-danger">*</span>
                                    <span class="">文档类型</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.HiddenFor(m => m.CaseFileTypeId)
                                    @Html.TextBoxFor(m => m.CaseFileTypeName, new { @class = "form-control", @autocomplete = "off" })
                                </div>
                                <div style="float: left; padding-top: 7px; padding-left: 1px;">
                                    <a id="lnkCaseFileTypeId" href="javascript:void(0)">选择</a>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span class="text-danger ">*</span>
                                    <span class="">上传案件文档</span>
                                </label>
                                <div class="col-sm-6">
                                    <div class="form-control-wrap">
                                        <input id="txtCaseFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control ng-valid" style=" display: inline-block">
                                        <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                            <input type="file" value="" id="flCaseFile" name="flCaseFile" style="height: 40px; width: 250px; margin-left: 10px;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span class="text-danger">*</span>
                                    <span class="spanreferencedate">文档日期</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.UploadingTime, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                </div>
                            </div>
                        </div>

                        <div style="display: none;" id="divUserList">
                            @Html.Partial("~/Areas/IPR/Views/IPRBase/UserList.cshtml")
                        </div>
                        

                        <div class="divCaseFileTypeList"></div>

                        <div class="i_common_select" id="div_CaseFileTypeList" style="display: none;">
                            <div class="i_common_wrap">
                                <div class="i_common_list"></div>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseFileBatchImport" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseFileBatchImportCancel" value="取消" />

                    </div>
                }
            </div>
        </div>
    </div>
</div>







