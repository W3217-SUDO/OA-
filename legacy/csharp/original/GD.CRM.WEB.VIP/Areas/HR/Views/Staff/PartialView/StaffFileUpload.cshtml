@model Dchien.Legal.Web.Areas.HR.ViewModels.Staff.StaffFileUpload

<div class="modal fade" id="staffFileUploadModal"  >
    <style>
        .btn-expense-file-upload input {
            position: absolute;
            top: 0px;
            right: 0px;
            left: 0px;
            bottom: 0px;
            opacity: 0;
            filter: alpha(opacity=0);
            overflow: hidden;
        }
    </style>

    <script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>

    <div class="modal-dialog">
        <div class="modal-content">

            @using (Html.BeginForm("StaffFileUploading", "Staff", FormMethod.Post, new { id = "uploadForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
            {
                @Html.HiddenFor(m => m.StaffGuid)
 
                <div class="modal-header">
                    <button type="button" class="close" id="btnStaffFileUploadClose">×</button>
                    <h5 class="modal-title ">上传员工文档</h5>
                </div>

                <div class="modal-body">
                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger ">*</span>
                                <span class="">员工文档</span>
                            </label>
                            <div class="col-sm-5">
                                <div class="form-control-wrap">
                                    <input id="txtStaffFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control ng-valid" style=" display: inline-block">
                                    <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                        <input type="file" value="" id="flStaffFile" name="flStaffFile" style="height: 40px; width: 200px; margin-left: 10px;">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <input class="btn btn-primary " type="button" id="btnStaffFileUpload" value="上传" />
                    <input class="btn btn-default " type="button" id="btnStaffFileUploadCancel" value="取消" />
                </div>

            }
        </div>

    </div>
</div>


