@using Dchien.Legal.Service.HR.Staff
@model Dchien.Legal.Web.Areas.FCM.ViewModels.Contract.DraftModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/font-awesome.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/citys/city.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/bootstrap-tagsinput.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" />
<link type="text/css" rel="stylesheet" href=@Url.Content("~/Resource/css/ticketSystem/add.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"]) />

<link type="text/css" rel="stylesheet" href="https://g.alicdn.com/aliyun/ticketsystem/1.6.17//styles/ticketSystem/detail.css" />
<link type="text/css" rel="stylesheet" href="https://g.alicdn.com/aliyun/ticketsystem/1.6.17//styles/ticketSystem/tip.css" />
<link type="text/css" rel="stylesheet" href="https://g.alicdn.com/aliyun/ticketsystem/1.6.17//styles/ticketSystem/common.css" />

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Common/citys/jquery.citys.json.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Common/citys/jquery.citys.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Common/bootstrap-tagsinput.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/FCM/Contract/FCM.Contract.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/FCM/Contract/FCM.Contract.ToAudit.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<style>
    .chosen-container-single .chosen-single {
        border: 1px solid #cccccc;
        font-size: 12px;
        border-radius: 0px;
    }
</style>

@{
    var staffs = StaffService.Instance.GetAuditorList(Dchien.Legal.Entity.System.AuditFlow.AuditType.Contract);
    var lst = staffs.FindAll(x => x.StaffBasic.IsActived).GroupBy(x => x.StaffBasic.DepartmentId)
    .ToList();
}

 <div class="viewFramework-product">
    <div class="viewFramework-product-body">
        <div class="console-container ">
            <div class="row ">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5>提交审核</h5>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12">

                    <div style="margin-top:24px">
                        <div class="create-ticket-step clearfix ">
                            <div class="create-ticket-step-item " style="width:25%">
                                <div class="item-wrap">
                                    <span class="icon-step">1</span>
                                    <span class="dingding-text">合同基本信息</span>
                                </div>
                            </div>
                            <div class="create-ticket-step-item active" style="width:25%">
                                <div class="item-wrap">
                                    <span class="icon-step">2</span>
                                    <span class="dingding-text">提交审核</span>
                                </div>
                            </div>
                            <div class="create-ticket-step-item" style="width:25%">
                                <div class="item-wrap">
                                    <span class="icon-step">3</span>
                                    <span class="dingding-text">合同审批</span>
                                </div>
                            </div>
                            <div class="create-ticket-step-item" style="width:25%">
                                <div class="item-wrap">
                                    <span class="icon-step">4</span>
                                    <span class="dingding-text">合同用印</span>
                                </div>
                            </div>
                        </div>

                        <div class="table-viewer-header clearfix">
                            <span class="table-viewer-topbar-title">
                                <span>选择审批人</span>
                            </span>
                        </div>

                        <div class="table-content">
                            <form class="chat-form form-horizontal form-horizontal ng-invalid ng-invalid-required">
                                <div class="simple-form-field ng-scope ng-isolate-scope hide">
                                    <input type="hidden" class="ng-scope">
                                </div>
                                <div class="simple-form-field ng-scope ng-isolate-scope">
                                    <div class="form-group ng-scope">
                                        <div class="col-sm-4">
                                            @*@Html.HiddenFor(m => m.Contract.ContractBasicInfo.Auditor)
                                            @Html.TextBoxFor(m => m.Contract.ContractBasicInfo.AuditorName, new { placeholder = "选择审批人", @class = "form-control", style = "height:32px; width:100%" })*@
                                            <select data-placeholder="选择审批人" id="Contract_ContractBasicInfo_Auditor" class="Contract_ContractBasicInfo_Auditor" style="height:26px;width: 100%;">
                                                @if (staffs != null && staffs.Count > 0)
                                                {
                                                    foreach (var staff in staffs)
                                                    {
                                                        <option value="@staff.StaffBasic.StaffName">@staff.StaffBasic.StaffChName</option>
                                                    }
                                                }
                                            </select>
                                             @*<div style="display: none;" id="divAuditorList">
                                                <div class="i_common_box" style='width:300px'>
                                                    <div class="i_common_hd">
                                                        从下列用户中选择
                                                        <input type="hidden" id="hidUserId">
                                                        <input type="hidden" id="hidUserName">
                                                    </div>
                                                    <div class="i_common_bd">
                                                        <ul class="i_common_ul layoutfix">
                                                            @if (staffs != null && staffs.Count > 0)
                                                            {
                                                                foreach (var staff in staffs)
                                                                {
                                                                    <li style='width:80px'><a href="javascript:void(0)" name="@staff.StaffBasic.StaffName">@staff.StaffBasic.StaffChName</a></li>
                                                                }
                                                            }
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>*@
                                         </div>

                                    </div>
                                </div><div class="simple-form-field ng-scope ng-isolate-scope">
                                    <div secret-content-check=""
                                         data="result.content"
                                         class="ng-scope ng-isolate-scope"></div>
                                </div>
                                <div class="simple-form-field ng-scope ng-isolate-scope">

                                    <div class="form-group simple-form-submit ng-scope" style="margin-bottom:0px">
                                        <label for="submit5" class="col-sm-12 control-label"><span class="ng-binding"></span></label>
                                        <div class="col-sm-4">
                                             <input class="btn btn-primary" type="button" id="btnContractToAudit" value="提交审批" />
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                       
                        <div ui-view="myTicket">
                            <div class="ticket-detail ng-scope">

                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.CustomerId)
                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractId)
                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractGuid)

                                <div class="table-viewer-header clearfix" style="margin-top: 12px">
                                    <span class="table-viewer-topbar-title">
                                        合同信息
                                    </span>
                                    <div class="pull-right table-viewer-topbar-content"></div>

                                </div>

                                <div class="info-panel" >

                                    <div class="row" style="margin-top:4px">

                                        <div class="col-sm-2 ">
                                            <span class="text-explode">
                                                <span> @Html.LabelFor(m => m.Contract.ContractBasicInfo.CustomerName)</span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.CustomerId)
                                                @Html.HiddenFor(m => m.Contract.ContractBasicInfo.ContractId)
                                                @if (Model.Contract != null && Model.Contract.ContractBasicInfo.CustomerId.HasValue)
                                                {
                                                    @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.CustomerName)
                                                }
                                                else
                                                {
                                                    @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.CustomerName)
                                                }
                                            </span>
                                        </div>

                                        <div class="col-sm-2">
                                            <span class="text-explode">
                                                <span>@Html.LabelFor(m => m.Contract.ContractBasicInfo.CustomerNo)</span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.CustomerNo)
                                            </span>
                                        </div>

                                        <div class="col-sm-2 ">
                                            <span class="text-explode">
                                                <span>@Html.LabelFor(m => m.Contract.ContractBasicInfo.AuditDate)</span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.AuditDate)
                                            </span>
                                        </div>
                                    </div>

                                    <div class="row" style="margin-top:4px">
                                        <div class="col-sm-2 ">
                                            <span class="text-explode">
                                                <span>@Html.LabelFor(m => m.Contract.ContractBasicInfo.ContractName)</span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                @if (Model.Contract != null && Model.Contract.ContractBasicInfo.CustomerId.HasValue)
                                                {
                                                    @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.ContractName)
                                                }
                                                else
                                                {
                                                    @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.ContractName)
                                                }
                                            </span>
                                        </div>

                                        <div class="col-sm-2 ">
                                            <span class="text-explode">
                                                <span>@Html.LabelFor(m => m.Contract.ContractBasicInfo.ContractNo)</span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.ContractNo)
                                            </span>
                                        </div>
                                        <div class="col-sm-2 ">
                                            <span class="text-explode">
                                                <span>@Html.LabelFor(m => m.Contract.ContractBasicInfo.BusinessOwnerName)</span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                @Html.DisplayTextFor(m => m.Contract.ContractBasicInfo.BusinessOwnerName)
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="case-section-wrap" style="padding-top: 12px;">
                            <div class="case-section-product">
                                <!-- product section -->
                                <div class="product-container">
                                    <div class="product-section">
                                        <ul class="nav nav-tabs">
                                            <li id="liContractFileList" class='active'><a href="javascript:void(0);" id="btnContractFileList">合同附件</a></li>
                                            <li class="pull-right" style="border:none">
                                                <div style="margin-top:3px">
                                                    <div style="text-align: inherit;">
                                                        <div style="text-align: right; padding-right: 8px; padding-bottom: 3px; float: right; display: inline;">
                                                            
                                                        </div>
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                        <div class="section-content clearfix">
                                            <div class="product-col ng-scope" style="width: 100%">
                                                <div id="dv_List">

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



 





