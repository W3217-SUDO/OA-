@using Dchien.Legal.Entity.System
@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.FAM.ViewModels.AR.ReceivedPayment.ListModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/index.css")" />

<script type="text/javascript" src="@Url.Content("~/Scripts/Legal/Case/Legal.Case.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script src="@Url.Content("~/Scripts/FAM/AR/FAM.AR.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/FAM/AR/FAM.AR.Payment.List.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product">
    <div class="viewFramework-product-body" style="overflow-y:hidden">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>待付款</h5>
                            </div>
                        </div>
                        <div class="pull-left margin-top-1 col-sm-12" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm">

                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                                @Html.HiddenFor(m => m.SearchCondition.PageId)
                                @Html.HiddenFor(m => m.SearchCondition.Sorting)

                                <table class="search_table" style="width: 600px">
                                    <colgroup>
                                        <col style="width: 80px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 220px" />

                                        <col>
                                    </colgroup>
                                    <tr>
                                        <th>
                                            银行单号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.InvoiceNo, new { @class = "form-control", @style = "" })
                                        </td>
                                        <th>
                                            案件编号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseNo, new { @class = "form-control", @style = "" })
                                        </td>

                                        <th>
                                            客户管理人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.BusinessOwner, new { @class = "form-control", @style = "" })
                                        </td>

                                        <th>
                                            回款日期：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CashedDateStart, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @style = "width:100px", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.CashedDateEnd, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @style = "width:100px", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>
                                            回款单位：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.Payer, new { @class = "form-control", @style = "" })
                                        </td>
                                        <th>
                                            客户名称：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CustomerName, new { @class = "form-control", @style = "" })
                                        </td>

                                        <th>
                                            提交人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.SettlementToAuditBusinessOwner, new { @class = "form-control" })
                                        </td>
                                        <th>
                                            提交日期：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.SettlementToAuditDateStart, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @style = "width:100px", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.SettlementToAuditDateEnd, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @style = "width:100px", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                        </td>


                                    </tr>
                                    <tr>

                                        <th>
                                            开庭律师：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CourtLawyer, new { @class = "form-control" })
                                        </td>
                                        <th>
                                            律师助理：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseAssistant, new { @class = "form-control" })
                                        </td>

                                        <th>
                                            审核人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.SettlementAuditor, new { @class = "form-control" })
                                        </td>
                                        <th>
                                            审核日期：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.SettlementAuditDateStart, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @style = "width:100px", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.SettlementAuditDateEnd, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @style = "width:100px", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                        </td>

                                    </tr>
                                    <tr>
                                        <th>
                                        </th>
                                        <td>
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnPaymentPendingPaymentListSearch">
                                                <span>查询</span>
                                            </a>
                                        </td>


                                    </tr>
                                </table>
 

                            </form>
                        </div>
                    </div>

                    <div class="col-sm-12">
                        <div class="">
                            <table class="aps-table aps-widget aps-ani-transition ">
                                <colgroup>
                                    <col style="width: 3%">
                                    <col style="width: 5%">
                                    <col style="width: 12%">
                                    <col style="width: 6%">
                                    <col style="width: 12%">
                                    <col style="width: 8%">
                                    <col style="width: 6%">
                                    <col style="width: 6%">
                                    <col style="width: 6%">
                                    <col style="width: 6%">
                                    <col style="width: 6%">
                                    <col style="width: 8%">
                                    <col style="width: 6%">
                                    <col style="width: 6%">
                                    <col style="width: 6%">
                                    <col style="width:17px">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <td><input type="checkbox" id="chkPaymentAll" name="chkPaymentAll"></td>
                                        <th style="text-align: center">操作</th>
                                        <th style="text-align: center">客户名称</th>
                                        <th style="text-align: center">客户<br>管理人</th>
                                        <th style="text-align: center">
                                            回款单位
                                            <span>
                                                <span class="aps-state-hidden"></span>
                                                <span data-field="PayerName" class="aps-widget aps-ani-transition aps-sort  aps-state-visible">
                                                    <i type="up" class="aps-icon aps-ani-transition aps-widget aps-icon-shangjiantou aps-sort-btn aps-sort-btn-up"></i>
                                                    <i type="down" class="aps-icon aps-ani-transition aps-widget aps-icon-xiajiantou aps-sort-btn aps-sort-btn-down"
                                                       style="top:9px">
                                                    </i>
                                                </span>
                                            </span>
                                        </th>
                                        <th style="text-align: center">
                                            回款日期
                                            <span>
                                                <span class="aps-state-hidden"></span>
                                                <span data-field="CashedDate" class="aps-widget aps-ani-transition aps-sort  aps-state-visible">
                                                    <i type="up" class="aps-icon aps-ani-transition aps-widget aps-icon-shangjiantou aps-sort-btn aps-sort-btn-up"></i>
                                                    <i type="down" class="aps-icon aps-ani-transition aps-widget aps-icon-xiajiantou aps-sort-btn aps-sort-btn-down"
                                                       style="top:9px">
                                                    </i>
                                                </span>
                                            </span>
                                        </th>
                                        <th style="text-align: center">
                                            回款金额
                                            <span>
                                                <span class="aps-state-hidden"></span>
                                                <span data-field="CashedAmount" class="aps-widget aps-ani-transition aps-sort  aps-state-visible">
                                                    <i type="up" class="aps-icon aps-ani-transition aps-widget aps-icon-shangjiantou aps-sort-btn aps-sort-btn-up"></i>
                                                    <i type="down" class="aps-icon aps-ani-transition aps-widget aps-icon-xiajiantou aps-sort-btn aps-sort-btn-down"
                                                       style="top:9px">
                                                    </i>
                                                </span>
                                            </span>
                                        </th>
                                        <th style="text-align: center">
                                            已分金额
                                            <span>
                                                <span class="aps-state-hidden"></span>
                                                <span data-field="AppliedAmount" class="aps-widget aps-ani-transition aps-sort  aps-state-visible">
                                                    <i type="up" class="aps-icon aps-ani-transition aps-widget aps-icon-shangjiantou aps-sort-btn aps-sort-btn-up"></i>
                                                    <i type="down" class="aps-icon aps-ani-transition aps-widget aps-icon-xiajiantou aps-sort-btn aps-sort-btn-down"
                                                       style="top:9px">
                                                    </i>
                                                </span>
                                            </span>
                                        </th>
                                        <th style="text-align: center">
                                            未分金额
                                            <span>
                                                <span class="aps-state-hidden"></span>
                                                <span data-field="UnAppliedAmount" class="aps-widget aps-ani-transition aps-sort  aps-state-visible">
                                                    <i type="up" class="aps-icon aps-ani-transition aps-widget aps-icon-shangjiantou aps-sort-btn aps-sort-btn-up"></i>
                                                    <i type="down" class="aps-icon aps-ani-transition aps-widget aps-icon-xiajiantou aps-sort-btn aps-sort-btn-down"
                                                       style="top:9px">
                                                    </i>
                                                </span>
                                            </span>
                                        </th>
                                        <th style="text-align: center">已分官费</th>
                                        <th style="text-align: center">已分<br>代理费</th>
                                        <th style="text-align: center">已分<br>其他费用</th>
                                        <th style="text-align: center">代理费<br>结算金额</th>
                                        <th style="text-align: center">扣归档费</th>
                                        <th style="text-align: center">实际<br>结算金额</th>
                                        <th></th>
                                    </tr>
                                </thead>
                            </table>

                            <div id="divPaymentList" style="border-top: 0;margin-top: -1px; overflow-x:hidden; overflow-y: scroll;">
                                <div class="simple-grid-none-data-wrap">
                                    <div class="simple-grid-none-data text-center  ">
                                        <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                            <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                            <div class="text-size-16 tip-text inline-block">
                                                <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                                <span class="">。</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <table id="tblPaymentList" class="aps-table aps-widget aps-ani-transition ">
                                    <colgroup>
                                        <col style="width: 3%">
                                        <col style="width: 5%">
                                        <col style="width: 12%">
                                        <col style="width: 6%">
                                        <col style="width: 12%">
                                        <col style="width: 8%">
                                        <col style="width: 6%">
                                        <col style="width: 6%">
                                        <col style="width: 6%">
                                        <col style="width: 6%">
                                        <col style="width: 6%">
                                        <col style="width: 8%">
                                        <col style="width: 6%">
                                        <col style="width: 6%">
                                        <col style="width: 6%">
                                    </colgroup>

                                    <tbody>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left;white-space: nowrap"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left;white-space: nowrap"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                        </tr>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left;white-space: nowrap"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left;white-space: nowrap"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                            <td style="text-align: left"></td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="" style="display: none">

                                        <tr>
                                            <td><input type="checkbox" id="chkPaymentAll" name="chkPaymentAll">

                                            </td>

                                            <td colspan="14">
                               
                                                <div class="pull-left">

                                                    <input type="button" id="btnPaymentListPaid" class="btn btn-default" style="height:32px" value="标记已支付" onclick="javascript: payment.Payment.Settlement.Paid($.checkbox.vals('chkPaymentId'));" />

                                                     @*<input type="button" class="btn btn-default" style="height:32px" value="导出结算清单" onclick="javascript: payment.Payment.Settlement.ExportSelectedToExcel($.checkbox.vals('chkCaseId'));" />*@
                                                    <input type="button" class="btn btn-default" style="height:32px" value="导出结算清单" onclick="javascript: payment.Payment.Settlement.ExportSettlementManifestToExcel($.checkbox.vals('chkPaymentId'));" />
                                                    <input type="button" class="btn btn-default" style="height:32px" value="导出到账清单" onclick="javascript: payment.Payment.Settlement.ExportSettlementHeaderManifestToExcel($.checkbox.vals('chkPaymentId'));" />
                                                    <input type="button" class="btn btn-default" style="height:32px" value="导出案件清单" onclick="javascript: payment.Payment.Settlement.ExportSettlementItemManifestToExcel($.checkbox.vals('chkPaymentId'));" />

                                                </div>
                                                <div class="">
                                                    <div class="pull-right page-box paymentList">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                           
                        </div>
                    </div>

                </div>
            </div>
        </div>


    </div>
</div>




