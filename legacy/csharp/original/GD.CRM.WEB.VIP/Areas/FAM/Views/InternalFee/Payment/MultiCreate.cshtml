@using Dchien.Legal.BizModel.FCM.Contract
@using Dchien.Legal.Service.Legal.Case
@using Dchien.Legal.Service.BAS.Type
@using Dchien.Legal.Service.FAM.InternalFee;
@using Dchien.Legal.Service.FAM.InternalFee.Payment;

@*<script type="text/javascript" src="@Url.Content("~/Scripts/FAM/InternalFee/Payment/FAM.InternalFee.Payment.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>*@
<div class="slide-panels">
    <div class="slide-panel active medium">
        <div class="slide-panel-content">
            <div class="panel-header">
                <h5>申请付款</h5>
                <a class="panel-close" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');">
                    <i class="next-icon next-icon-close next-small" style="font-size: 0px;">close</i>
                </a>
                <div class="head-custom"></div>
            </div>
            <div class="placeholder">...</div>
            <div class="panel-body">
                <div class="panel-body-content">
                    <div class="page-overview-panel-apply">
                        <div ui-view="myTicket">
                            <div class="ticket-detail ">

                                <div class="ng-isolate-scope">

                                    <div class="">
                                        <div class="console-step row step-bar" style="margin-bottom: 8px">
                                            <div class="step col-md-6  step-first step-done ">
                                                <span class="">新增费用</span>
                                            </div>
                                            <div class="step col-md-6  step-end step-active">
                                                <span class="">申请付款</span>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <div class="">
                                    <div class="">
                                        <div class="">
                                            <style type="text/css" class="">
                                                .tableWrapper .table {
                                                    margin-bottom: 0px;
                                                }

                                                .table-hover tbody tr.trWarapper:hover td {
                                                    background-color: #FCF8E2;
                                                }
                                            </style>
                                            <div class="">
                                                <div class="alert alert-info clearfix" style="padding: 8px 12px 0px;line-height: 18px;margin-bottom: 6px;border-radius: 0px">
                                                    <div class="pull-left">
                                                        <span>温馨提示</span> ：
                                                    </div>
                                                    <div class="pull-left">
                                                        <p>1. <span>申请付款按照每个案号生成一个申请单.</span> </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
  
                                    <div class="form-group">
                                        <div class="col-sm-12" style="padding:0px">
                                            <div class="gridSection">
                                                <table  class="aps-table aps-widget aps-ani-transition " id="tblInternalFeeObjectList" width="100%">
                                                    <colgroup>
                                                        <col style="width: 10%">
                                                        <col style="width: 8%">
                                                        <col style="width: 15%">
                                                        <col style="width: 6%">
                                                        <col style="width: 10%">
                                                        <col style="width: 5%">
                                                    </colgroup>
                                                    <thead>

                                                        <tr>
                                                            <th>案号</th>
                                                            <th>费用类型</th>
                                                            <th>支付对象</th>
                                                            <th>金额</th>
                                                            <th>本次支付</th>
                                                            <th>备注</th>
                                                          
                                                        </tr>

                                                    </thead>
                                                    <tbody>
                                                        <tr style="display: none">
                                                            <td style="text-align: center"></td>
                                                            <td style="text-align: center"></td>
                                                            <td style="text-align: center"></td>
                                                            <td style="text-align: center"></td>
                                                            <td style="text-align: center"></td>
                                                            <td style="text-align: center"></td>
                                                            <td style="text-align: center"></td>
                                                        </tr>
                                                        <tr style="display: none">
                                                            <td style="text-align: center"></td>
                                                            <td style="text-align: center"></td>
                                                            <td style="text-align: center"></td>
                                                            <td style="text-align: center"></td>
                                                            <td style="text-align: center"></td>
                                                            <td style="text-align: center"></td>
                                                            <td style="text-align: center"></td>
                                                        </tr>
                                                    </tbody>
                                                </table>

                                                <div class="i_common_select" id="divAssociateUserList_InternalFee" style="display: none;">
                                                    <div class="i_common_wrap">
                                                        <div class="i_common_list"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

             
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="panel-footer">
                <div class="btn-con">
                    <input type="button" id="btnParticipantCreateUpdate" class="btn   btn-primary" style="border-radius: 0;
                                                                                                    padding: 0 16px;
                                                                                                    height: 32px;
                                                                                                    line-height: 30px;
                                                                                                    font-size: 12px;
                                                                                                    border-width: 1px;" value="下一步" />
                    <input type="button" class="btn  btn-normal" style="border-radius: 0;
                                                                        padding: 0 16px;
                                                                        height: 32px;
                                                                        line-height: 30px;
                                                                        font-size: 12px;
                                                                        border-width: 1px;" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');" value="取消" />
                </div>
            </div>
        </div>
    </div>
 
