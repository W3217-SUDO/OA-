                                               @onafterpaste = "this.value=this.value.replace(/\\D/g,'')" ,
                                               @style = "width:100px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.RefundFeeAmountTo, new { @class = "form-control",
                                           @onkeyup = "javascript:this.value=this.value.replace(/\\D/g,'')",
                                           @onafterpaste = "this.value=this.value.replace(/\\D/g,'')",
                                           @style = "width:100px" })
                                        </td>
                                    </tr>



