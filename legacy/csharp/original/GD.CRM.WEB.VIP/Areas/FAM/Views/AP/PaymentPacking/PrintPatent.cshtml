                                                                                        <td>@(paymentItem.CaseOfficeFeeTypeId == (int)Dchien.Legal.Entity.IPR.Case.CaseFeeType.FeeType11009
                                                                                        || paymentItem.CaseOfficeFeeTypeId == (int)Dchien.Legal.Entity.IPR.Case.CaseFeeType.FeeType21009
