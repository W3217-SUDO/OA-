@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.FAM.ViewModels.AP.Payment.Packing.ListModel


<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />

<script src="@Url.Content("~/Scripts/FAM/AP/FAM.AP.Payment.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/FAM/AP/FAM.AP.PaymentPacking.Print.List.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product ">
    @*<div class="viewFramework-product-navbar ng-scope">
       
        @{
            Html.RenderPartial("~/Areas/FAM/Views/AP/Payment/MenuList.cshtml");
        }
    </div> 
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>*@
    <div class="viewFramework-product-body">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                @if (Model.SearchCondition.PageId.ToString() == Dchien.Legal.Entity.System.PageId.PageId_5001003004)
                                { 
                                    <h5>付款打包-打印</h5>
                                }
                                  else if (Model.SearchCondition.PageId.ToString() == Dchien.Legal.Entity.System.PageId.PageId_5001003006)
                                 
                                { 
                                    <h5>付款单-核销</h5>
                                }
                            </div>
                        </div>
                        <div class="pull-left margin-top-1 col-sm-12">
                            <form class="form-inline ng-valid " id="postForm" action="@Url.Content("~/FAM/AP/PaymentPackingList")">
                                @Html.HiddenFor(m => m.SearchCondition.PageId, new { name = "PageId" })
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                                <div class="simple-form-field">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">付款包号码：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.PackageNo, new { @class = "form-control", @placeholder = "", @style = "" })
                                        </div>
                                    </div>

                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">付款类型：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.DropDownListFor(m => m.SearchCondition.PaymentTypeId, Dchien.Legal.Service.FAM.AP.Payment.PaymentTypeService.Instance.GetPaymentTypeList(true), new { @class = "form-control", style = "width:147px" })
                                        </div>
                                    </div>

                                    @*<div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">付款状态：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.DropDownListFor(m => m.SearchCondition.PackingStatus, Dchien.Legal.Service.FAM.AP.Payment.PaymentPackingStatusService.Instance.GetPaymentPackingStatusList(true), new { @class = "form-control", style = "width:147px" })
                                        </div>
                                    </div>*@

                                </div>
                                <div class="simple-form-field  ">
                                    <div class="form-group">
                                        <label class="control-label">
                                            <span class="">
                                            </span>
                                        </label>
                                        <div class="form-control-wrap text-right">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnPackingListSearch">
                                                <span>查询</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </form>

                        </div>
                    </div>
   
                    <div class="col-sm-12">
                        <div class="">
                            <div class="gridSection">
                                <table id="tblPaymentPackingList" class="table table-hover" width="100%">
                                    <colgroup>
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">

                                        <col style="width: 10%">
                                        <col style="width: 15%">
                                        <col style="width: 15%">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            @if (Model.SearchCondition.PageId.ToString() == Dchien.Legal.Entity.System.PageId.PageId_5001003004)
                                            {
                                                /*付款包打印*/
                                                <th style="text-align: center">打印缴费</th>
                                            }
                                            else
                                            {
                                                <th style="text-align: center">核销</th>
                                            }

                                            <th style="text-align: center">付款包号码</th>
                                            <th style="text-align: center">付款单数量</th>
                                            <th style="text-align: center">计划付款金额</th>
                                            <th style="text-align: center">状态</th>
                                            <th style="text-align: center">付款日期</th>
                                            <th style="text-align: center">付款性质</th>
                                            <th style="text-align: center">付款类型</th>
                                            <th style="text-align: center">收款单位 </th>
                                            <th style="text-align: center">备注</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="" style="display: none">
                                        <tr>
                                            <td colspan="10">
                                                <div class="pull-left"></div>
                                                <div class="">
                                                    <div class="pull-right page-box paymentPackingList">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="i_common_select" id="div_customer" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                    <div class="i_common_select" id="divAssociateUserList" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                    <div style="display: none;" id="divUserList">
                    </div>

                </div>
            </div>
        </div>


    </div>
</div>

