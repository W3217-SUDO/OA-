@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.FAM.ViewModels.AP.Payment.PaymentType.ListModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />

<div class="modal fade" id="paymentTypeListModal">
    <div class="modal-dialog" style='width:60%'>
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" id="btnPaymentTypeListClose"  onclick="javascript: $('#paymentTypeListModal').modal('hide');"  >×</button>
                <h5 class="modal-title">选择付款单位</h5>
            </div>
            <div class="modal-body">
                <form id="paymentTypeListForm" class="form-inline ng-valid">

                    @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                    @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })

                    <div class="simple-form-field">

                        <div class="form-group ">
                            <label class="control-label">
                                <span contenteditable="" class="text-danger "></span>
                                <span class="">收款单位：</span>
                            </label>
                            <div class="form-control-wrap">
                                @Html.TextBoxFor(m => m.SearchCondition.OrganizationName, new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="form-group ">
                            <label class="control-label">
                                <span contenteditable="" class="text-danger "></span>
                                <span class="">类型：</span>
                            </label>
                            <div class="form-control-wrap">
                                @Html.DropDownListFor(m => m.SearchCondition.CaseFeeTypeId, Dchien.Legal.Service.PaymentModeService.Instance.GetPaymentModeTypeList(), new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="form-group ">
                            <label class="control-label">
                                <span contenteditable="" class="text-danger "></span>
                                <span class=""> </span>
                            </label>
                            <div class="form-control-wrap">
                                <input style='display:none' />
                            </div>
                        </div>

                    </div>
                    <div class="simple-form-field  ">
                        <div class="form-group  ">
                            <label class="control-label">
                                <span class="">
                                </span>
                            </label>
                            <div class="form-control-wrap text-right">
                                <input class="btn btn-primary " type="button" id="btnPaymentTypeSearch" value="查询" />
                            </div>
                            <div class="form-control-wrap text-right">
                                <input class="btn btn-primary " type="button" id="btnPaymentTypeSelected" value="选择" />
                            </div>
                            <div class="form-control-wrap text-right">
                                <input class="btn btn-primary " type="button" id="btnPaymentTypeCreate" value="新增" />
                            </div>
                        </div>
                    </div>
                </form>
                <div class="gridSection">
                    <table id="tblPaymentTypeList" class="table table-hover" style="padding-bottom:0px">
                        <colgroup>
                            <col style="width: 5%">
                            <col style="width: 10%">
                            <col style="width: 20%">
                            <col style="width: 20%">
                            <col style="width: 30%">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>
                                    选择
                                </th>
                                <th>
                                    类型
                                </th>
                                <th>
                                    收款单位
                                </th>
                                <th>
                                    开户行
                                </th>
                                <th>
                                    帐号信息
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="display: none">
                                <td>
                                    &nbsp;
                                </td>
                                <td style="text-align: left"></td>
                                <td style="text-align: left"></td>
                                <td style="text-align: left"></td>
                                <td style="text-align: left"></td>
                            </tr>
                        </tbody>
                        <tfoot class="ng-scope" style="display: none">
                            <tr>
                                <td colspan="5">
                                    <div class="pull-left"></div>
                                    <div class="ng-scope">
                                        <div class="pull-right page-box paymenttype">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                    <div class="simple-grid-none-data-wrap" style="">
                        <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                            <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                <div class="text-size-16 tip-text inline-block">
                                    <span class="margin-left ng-binding"></span>没有查询到符合条件的记录.
                                    <span class="ng-binding"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                    <input type="button" class="btn btn-default"    onclick="javascript: $('#paymentTypeListModal').modal('hide');" value="取消" />
            </div>
        </div>
    </div>
</div>

