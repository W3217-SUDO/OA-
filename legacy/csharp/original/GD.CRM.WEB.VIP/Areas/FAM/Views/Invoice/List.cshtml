@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.FAS.ViewModels.AR.Invoice.ListModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />

<script src="@Url.Content("~/Scripts/FAS/AR/Invoice/FAS.AR.Invoice.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("~/Areas/FAS/Views/Invoice/MenuList.cshtml");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>开票申请</h5>
                            </div>
                        </div>
                        <div class="pull-left margin-top-1 col-sm-12">
                            <form class="form-inline ng-valid " id="postForm" action="@Url.Content("~/FAS/Invoice/List")">
                                @Html.HiddenFor(m => m.CaseFeeSearchCondition.PageNo)
                                @Html.HiddenFor(m => m.CaseFeeSearchCondition.PageSize)
                                <div class="simple-form-field">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">案号：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.CaseFeeSearchCondition.CaseNos, new { @class = "form-control", @placeholder = "案件编号或申请号(多个用逗号分隔)" })
                                        </div>
                                    </div>
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">客户：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.CaseFeeSearchCondition.CustomerName, new { @class = "form-control", @placeholder = "客户编号或客户名称" })
                                        </div>
                                    </div>
                                    
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">案件类型：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.CaseFeeSearchCondition.CaseTypeName, new { @class = "form-control" })
                                            @Html.HiddenFor(m => m.CaseFeeSearchCondition.CaseTypeId)
                                        </div>
                                    </div>

                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class=""> 费用类型：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.CaseFeeSearchCondition.CaseFeeTypeName, new { @class = "form-control" })
                                            @Html.HiddenFor(m => m.CaseFeeSearchCondition.CaseFeeTypeId)
                                        </div>
                                    </div>
                                    
                                    <div class="form-group ">
       
                                        <div class="form-control-wrap">
                                            @Html.CheckBoxFor(m => m.CaseFeeSearchCondition.IsInvoiced)
                                            <span class="">已开票</span>

                                        </div>
                                        @*<label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class=""> 已开票：</span>
                                        </label>*@
                                    </div>
 
                                </div>
                                <div class="simple-form-field">
                                    <div class="form-group  ">
                                        <label class="  control-label">
                                            <span class="">
                                            </span>
                                        </label>
                                        <div class="form-control-wrap text-right">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnSearch">
                                                <span>查询</span>
                                            </a>
                                        </div>

                                        <div class="form-control-wrap text-right">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnInvoiceApply">
                                                <span>开票申请</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="">
                            <div class="gridSection">
                                <table id="tblCaseFeeList" class="table table-hover" style="width:100%">
                                    <colgroup>
                                        <col style="width: 4%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 15%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>
                                                <input type="checkbox" id="chkCaseFeeAll" class="ng-pristine ng-valid">
                                            </th>
                                            <th>案件编号</th>
                                            <th>申请号</th>
                                            <th>合同号</th>
                                            <th>客户名称</th>
                                            <th>费用类型</th>
                                            <th>金额</th>
                                            <th>已开金额</th>
                                            <th>高开金额</th>
                                            <th>通知日期</th>
                                            <th>提交人</th>
                                            <th>到账金额</th>
                                            <th>到账日期</th>
                                         </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="" style="display: none">
                                        <tr>
                                            <td colspan="13">
                                                <div class="pull-left"></div>
                                                <div class="">
                                                    <div class="pull-right page-box caseFeeList">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="i_common_select" id="div_customer" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                    <div class='divcaseconditioncasetypes'></div>
                    <div class='divcaseconditioncasephases'></div>
                    <div class='divcaseconditioncasefeetypes'></div>
                </div>
            </div>
        </div>
    </div>
</div>

