@model Dchien.Legal.VipWeb.Areas.Account.ViewModels.Message.MessageListModel

@{
    object htmlAttribute = null;
}


<link rel="stylesheet" href="@Url.Content("~/Resource/css/messageCenter.console.css")" />

<script src="@Url.Content("~/Scripts/Account/MessageCenter/Message.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("List");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>

    <div class="viewFramework-product-body">

        <div ng-transclude="">
            <div class="console-container ng-scope">
                <div class="row ng-scope">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5 class="ng-binding">消息列表</h5>
                            </div>
                            <div class="pull-right">
                                <a href="javascript:void(0);" class="btn btn-primary ng-isolate-scope" id="btnMessageCreate">
                                    <span id="btnMessageCreate">发送消息</span>
                                </a>
                            </div>
                            <div class="messageCreateUpdate"></div>
                        </div>
                        <div class="pull-left margin-top-1 col-sm-12">
                            <form class="form-inline ng-valid ng-valid-required" id="postForm" action="@Url.Content("~/Account/Message/List")">
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })

                                @Html.HiddenFor(m => m.MessageTypeId)
                            </form>
                        </div>
                    </div>

                    <div class="col-sm-12">

                        <div class="ng-scope">
                            <div class="gridSection">
                                <table id="tblMessageList" class="table table-hover" style="margin-bottom: 57px;">
                                    <colgroup>
                                        <col style="width: 5%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 15%" />
                                        <col style="width: 35%" />
                                        <col style="width: 10%" />
                                        <col style="width: 10%" />
                                        <col style="width: 5%" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>
                                                编号
                                            </th>
                                            <th>
                                                发送者
                                            </th>
                                            <th>
                                                接收者
                                            </th>
                                            <th>
                                                标题
                                            </th>
                                            <th>
                                                内容
                                            </th>
                                            <th>
                                                提交时间
                                            </th>
                                            <th>
                                                类型
                                            </th>
                                            <th>
                                                操作
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td>
                                                &nbsp;
                                            </td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="ng-scope" style="display: none">
                                        <tr>
                                            <td colspan="8">
                                                <div class="pull-left"></div>
                                                <div class="ng-scope">
                                                    <div class="pull-right page-box message">

                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>

                            </div>

                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left ng-binding">没有查询到符合条件的记录，可以去</span>
                                            <a href="javascript:void(0);" class="messageCreate ng-binding">发送消息</a>
                                            <span class="ng-binding">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>