@using Dchien.Legal.Common
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.CRM.ViewModels.CustomerEvent.CustomerEventModel

<div class="modal fade" id="customerEventModal" >
        <div class="modal-dialog">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("CustomerEvent", "CustomerEvent", FormMethod.Post, new { id = "customerEvent", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.CustomerId)
                        <div class="modal-header">
                            <button type="button" class="close" id="btnCustomerEventClose">×</button>
                            <h5 class="modal-title ng-binding">客户注意事项</h5>
                        </div>
                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label  class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">事项内容</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextAreaFor(m => m.CustomerEvent.Content, new { @required = "true", maxlength = 1000, rows = 4, style = "width:120%" })
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer">
                           <input class="btn btn-primary ng-binding" type="button" id="btnCustomerEvent" value="确定" />
                           <input class="btn btn-default ng-binding" type="button" id="btnCustomerEventCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div>
</div>



