@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.System.ViewModels.SystemCenter.PaymentType.PaymentTypeListModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<script src="@Url.Content("~/Scripts/System/SystemCenter/PaymentType.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">

        @{
            Html.RenderPartial("MenuList");
        }
    </div>
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>

    <div class="viewFramework-product-body">
        <a tabindex="0" href="javascript:void(0)" id="viewFramework-product-anchor" style="position: absolute;top: -10000px;left: -10000px">let's go</a>
        <div class="console-container ng-scope">
            <div class="row ng-scope">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5>付款类型列表</h5>
                        </div>
                    </div>
                    <div class="pull-left margin-top-1 col-sm-12">
                        <form class="form-inline ng-valid " id="postForm" action="@Url.Content("~/System/SystemCenter/PaymentTypeList")">
                            @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                            @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })

                            <div class="simple-form-field">
                                <div class="form-group ">
                                    <label class="control-label">
                                        <span contenteditable="" class="text-danger "></span>
                                        <span class="">付款类型名称：</span>
                                    </label>
                                    <div class="form-control-wrap">
                                        @Html.TextBoxFor(m => m.SearchCondition.PaymentTypeName, new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                            <div class="simple-form-field  ">
                                <div class="form-group  ">
                                    <label class="  control-label">
                                        <span class="">
                                        </span>
                                    </label>
                                    <div class="form-control-wrap text-right">
                                        <a href="javascript:void(0);" class="btn btn-primary " id="btnPaymentTypeSearch">
                                            <span>查询</span>
                                        </a>
                                    </div>
                                    <div class="form-control-wrap text-right">
                                        <a href="javascript:void(0);" class="btn btn-primary " id="btnPaymentTypeCreate">
                                            <span>新增付款单位</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                </div>
                <div class="col-sm-12">
                    <div class="ng-scope">

                        <div class="gridSection">
                            <table id="tblPaymentTypeList" class="table table-hover">
                                
                                <colgroup>
                                    <col style="width: 6%">
                                    <col style="width: 10%">
                                    <col style="width: 10%">
                                    <col style="width: 20%">
                                    <col style="width: 20%">
                                    <col style="width: 40%">
                                    <col style="width: 10%">
                                </colgroup>

                                <thead>
                                    <tr>
                                        <th>序号</th>
                                        <th>付款类型名</th>
                                        <th>付款性质</th>
                                        <th>收款单位</th>
                                        <th>账号</th>
                                        <th>备注</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="display: none">
                                        <td>
                                            &nbsp;
                                        </td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>

                                    </tr>
                                </tbody>
                                <tfoot class="ng-scope" style="display: none">
                                    <tr>
                                        <td colspan="7">
                                            <div class="pull-left"></div>
                                            <div class="ng-scope">
                                                <div class="pull-right page-box PaymentType">

                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="simple-grid-none-data-wrap">
                            <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                                <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                    <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                    <div class="text-size-16 tip-text inline-block">
                                        <span class="margin-left ng-binding" ng-bind-html="vm.msg">没有查询到符合条件的记录，可以去</span>
                                        <a href="javascript:void(0);" class="ng-binding"  style="color: #039">新增费用类型</a>
                                        <span class="ng-binding">。</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>

</div>
