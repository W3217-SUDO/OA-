@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.System.ViewModels.SystemCenter.CaseType.CaseTypeModel

@{
    object htmlAttribute = null;
}

<script type="text/javascript"></script>

<div class="modal fade" id="CaseTypeModal">
  
        <div class="modal-dialog" >
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("CaseType", "SystemCenter", FormMethod.Post, new { id = "CaseType", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.CaseType.CaseTypeId)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnCaseTypeClose">×</button>
                            <h5 class="modal-title ng-binding">类型名称</h5>
                        </div>
                        @*<div style="padding-left:10px;padding-right:10px">
                                <div class="margin-top-2 alert alert-info">
                                    <b>提醒：</b><span style="color:#F00" class="ng-binding"></span>
                                </div>
                            </div>*@

                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label for="CaseTypeId_CaseTypeIdName" class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">类型名称</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.CaseType.CaseTypeName, new { @class = "form-control"})
                                    </div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="CaseTypeId_CaseTypeShortCode" class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">类型字母名称</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.CaseType.CaseTypeShortCode, new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>
 
                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnCaseType" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" id="btnCaseTypeCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div><!-- /.modal -->
    
</div>

