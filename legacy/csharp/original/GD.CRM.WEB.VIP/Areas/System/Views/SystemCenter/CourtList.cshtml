@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.System.ViewModels.SystemCenter.CourtListModel
@{
    object htmlAttribute = null;
}
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />

<script src="@Url.Content("~/Scripts/System/SystemCenter/Court.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>


<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("MenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>

    <div class="viewFramework-product-body">
        <div class="console-container">
            <div class="row">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5>法院列表</h5>
                        </div>
                    </div>
                    <div class="pull-left margin-top-1 col-sm-12">
                        <form class="form-inline ng-valid "  id="postForm" action="@Url.Content("~/System/SystemCenter/CourtList")">
                            @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                            @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                            <div class="simple-form-field">
                                <div class="form-group ">
                                    <label class="control-label">
                                        <span contenteditable="" class="text-danger "></span>
                                        <span class="">法院名称：</span>
                                    </label>
                                    <div class="form-control-wrap">
                                        @Html.TextBoxFor(m => m.SearchCondition.CourtName, new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                            <div class="simple-form-field  ">
                                <div class="form-group  ">
                                    <label class="  control-label">
                                        <span class="">
                                        </span>
                                    </label>
                                    <div class="form-control-wrap text-right">
                                        <a href="javascript:void(0);" class="btn btn-primary " id="btnCourtSearch">
                                            <span>查询</span>
                                        </a>
                                    </div>

                                    <div class="form-control-wrap text-right">
                                        <a href="javascript:void(0);" class="btn btn-primary " id="btnCourtCreate">
                                            <span>新增法院</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="ng-scope">
                        <div class="gridSection">
                            <table id="tblCourtList" class="table table-hover">
                                <colgroup>
                                    <col style="width: 6%">
                                    <col style="width: 40%">
                                    <col style="width: 10%">
                                    <col style="width: 10%">
                                    <col style="width: 10%">
                                    <col style="width: 10%">
                                    <col style="width: 10%">
                                </colgroup>
                                <thead>

                                    <tr>
                                        <th>序号</th>
                                        <th style="text-align: left">法院名称</th>
                                        <th style="text-align: left">法院代字</th>
                                        <th style="text-align: left">区划代码</th>
                                        <th style="text-align: left">对应行政区划</th>
                                        <th style="text-align: left">类型</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="display: none">
                                        <td>
                                            &nbsp;
                                        </td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td></td>


                                    </tr>
                                </tbody>
                                <tfoot class="ng-scope" style="display: none">
                                    <tr>
                                        <td colspan="7">
                                            <div class="pull-left"></div>
                                            <div class="ng-scope">
                                                <div class="pull-right page-box court">

                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="simple-grid-none-data-wrap">
                            <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                                <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                    <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                    <div class="text-size-16 tip-text inline-block">
                                        <span class="margin-left ng-binding" ng-bind-html="vm.msg">没有查询到符合条件的记录，可以去</span>
                                        <a href="javascript:void(0);" class="ng-binding"  style="color: #039">新增法院</a>
                                        <span class="ng-binding">。</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
