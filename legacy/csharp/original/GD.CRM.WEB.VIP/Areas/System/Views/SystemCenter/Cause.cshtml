@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.System.ViewModels.SystemCenter.CauseModel

<div class="modal fade" id="CauseModal" >
  
        <div class="modal-dialog">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("Cause", "SystemCenter", FormMethod.Post, new { id = "Cause", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.Cause.CauseId)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnCauseClose">×</button>
                            <h5 class="modal-title ng-binding">案由名称</h5>
                        </div>
 
                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label for="Cause_CauseName" class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">案由名称:</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.Cause.CauseName, new { @class = "form-control"})
                                    </div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="Cause_CauseType" class="col-sm-3 control-label">
                                        <span class="ng-binding">上级案由分类ID:</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.Cause.ParentCauseId, new { @class = "form-control", 
                                                                   @onkeyup="javascript:this.value=this.value.replace(/\\D/g,'')",
                                                                   @onafterpaste="this.value=this.value.replace(/\\D/g,'')"})
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" id="btnCause" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" id="btnCauseCancel" value="取消" />
                        </div>
                    }
                </div>
            </div>
        </div><!-- /.modal -->
    
</div>

