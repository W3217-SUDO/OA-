@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.System.ViewModels.SystemCenter.CompanyModel

@{
    object htmlAttribute = null;
}

<script src="@Url.Content("~/Scripts/System/SystemCenter/Company.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("MenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>

    <div class="viewFramework-product-body">
        <a tabindex="0" href="javascript:void(0)" id="viewFramework-product-anchor" style="position: absolute;top: -10000px;left: -10000px">let's go</a>
        <!-- product body -->
        <div ng-transclude="">
            <!-- <div dchien-console-topbar-new product-id="messageCenter"></div>
            <div dchien-console-navbar></div> -->
            <div class="console-container ng-scope">
                <div class="row ng-scope">
                    <div class="col-sm-12">
                        <div class="console-title clearfix">
                            <div class="pull-left">
                                <h5>公司设置</h5>
                            </div>
                            <div class="pull-right">
                            </div>
                        </div>
                        <div class="alert alert-info">请完善以下信息,方便我们更好的为您服务</div>

                        <div class="basicinfo-bd">
                            <form id="companyform" class="form-horizontal ">
                                <fieldset>
                                    <div class="form-group">
                                        @Html.HiddenFor(m => m.Company.CompanyId, new { name = "CompanyId" })

                                        <label class="col-sm-4 control-label label-width">
                                            <span class="text-danger">*</span>
                                            <span> @Html.LabelFor(m => m.Company.CompanyName)</span>
                                        </label>
                                        <div class="col-sm-4 row">
                                            @Html.TextBoxFor(m => m.Company.CompanyName, new { @class = "form-control", style = "width:100%" })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label label-width">
                                            <span class="text-danger">*</span>
                                            <span> @Html.LabelFor(m => m.Company.CompanyCode)</span>
                                        </label>
                                        <div class="col-sm-4 row">
                                            @Html.TextBoxFor(m => m.Company.CompanyCode, new { @class = "form-control", style = "width:100%" })
                                        </div>
                                    </div>
 
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label label-width">
                                            <span class="text-danger">*</span>
                                            <span> @Html.LabelFor(m => m.Company.CompanyShortCode)</span>
                                        </label>
                                        <div class="col-sm-4 row">
                                            @Html.TextBoxFor(m => m.Company.CompanyShortCode, new { @class = "form-control", style = "width:100%" })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label label-width">
                                            <span class="text-danger">*</span>
                                            <span> @Html.LabelFor(m => m.Company.ContractAddress)</span>
                                        </label>
                                        <div class="col-sm-4 row">
                                            @Html.TextBoxFor(m => m.Company.ContractAddress, new { @class = "form-control", style = "width:100%" })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label label-width">
                                            <span class="text-danger">*</span>
                                            <span> @Html.LabelFor(m => m.Company.ContractPhone)</span>
                                        </label>
                                        <div class="col-sm-4 row">
                                            @Html.TextBoxFor(m => m.Company.ContractPhone, new { @class = "form-control", style = "width:100%" })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label label-width">
                                            <span class="text-danger">*</span>
                                            <span> @Html.LabelFor(m => m.Company.ContractFax)</span>
                                        </label>
                                        <div class="col-sm-4 row">
                                            @Html.TextBoxFor(m => m.Company.ContractFax, new { @class = "form-control", style = "width:100%" })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label label-width">
                                            <span class="text-danger">*</span>
                                            <span> @Html.LabelFor(m => m.Company.ContractEmail)</span>
                                        </label>
                                        <div class="col-sm-4 row">
                                            @Html.TextBoxFor(m => m.Company.ContractEmail, new { @class = "form-control", style = "width:100%" })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label label-width">
                                            <span class="text-danger">*</span>
                                            <span> @Html.LabelFor(m => m.Company.Zip)</span>
                                        </label>
                                        <div class="col-sm-4 row">
                                            @Html.TextBoxFor(m => m.Company.Zip, new
                                       {
                                           @class = "form-control",
                                           style = "width:100%",
                                           @onkeyup = "javascript:this.value=this.value.replace(/\\D/g,'')",
                                           @onafterpaste = "this.value=this.value.replace(/\\D/g,'')"
                                       })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label class="col-sm-4 control-label label-width">
                                            <span class="text-danger">*</span>
                                            <span> @Html.LabelFor(m => m.Company.BankName)</span>
                                        </label>
                                        <div class="col-sm-4 row">
                                            @Html.TextBoxFor(m => m.Company.BankName, new { @class = "form-control", style = "width:100%" })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label label-width">
                                            <span class="text-danger">*</span>
                                            <span> @Html.LabelFor(m => m.Company.BankAccount)</span>
                                        </label>
                                        <div class="col-sm-4 row">
                                            @Html.TextBoxFor(m => m.Company.BankAccount, new
                                       {
                                           @class = "form-control",
                                           style = "width:100%",
                                           @onkeyup = "javascript:this.value=this.value.replace(/\\D/g,'')",
                                           @onafterpaste = "this.value=this.value.replace(/\\D/g,'')"
                                       })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label label-width">
                                            <span class="text-danger">*</span>
                                            <span> 开户银行地址:</span>
                                        </label>
                                        <div class="col-sm-4 row">
                                            @Html.TextBoxFor(m => m.Company.WebSite, new { @class = "form-control", style = "width:100%" })
                                        </div>
                                    </div>
                                </fieldset>

                                <div class="form-group">
                                    <label class="col-sm-4 control-label label-width"></label>
                                    <div class="col-sm-8 row clearfix">
                                        <input class="btn btn-primary ng-binding" type="button" id="btnCreateUpdate" value="保存" />
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="ng-scope">
        </div>
        <div class="ng-scope">
            <div class="growl">

            </div>
        </div>
    </div>

</div>
