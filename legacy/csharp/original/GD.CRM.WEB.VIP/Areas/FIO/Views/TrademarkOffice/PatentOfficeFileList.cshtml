@using Dchien.Legal.Entity.FAM.AR.CaseFee
@using Dchien.Legal.Entity.IPR.Case
@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.IPR.ViewModels.Case.CasePatentOfficeFileListModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<script type="text/javascript" src="@Url.Content("~/Scripts/IPR/Case/Case.CaseFile.PatentOfficeFile.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar ng-scope">
        <!-- product nav -->
        @{
            Html.RenderPartial("MenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse ng-scope">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>
    <div class="viewFramework-product-body">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                 <h5>专利官文查询</h5>
                            </div>
                        </div>
                        <div class="pull-left margin-top-1 col-sm-12">
                            <form class="form-inline ng-valid " id="postForm" action="@Url.Content("~/IPR/CasePatentOfficeFile/CaseFileList")">
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })

                                <div class="simple-form-field">
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">案号：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseNo, new { @class = "form-control",  @placeholder = "案件编号或申请号" })
                                        </div>
                                    </div>
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">文件名：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.FileName, new { @class = "form-control", @placeholder = "文件名" })
                                        </div>
                                    </div>
                                    
                                    @*<div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">状态：</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition, new { @class = "form-control", @placeholder = "文件名" })
                                        </div>
                                    </div>*@
                                    
                                    <div class="form-group ">
                                        <label class="control-label">
                                            <span contenteditable="" class="text-danger "></span>
                                            <span class="">上传时间：</span>
                                        </label>
 
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.InDateStart, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </div>

                                        <label class="control-label">
                                            <span class="">-</span>
                                        </label>
                                        <div class="form-control-wrap">
                                            @Html.TextBoxFor(m => m.SearchCondition.InDateEnd, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        </div>
                                    </div>

                                </div>
                                <div class="simple-form-field">
                                    <div class="form-group  ">
                                        <label class="  control-label">
                                            <span class="">
                                            </span>
                                        </label>
                                        <div class="form-control-wrap text-right">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnCaseFileSearch">
                                                <span>查询</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="">
                            <div class="gridSection">
                                <table id="tblCaseFileList" class="table table-hover">
                                    <colgroup>
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 5%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 10%">
                                        <col style="width: 8%">
                                        <col style="width: 5%">
                                        <col style="width: 5%">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th style="text-align: center">原始文件</th>
                                            <th style="text-align: center">通知书编号</th>
                                            <th style="text-align: center">状态</th>
                                            <th style="text-align: center">案号</th>
                                            <th style="text-align: center">申请号</th>
                                            <th style="text-align: center">文档类型</th>
                                            <th style="text-align: center">文档日期</th>
                                            <th style="text-align: center">期限</th>
                                            <th style="text-align: center">费用</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                        </tr>
                                    </tbody>
                                    
                                    <tfoot class="ng-scope" style="display: none">
                                        <tr>
                                            <td colspan="9">
                                                <div class="pull-left"></div>
                                                <div class="ng-scope">
                                                    <div class="pull-right page-box caseFileList">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="i_common_select" id="div_customer" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
