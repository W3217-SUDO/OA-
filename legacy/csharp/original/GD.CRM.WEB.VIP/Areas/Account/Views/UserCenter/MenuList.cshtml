@using Dchien.Legal.Entity.System
@{
    var controller = ViewContext.RouteData.Values["controller"].ToString().ToLower();
    var action = ViewContext.RouteData.Values["action"].ToString().ToLower();

    var actived = "active";

}
<div class="product-nav-stage ng-scope product-nav-stage-main">
    <div class="product-nav-scene product-nav-main-scene">
        <div class="product-nav-title ng-binding">账户管理</div>
        <div class="ng-isolate-scope"></div>

        <div class="product-nav-list">
            <ul class="top-level">

                @{ actived = action == "Account".ToLower() ? "class=active" : "";}

                <li @actived>
                    <div class="ng-isolate-scope">
                        
                            <a href=@Url.Content(string.Format("~/{0}/Account/UserCenter/Account", PageId.PageId_2001004001)) class="ng-scope">
                                <div class="nav-icon"></div>
                                <div class="nav-title ng-binding">基本资料</div>
                            </a>
                    </div>
                </li>

                @{ actived = action == "Password".ToLower() ?  "class=active" : "";}

                <li @actived>
                    <div class="ng-isolate-scope">
                         
                            <a href=@Url.Content(string.Format("~/{0}/Account/UserCenter/Password", PageId.PageId_2001004002)) class="ng-scope">
                                <div class="nav-icon"></div>
                                <div class="nav-title ng-binding">密码修改</div>
                            </a>
                    </div>
                </li>

                

 
            </ul>
        </div>
    </div>
    <div class="product-nav-scene product-nav-sub-scene">
        <div class="product-nav-title">xxx</div>
        <div class="product-nav-list">
            <ul></ul>
        </div>
    </div>
</div>
