@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.Account.ViewModels.UserCenter.SettingModel

<script src="@Url.Content("~/Scripts/Account/UserCenter/Account.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product viewFramework-product-col-1">
    <div class="viewFramework-product-navbar">
        <!-- product nav -->
        @{
            Html.RenderPartial("MenuList");
        }
    </div><!-- /product nav -->
    <div class="viewFramework-product-navbar-collapse">
        <div class="product-navbar-collapse-inner">
            <div class="product-navbar-collapse-bg"></div>
            <div class="product-navbar-collapse">
                <span class="icon-collapse-left"></span>
                <span class="icon-collapse-right"></span>
            </div>
        </div>
    </div>

    <div class="viewFramework-product-body">
        <!-- product body -->
        <div>
            <div class="console-container">
                <div class="basicinfo">
                    <!--main table-->
                    <div class="console-title console-title-border drds-detail-title">
                        <h5>个性配置</h5>
                    </div>
                    <div class="alert alert-info">请完善以下信息,方便我们更好的为您服务</div>
                    <div class="basicinfo-bd">
                        <form id="customerTypeform" class="form-horizontal">
                            <fieldset>
                                @Html.HiddenFor(m => m.UserId)
                                
                                <div class="form-group" >
                                    <label class="col-sm-4 control-label label-width">
                                        <span class="text-danger">*</span>
                                        <span>@Html.LabelFor(m => m.MenuFold)</span>
                                    </label>
                                    <div class="col-sm-2 row">
                                       @Html.DropDownListFor(m => m.MenuFold, CommonService.Instance.GetTrueFalseList(), new { @class = "form-control", @style = "height:32px;width:100%" })
                                    </div>
                                </div>
                            </fieldset>

                            <div class="form-group">
                                <label class="col-sm-4 control-label label-width"></label>
                                <div class="col-sm-8 row">
                                    <input class="btn btn-primary " type="button" id="btnStaffSetting" value="保存" />
                                </div>
                            </div>
                        </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>