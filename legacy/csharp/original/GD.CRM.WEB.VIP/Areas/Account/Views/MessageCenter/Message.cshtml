@using Dchien.Legal.Common
@using Dchien.Legal.Service

@model Dchien.Legal.Web.Areas.Account.ViewModels.Message.MessageModel

@{
    var title = Model.Message.MessageId > 0 ? "查看消息" : "发送消息";
}
 
<div class="modal fade" id="messageModal" >
        <div class="modal-dialog" style="width:660px">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("Message", "MessageCenter", FormMethod.Post, new { id = "messageForm", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.Message.MessageId)

                        <div class="modal-header">
                            <button type="button" class="close" id="btnMessageClose"  onclick="javascript: $('#messageModal').modal('hide');">×</button>
                            <h5 class="modal-title ng-binding">@title</h5>
                        </div>

                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">接收人:</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.HiddenFor(m => m.Message.Receiver)
                                        @(Model.Message.MessageId > 0 ? Html.TextBoxFor(m => m.Message.ReceiverName, new { @class = "form-control", @disabled = true }) : Html.TextBoxFor(m => m.Message.ReceiverName, new { @class = "form-control", @readonly = true }))
                                     </div>
                                </div>
                            </div>
                            <div>
                                <div class="form-group">
                                    <label  class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">标题:</span>
                                    </label>
                                    <div class="col-sm-6">
                                      
                                        @(Model.Message.MessageId > 0 ? Html.TextBoxFor(m => m.Message.Title, new {@class = "form-control", @disabled = true}) : Html.TextBoxFor(m => m.Message.Title, new {@class = "form-control"}))

                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">内容:</span>
                                    </label>
                                    <div class="col-sm-6">
                                      
                                        @(Model.Message.MessageId > 0 ? Html.TextAreaFor(m => m.Message.Content, new {@disabled = true, @class = "form-control", @required = "true", maxlength = 1000, rows = 4, style = "width:120%"}) : Html.TextAreaFor(m => m.Message.Content, new {@class = "form-control", @required = "true", maxlength = 1000, rows = 4, style = "width:120%"}))

                                    </div>
                                </div>
                            </div>
                            
                            <div style="display: none;" id="divUsers">
                                
                            </div>
                          
                        </div>

                        <div class="modal-footer">
                            
                            @if (Model.Message.MessageId > 0)
                            {
                                <input class="btn btn-default ng-binding" type="button" id="btnMessageCancel"  onclick="javascript: $('#messageModal').modal('hide');" value="取消" />
                            }
                            else
                            {
                                <input class="btn btn-primary ng-binding" type="button" id="btnMessageSend" value="发送" />
                                <input class="btn btn-default ng-binding" type="button" id="btnMessageCancel"  onclick="javascript: $('#messageModal').modal('hide');" value="取消" />
                            }
                        </div>
                        

                    }
                </div>
            </div>
        </div>

</div>
