@using Dchien.Legal.Common
@using Dchien.Legal.Service.Lawsuit.Case
@model Dchien.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseModel

@{
    object htmlAttribute = null;
}

@using (Html.BeginForm("CaseInfo", "Case", FormMethod.Post, new { id = "caseForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
{
    <div class="ng-scope">

        @Html.HiddenFor(m => m.CaseId)
        @Html.HiddenFor(m => m.Case.CaseBasicInfo.CauseId)
        @Html.HiddenFor(m => m.Case.CaseBasicInfo.CompanyId)
        @Html.HiddenFor(m => m.Case.CaseBasicInfo.CaseNo)
        @Html.HiddenFor(m => m.Case.CaseBasicInfo.DeadlineLeftDays)
        @Html.TextBoxFor(m => m.Case.CaseBasicInfo.ReminderDate, "{0:yyyy-MM-dd}", new { @style = "display:none" })
        @Html.HiddenFor(m => m.Case.CaseBasicInfo.CaseOriginPeople)
        @Html.HiddenFor(m => m.Case.CaseExecution.CaseExecutionId)
        <table class="input_table" style="width:100%" id='tabCase'>
            <colgroup>
                <col style="width: 8%;" />
                <col style="width: 17%" />
                <col style="width: 8%;" />
                <col style="width: 17%" />
                <col style="width: 8%;" />
                <col style="width: 17%" />
                <col style="width: 8%;" />
                <col style="width: 17%" />
            </colgroup>

            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.CourtId)
                    @Html.HiddenFor(m => m.Case.CaseExecution.CourtId)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.CourtName, new { @class = "case-form-control", @unselectable = "on" })
                </td>
                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.CaseJudge)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.CaseJudge, new { @class = "case-form-control", @unselectable = "on" })
                </td>
                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.CourtCasetNo)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.CourtCasetNo, new { @class = "case-form-control", @unselectable = "on" })
                </td>
                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.LegalRedTapeEffectiveDate)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.LegalRedTapeEffectiveDate, "{0:yyyy-MM-dd}", new { @class = "case-form-control input_time ", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                </td>
            </tr>
            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.CasePhaseId)
                    @Html.HiddenFor(m => m.Case.CaseBasicInfo.CasePhaseId)
                </th>
                <td>
                    @{
    htmlAttribute = new { maxlength = 60, @class = "case-form-control" };
                    }

                    @Html.DropDownListFor(m => m.Case.CaseBasicInfo.CasePhaseId, CaseTypeService.Instance.GetCasePhaseList(), htmlAttribute)

                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.CaseRegisterDate)

                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.CaseRegisterDate, "{0:yyyy-MM-dd}", new { @class = "case-form-control input_time ", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                </td>


                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.CaseLawyer)
                    @Html.HiddenFor(m => m.Case.CaseExecution.CaseLawyer)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.CaseLawyerName, new { @class = "case-form-control",  @unselectable = "on" })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.Assistant)
                    @Html.HiddenFor(m => m.Case.CaseExecution.Assistant)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.AssistantName, new { @class = "case-form-control",  @unselectable = "on" })
                </td>
            </tr>

            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.CaseProsecutor)
                    @Html.HiddenFor(m => m.Case.CaseExecution.CaseProsecutor)
                </th>

                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.CaseProsecutorName, new { @readonly = true, @class = "case-form-control " })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.CaseProsecutorLitigationStatus)
                </th>
                <td>
                    @Html.DropDownListFor(m => m.Case.CaseExecution.CaseProsecutorLitigationStatusId, CaseTypeService.Instance.GetCaseLitigationStatusList(), htmlAttribute)
                </td>

                @*<th>
                    @Html.LabelFor(m => m.Case.CaseExecution.HolderOfRelationship)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.HolderOfRelationship, new { @class = "case-form-control " })
                </td>*@

                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.CaseDefendant)
                    @Html.HiddenFor(m => m.Case.CaseExecution.CaseDefendant)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.CaseDefendantName, new { @readonly = true, @class = "case-form-control " })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.CaseDefendantLitigationStatus)
                </th>
                <td>
                    @Html.DropDownListFor(m => m.Case.CaseExecution.CaseDefendantLitigationStatusId, CaseTypeService.Instance.GetCaseLitigationStatusList(), htmlAttribute)
                </td>

                @*<th>
                    @Html.LabelFor(m => m.Case.CaseExecution.DetermineTheway)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.DetermineTheway, new { @class = "case-form-control " })
                </td>*@
            </tr>
            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.PropertyClues)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.PropertyClues, new { @class = "case-form-control " })
                </td>
                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.Deadline)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.Deadline, "{0:yyyy-MM-dd}", new { @class = "case-form-control input_time ", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                </td>
                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.CaseSubmitter)
                    @Html.HiddenFor(m => m.Case.CaseBasicInfo.CaseSubmitter)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.CaseSubmitterName, new { @readonly = true, @class = "case-form-control " })
                </td>
                <th>
                    @Html.LabelFor(m => m.Case.CaseBasicInfo.CaseOfficer)
                    @Html.HiddenFor(m => m.Case.CaseBasicInfo.CaseOfficer)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseBasicInfo.CaseOfficerName, new {  @class = "case-form-control " })
                </td>
            </tr>


            <tr>
                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.TheThird)
                    @Html.HiddenFor(m => m.Case.CaseExecution.TheThird)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.TheThirdName, new { @class = "case-form-control " })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.TheThirdRelationship)
                </th>
                <td>
                    @Html.TextBoxFor(m => m.Case.CaseExecution.TheThirdRelationship, new { @class = "case-form-control " })
                </td>

                <th>
                    @Html.LabelFor(m => m.Case.CaseExecution.CaseCustomerAs)
                </th>
                <td>
                    @Html.DropDownListFor(m => m.Case.CaseExecution.CaseCustomerTypeId, CaseTypeService.Instance.GetCaseCustomerTypeList(), htmlAttribute)
                </td>
            </tr>
        </table>

    </div>
}
