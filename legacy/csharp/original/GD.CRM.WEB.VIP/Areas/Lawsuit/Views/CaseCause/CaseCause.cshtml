@using Dchien.Legal.Common
@model Dchien.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseCauseModel

@{
    object htmlAttribute = null;
}

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bootstrap-treeview.min.css")" />
<script type="text/javascript" src="@Url.Content("~/Scripts/Common/bootstrap-treeview.js")"></script>

<script type="text/javascript">

    $(document).ready(function () {
        //caseInfo.CaseCause.BulidTreeView();
    });

</script>

<div class="modal fade" id="caseCauseModal">
    <div class="modal-dialog" style="width:560px">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseCause", "CaseCause", FormMethod.Post, new { id = "CaseCause", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CaseId)

                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseCauseClose">×</button>
                        <h5 class="modal-title ng-binding">选择案由</h5>
                    </div>

                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">案由:</span>
                                </label>
                                <div class="col-sm-10">
                                    <div class="gridSection" style="height: 245px;overflow-y: scroll; ">
                                        <div id="treeview" class="treeview"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseCause" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseCauseCancel" value="取消" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>

