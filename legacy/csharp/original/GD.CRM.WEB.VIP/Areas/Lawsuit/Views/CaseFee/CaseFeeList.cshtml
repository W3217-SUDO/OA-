@using Dchien.Legal.Common
@using Dchien.Legal.Entity
@using Dchien.Legal.Entity.Account
@using Dchien.Legal.Entity.Lawsuit.Case
@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseFeeListModel

<form id="postForm" action="">

    <div id="casegridSection" class="gridSection">
        <table class="list_table " style='width:100%; margin-top: 0px; margin-bottom: 0px;'>
            <colgroup>
                <col style="width: 3%" />
                <col style="width: 5%" />
                <col style="width: 8%" />
                <col style="width: 14%" />
         
                <col style="width: 8%" />
                <col style="width: 6%" />
                <col style="width: 6%" />
                <col style="width: 12%" />
                <col style="width: 12%" />
                <col style="width: 10%" />
                <col style="width: 8%" />
                <col style="width: 5%" />
            </colgroup>
            <thead>
                <tr>
                    <th>

                    </th>
                    <th>
                        组号
                    </th>
                    <th>
                        案件编号
                    </th>
                    <th>
                        费用类型
                    </th>
 
                    <th>
                        金额
                    </th>
                    <th>
                        提交人
                    </th>
                    <th>
                        收费人
                    </th>
                    <th>
                        通知日期
                    </th>
                    <th>
                        开票/交费日期
                    </th>
                    <th>
                        到款日期
                    </th>
                    <th>
                        发票号
                    </th>
                    <th>
                        锁定
                    </th>

                </tr>
            </thead>

        </table>

        <div class="context" id='divContextList' style="height:555px; overflow-y: auto; ">
            <table class="list_table" id="tblCaseFee" style='width:100%; margin-top: -1px; margin-bottom: 0px;'>
                <colgroup>
                    <col style="width: 3%" />
                    <col style="width: 5%" />
                    <col style="width: 8%" />
                    <col style="width: 14%" />
                     <col style="width: 8%" />
                    <col style="width: 6%" />
                    <col style="width: 6%" />
                    <col style="width: 12%" />
                    <col style="width: 12%" />
                    <col style="width: 10%" />
                    <col style="width: 8%" />
                    <col style="width: 5%" />
                </colgroup>

                <tbody>

                    @if (Model.CaseFees != null)
                    {
                        foreach (var item in Model.CaseFees)
                        {
                            <tr class="caseFee">
                                <td>
                                    <input type="checkbox" name="chkCaseFeeItemId" value="@item.FeeItemId">
                                </td>

                                <td class="feeId">
                                    @Html.HiddenFor(m => item.FeeItemId)
                                    @Html.HiddenFor(m => item.FeeId)
                                    @*@(Model.CaseFees.IndexOf(item) + 1)*@
                                    @item.FeeId
                                </td>
                                <td>
                                    <span>@item.CaseNo</span>
                                </td>
                                <td>
                                    <span>(@item.FeeTypeId) @(item.FeeTypeId == (int)CaseFeeType.FeeType3 ? item.FeeTypeName + "(" + item.Yearly + ")" : item.FeeTypeName)</span>
                                </td>
           
                                <td>
                                    <span> @(item.Amount.HasValue ? item.Amount.Value.ToString("N2") : "0") </span>
                                </td>
                                <td>
                                    <span>@item.RequestUserName</span>
                                </td>
                                <td>
                                    <span>@item.ResponseUserName</span>
                                </td>
                                <td>
                                    <span>@(item.InformDate.HasValue ? item.InformDate.Value.ToString("yyyy-MM-dd") : "")</span>
                                </td>
                                <td>
                                    <span>@(item.BillDate.HasValue ? item.BillDate.Value.ToString("yyyy-MM-dd") : "")</span>
                                </td>
                                <td>
                                    <span>@(item.GainedDate.HasValue ? item.GainedDate.Value.ToString("yyyy-MM-dd") : "")</span>
                                </td>
                                <td>
                                    <span>@item.BillNo</span>
                                </td>
                                <td>
                                    <span>@(item.IsActive ? "是" : "否")</span>
                                </td>
                            </tr>
                        }
                    }

                </tbody>

                <tfoot class="ng-scope" style="display: none">
                    <tr>
                        <td colspan="12">
                            <div class="pull-left"></div>
                            <div class="ng-scope">
                                <div class="pull-right page-box casefee">

                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>

            <div class="simple-grid-none-data-wrap" style="height:280px">
                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                        <div class="text-size-16 tip-text inline-block">
                            <span class="margin-left ng-binding"></span>没有查询到费用信息。

                            @if (CommonService.Instance.CheckPermission((int)Permission.CreateCaseFeeInform))
                            {
                                <a href="javascript:void(0);" class="ng-binding"  style="color: #039" id="btnCaseFeeInformCreate">新建费用信息</a>
                            }

                            <span class="ng-binding"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>

    <div class="contextMenu" id="feeMenu" style="display: none;">
        <ul>
            @if (CommonService.Instance.CheckPermission((int)Permission.CreateCaseFeeInform))
            {
                <li id="create">新建费用信息</li>
            }

            @if (CommonService.Instance.CheckPermission((int)Permission.ConfirmCaseFeeInform))
            {
                <li id="feeConfirm">到账确认</li>
            }

            @if (CommonService.Instance.CheckPermission((int)Permission.ConfirmCaseFeeInvoice))
            {
                <li id="billConfirm">上传票据</li>
            }

            <li id="download">查看票据文件</li>

            @if (CommonService.Instance.CheckPermission((int)Permission.UnlockCaseFeeFile))
            {
                <li id="nolock">解锁</li>
            }

            @if (CommonService.Instance.CheckPermission((int)Permission.DeleteCaseFeeFile))
            {
                <li id="delete">删除</li>
            }

            <li id="linked">关联费用信息</li>
            <li id="refresh">刷新</li>
        </ul>
    </div>

    @Html.HiddenFor(m => Model.TotalCount, new { name = "TotalCount" })
    @Html.HiddenFor(m => Model.PageNo, new { name = "PageNo" })
    @Html.HiddenFor(m => Model.PageSize, new { name = "PageSize" })
</form>
