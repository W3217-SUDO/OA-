@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Entity
@using Dchien.Legal.Entity.Account

@model Dchien.Legal.Web.Areas.Legal.ViewModels.CaseEvent.CaseEventModel

<div class="modal fade" id="caseEventModal" >
        <div class="modal-dialog">
            <div class="modal-content" ng-transclude="">
                <div class="ng-scope">
                    @using (Html.BeginForm("CaseEvent", "Case", FormMethod.Post, new { id = "caseEvent", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                    {
                        @Html.HiddenFor(m => m.EventId)
                        @Html.HiddenFor(m => m.CaseNo)

                        <div class="modal-header">
                            <button type="button" class="close" onclick="javascript: $('#caseEventModal').modal('hide');" id="btnCaseEventClose">×</button>
                            <h5 class="modal-title ng-binding">案件提醒</h5>
                        </div>
                        <div class="modal-body">
                            <div>
                                <div class="form-group">
                                    <label for="CaseEvent_Deadline" class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">截止日期</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextBoxFor(m => m.CaseEvent.Deadline, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", required = "true" })
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="form-group">
                                    <label for="CaseEvent_EventContent" class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">提醒内容</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextAreaFor(m => m.CaseEvent.EventContent, new { @required = "true", maxlength = 1000, rows = 4, style = "width:120%" })
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer">
                            @if (Model.CaseEvent != null && Model.CaseEvent.EventId > 0 && Model.CaseEvent.EventTypeId == 0)
                            {
                                if (CommonService.Instance.CheckPermission((int)Permission.DeleteCaseEvent) || Model.CaseEvent.Operator == LoginHelper.GetUserName())
                                {
                                    <input class="btn btn-primary ng-binding" type="button" id="btnCaseEventDelete" onclick="javascript: c.Cases.Case.CaseEvents.CaseEvent.Delete();" value="删除" />
                                }
                            }
                            else if(Model.CaseEvent.EventId == 0)
                            {
                                <input class="btn btn-primary ng-binding" type="button" id="btnCaseEvent" onclick="javascript: c.Cases.Case.CaseEvents.CaseEvent.CreateUpdate();" value="确定" />
                            }
                            <input class="btn btn-default ng-binding" type="button" id="btnCaseEventCancel" onclick="javascript: $('#caseEventModal').modal('hide');" value="取消" />

                        </div>
                    }
                </div>
            </div>
        </div>
</div>



