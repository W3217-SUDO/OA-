@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.Legal.ViewModels.Case.LitigantAgentModel
<div class="modal fade" id="litigantAgentModal">
    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            @using (Html.BeginForm("LitigantAgent", "Case", FormMethod.Post, new { id = "litigantAgentForm", @class = "form-horizontal ng-invalid ng-invalid-required" }))
            {
               <input type="hidden" id="LitigantAgentInput"> 

                <div class="modal-header">
                    <button type="button" class="close"  onclick="javascript: $('#litigantAgentModal').modal('hide');">×</button>
                    <h5 class="modal-title ng-binding">代理人</h5>
                </div>
                <div class="modal-body">

                    <div class="form-group">
                        <label class="col-sm-3 control-label">
                            <span class="text-danger ng-binding">*</span>
                            <span class="ng-binding">姓名</span>
                        </label>
                        <div class="col-sm-6">
                            @Html.TextBoxFor(m => m.LitigantAgent.Name, new { @autocomplete = "off", style = "height:28px;", @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label">
                            <span class="text-danger ng-binding">*</span>
                            <span class="ng-binding">身份</span>
                        </label>
                        <div class="col-sm-6">
                            @Html.DropDownListFor(m => m.LitigantAgent.Position, CommonService.Instance.GetLitigantAgentPosition(), new { @class = "form-control", @style = "height:28px;width:100%" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label">
                            <span class="text-danger ng-binding">*</span>
                            <span class="ng-binding">代理权限</span>
                        </label>
                        <div class="col-sm-6">
                            @Html.DropDownListFor(m => m.LitigantAgent.AgentAuthCode, CommonService.Instance.GetLitigantAgentAuthCode(), new { @class = "form-control", @style = "height:28px;width:100%" })
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <input class="btn btn-primary ng-binding" type="button" id="btnLitigantAgent" value="确定" />
                    <input class="btn btn-default ng-binding" type="button"  onclick="javascript: $('#litigantAgentModal').modal('hide');" value="取消" />
                </div>
            }
        </div>
    </div>

</div>

