@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Newtonsoft.Json.Linq

@model Dchien.Legal.Web.Areas.Legal.ViewModels.CaseFile.MultiCaseFileUploadModel

<style>
    .bootstrap-tagsinput {
        width: 100%;
        border-radius: 0px;
        padding: 2px 4px;
    }

        .bootstrap-tagsinput input {
            padding: 0px;
            width: 50px;
        }

    .chosen-container-multi .chosen-choices {
        border: 1px solid #cccccc;
        font-size: 12px;
    }
</style>

<script type="text/javascript" src="@Url.Content("~/Scripts/Legal/Case/Legal.Case.File.Upload.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
 

<SCRIPT type="text/javascript">
    var setting = {
        view: {
            showLine: false,
        },
        check: {
            enable: true,
            chkStyle: "radio",
            radioType: "all"
        },
        data: {
            simpleData: {
                enable: true
            }
        }
    };
	$(document).ready(function () {
		var data = {	  
		};
		$.ajaxPost(AP_ROOT + AP_PAGE_ID + "/Legal/CaseFileType/GetCaseFileTypeListForChange", data, function (response) {
		    if (response.IsSuccess) {
		        if (response.Data.CaseFileTypes.length > 0) {
		            var zNodes = [];
		            $.each(response.Data.CaseFileTypes, function (i, fileType) {
		                var node = {};
		                node.id = fileType.FileTypeId;
		                node.pId = fileType.ParentFileTypeId;
		                node.name = fileType.FileTypeName;
		                node.open = true;
		                node.typeId = fileType.TypeId;
		                zNodes.push(node);
		            });
		            zNodes[0].checked = true;
		            $.fn.zTree.init($("#caseFileTypeTree"), setting, zNodes);
		            var zTree = $.fn.zTree.getZTreeObj("caseFileTypeTree");
		            $("#selectAll").bind("click", selectAll);
		        }
		    }
		});
	});
</SCRIPT>


<style type="text/css">
    ul.ztree {
        margin-top: 0px;
        border-right: 1px solid #e1e6eb;
        overflow-y: auto;
        overflow-x: auto;
    }

    /*.ztree * {font-size: 10pt;font-family:"Microsoft Yahei",Verdana,Simsun,"Segoe UI Web Light","Segoe UI Light","Segoe UI Web Regular","Segoe UI","Segoe UI Symbol","Helvetica Neue",Arial}*/
    .ztree li {
        line-height: 20px;
    }

        .ztree li a {
            width: 200px;
            height: 20px;
            padding-top: 0px;
        }

            .ztree li a:hover {
                text-decoration: none;
                background-color: #E7E7E7;
            }

            .ztree li a span.button.switch {
                visibility: hidden;
            }

    .ztree.showIcon li a span.button.switch {
        visibility: hidden;
    }

    .ztree li a.curSelectedNode {
        background-color: #D4D4D4;
        border: 0;
        height: 20px;
    }

    .ztree li span {
        line-height: 20px;
    }

        .ztree li span.button {
            margin-top: 2px;
        }

            .ztree li span.button.switch {
                width: 15px;
                height: 10px;
                margin-bottom: 2px;
            }

            .ztree li span.button.add {
                margin-left: 2px;
                margin-right: -1px;
                background-position: -144px 0;
                vertical-align: top;
                *vertical-align: middle;
            }


            .ztree li span.button.ico_docu {
                background-position: -110px -16px;
            }

            .ztree li span.button.switch.level0 {
                width: 15px;
                height: 10px;
                margin-bottom: 2px;
            }

            .ztree li span.button.switch.level1 {
                width: 15px;
                height: 10px;
                margin-bottom: 2px;
            }
    /*.ztree li span.button.noline_open {background-position: 0 0;}
    .ztree li span.button.noline_close {background-position: -18px 0;}
    .ztree li span.button.noline_open.level0 {background-position: 0 -18px;}
    .ztree li span.button.noline_close.level0 {background-position: -18px -18px;}
    .ztree li span.button.noline_close.level0 {background-position: -18px -18px;}*/

    .node_name {
        margin-left: 10px;
    }

    div#rMenu {
        position: absolute;
        visibility: hidden;
        top: 0;
        background-color: #555;
        text-align: left;
        padding: 2px;
    }

        div#rMenu ul li {
            margin: 1px 0;
            padding: 0 5px;
            cursor: pointer;
            list-style: none outside none;
            background-color: #DFDFDF;
        }
</style>

<div class="slide-panels" >
    <div class="slide-panel active medium">
        <div class="slide-panel-content">
            <div class="panel-header">
                <h5>上传文档</h5>
                <a class="panel-close" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');">
                    <i class="next-icon next-icon-close next-small" style="font-size: 0px;">close</i>
                </a>
                <div class="head-custom"></div>
            </div>
            <div class="placeholder">...</div>
            <div class="panel-body">
                <div class="panel-body-content">
                    <div class="page-overview-panel-apply">
                        <div ui-view="myTicket">
                            <div class="ticket-detail ">
                                <div class="">
                                    <div class="" style="display:none">
                                        <div class="">
                                            <style type="text/css" class="">
                                                .tableWrapper .table {
                                                    margin-bottom: 0px;
                                                }

                                                .table-hover tbody tr.trWarapper:hover td {
                                                    background-color: #FCF8E2;
                                                }
                                            </style>
                                            <div class="">
                                                <div class="alert alert-info clearfix" style="padding: 8px 12px 0px;line-height: 18px;margin-bottom: 6px;border-radius: 0px">
                                                    <div class="pull-left">
                                                        <span>温馨提示</span> ：
                                                    </div>
                                                    <div class="pull-left">
                                                        <p>1. <span>如不选文档类型,会按照文件名称匹配类型,未匹配上默认为待定.</span> </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="">
                                       @using (Html.BeginForm("MultiCaseFileUpload", "CaseFile", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                                       {
                                            @Html.HiddenFor(m => m.CaseNos)
                                            @Html.HiddenFor(m => m.CaseFileTypeId)

                                            <div>
                                                <div>
                                                    <div class="form-group">
                                                        <label class="col-sm-2 control-label">
                                                            <span class="text-danger">*</span>
                                                            <span class="spanreferencedate">参考日期</span>
                                                        </label>
                                                        <div class="col-sm-8">
                                                            @Html.TextBoxFor(m => m.UploadingTime, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @style = "height:32px", @onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            if (!Model.CaseFileTypeId.HasValue)
                                            {
                                                <div>
                                                    <div class="form-group">
                                                        <label class="col-sm-2 control-label">
                                                            <span class="text-danger">*</span>
                                                            <span class="spanreferencedate">文档目录</span>
                                                        </label>
                                                        <div class="col-sm-8">
                                                            <div style="height: 140px;overflow-y: scroll; "><ul id="caseFileTypeTree" class="ztree"></ul></div>
                                                            
                                                        </div>                                                      
                                                    </div>
                                                        @*<div style="float: left; padding-top: 7px; padding-left: 1px;">
                                                            <a id="lnkCaseFileTypeId" href="javascript:void(0)">选择目录</a>
                                                        </div>*@
                                                </div>
                                                
                                            }

                                            <div>
                                                <div class="form-group" style="margin-right: 0px;margin-left: 0px">
                                                    <input id="casefile" class="file" type="file"  multiple />
                                                </div>
                                            </div>


                                            <div class="divCaseFileTypeList"></div>

                                            <div class="i_common_select" id="div_CaseFileTypeList" style="display: none;">
                                                <div class="i_common_wrap">
                                                    <div class="i_common_list"></div>
                                                </div>
                                            </div>
                                       }
                                   
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
              
            </div>
            <div class="panel-footer">
                <div class="btn-con" style="padding-top:8px">
                    <input type="button" id="btnTaskCreateUpdate" class="btn   btn-primary" style="display:none; border-radius: 0;
                                                                                                    padding: 0 16px;
                                                                                                    height: 32px;
                                                                                                    line-height: 30px;
                                                                                                    font-size: 12px;
                                                                                                    border-width: 1px;" value="确定" />
                    <input type="button" class="btn  btn-normal" style="border-radius: 0;
                                                                        padding: 0 16px;
                                                                        height: 32px;
                                                                        line-height: 30px;
                                                                        font-size: 12px;
                                                                        border-width: 1px;" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');" value="取消" />
                </div>
            </div>
        </div>
    </div>
</div>



