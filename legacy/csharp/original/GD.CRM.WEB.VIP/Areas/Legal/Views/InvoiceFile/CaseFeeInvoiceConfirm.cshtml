 
@using Dchien.Legal.Service.HR.Staff

@model Dchien.Legal.Web.Areas.Legal.ViewModels.CaseFee.Invoice.CaseFeeInvoiceModel
@{
    var staffs = StaffService.Instance.GetStaffList();
}
<style>
    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>
<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<div class="modal fade" id="caseFeeInvoiceConfirmModal">

    <div class="modal-dialog">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("CaseFeeInvoiceConfirmCreate", "InvoiceFile", FormMethod.Post, new { id = "caseFeeInvoiceConfirm", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.CaseFeeIds)
                    var caseFeeListIds = (Model.CaseFeeIds != null && Model.CaseFeeIds.Any()) ? string.Join(",", Model.CaseFeeIds) : string.Empty;
                    @Html.HiddenFor(m => caseFeeListIds, new { @id = "caseFeeListIds" })
                    
                    <div class="modal-header">
                        <button type="button" class="close" id="btnCaseFeeInvoiceConfirmClose">×</button>
                        <h5 class="modal-title ng-binding">票据确认</h5>
                    </div>
                    <div class="modal-body">
                        <div>
                            <div class="form-group">
                                <label for="InvoiceNo" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">票据编号</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.Invoice.InvoiceNo, new {@class = "form-control"})
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="form-group">
                                <label for="PaymentDate" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">票据日期</span>
                                </label>
                                <div class="col-sm-6">
                                    @Html.TextBoxFor(m => m.Invoice.InvoiceDate, "{0:yyyy-MM-dd}", new {@class = "form-control input_time", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", required = "true"})
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="form-group">
                                <label for="ActualAmount" class="col-sm-3 control-label">
                                    <span class="text-danger ng-binding">*</span>
                                    <span class="ng-binding">票据文件</span>
                                </label>
                                <div class="col-sm-6">
                                    <div class="form-control-wrap">
                                        <input id="txtInvoiceFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control ng-pristine ng-valid" style="display: inline-block">
                                        <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px; border: 0px">
                                            <input type="file" value="" id="flInvoiceFile" name="flInvoiceFile" style="height: 40px; width: 250px; margin-left: 10px;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div style="display: none;" id="divUsers">
                            <div class="i_common_box" style='width: 300px'>
                                <div class="i_common_hd">
                                    从下列用户中选择
                                    <input type="hidden" id="hidUserId">
                                    <input type="hidden" id="hidUserName">
                                </div>
                                <div class="i_common_bd">
                                    <ul class="i_common_ul layoutfix">
                                        @if (staffs != null && staffs.Count > 0)
                                        {
                                            foreach (var staff in staffs.FindAll(x => x.StaffBasic.DepartmentId == 5))
                                            {
                                                <li style='width:100px'><a href="javascript:void(0)" name="@staff.StaffBasic.StaffName">@staff.StaffBasic.StaffChName</a></li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" id="btnCaseFeeInvoiceConfirmCreate" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" id="btnCaseFeeInvoiceConfirmCancel" value="取消" />
                    </div>
                }
            </div>
        </div>
    </div>

</div>

