@using Dchien.Legal.Service.FCM.Contract

@model Dchien.Legal.Web.Areas.Legal.ViewModels.Case.InternalFee.InteralFeeModel

<div class="modal fade" id="internalFeeModal">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("CreateUpdate", "InternalFee", FormMethod.Post, new { id = "internalFee", @class = "form-horizontal" }))
            {
                <div class="modal-header">
                    <button type="button" class="close" onclick="javascript: $('#internalFeeModal').modal('hide');">×</button>
                    <h5 class="modal-title ">新增内部费用</h5>
                </div>
                <div class="modal-body">
                    <div>
                        <div class="form-group">
                            <label for="CaseFileTypeId" class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span class="">支付对象</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.HiddenFor(m => m.InternalFee.PaymentObject)
                                @Html.TextBoxFor(m => m.InternalFee.PaymentObjectName, new { @class = "form-control", @autocomplete = "off", style = "height:28px; " })
                                <div class="i_common_select" id="divAssociateUserList_InternalFee" style="display: none;">
                                    <div class="i_common_wrap">
                                        <div class="i_common_list"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="form-group">
                            <label for="" class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span class="">支付时间</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.InternalFee.PaymentDate, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", @autocomplete = "off", style = "height:28px; ", @onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="form-group">
                            <label for="CaseFileTypeId" class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span class="">费用类型</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.HiddenFor(m => m.InternalFee.InternalFeeId)
                                @Html.HiddenFor(m => m.InternalFee.FeeTypeId)
                                @Html.TextBoxFor(m => m.InternalFee.FeeTypeName, new { @class = "form-control", @autocomplete = "off", style = "height:28px; " })
                            </div>
                            <div style="float: left; padding-top: 5px; padding-left: 1px;">
                                <div style="float: left; padding-top: 5px; padding-left: 1px;">
                                    <a id="lnkCaseFeeTypeIdForInternal" style="color: #039" href="javascript:void(0)">类型</a>
                                 </div>
                            </div>
                        </div>
                    </div>
 
                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span class="spanreferencedate">金额</span>
                            </label>
                            <div class="col-sm-6">
                                <span>@Html.TextBoxFor(m => m.InternalFee.Amount, new { @class = "form-control", @unselectable = "on", style = "height:28px; " } )</span>

                                   
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="form-group">
                            <label for="CaseEvent_EventContent" class="col-sm-3 control-label">
                                <span class="text-danger ng-binding"></span>
                                <span class="ng-binding">备注</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextAreaFor(m => m.InternalFee.Remark, new { @required = "true", maxlength = 1000, rows = 2, style = "width:100%" })
                            </div>
                        </div>
                    </div>

                        <div class="divCaseFeeTypeList"></div>

                        <div class="i_common_select" id="div_CaseFeeTypeList" style="display: none;">
                            <div class="i_common_wrap">
                                <div class="i_common_list"></div>
                            </div>
                        </div>
                    </div>

                <div class="modal-footer">
                    <input class="btn btn-primary " type="button" id="btnInternalFeeCreateUpdate" value="确定" />
                    <input class="btn btn-default " type="button"  value="取消" onclick="javascript: $('#internalFeeModal').modal('hide');"/>
                </div>

            }
        </div>

    </div>
</div>


