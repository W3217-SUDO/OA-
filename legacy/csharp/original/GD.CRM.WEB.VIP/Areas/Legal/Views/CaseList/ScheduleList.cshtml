<div class="viewFramework-product">

    <div class="viewFramework-product-body" style="overflow-y:hidden">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>案件列表</h5>
                            </div>
                            @*<div class="pull-right">
                                <a href="javascript:void(0);" class="btn advancedBtnSearch" onclick="javascript: $('.advancedSearch').show(); $('.commonBtnSearch').show(); $('.advancedBtnSearch').hide(); c.ResetSize();">
                                    高级搜索
                                </a>
                                <a href="javascript:void(0);" style="display:none" class="btn commonBtnSearch" onclick="javascript: $('.advancedSearch').hide(); $('.commonBtnSearch').hide(); $('.advancedBtnSearch').show(); c.ResetSize();">
                                    普通搜索
                                </a>
                            </div>*@
                        </div>
                        <div class="pull-left margin-top-1 col-sm-12  search-collapse" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm" action="@Url.Content("~/Legal/CaseList/List")">
                                @Html.HiddenFor(m => m.SearchCondition.PageId, new { name = "PageId" })
                                @Html.HiddenFor(m => m.SearchCondition.PageName, new { name = "PageName" })
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageSize" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageNo" })
                                @Html.HiddenFor(m => m.SearchCondition.Sorting)
                                @*//@Html.HiddenFor(m => m.SearchCondition.CaseTypeId)*@

                                <table class="search_table" style="width: 600px">
                                    <colgroup>
                                        <col style="width: 140px;" />
                                        <col style="width: 180px" />
                                        <col style="width: 60px;" />
                                        <col style="width: 180px" />
                                        <col style="width: 80px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 80px;" />
                                        <col style="width: 200px" />
                      

                                        <col />
                                    </colgroup>
                                    <tr>
                                        <th>
                                            原告/申请人/公诉机关：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.AppellantName, new { @class = "form-control", @placeholder = "原告", @style = "width:96%" })
                                        </td>


                                        <th>
                                            案号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseNos, new { @class = "form-control", @placeholder = "案号", @style = "width:96%" })
                                        </td>

                                        <th>
                                            经办律师：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseLawyer, new { @class = "form-control", @placeholder = "经办律师", @style = "width:96%" })
                                        </td>

                                        <th>
                                            关键字：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.Keyword, new { @class = "form-control", @placeholder = "案号、法院号、案件名称、客户名称", @style = "width:96%" })
                                        </td>

                                    </tr>
                                    <tr>
                                        <th>
                                            被告/被申请人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.AppelleeName, new { @class = "form-control", @placeholder = "被告", @style = "width:96%" })
                                        </td>

                                        <th>
                                            公证书号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.NotarialNo, new { @class = "form-control", @placeholder = "公证书号", @style = "width:96%" })
                                        </td>

                                        <th>
                                            开庭律师：
                                        </th>
                                        <td >

                                            @Html.TextBoxFor(m => m.SearchCondition.CourtLawyer, new { @class = "form-control", @placeholder = "开庭律师", @style = "width:96%" })
                                        </td>

                                        <th>
                                            法院/机构：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CourtName, new { @class = "form-control", @placeholder = "法院名称", @style = "width:96%" })
                                        </td>
                                    </tr>
                                    <tr>

                                        <th>
                                            第三人/受害人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.TheThirdName, new { @class = "form-control", @placeholder = "第三人", @style = "width:96%" })
                                        </td>
                      
                                        <th>
                                            调查员：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.InvestigatorName, new { @class = "form-control", @placeholder = "调查员", @style = "width:96%" })
                                        </td>
                                        <th>
                                            律师助理：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseAssistant, new { @class = "form-control", @placeholder = "律师助理", @style = "width:96%" })
                                        </td>

                                        <th>
                                            文档名称：
                                        </th>
                                        <td >
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseFileName, new { @class = "form-control", @placeholder = "文档名称", @style = "width:96%" })
                                        </td>

                                    </tr>
                                    <tr class="advancedSearch"  >

                                        <th>
                                            案源时间：
                                        </th>

                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseRegisterDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:80px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseRegisterDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:80px" })
                                        </td>

                                        <th>
                                            开庭时间：
                                        </th>

                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.LawfulDayFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:80px" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.LawfulDayTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:80px" })
                                        </td>
                                         
                        
                                        <th  >
                                            案件类型：
                                        </th>
                                        <td>
                                            @Html.DropDownListFor(m => m.SearchCondition.CaseTypeId, Dchien.Legal.Service.BAS.Type.CaseTypeService.Instance.GetCaseTypeList(true), new { maxlength = 60, @class = "form-control select", style = " width:96%" })
                                        </td>

                                        <th>
                                            日志内容：
                                        </th>
                                        <td >
                                            @Html.TextBoxFor(m => m.SearchCondition.LogContent, new { @class = "form-control", @placeholder = "日志内容", @style = "width:96%" })
                                        </td>

                                    </tr>
                            
                                    <tr>
                                        <th>

                                        </th>
                                        <td>
                                            <div class="form-group">
                                                <a href="javascript:void(0);" class="btn btn-primary " id="btnCaseSearch">
                                                    <span>查询</span>
                                                </a>
                                                <a href="javascript:void(0);" class="btn btn-default " id="btnCaseSearchReset">
                                                    <span>重置</span>
                                                </a>

                                            </div>
                                        </td>
                                    </tr>
                                </table>

                                <div class='divcaseconditioncasephases'></div>
                                <div class='divcaseconditioncasetypes'></div>
                                <div class="i_common_select" id="divAssociateUserList" style="display: none;">
                                    <div class="i_common_wrap">
                                        <div class="i_common_list"></div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="col-sm-12 select-table">
                        <div class="">
                            <table class="aps-table aps-widget aps-ani-transition ">
