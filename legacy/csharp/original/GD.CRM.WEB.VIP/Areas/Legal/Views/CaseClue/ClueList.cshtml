
@model Dchien.Legal.Web.Areas.Legal.ViewModels.Case.CaseClueListModel

@{
    var display = "display:block";

    if (@Model.CaseClues != null && @Model.CaseClues.Count > 0)
    {
        display = "display:none";
    }

}

<form id="postForm" action="">
    <div id="taskgridSection" class="gridSection">

        <div id='divContextList' style="overflow-y: auto; margin-top: -1px; overflow-x: hidden; overflow-y: auto; ">
            <table class='table table-hover' id="tblCaseClueList" width="100%">
                <colgroup>
                    <col style="width: 3%">
                    <col style="width: 10%">
                    <col style="width: 15%">
                    <col style="width: 15%">
                    <col style="width: 30%">
                    <col style="width: 20%">
                    <col style="width: 10%">
                    <col style="width: 10%">
                    <col style="width: 10%">
                </colgroup>

                <thead>
                    <tr>
                        <th style="text-align: center">
                            序号
                        </th>
                        <th style="text-align: center">
                            线索号
                        </th>
                        <th style="text-align: center">
                            调查时间
                        </th>
                        <th style="text-align: center">
                            店铺名称
                        </th>
                        <th style="text-align: center">
                            店铺地址
                        </th>

                        <th style="text-align: center">
                            公证书号
                        </th>
                        <th style="text-align: center">
                            发票号
                        </th>
                        <th style="text-align: center">
                            仓库名称
                        </th>
                        <th style="text-align: center">
                            仓库位置
                        </th>
                    </tr>

                </thead>

                <tbody>
                    @if (Model.CaseClues != null)
                    {

                        foreach (var item in Model.CaseClues)
                        {
                            <tr>
                                <td style="text-align: center">
                                    <span>@(Model.CaseClues.IndexOf(item) + 1)</span>
                                </td>

                                <td style="text-align: left">
                                    <a style='color: #039' href="javascript:void(0);" onclick="javascript:investigation.InvestigationClue.View('@item.Basic.ClueNo'); "><span><span>@item.Basic.ClueNo</span> </span></a>
                                </td>
                                <td style="text-align: center">
                                    <span>@item.Basic.InvestigationDate.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                </td>
                                <td style="text-align: left">
                                    <span>@item.Basic.StoreName </span>
                                </td>
                                <td style="text-align: left">
                                    <span style="white-space:nowrap"> 

                                        @if (string.IsNullOrEmpty(item.Basic.Address))
                                        {
                                            <a target='_blank' href=@item.Basic.StoreUrl><span>@item.Basic.StoreUrl</span></a>
                                        }
                                        else
                                        {
                                            @item.Basic.Address
                                        }
                                    </span>
                                </td>
                                <td style="text-align: left">
                                    <span>@item.InvestigationClueEvidenceList[0].Basic.NotarialNo </span>
                                </td>
                                <td style="text-align: left">
                                    <span>@item.InvestigationClueEvidenceList[0].Basic.InvoiceNo </span>
                                </td>
                                <td style="text-align: center">
                                    <span>@item.InvestigationClueEvidenceList[0].Basic.WarehouseName</span>
                                </td>
                                <td style="text-align: center">
                                    <span>@item.InvestigationClueEvidenceList[0].Basic.StorageLocationName</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="ng-scope" style="display:none">
                    <tr>
                        <td colspan="9">
             
                            <div class="ng-scope">
                                <div class="pull-right page-box caseclue">

                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>


            <div class="simple-grid-none-data-wrap" style="@display">
                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" >
                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ></span>
                        <div class="text-size-16 tip-text inline-block">
                            <span class="margin-left ng-binding"></span>没有查询到案件线索.
                        </div>
                    </div>
                </div>
            </div>


        </div>

    </div>


    @Html.HiddenFor(m => m.TotalCount, new { name = "TotalCount" })
    @Html.HiddenFor(m => m.PageNo, new { name = "PageNo" })
    @Html.HiddenFor(m => m.PageSize, new { name = "PageSize" })

</form>



