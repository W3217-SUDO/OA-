@model Dchien.Legal.Web.Areas.Legal.ViewModels.CaseFee.CaseFeeModel
<div class="modal fade" id="caseRefundAmountModal" >
    <div class="modal-dialog" >
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("Edit", "CaseFee", FormMethod.Post, new { id = "caseLog", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    <div class="modal-header">
                        <button type="button" class="close" onclick="javascript: $('#caseRefundAmountModal').modal('hide');">×</button>
                        <h5 class="modal-title ng-binding">法院退费</h5>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                <span class="text-danger">*</span>
                                <span>退费金额：</span>
                            </label>
                            <div class="col-sm-6">
                                @Html.TextBoxFor(m => m.CaseFee.RefundAmount,
                                new
                                {
                                    @class = "form-control inline-block ",
                                    placeholder = "退费金额",
                                    style = "height:28px;width:90%",
                                    @value = "",
                                    cityvalue = "",
                                    autocomplete = "off",
                                })
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button"    onclick="javascript: c.Cases.Case.CaseFees.Refound.CreateUpdate();" value="确定" />
                        <input class="btn btn-default ng-binding" type="button"    onclick="javascript: $('#caseRefundAmountModal').modal('hide');"  value="取消" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>