@using Dchien.Legal.Service.HR.Staff
@using Dchien.Legal.Service.BAS.Type
@using Dchien.Legal.Service.BAS.NotaryOffice
@using Dchien.ServiceStack.Text
@{

    var caseTypes = CaseTypeService.Instance.GetAllCaseTypes();
    var caseFileTypes = CaseTypeService.Instance.GetAllCaseFileTypes();
    var casePhaseTypes = CaseTypeService.Instance.GetAllCasePhases();
    var caseFeeTypes = CaseTypeService.Instance.GetAllCaseFeeTypes();

    var caseTypesToJosn = Newtonsoft.Json.JsonConvert.SerializeObject(caseTypes);
    var casePhasesToJosn = Newtonsoft.Json.JsonConvert.SerializeObject(casePhaseTypes);
    var caseFileTypesToJosn = Newtonsoft.Json.JsonConvert.SerializeObject(caseFileTypes);
    var caseFeeTypesToJosn = Newtonsoft.Json.JsonConvert.SerializeObject(caseFeeTypes.FindAll(x => x.IsActived));

    var caseTaskTypes = TaskTypeService.Instance.GetAllTaskTypes();
    var caseTaskTypesToJosn = Newtonsoft.Json.JsonConvert.SerializeObject(caseTaskTypes);

    var notaryOffices = NotaryOfficeService.Instance.GetAllNotaryOffices();
    var notaryOfficesToJosn = Newtonsoft.Json.JsonConvert.SerializeObject(notaryOffices);

    //var menus = MenuService.Instance.GetMenusByCurrentUser();

}
