<style>
    p {
        margin: 0 0 5px;
    }

    input.input_text, textarea, select, input.input_time {
        border: 1px solid #ccc;
    }


    input.input_text, textarea, input.input_time {
        padding: 2px 2px 2px 3px;
    }

    input.input_text, textarea, input.input_time {
        background-color: #fff;
    }

    .case-form-control {
        /*border-radius: 0px;*/
        -webkit-transition: none;
        transition: none;
        font-size: 12px;
        width: 100%;
        height: 24px;
    }



    table td, th {
        padding: 0px 0;
        /* border-bottom: 1px dotted #D6D6D6; */
        vertical-align: middle;
    }

    .input_table th {
        font-weight: normal;
        text-align: right;
    }

    .input_table td {
        text-align: left;
    }

    .multi-select .value .element {
        border: 0px solid #999;
        margin: 0;
        padding: 2px;
    }

    .multi-select .value {
        border: 0px solid #999;
    }

    .bootstrap-tagsinput {
        width: 100%;
        border-radius: 0px;
        padding: 2px 1px;
        border: 0px solid #ccc;
        box-shadow: none;
    }

        .bootstrap-tagsinput input {
            padding: 0px;
            width: 45px;
        }

        .bootstrap-tagsinput .tag [data-role="remove"] {
            margin-left: 5px;
            cursor: pointer;
        }

            .bootstrap-tagsinput .tag [data-role="remove"]:after {
                content: "x";
                padding: 0px 0px;
            }
</style>
