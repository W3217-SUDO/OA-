@using Dchien.Legal.Common
@using Dchien.Legal.Service
@using Dchien.Legal.Service.BAS.Type
@using Dchien.Legal.Entity.Legal.Case;

@model Dchien.Legal.Web.Areas.Legal.ViewModels.Case.CaseModel

<link rel="stylesheet" href="@Url.Content("~/Resource/css/bootstrap-tagsinput.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" />
<script src="@Url.Content("~/Scripts/Common/bootstrap-tagsinput.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Legal/Case/Legal.Case.Litigant.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<style>
    .bootstrap-tagsinput {
        width: 100%;
        border-radius: 0px;
        padding: 2px 4px;
    }

        .bootstrap-tagsinput input {
            padding: 0px;
            width: 50px;
        }
     

    .chosen-container-multi .chosen-choices {
        border: 1px solid #cccccc;
        font-size: 12px;
    }
</style>

<div class="modal fade" id="casePublicSecurityUnitModal" >
 
    <div class="modal-dialog" style="width:720px">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("PublicSecurityUnitEdit", "Case", FormMethod.Post, new { id = "caseLog", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
          
                    <div class="modal-header">
                        <button type="button" class="close" onclick="javascript: $('#casePublicSecurityUnitModal').modal('hide');">×</button>
                        <h5 class="modal-title ng-binding">公安信息</h5>
                    </div>
                    <div class="modal-body">

 

                            <div class="form-group">
                                <label class="col-sm-3 control-label">

                                    <span>公安机关名称：</span>
                                </label>
                                <div class="col-sm-7">
                                    @Html.TextBoxFor(m => m.Case.Basic.PublicSecurityUnitName,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "公安机关名称",
                                                   style = "height:29px;width:100%",
                                                   @value = "",
                                                   cityvalue = "",
                                                   autocomplete = "off"
                                               })

                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">

                                    <span>公安案号：</span>
                                </label>
                                <div class="col-sm-7">
                                    @Html.TextBoxFor(m => m.Case.Basic.PublicSecurityUnitCaseNo,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "公安案号",
                                                   style = "height:29px;width:100%",
                                                   autocomplete = "off"
                                               })
                                </div>
                            </div>

                            <div class="form-group">

                                <label class="col-sm-3 control-label">

                                    <span>地址：</span>
                                </label>
                                <div class="col-sm-7">
                                    @Html.TextBoxFor(m => m.Case.Basic.PublicSecurityUnitAddress,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "地址",
                                                   style = "height:29px;width:100%",
                                                   autocomplete = "off"
                                               })
                                </div>

                            </div>


                            <div class="form-group">
                                <label class="col-sm-3 control-label">

                                    <span>联系方式：</span>
                                </label>


                                <div class="col-sm-7">
                                    <div class="bootstrap-tagsinput">
                                        @Html.TextBoxFor(m => m.Case.Basic.PublicSecurityUnitPhone,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "联系方式",
                                                   style = "height:22px;width:90%",
                                                   @value = "",
                                                   cityvalue = "",
                                                   autocomplete = "off"
                                               })

                                    </div>

                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    <span>经办人：</span>
                                </label>
                                <div class="col-sm-7">
                                    @Html.TextBoxFor(m => m.Case.Basic.PublicSecurityUnitOperator,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "经办人",
                                                   style = "height:29px;width:100%",
                                                   autocomplete = "off"
                                               })
                                </div>

                            </div>

   
                  
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button"    onclick="javascript: c.Cases.Case.PublicSecurityUnit.CreateUpdate(c.Cases.Case.PublicSecurityUnit.CreateUpdate_Refersh);" value="确定" />
                        <input class="btn btn-default ng-binding" type="button"    onclick="javascript: $('#casePublicSecurityUnitModal').modal('hide');"  value="取消" />
                    </div>
                }
            </div>
        </div>
    </div>
   
</div>