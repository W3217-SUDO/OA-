
<link type="text/css" rel="stylesheet" href=@Url.Content("~/Resource/css/ticketSystem/add.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"]) />

<div class="slide-panels">
    <div class="slide-panel active medium">
        <div class="slide-panel-content">
            <div class="panel-header">
                <h5>生成结果</h5>
                <a class="panel-close" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');">
                    <i class="next-icon next-icon-close next-small" style="font-size: 0px;">close</i>
                </a>
                <div class="head-custom"></div>
            </div>
            <div class="placeholder">...</div>
            <div class="panel-body">
                <div class="panel-body-content">
                    <div class="page-overview-panel-apply">
                        <div ui-view="myTicket">
                            <div class="ticket-detail">

                                <div class="create-ticket-step clearfix" style="margin-top: 0px;margin-bottom: 10px;">
                                    <div class="create-ticket-step-item" style="width:50%">
                                        <div class="item-wrap">
                                            <span class="icon-step">1</span>
                                            <span class="dingding-text">基本信息</span>
                                        </div>
                                    </div>
                                    <div class="create-ticket-step-item active" style="width:50%">
                                        <div class="item-wrap">
                                            <span class="icon-step">2</span>
                                            <span class="dingding-text">生成结果</span>
                                        </div>
                                    </div>

                                </div>


                                <div class="">
                                    <div class="">
                                        <div class="">
                                            <style type="text/css" class="">
                                                .tableWrapper .table {
                                                    margin-bottom: 0px;
                                                }

                                                .table-hover tbody tr.trWarapper:hover td {
                                                    background-color: #FCF8E2;
                                                }
                                            </style>
                                            <div class="">
                                                <div class="alert alert-info clearfix" style="padding: 8px 12px 0px;line-height: 18px;margin-bottom: 6px;border-radius: 0px">
                                                    <div class="pull-left">
                                                        <span>温馨提示</span> ：
                                                    </div>
                                                    <div class="pull-left">
                                                        <p>1. <span>案件名称默认为客户名称+案由+侵权店铺名称.</span> </p>
                                                        <p>2. <span>调查员默认线索提供人.</span> </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="col-sm-12" style="padding:0px">
                                        <div class="gridSection">
                                            <table class="aps-table aps-widget aps-ani-transition " id="tblCaseList" width="100%">
                                                <colgroup>
                                                    <col style="width: 15%">
                                                    <col style="width: 40%">
                                                    <col style="width: 10%">
                                                    <col style="width: 10%">
                                                    <col style="width: 10%">
                                                </colgroup>
                                                <thead>
                                                    <tr>
                                                        <th>案件号</th>
                                                        <th>案件名称</th>
                                                        <th>经办律师</th>
                                                        <th>调查员</th>
                                                        <th>立案日期</th>
                                                    </tr>
                                                </thead>
                                                <tbody style="position:relative;z-index: 99;"></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="panel-footer">
            <div class="btn-con">
                <input type="button" class="btn  btn-normal" style="border-radius: 0;
                                                                        padding: 0 16px;
                                                                        height: 32px;
                                                                        line-height: 30px;
                                                                        font-size: 12px;
                                                                        border-width: 1px;" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');" value="关闭" />
            </div>
        </div>
    </div>
</div>
