@using Dchien.Legal.Service
@model Dchien.Legal.Web.Areas.Lawsuit.ViewModels.Case.CaseListModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/bsn.console.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />

<script src="@Url.Content("~/Scripts/Lawsuit/CaseSearch/Case.Search.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>

<div class="viewFramework-product ">
    <div class="viewFramework-product-body">
        <div ng-transclude="">
            <div class="console-container ">
                <div class="row ">
                    <div class="col-sm-12">
                        <div class="console-title console-title-border clearfix">
                            <div class="pull-left">
                                <h5>案件查询</h5>
                            </div>
                        </div>
                      
                        <div class="pull-left margin-top-1 col-sm-12" style="margin-bottom:4px">
                            <form class="form-inline ng-valid " id="postForm" action="@Url.Content("~/Lawsuit/Case/Cases")">
                                @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageNo" })
                                @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageSize" })
                                <table class="search_table" style="width: 100%">
                                    <colgroup>
                                        <col style="width: 80px;" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 160px" />
                                        <col style="width: 60px" />
                                        <col style="width: 160px" />

                                        <col style="width: 60px" />
                                        <col style="width: 160px" />

                                        <col>
                                    </colgroup>
                                    <tr>
                                        <th>
                                            案号：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseNo, new { @class = "form-control", @placeholder = "案号" })
                                        </td>
                                        <th>
                                            案件名称：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseName, new { @class = "form-control", @placeholder = "案件名称" })
                                        </td>
                                        <th>
                                            案件阶段：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CasePhaseName, new { @class = "form-control", @placeholder = "案件阶段" })
                                            @Html.HiddenFor(m => m.SearchCondition.CasePhaseId)
                                        </td>

                                    </tr>

                                    <tr>

                                        <th>
                                            当事人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.Party, new { @class = "form-control", @placeholder = "被告、原告、权利人" })
                                        </td>

                                        <th>
                                            案源人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseOriginPeople, new { @class = "form-control", @placeholder = "案源人" })
                                        </td>

                                        <th>
                                            法院名称：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CourtName, new { @class = "form-control", @placeholder = "法院名称" })
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>
                                            经办律师：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseLawyer, new { @class = "form-control", @placeholder = "经办律师" })
                                        </td>

                                        <th>
                                            律师助理：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseAssistantLawyer, new { @class = "form-control", @placeholder = "律师助理" })
                                        </td>

                                        <th>
                                            调查人员：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.Investigator, new { @class = "form-control", @placeholder = "调查人员" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>
                                            权利类型：
                                        </th>
                                        <td>
                                            @*@Html.TextBoxFor(m => m.SearchCondition.CaseTypeName, new { @class = "form-control", @placeholder = "权利类型" })*@
                                            @Html.DropDownListFor(m => m.SearchCondition.CopyrightTypeId, Dchien.Legal.Service.Lawsuit.Case.CaseCopyrightTypeService.Instance.GetCopyrightTypeList(true), new { @class = "form-control", @width = "100%" })
                                        </td>
                                        <th>
                                            开庭时间：
                                        </th>
                                   
                                        <td colspan="3">
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseLawfulDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})"})
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseLawfulDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>
                                            处理人：
                                        </th>
                                        <td>
                                            @Html.TextBoxFor(m => m.SearchCondition.CaseOfficer, new { @class = "form-control", @placeholder = "处理人" })
                                        </td>
                                        <th>
                                            处理时间：
                                        </th>
                                        <td colspan="3">
                                            @Html.TextBoxFor(m => m.SearchCondition.DeadlineFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                            -
                                            @Html.TextBoxFor(m => m.SearchCondition.DeadlineTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})" })
                                        </td>
                                        <td colspan="3">
                                            <a href="javascript:void(0);" class="btn btn-primary " id="btnCaseSearch">
                                                <span>查询</span>
                                            </a>
                                            <a style="display:none" href="javascript:void(0);" class="btn btn-primary " id="btnCaseExportToExcel">
                                                <span>导出Excel</span>
                                            </a>
                                        </td>
                                    </tr>
                                </table>

                                <div class='divcaseconditioncasephases'></div>
                            </form>
                        </div>

                    </div>

                    <div class="col-sm-12">
                        <div class="">
                            <div class="gridSection">
                                <table id="tblCaseList" class="table table-hover " style="width:100%">
                                    <thead>
                                        <tr>
                                            <th style="text-align: center">案件编号</th>
                                            <th style="text-align: center">案由</th>
                                            <th style="text-align: center">案件阶段</th>
                                            <th style="text-align: center">原告</th>
                                            <th style="text-align: center">被告</th>
                                            <th style="text-align: center">案件来源</th>
                                            <th style="text-align: center">处理人</th>
                                            <th style="text-align: center">现处理日期</th>

                                            <th>操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td>
                                                &nbsp;
                                            </td>
                                            <td style="text-align: left"></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="" style="display: none">
                                        <tr>
                                            <td colspan="9">
                                                <div class="pull-left"></div>
                                                <div class="">
                                                    <div class="pull-right page-box Caselist">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="simple-grid-none-data-wrap">
                                <div class="simple-grid-none-data text-center  ">
                                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                        <div class="text-size-16 tip-text inline-block">
                                            <span class="margin-left " ng-bind-html="vm.msg">没有查询到符合条件的记录</span>
                                            <span class="">。</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    
                    <div class="i_common_select" id="div_customer" style="display: none;">
                        <div class="i_common_wrap">
                            <div class="i_common_list"></div>
                        </div>
                    </div>
                    
                   

                </div>

            </div>
        </div>
    </div>
</div>
