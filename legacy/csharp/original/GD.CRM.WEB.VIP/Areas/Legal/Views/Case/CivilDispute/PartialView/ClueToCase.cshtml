@using Dchien.Legal.Entity.System
@using Dchien.Legal.Service.BAS
@using Dchien.Legal.Service.BAS.Type

@model Dchien.Legal.Web.Areas.Legal.ViewModels.Case.CaseModel

<script src="@Url.Content("~/Scripts/Common/bootstrap-tagsinput.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Legal/Case/Legal.Case.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/Legal/Case/Legal.Case.Basic.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<link type="text/css" rel="stylesheet" href=@Url.Content("~/Resource/css/ticketSystem/add.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"]) />


<style>
    .bootstrap-tagsinput {
        width: 90%;
        border-radius: 0px;
        padding: 2px 4px;
        box-shadow: inset 0 0px 0px rgba(0, 0, 0, 0.075);
    }

        .bootstrap-tagsinput input {
            padding: 0px;
            width: 50px;
        }

 

    .chosen-container-multi .chosen-choices {
        border: 1px solid #cccccc;
        font-size: 12px;
    }

        .chosen-container-multi .chosen-choices li.search-field input[type=text] {
            height: 28px;
        }
</style>


<div class="slide-panels">
    <div class="slide-panel active medium">
        <div class="slide-panel-content">
            <div class="panel-header">
                <h5>生成案件</h5>
                <a class="panel-close" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');">
                    <i class="next-icon next-icon-close next-small" style="font-size: 0px;">close</i>
                </a>
                <div class="head-custom"></div>
            </div>
            <div class="placeholder">...</div>
            <div class="panel-body">
                <div class="panel-body-content">
                    <div class="page-overview-panel-apply">
                        <div ui-view="myTicket">
                            <div class="ticket-detail ">

                                <div class="create-ticket-step clearfix" style="margin-top: 0px;margin-bottom: 10px;">
                                    <div class="create-ticket-step-item active" style="width:50%">
                                        <div class="item-wrap">
                                            <span class="icon-step">1</span>
                                            <span class="dingding-text">基本信息</span>
                                        </div>
                                    </div>
                                    <div class="create-ticket-step-item"  style="width:50%">
                                        <div class="item-wrap">
                                            <span class="icon-step">2</span>
                                            <span class="dingding-text">生成结果</span>
                                        </div>
                                    </div>
       
                                </div>


                                <div class="">
                                    <div class="">
                                        <div class="">
                                            <style type="text/css" class="">
                                                .tableWrapper .table {
                                                    margin-bottom: 0px;
                                                }

                                                .table-hover tbody tr.trWarapper:hover td {
                                                    background-color: #FCF8E2;
                                                }
                                            </style>
                                            <div class="">
                                                <div class="alert alert-info clearfix" style="padding: 8px 12px 0px;line-height: 18px;margin-bottom: 6px;border-radius: 0px">
                                                    <div class="pull-left">
                                                        <span>温馨提示</span> ：
                                                    </div>
                                                    <div class="pull-left">
                                                        <p>1. <span>案件名称默认为客户名称+案由+侵权店铺名称.</span> </p>
                                                        <p>2. <span>调查员默认线索提供人.</span> </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div role="grid" class="next-form next-medium">
                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label required="">线索号：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <div class="bootstrap-tagsinput">

                                                @if (!string.IsNullOrEmpty(Model.InvestigationClueNos))
                                            {
                                                var clueNos = Model.InvestigationClueNos.Split(',');
                                                var i = 0;
                                                foreach (var clueNo in Model.InvestigationClueNos.Split(','))
                                                {
                                            <span class="tag label label-info">
                                                <a name="clueNo" style="color:white; width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                                   clueno="@clueNo" data-toggle="tooltip" data-container="body" href="javacript:void(0);"
                                                   target="_blank" data-original-title="@clueNo">@clueNo</a>
                                                <span class="clueremove" data-role="remove"></span>
                                            </span>
                                                    i++;
                                                }
                                            }

                                                <input type="text" readonly class="form-control inline-block" disabled style="height:26px;width: 1px;margin-left: 6px;" id="CIT_ClueNo_Input" autocomplete="off" size="1">
                                            </div>
                                            <br>
                                            <span style="color:red">@Html.DisplayTextFor(m => m.ErrorMessage)</span>
                                        </div>
                                    </div>

                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label required="">客户：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <span class="next-input next-medium">

                                                @Html.HiddenFor(m => m.Case.Basic.CustomerNo)

                                                @Html.TextBoxFor(m => m.Case.Basic.CustomerName,
                                                new
                                                {
                                                    @class = "form-control select",
                                                    @style = "border:none;height:100%",
                                                    placeholder = "客户名称",
                                                    @value = "",
                                                    cityvalue = "",
                                                    autocomplete = "off",
                                                    @readonly = true
                                                })

                                            </span>
                                        </div>
                                    </div>

                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label required="">客户诉讼地位：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <span class="next-input next-medium">
                                                @Html.DropDownListFor(m => m.Case.Basic.CustomerTypeId, CaseCustomerTypeService.Instance.GetCaseCustomerTypeList((int)Dchien.Legal.Entity.BAS.Type.CaseType.CaseType_110),
                                            new
                                            {
                                                maxlength = 60,
                                                @disabled = true,
                                                @class = "form-control select",
                                                @style = "border:none;height:100%",
                                            })

                                            </span>
                                        </div>
                                    </div>

                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label required="">合同号：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <span class="next-input next-medium">

                                                @{
                                                if (Model.ContractList != null && Model.ContractList.Any())
                                                {
                                            <select class="form-control select"
                                                    id="Case_Basic_ContractNo"
                                                    maxlength="60"
                                                    name="Case.Basic.ContractNo"
                                                    style="border:none;height:100%">

                                                @{
                                                            foreach (var contract in Model.ContractList)
                                                            {
                                                        <option value="@contract.ContractBasicInfo.ContractNo">@(contract.ContractBasicInfo.ContractNo + "_" + contract.ContractBasicInfo.ContractName)</option>
                                                            }
                                                }

                                            </select>
                                                            }
                                                            else
                                                            {    <select class="form-control select" id="Case_Basic_ContractNo" maxlength="60" name="Case.Basic.ContractNo" style="border:none;height:100%">
                                                <option value="">请选择合同</option>
                                            </select>
                                                            }
                                                }
                                            </span>
                                        </div>
                                    </div>

                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label required="">案由：</label>
                                        </div>

                                        <div class="next-col next-col-18 next-form-item-control">

                                            <div class="bootstrap-tagsinput">
                                                <input type="text" placeholder="案由" class="form-control inline-block"
                                                       style="height:26px;width: 200px;margin-left: 6px;"
                                                       id="Case_Basic_CauseName_Input" autocomplete="off" size="1">
                                            </div>
                                            <div class="i_common_select" id="div_cause" style="display: none;">
                                                <div class="i_common_wrap">
                                                    <div class="i_common_list"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label required="">案件阶段：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <span class="next-input next-medium">
                                                @Html.DropDownListFor(m => m.Case.Basic.CasePhaseId, CasePhaseService.Instance.GetCasePhaseList((int)Dchien.Legal.Entity.BAS.Type.CaseType.CaseType_110),
                                            new
                                            {
                                                maxlength = 60,
                                                @class = "form-control select",
                                                style = "border:none;height:100% ",
                                                @disabled=true
                                            })
                                            </span>
                                        </div>
                                    </div>

                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">

                                            <label required="">经办律师：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">

                                            <div class="bootstrap-tagsinput">
                                                <span class="tag label label-info">
                                                    <a name="lawyername" style="color:white; width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                                       username="REDACTED_ARCHIVE_ONLY" userchname="陶国南" title="" data-toggle="tooltip" data-container="body" href="javascript:void(0);" data-original-title="陶国南">陶国南</a>
                                                </span>
                                            </div>

                                            @*<div class="bootstrap-tagsinput">
                                                <input type="text" placeholder="经办律师" class="form-control inline-block"
                                                       style="height:26px;width: 200px;margin-left: 6px;"
                                                       id="Case_Basic_CaseLawyer_Input" autocomplete="off" size="1">
                                            </div>*@
                                            <div class="i_common_select" id="div_lawyerlist" style="display: none;">
                                                <div class="i_common_wrap">
                                                    <div class="i_common_list"></div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                    <div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">

                                            <label required="">律师助理：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <div class="bootstrap-tagsinput">
                                                <input type="text" placeholder="律师助理" class="form-control inline-block" style="height:26px;width: 200px;margin-left: 6px;" id="Case_Basic_CaseAssistant_Input" autocomplete="off" size="1">
                                            </div>
                                            <div class="i_common_select" id="div_assistantlist" style="display: none;">
                                                <div class="i_common_wrap">
                                                    <div class="i_common_list"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @*<div class="next-row next-form-item next-medium">
                                        <div class="next-col next-col-5 next-form-item-label">
                                            <label required="">调查员：</label>
                                        </div>
                                        <div class="next-col next-col-18 next-form-item-control">
                                            <div class="bootstrap-tagsinput">

                                                @if (!string.IsNullOrEmpty(Model.Case.Basic.Investigator))
                                                {
                                                    var investigatorNames = Model.Case.Basic.InvestigatorName.Split(',');
                                                    var i = 0;
                                                    foreach (var investigatorName in Model.Case.Basic.Investigator.Split(','))
                                                    {
                                                        <span class="tag label label-info">
                                                            <a name="investigatorname" style="color:white; width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                                               username="REDACTED_ARCHIVE_ONLY" userchname="@investigatorNames[i]" data-toggle="tooltip" data-container="body" href="javascript:caseInfo.CaseCustomer.ViewCustomer('@investigatorName');"
                                                               target="_blank" data-original-title="@investigatorNames[i]">@investigatorNames[i]</a>
                                                            <span class="investigatorremove" data-role="remove"></span>
                                                        </span>
                                                        i++;
                                                    }
                                                }

                                                <input type="text" placeholder="调查员" class="form-control inline-block" style="height:26px;width: 100px;margin-left: 6px;" id="Case_Basic_Investigator_Input" autocomplete="off" size="1">
                                            </div>
                                            <div class="i_common_select" id="div_investigatorlist" style="display: none;">
                                                <div class="i_common_wrap">
                                                    <div class="i_common_list"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>*@

                                </div>
                             </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="panel-footer">
                <div class="btn-con">


                    <input type="button" id="btnClueGenerateCaseCreate" class="btn btn-primary ng-binding" style="height: 32px; line-height: 14px;   padding: 8px 16px;" value="确定" />
                   

                    <input type="button" class="btn  btn-normal" style="border-radius: 0;
                                                                        padding: 0 16px;
                                                                        height: 32px;
                                                                        line-height: 30px;
                                                                        font-size: 12px;
                                                                        border-width: 1px;" onclick="javascript: $('.slide-panel-container').empty(); $('.slide-panel-container').removeClass('show-panel');" value="取消" />
                </div>
            </div>
        </div>
    </div>
</div>
