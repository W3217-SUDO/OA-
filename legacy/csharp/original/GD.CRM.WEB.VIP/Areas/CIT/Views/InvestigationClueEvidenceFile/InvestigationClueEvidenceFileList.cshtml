@using Dchien.Legal.Entity.System
@using Dchien.Legal.Service.BAS;

@model Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationClue.Evidence.File.InvestigationClueEvidenceFileListModel

<script type="text/javascript" src="@Url.Content("~/Scripts/CIT/Investigation/CIT.Investigation.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/CIT/Investigation/CIT.Investigation.Clue.Evidence.File.List.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<div class="viewFramework-product">

    <div class="viewFramework-product-body" style="background:#ffffff">
        <div class="console-container ">
            <div class="row ">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5>公证书文件列表</h5>
                        </div>
                    </div>

                    <div class="pull-left margin-top-1 col-sm-12" style="margin-bottom:4px">
                        <form class="form-inline ng-valid " id="postForm">
                            @Html.HiddenFor(m => m.SearchCondition.PageId)
                            @Html.HiddenFor(m => m.SearchCondition.PageName, new { name = "PageName" })
                            @Html.HiddenFor(m => m.SearchCondition.PageNo, new { name = "PageNo" })
                            @Html.HiddenFor(m => m.SearchCondition.PageSize, new { name = "PageSize" })
                            @Html.HiddenFor(m => m.SearchCondition.TotalCount, new { name = "TotalCount" })

                            <table class="search_table" style="width: 600px">
                                <colgroup>
                                    <col style="width: 60px;" />
                                    <col style="width: 160px" />
                                    <col style="width: 60px;" />
                                    <col style="width: 160px" />
                                    <col style="width: 60px;" />
                                    <col style="width: 160px" />
                                    <col style="width: 60px;" />
                                    <col style="width: 220px" />

                                    <col>
                                </colgroup>
                                <tr>
                                    <th style="text-align: left">
                                        线索编号：
                                    </th>
                                    <td>
                                        @Html.TextBoxFor(m => m.SearchCondition.InvestigationClueNo, new { @class = "form-control", @style = "width:95%" })
                                    </td>
 
             
                                    <th style="text-align: left">
                                        调查员：
                                    </th>
                                    <td>
                                        @Html.TextBoxFor(m => m.SearchCondition.InvestigatorName, new { @class = "form-control", @style = "width:95%" })
                                    </td>
                                    <th style="text-align: left">
                                        文书：
                                    </th>
                                    <td>
                                        @Html.TextBoxFor(m => m.SearchCondition.CaseAssistantName, new { @class = "form-control", @style = "width:95%" })
                                    </td>
                                    <th style="text-align: left">
                                        权利人：
                                    </th>
                                    <td>
                                        @Html.TextBoxFor(m => m.SearchCondition.IndicterName, new { @class = "form-control", @style = "width:97.3%" })
                                    </td>
                                </tr>

                                <tr>
                                    <th style="text-align: left">
                                        案件编号：
                                    </th>
                                    <td>
                                        @Html.TextBoxFor(m => m.SearchCondition.CaseNo, new { @class = "form-control", @style = "width:95%" })
                                    </td>
                                    <th style="text-align: left">
                                        店铺名称：
                                    </th>
                                    <td>
                                        @Html.TextBoxFor(m => m.SearchCondition.StoreName, new { @class = "form-control", @style = "width:95%" })
                                    </td>

                                    <th style="text-align: left">
                                        处理人：
                                    </th>
                                    <td>
                                        @Html.TextBoxFor(m => m.SearchCondition.UploaderName, new { @class = "form-control", @style = "width:95%" })
                                    </td>
                                    <th style="text-align: left">
                                        导入日期：
                                    </th>
                                    <td>
                                        @Html.TextBoxFor(m => m.SearchCondition.UploadDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        -
                                        @Html.TextBoxFor(m => m.SearchCondition.UploadDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                    </td>
                                </tr>


                                <tr>

                                    <th style="text-align: left">
                                        发票号：
                                    </th>
                                    <td>
                                        @Html.TextBoxFor(m => m.SearchCondition.InvoiceNo, new { @class = "form-control", @style = "width:95%" })
                                    </td>
         

                                    <th style="text-align: left">
                                        公证书号：
                                    </th>
                                    <td>
                                        @Html.TextBoxFor(m => m.SearchCondition.NotarialNo, new { @class = "form-control", @style = "width:95%" })
                                    </td>
 
                                    <th style="text-align: right">
                                        公证机构：
                                    </th>
                                    <td>
                                        @Html.TextBoxFor(m => m.SearchCondition.NotaryOrganization, new { @class = "form-control", @style = "width:95%" })
                                    </td>

                                    <th style="text-align: left">
                                        取证日期：
                                    </th>
                                    <td>
                                        @Html.TextBoxFor(m => m.SearchCondition.EvidenceDateFrom, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                        -
                                        @Html.TextBoxFor(m => m.SearchCondition.EvidenceDateTo, "{0:yyyy-MM-dd}", new { @class = "input_time form-control", onfocus = "WdatePicker({doubleCalendar:true,dateFmt:'yyyy-MM-dd'})", @style = "width:100px" })
                                    </td>

               
                                </tr>

                                <tr>
                                    <td style="text-align: left"></td>
                 

                                    <td style="text-align: left">
                                        <a href="javascript:void(0);" class="btn btn-primary " id="btnInvestigationClueEvidenceSearch">
                                            <span>查询</span>
                                        </a>
                                    </td>
                                </tr>

                            </table>

                        </form>
                    </div>

                </div>
                <div class="col-sm-12">
                    <div class="ng-scope">
                        <div class="gridSection" id="investigationgridSection">
                            <table id="tblClueEvidenceFileList" class="aps-table aps-widget aps-ani-transition ">
                                <colgroup>
                                    <col style="width: 3%">
                                    <col style="width: 15%">
                                    <col style="width: 6%">
                                    <col style="width: 8%">
                                    <col style="width: 12%">
                                    <col style="width: 8%">
                                    <col style="width: 10%">
                                    <col style="width: 6%">
                                    <col style="width: 6%">
                                    <col style="width: 12%">
                                    <col style="width: 12%">
                                    <col style="width: 6%">
                                    <col style="width: 15%">
                                    <col style="width:6%">
                                </colgroup>
                                <thead>
                                    <tr>
                                        <td><input type="checkbox" id="chkClueAll" name="chkClueAll"></td>
                                        <th style="text-align: left">
                                            文件名称
                                        </th>
                                        <th style="text-align: left">
                                            发票号
                                        </th>
                                        <th style="text-align: left">
                                            取证时间
                                            <span>
                                                <span class="aps-state-hidden"></span>
                                                <span data-field="T.lawfulDay" class="aps-widget aps-ani-transition aps-sort  aps-state-visible">
                                                    <i type="up" class="aps-icon aps-ani-transition aps-widget aps-icon-shangjiantou aps-sort-btn aps-sort-btn-up"></i>
                                                    <i type="down" class="aps-icon aps-ani-transition aps-widget aps-icon-xiajiantou aps-sort-btn aps-sort-btn-down"
                                                       style="top:9px">
                                                    </i>
                                                </span>
                                            </span>
                                        </th>
                                        <th style="text-align: left">
                                            取证机构
                                        </th>
                                        <th style="text-align: left">
                                            线索编号
                                        </th>
                                        <th style="text-align: left">
                                            案件编号
                                        </th>
                                        <th style="text-align: left">
                                            调查员
                                        </th>
                                        <th style="text-align: left">
                                            文书
                                        </th>
                                        <th style="text-align: left">
                                            店铺名称
                                        </th>
                                        <th style="text-align: left">
                                            权利人
                                        </th>
                                        <th style="text-align: left">
                                            处理人
                                        </th>
                                        <th style="text-align: left">
                                            公证书号
                                        </th>
                                        <th style="text-align: left">
                                            导入时间
                                        </th>
                                    </tr>

                                </thead>
                                <tbody>
                                    <tr style="display: none">
                                        <td style="text-align: center"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left;"></td>
                                        <td style="text-align: left;white-space:nowrap;"></td>
                                        <td style="text-align: left;white-space:nowrap;"></td>
                                        <td style="text-align: left"></td>

                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                    </tr>

                                    <tr style="display: none">
                                        <td style="text-align: center"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left;"></td>
                                        <td style="text-align: left;white-space:nowrap;"></td>
                                        <td style="text-align: left;white-space:nowrap;"></td>
                                        <td style="text-align: left"></td>

                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                        <td style="text-align: left"></td>
                                    </tr>
                                </tbody>
                                <tfoot class="ng-scope" style="display:none">
                                    <tr>
                                        <td><input type="checkbox" id="chkClueAll" name="chkClueAll"></td>
                                        <td colspan="13">
                                            <div class="pull-left" style="position:absolute;z-index: 1000;">
 
                                                <div class="inline-block dropdown" style="margin-left: 4px">
                                                    <div class="dropdown ng-scope">
                                                        <button class="btn btn-default dropdown-toggle" style="height:32px" data-toggle="dropdown">
                                                            导出线索
                                                            <span class="caret"></span>
                                                        </button>
                                                        <ul class="dropdown-menu" style="position:absolute;z-index: 99999;text-align: left;">
                                                            <li>
                                                                <a href="javascript:;" id="btnInvestigationClueExportSelected" onclick="javascript:void(0);">
                                                                    <span style="font-size:12px">导出选中</span>
                                                                </a>
                                                            </li>
                                                            @*<li>
                                                                <a href="javascript:;" id="btnInvestigationClueExportAll" onclick="javascript:void(0);">
                                                                    <span style="font-size:12px">导出全部</span>
                                                                </a>
                                                            </li>*@
                                                        </ul>
                                                    </div>
                                                </div>

                                                <div class="inline-block dropdown" style="margin-left: 4px">
                                                    <div class="dropdown ng-scope">
                                                        <button class="btn btn-default dropdown-toggle" style="height:32px" data-toggle="dropdown">
                                                            导出交接清单
                                                            <span class="caret"></span>
                                                        </button>
                                                        <ul class="dropdown-menu" style="position:absolute;z-index: 99999;text-align: left;">
                                                            <li>
                                                                <a href="javascript:;" id="btnInvestigationClueExportSelectedForManifest" onclick="javascript:void(0);">
                                                                    <span style="font-size:12px">导出选中</span>
                                                                </a>
                                                            </li>
                                                            @*<li>
                                                                <a href="javascript:;" id="btnInvestigationClueExportAllForManifest" onclick="javascript:void(0);">
                                                                    <span style="font-size:12px">导出全部</span>
                                                                </a>
                                                            </li>*@
                                                        </ul>
                                                    </div>
                                                </div>

                                                @*<input type="button" id="btnInvestigationClueIn"  onclick="javascript:void(0);" class="btn btn-default" style="height:32px" value="导入公正书号&仓库" />*@

                                            </div>
                                            <div class="ng-scope">
                                                <div class="pull-right page-box investigationclueevidencefile">
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <div class="simple-grid-none-data-wrap">
                            <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                                <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                                    <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                                    <div class="text-size-16 tip-text inline-block">
                                        <span class="margin-left ng-binding">没有查询到符合条件的记录</span>
                                        <span class="ng-binding">。</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div id="sidebox" class="sidebox active" style="overflow-y: auto;width: 30%; min-width: 750px; display:none">
            <div class="sidebox-content"></div>
        </div>
    </div>
</div>






