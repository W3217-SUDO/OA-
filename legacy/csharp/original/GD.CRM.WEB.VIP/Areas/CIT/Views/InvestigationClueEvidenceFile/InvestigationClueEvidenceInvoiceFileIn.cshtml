@using Dchien.Legal.Entity.System
@using Dchien.Legal.Service.BAS.Type

<script type="text/javascript" src="@Url.Content("~/Scripts/CIT/Investigation/CIT.Investigation.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/CIT/Investigation/CIT.Investigation.Clue.Evidence.File.In.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

<style>
    input.input_text, textarea, select, input.input_time {
        border: 1px solid #ccc;
    }

    input.input_text, textarea, input.input_time {
        padding: 2px 0 0px 0px;
    }

    input.input_text, input.input_time {
        background-color: #fff;
    }

    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>
<div class="viewFramework-product">

    <div class="viewFramework-product-body" style="background:#ffffff">
        <div class="console-container ">
            <div class="row ">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5 class="ng-binding">公证书发票文件导入</h5>
                            <label>
                                <span class="ng-binding">
                                    文件命名规则 ：8989565.pdf
                                </span>
                            </label>
                        </div>
                    </div>
                    <div class="pull-left margin-top-1 col-sm-12">
                        @using (Html.BeginForm("InvestigationClueEvidenceFileInvoiceInUpload", "InvestigationClueEvidenceFile", FormMethod.Post, new { id = "uploadingForm", enctype = "multipart/form-data", @class = "form-inline ng-valid ng-valid-required" }))
                        {
                            <input id="txtPrimaryFile" style="display:none">
                            <div class="simple-form-field  ">
                                <div class="form-group ">
                                    <label for="text3" class="control-label">
                                        <span contenteditable="" class="text-danger ng-binding"></span>
                                        <span class="ng-binding">请选择上传文件：</span>
                                    </label>
                                    <div class="form-control-wrap">

                                        <input id="txtFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control ng-pristine ng-valid" style="width: 150px; display: inline-block">
                                        <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px; border: 0px">
                                            <input type="file" value="" id="flZip" name="flFile" style="height: 40px; width: 150px; margin-left: 118px;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="simple-form-field  ">
                                <div class="form-group simple-form-submit ">
                                    <label for="submit4" class="control-label">
                                        <span class="ng-binding">
                                        </span>
                                    </label>
                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary " type="button" id="btnEvidenceInvoiceFileUpload" value="上传文件" />
                                    </div>
                                    <div class="form-control-wrap text-right">
                                        <input class="btn btn-primary ng-binding" type="button" id="btnEvidenceInvoiceFileIn" value="开始导入" />
                                    </div>

                                </div>
                            </div>
                            <div ng-transclude=""></div>

                        }
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="">
                        <div class="">
                            <div class="gridSection">
                                <table id="tblEvidenceFileList"  class="aps-table aps-widget aps-ani-transition ">
                                    <colgroup>
                                        <col style="width: 3%">
                                        <col style="width: 10%">
                                        <col style="width: 15%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 8%">
                                        <col style="width: 15%">
                                        <col style="width: 15%">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th width="10">
                                                <input type="checkbox" id="chkInvestigationClueEvidenceAll" class="ng-pristine ng-valid">
                                            </th>
                                            <th style="text-align: center">文件名</th>
                                            <th style="text-align: center">公证书号</th>
                                            <th style="text-align: center">发票号</th>
                                            <th style="text-align: center">取证时间</th>
                                            <th style="text-align: center">取证机构</th>
                                            <th style="text-align: center">落款时间</th>
                                            <th style="text-align: center">线索编号</th>
                                            <th style="text-align: center">调查员</th>
                                            <th style="text-align: center">店铺名称</th>
                                            <th style="text-align: center">权利人</th>
           
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                        </tr>
                                        <tr style="display: none">
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                            <td style="text-align: center"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="sidebox" class="sidebox active" style="overflow-y:auto;width: 30%; min-width: 700px;display:none">
        <div class="sidebox-content"></div>
    </div>
</div>






