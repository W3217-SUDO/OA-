@model Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationClue.InvestigationClueModel

<style>
    .bootstrap-tagsinput {
        width: 100%;
        border-radius: 0px;
        padding: 2px 4px;
    }

        .bootstrap-tagsinput input {
            padding: 0px;
            width: 50px;
        }

    .btn-expense-file-upload input {
        position: absolute;
        top: 0px;
        right: 0px;
        left: 0px;
        bottom: 0px;
        opacity: 0;
        filter: alpha(opacity=0);
        overflow: hidden;
    }
</style>

<div class="modal fade" id="investigationClueFileModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="ng-scope">
                @using (Html.BeginForm("InvestigationClueFileUpload", "InvestigationClueFile", FormMethod.Post, new { id = "investigationClue", enctype = "multipart/form-data", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    @Html.HiddenFor(m => m.InvestigationClue.Basic.ClueGuid)

                    <div class="modal-header">
                        <button type="button" class="close" onclick="javascript: $('#investigationClueFileModal').modal('hide');">×</button>
                        <h5 class="modal-title ng-binding">线索信息</h5>
                    </div>
                    <div class="modal-body">
                        <div class="">
                            <div class="form-horizontal margin-top-3 ">

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger ng-binding">*</span>
                                        <span class="ng-binding">线索文件：</span>
                                    </label>
                                    <div class="col-sm-6">

                                        <div class="form-control-wrap">
                                            <input id="txtFilePath" placeholder="选择一个文件" disabled="disabled" class="form-control" style="height:30px;display:inline-block">
                                            <div class="btn btn-default btn-xs btn-expense-file-upload" style="height: 0px; line-height: 0px; padding: 0px;border:0px">
                                                <input type="file" value="" id="flFile" name="flFile" style="height: 30px; width: 250px; margin-left: 10px;">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                           
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-primary ng-binding" type="button" onclick="javascript: investigation.Investigations.Investigation.Clues.Clue.Files.File.FileUpload(false);" value="确定" />
                        <input class="btn btn-default ng-binding" type="button" onclick="javascript: $('#investigationClueFileModal').modal('hide');" value="取消" />

                    </div>
                }
            </div>
        </div>
    </div>
</div>
