@using Dchien.Legal.Entity.System
@model Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationClue.File.FileListModel

<form id="postForm" action="">
    <div class="gridSection">
        <div id='divContextList' style="overflow-y: auto; margin-top: -1px; overflow-x: hidden; overflow-y: auto; ">
            <table class='table table-hover' id="tblInvestigationClueFileList" width="100%" style="margin:0px">
                <colgroup>
                    <col style="width: 3%">
                    <col style="width: 10%">
 
                    <col style="width: 25%">
                    <col style="width: 10%">
                    <col style="width: 10%">
                </colgroup>
                <thead>
                    <tr>
                        <th width="10">
                            <input type="checkbox" id="chkInvestigationClueFileAll" name="chkInvestigationClueFileAll" >
                        </th>
                        
                        <th style="text-align: center">
                            上传人
                        </th>
                   
                        <th style="text-align: center">
                            文件名称
                        </th>
                        <th style="text-align: center">
                            文档日期
                        </th>
                        <th style="text-align: center">
                            操作
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="display: none">
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                       
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                    </tr>
                </tbody>
                <tfoot class="ng-scope" style="display:none">
                    <tr>
                        <td ><input type="checkbox"  id="chkInvestigationClueFileAll" name="chkInvestigationClueFileAll"></td>
                      
                          <td colspan="4">
                            <div class="pull-left">
                                <input type="button" onclick="javascript:investigation.Investigations.Investigation.Clues.Clue.Files.List();" id="btnInvestigationClueFileRefresh" class="btn btn-default" style="height:32px" value="刷新" />
                                @*<input type="button" id="btnInvestigationClueFileUpload" class="btn btn-default"  style="height:32px" value="上传" />*@

                                @if (Model.PageId == PageId.PageId_1401003000)
                                {
                                    <input type="button" id="btnInvestigationClueFileDelete" class="btn btn-default" style="height:32px" value="批量删除" />
                                }
                            </div>
                            <div class="ng-scope">
                                <div class="pull-right page-box InvestigationClueFile">
                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>
            <div class="simple-grid-none-data-wrap none-investigationcluefile">
                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                        <div class="text-size-16 tip-text inline-block">
                            <span class="margin-left ng-binding"></span>没有查询到线索文件。
                            @*<a href="javascript:void(0);" class="ng-binding" style="color: #039" id="btnInvestigationClueFileCreate">上传文件</a>*@
                            <span class="ng-binding"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.TotalCount, new { name = "TotalCount" })
    @Html.HiddenFor(m => m.PageNo, new { name = "PageNo" })
    @Html.HiddenFor(m => m.PageSize, new { name = "PageSize" })
</form>

