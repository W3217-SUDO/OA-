@model Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationClue.InvestigationClueListModel

<form id="postForm" action="">
    <div class="gridSection">
        <div id='divContextList' style="overflow-y: auto; margin-top: -1px; overflow-x: hidden; overflow-y: auto; ">
            <table class='table table-hover' id="tblInvestigationClueList" width="100%">
                <colgroup>
                    <col style="width: 3%">
                    <col style="width: 10%">
                    <col style="width: 6%">
                    <col style="width: 6%">
                    <col style="width: 10%">
                    <col style="width: 20%">
                    <col style="width: 6%">
                </colgroup>
                <thead>
                    <tr>
                        <td><input type="checkbox" id="chkClueAll" name="chkClueAll"></td>

                        <th style="text-align: center">
                            线索号
                        </th>
           
                        <th style="text-align: center">
                            调查时间

                        </th>
                        <th style="text-align: center">
                            侵权方式
                        </th>
                        <th style="text-align: center">
                            店铺名称
                        </th>
                        <th style="text-align: center">
                            调查地址
                        </th>
                        <th style="text-align: center">
                            状态
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="display: none">
                        <td style="text-align: left;white-space: nowrap;"></td>
                     
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                        <td style="text-align: center"></td>
                        <td style="text-align: left;white-space: nowrap;"></td>
                        <td style="text-align: left;white-space: nowrap;"></td>
                        <td style="text-align: left"></td>
                    </tr>
                </tbody>
                <tfoot class="ng-scope" style="display:none">
                    <tr>
                        <td><input type="checkbox" id="chkClueAll" name="chkClueAll"></td>
                        <td colspan="6">
                            <div class="pull-left">
                                
     
                            </div>
                            <div class="ng-scope">
                                <div class="pull-right page-box investigationclue">
                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>
            <div class="simple-grid-none-data-wrap none-investigationclue">
                <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                    <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                        <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                        <div class="text-size-16 tip-text inline-block">
                            <span class="margin-left ng-binding"></span>没有查询到任务线索。
                            @*<a href="javascript:void(0);" class="ng-binding" style="color: #039" id="btnInvestigationTaskClueCreate">新增</a>*@
                            <span class="ng-binding"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.TotalCount, new { name = "TotalCount" })
    @Html.HiddenFor(m => m.PageNo, new { name = "PageNo" })
    @Html.HiddenFor(m => m.PageSize, new { name = "PageSize" })
</form>

