@using Dchien.Legal.Service.BAS.Type
@using Dchien.Legal.Service.HR.Staff

@model Dchien.Legal.Web.Areas.CIT.ViewModels.Investigation.InvestigationModel

 <link type="text/css" rel="stylesheet" href=@Url.Content("~/Resource/css/ticketSystem/add.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"]) />

<script src="@Url.Content("~/Scripts/Common/jquery.form.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Common/citys/jquery.citys.json.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Common/citys/jquery.citys.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Common/bootstrap-tagsinput.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" type="text/javascript"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/CIT/Investigation/CIT.Investigation.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/CIT/Investigation/CIT.Investigation.ToAudit.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])"></script>

@{
    var staffs = StaffService.Instance.GetAuditorList(Dchien.Legal.Entity.System.AuditFlow.AuditType.Investigation);
    var lst = staffs.FindAll(x => x.StaffBasic.IsActived).GroupBy(x => x.StaffBasic.DepartmentId)
    .ToList();
}

<style>
    .chosen-container-single .chosen-single {
        border: 1px solid #cccccc;
        font-size: 12px;
        border-radius:0px;
    }
</style>


 <div class="viewFramework-product">
    <div class="viewFramework-product-body">
        <div class="console-container ">
            <div class="row ">
                <div class="col-sm-12">
                    <div class="console-title console-title-border clearfix">
                        <div class="pull-left">
                            <h5>提交分配</h5>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12">
                    <div style="margin-top:24px">
                        <div class="create-ticket-step clearfix ">
                            <div class="create-ticket-step-item ">
                                <div class="item-wrap">
                                    <span class="icon-step">1</span>
                                    <span class="dingding-text">新建调查任务</span>
                                </div>
                            </div>
                            <div class="create-ticket-step-item active">
                                <div class="item-wrap">
                                    <span class="icon-step">2</span>
                                    <span class="dingding-text">选择分配人</span>
                                </div>
                            </div>
                            <div class="create-ticket-step-item">
                                <div class="item-wrap">
                                    <span class="icon-step">3</span>
                                    <span class="dingding-text">完成分配</span>
                                </div>
                            </div>
                        </div>

                        <div class="table-viewer-header clearfix">
                            <span class="table-viewer-topbar-title">
                                <span>选择分配人</span>
                            </span>
                        </div>

                        <div class="table-content">
                            <form class="chat-form form-horizontal form-horizontal ">
                                <div class="simple-form-field  hide">
                                    @Html.HiddenFor(m => m.Investigation.Basic.InvestigationId)
                                    @Html.HiddenFor(m => m.Investigation.Basic.InvestigationNo)
                                </div>
                                <div class="simple-form-field ">
                                    <div class="form-group ng-scope">
                                        <div class="col-sm-4">
                                            <select data-placeholder="选择分配人"  id="Investigation_Basic_Auditor" class="Investigation_Basic_Auditor" style="height:26px;width: 100%;">
                                                @if (staffs != null && staffs.Count > 0)
                                                {
                                                    foreach (var staff in staffs)
                                                    {
                                                        <option value="@staff.StaffBasic.StaffName">@staff.StaffBasic.StaffChName</option>
                                                    }
                                                }
                                            </select>
                                         </div>
                                    </div>
                                </div>

                                <div class="simple-form-field ">
                                    <div class="form-group simple-form-submit ng-scope" style="margin-bottom:0px">
                                        <label for="submit5" class="col-sm-12 control-label"><span class="ng-binding"></span></label>
                                        <div class="col-sm-4">
                                             <input class="btn btn-primary" type="button" id="btnInvestigationToAudit" value="提交" />
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                       
                        <div ui-view="myTicket">
                            <div class="ticket-detail ng-scope">
                                <div class="table-viewer-header clearfix" style="margin-top: 12px">
                                    <span class="table-viewer-topbar-title">
                                        调查信息
                                    </span>
                                    <div class="pull-right table-viewer-topbar-content"></div>
                                </div>
                                <div class="info-panel" >
                                    <div class="row" style="margin-top:4px">
                                        <div class="col-sm-2 ">
                                            <span class="text-explode">
                                                <span> @Html.LabelFor(m => m.Investigation.Basic.InvestigationNo)</span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                    @Html.DisplayTextFor(m => m.Investigation.Basic.InvestigationNo)
                                            </span>
                                        </div>

                                        <div class="col-sm-2">
                                            <span class="text-explode">
                                                <span>@Html.LabelFor(m => m.Investigation.Basic.BusinessOwnerName)</span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                @Html.DisplayTextFor(m => m.Investigation.Basic.BusinessOwnerName)
                                            </span>
                                        </div>

                                        <div class="col-sm-2 ">
                                            <span class="text-explode">
                                                <span>@Html.LabelFor(m => m.Investigation.Basic.CaseTypeId)</span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                @Html.DisplayTextFor(m => m.Investigation.Basic.CaseTypeName)
                                            </span>
                                        </div>
                                    </div>

                                    <div class="row" style="margin-top:4px">
                                        <div class="col-sm-2 ">
                                            <span class="text-explode">
                                                <span>@Html.LabelFor(m => m.Investigation.Basic.IndicterName)</span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                @Html.DisplayTextFor(m => m.Investigation.Basic.IndicterName)
                                            </span>
                                        </div>

                                        <div class="col-sm-2 ">
                                            <span class="text-explode">
                                                <span>@Html.LabelFor(m => m.Investigation.Basic.AuthorizationBeginTime) </span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                @Html.DisplayFor(m => m.Investigation.Basic.AuthorizationBeginTime)
                                            </span>
                                        </div>
                                        <div class="col-sm-2 ">
                                            <span class="text-explode">
                                                <span>@Html.LabelFor(m => m.Investigation.Basic.AuthorizationEndTime) </span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                @Html.DisplayFor(m => m.Investigation.Basic.AuthorizationEndTime)
                                            </span>
                                        </div>
                                    </div>

                                    <div class="row" style="margin-top:4px">
                                        <div class="col-sm-12 ">
                                            <span class="text-explode">
                                                <span>@Html.LabelFor(m => m.Investigation.Basic.Province )</span>
                                                <span>:</span>
                                            </span>
                                            <span>
                                                @Html.DisplayTextFor(m => m.Investigation.Basic.Province)
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



 





