@using Dchien.Legal.Common
@using Dchien.Legal.Entity
@using Dchien.Legal.Entity.Account
@using Dchien.Legal.Service;
@model Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationTask.InvestigationTaskListModel

@{
    var display = "display:block";
   
    if (@Model.CaseTasks != null && @Model.CaseTasks.Count > 0)
    {
        display = "display:none";
    }
    
     var contactsList = Dchien.Legal.Service.IPR.Case.CaseCustomerService.Instance.GetCaseCustomerContactsList(Model.CaseId);
}

<form id="postForm" action="">
    <div id="taskgridSection" class="gridSection">

        <div id='divContextList' style="overflow-y: auto; margin-top: -1px; overflow-x: hidden; overflow-y: auto; ">
            <table class='table table-hover' id="tblCaseTask" width="100%">
                <colgroup>
                    <col style="width: 5%">
                    <col style="width: 13%">
                    <col style="width: 5%">
                    <col style="width: 15%">
                    <col style="width: 20%">
                    <col style="width: 8%">
                    <col style="width: 8%">
                    <col style="width: 8%">
                    <col style="width: 5%">
                    <col style="width: 8%">
                    <col style="width: 5%">

                </colgroup>

                <thead>
                    <tr>
                        <th style="text-align: center">
                            序号
                        </th>

                        <th style="text-align: center">
                            任务编号
                        </th>
                        <th style="text-align: center">
                            优先级
                        </th>

                        <th style="text-align: center">
                            标题
                        </th>
        
                        <th style="text-align: center">
                            具体内容
                        </th>
                        <th style="text-align: center">
                            提交时间
                        </th>
                        <th style="text-align: center">
                            截止日期
                        </th>
                        <th style="text-align: center">
                            剩余时间
                        </th>
                        <th style="text-align: center">
                            发起人
                        </th>
                        <th style="text-align: center">
                            负责人
                        </th>
                        <th style="text-align: center">
                            状态
                        </th>
                    </tr>

                </thead>

                <tbody>
                    @if (Model.CaseTasks != null)
                        {

                            foreach (var item in Model.CaseTasks)
                            {
                                <tr>

                                    <td style="text-align: center">
                                        <span>@(Model.CaseTasks.IndexOf(item) + 1)</span>
                                    </td>

                                    <td style="text-align: center">
                                        <span style="display:none" id="taskId">@item.TaskId</span>
                                        <span style="display:none" id="canModify">@item.Initiator.Equals(LoginHelper.GetUserName())</span>
                                        <a style='color: #039' href="javascript:void(0);" onclick="javascript:caseInfo.CaseTask.View('@item.TaskId'); "><span><span>@item.TaskNo</span> </span></a>

                                    </td>

                                    <td style="text-align: center">
                                        <span>@item.TaskPriorityName</span>
                                    </td>

                                    <td style="text-align: center">
                                     
                                        <span>@item.TaskTitle</span>
                                    </td>
                        
                                    <td style="text-align: center">
                                        <span>@item.TaskContent</span>
                                    </td>
                                    <td style="text-align: center">
                                        <span>@item.TaskBeginTime.ToString("yyyy-MM-dd")</span>
                                    </td>
                                    <td style="text-align: center">
                                        <span>@item.TaskEndTime.ToString("yyyy-MM-dd") </span>
                                    </td>

                                    @if (item.TaskStatus == Dchien.Legal.Entity.TP.TaskStatus.Finished
                                        || item.TaskStatus == Dchien.Legal.Entity.TP.TaskStatus.Checked)
                                        {
                                            <td style="text-align: center">
                                                <span></span>
                                            </td>
                                        }
                                    else
                                    {
                                        <td style="text-align: center">
                                            <span>@item.TaskRemainingDays /天</span>
                                        </td>
                                    }

                                    <td style="text-align: center">
                                        <span>@item.InitiatorName </span>
                                    </td>
                                    <td style="text-align: center">
                                        <span>@item.OfficerName </span>
                                    </td>

                                    @if (item.TaskStatus == Dchien.Legal.Entity.TP.TaskStatus.Pending
                                        || item.TaskStatus == Dchien.Legal.Entity.TP.TaskStatus.Processing)
                                    {
                                        <td style="text-align: center;background-color:red">
                                            <span style="color:white">@item.TaskStatusName</span>
                                          </td>
                                    }
                                    else if (item.TaskStatus == Dchien.Legal.Entity.TP.TaskStatus.Finished
                                    || item.TaskStatus == Dchien.Legal.Entity.TP.TaskStatus.Checked)
                                    {
                                        <td style="text-align: center;background-color:green">
                                            <span style="color:white">@item.TaskStatusName</span>
                                        </td>
                                    }

                                    else if (item.TaskStatus == Dchien.Legal.Entity.TP.TaskStatus.Rejected)
                                    {
                                        <td style="text-align: center;background-color:grey">
                                            <span style="color:white">@item.TaskStatusName</span>
                                        </td>
                                    }
                                </tr>
                        }
                    }
                </tbody>
                <tfoot class="ng-scope" style="display:none">
                    <tr>
                        <td colspan="11">
                            <div class="pull-left"></div>
                            <div class="ng-scope">
                                <div class="pull-right page-box casetask">

                                </div>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>


             @if (contactsList.Any(x => x.Item1 == (int)Dchien.Legal.Entity.IPR.Case.CaseCustomerContactsType.Technology)  
                 || CommonService.Instance.CheckPermission((int)Permission.CreateTask))
             {
                <div class="simple-grid-none-data-wrap" style="@display">
                    <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                        <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                            <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                            <div class="text-size-16 tip-text inline-block">
                                <span class="margin-left ng-binding"></span>没有查询到案件任务，可以去
                                <a href="javascript:void(0);" class="ng-binding" style="color: #039" id="btnCaseTaskCreate">发布任务</a>
                                <span class="ng-binding"></span>
                            </div>
                        </div>
                    </div>
                </div>
             }
             else
             {
                <div class="simple-grid-none-data-wrap" style="display:block">
                    <div class="simple-grid-none-data text-center ng-scope ng-isolate-scope">
                        <div class="simple-grid-none-data row-padding row-margin text-center  grid-no-data-sm" ng-class="vm.cls">
                            <span class="text-size-16 text-success icon-info-1" style="vertical-align: middle" ng-class="vm.iconCls"></span>
                            <div class="text-size-16 tip-text inline-block">
                                <span class="margin-left ng-binding">无案件技术联系人，不允许发布任务</span>
                            </div>
                        </div>
                    </div>
                </div>
             }

        </div>

    </div>


    <!-- Your custom menu with dropdown-menu as default styling -->
    <div class="contextMenu" id="taskMenu" style="display: none;">
        <ul style="width:150px">
            @{
                if (contactsList.Any(x => x.Item1 == (int)Dchien.Legal.Entity.IPR.Case.CaseCustomerContactsType.Technology) || CommonService.Instance.CheckPermission((int)Permission.CreateTask))
                {   
                    <li id="create">发布任务</li>
                    <li id="edit">任务修改</li>
                }
            }
            <li id="refresh">刷新</li>
        </ul>
    </div>

    @Html.HiddenFor(m => m.TotalCount, new { name = "TotalCount" })
    @Html.HiddenFor(m => m.PageNo, new { name = "PageNo" })
    @Html.HiddenFor(m => m.PageSize, new { name = "PageSize" })

</form>

