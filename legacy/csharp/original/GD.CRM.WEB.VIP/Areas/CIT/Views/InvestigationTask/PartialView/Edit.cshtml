@model Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationTask.InvestigationTaskModel

<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/font-awesome.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/input.dynamic.css")" />
<link type="text/css" rel="stylesheet" href="@Url.Content("~/Resource/css/citys/city.css")" />
<link rel="stylesheet" href="@Url.Content("~/Resource/css/bootstrap-tagsinput.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])" />
<link type="text/css" rel="stylesheet" href=@Url.Content("~/Resource/css/ticketSystem/add.css?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"]) />

<style>
    .bootstrap-tagsinput {
        width: 100%;
        border-radius: 0px;
        padding: 2px 4px;
    }

        .bootstrap-tagsinput input {
            padding: 0px;
            width: 50px;
        }
</style>

<div class="modal fade" id="investigationTaskModal">
    <div class="modal-dialog" style="width:660px">
        <div class="modal-content">
            <div class="ng-scope">
                @using (Html.BeginForm("InvestigationTask", "Edit", FormMethod.Post, new { id = "investigationTask", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    <div class="modal-header">
                        <button type="button" class="close" onclick="javascript: $('#investigationTaskModal').modal('hide');">×</button>
                        <h5 class="modal-title ng-binding">信息修改</h5>
                    </div>
                    <div class="modal-body">
                        <div class="">
                            <div class="form-horizontal margin-top-3 ">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span>调查员：</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.HiddenFor(m => m.InvestigationTask.Basic.InvestigationNo)
                                        @Html.HiddenFor(m => m.InvestigationTask.Basic.TaskNo  )
                                        <div class="bootstrap-tagsinput">
                                            <span class="tag label label-info">
                                                <a name="username" style="color:white; width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                                   username="REDACTED_ARCHIVE_ONLY" userchname="@Model.InvestigationTask.Basic.InvestigatorName"
                                                   title="" data-toggle="tooltip" data-container="body" href="javascript:void(0);">
                                                    @Model.InvestigationTask.Basic.InvestigatorName
                                                </a>
                                                @*<span class="userremove" data-role="remove"></span>*@
                                                </span>
                                            <input type="text" placeholder="" class="form-control inline-block" style="height:26px;width: 80px;margin-left: 6px; display:none" readonly autocomplete="off" size="1">
                                        </div>
                                        <div class="i_common_select" id="div_userlist" style="display: none;">
                                            <div class="i_common_wrap">
                                                <div class="i_common_list"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span>调查区域：</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.HiddenFor(m => m.Investigation.Basic.City)
                                        @Html.TextBoxFor(m => m.InvestigationTask.Basic.Province,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "调查区域",
                                                   style = "height:28px;width:100%",
                                                   cityvalue = Model.InvestigationTask.Basic.Province,
                                                   autocomplete = "off"
                                               })
                                        授权区域：@Html.DisplayFor(m => m.Investigation.Basic.InvestigationRegion)
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span>调查期限：</span>
                                    </label>
                                    <div class="col-sm-6">

                                        <div>
                                            @Html.HiddenFor(m => m.Investigation.Basic.AuthorizationBeginTime)
                                            @Html.HiddenFor(m => m.Investigation.Basic.AuthorizationEndTime)

                                            <div style="float:left;height:32px;width:50%;padding-right:10px">
                                                <input class="form-control inline-block" data-val="true"
                                                       id="InvestigationTask_Basic_BeginTime" name="InvestigationTask.Basic.BeginTime"
                                                       onfocus="WdatePicker({ doubleCalendar: true, dateFmt:'yyyy-MM-dd', minDate:'@Model.Investigation.Basic.AuthorizationBeginTime', maxDate:'@Model.Investigation.Basic.AuthorizationEndTime'})"
                                                       placeholder="开始时间"
                                                       style="height:29px;"
                                                       type="text" value="@Model.InvestigationTask.Basic.BeginTime.Value.ToString("yyyy-MM-dd")">


                                            </div>

                                            <div style="float:right;height:32px;width:50%;padding-left:10px">

                                                <input class="form-control inline-block" data-val="true"
                                                       id="InvestigationTask_Basic_EndTime" name="InvestigationTask.Basic.EndTime"
                                                       onfocus="WdatePicker({ doubleCalendar: true, dateFmt:'yyyy-MM-dd', minDate:'@Model.Investigation.Basic.AuthorizationBeginTime', maxDate:'@Model.Investigation.Basic.AuthorizationEndTime'})"
                                                       placeholder="结束时间"
                                                       style="height:29px;"
                                                       type="text" value="@Model.InvestigationTask.Basic.EndTime.Value.ToString("yyyy-MM-dd")">

                                            </div>
                                            <p id="custom_text3_description" class="help-block">
                                                授权时间：@Html.DisplayFor(m => m.Investigation.Basic.AuthorizationBeginTime) 至 @Html.DisplayFor(m => m.Investigation.Basic.AuthorizationEndTime)
                                            </p>
                                        </div>

                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">
                                        <span class="text-danger">*</span>
                                        <span>备注：</span>
                                    </label>
                                    <div class="col-sm-6">
                                        @Html.TextAreaFor(m => m.InvestigationTask.Basic.Remark,
                                               new
                                               {
                                                   @class = "form-control inline-block ",
                                                   placeholder = "备注",
                                                   rows = "3",
                                                   style = "width:100%"
                                               })

                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>
                        <div class="modal-footer">
                            <input class="btn btn-primary ng-binding" type="button" onclick="javascript: investigation.Investigations.Investigation.Tasks.Task.CreateUpdate(investigation.Investigations.Investigation.Tasks.Task.CreateUpdateCallBack_RefreshList);" value="确定" />
                            <input class="btn btn-default ng-binding" type="button" onclick="javascript:$('#investigationTaskModal').modal('hide');" value="取消" />
                        </div>
                }
            </div>
        </div>
    </div>
</div>

