 @using Dchien.Legal.Service.BAS.Type;
 @model Dchien.Legal.Web.Areas.CIT.ViewModels.InvestigationTask.InvestigationTaskModel
<script type="text/javascript" src="@Url.Content("~/Scripts/CIT/Investigation/CIT.Investigation.Task.Invoke.js?releaseno=" + System.Configuration.ConfigurationManager.AppSettings["ReleaseNo"])">
 </script>
<div class="case-section-wrap" style="padding-top: 3px;">
    <div class="case-section-product">
        <!-- product section -->
        <div class="product-container">
            <div class="product-section">
                <div class="section-content clearfix" style="padding: 0px; padding-left: 5px; padding-right: 5px; ">
                    <form id="form">
                        <div class="ng-scope">
                            <div class="table-viewer-header clearfix" style="margin-top: 0px">
                                <span class="table-viewer-topbar-title">
                                    任务信息
                                </span>
                                <div class="pull-right table-viewer-topbar-content" style="margin-top: 5px">
                                    @*<input class="btn btn-default" type="button" id="btnInvestigationEdit" value="修改">*@
                                    <input class="btn btn-default" type="button" onclick="javascript:investigation.Investigations.Investigation.Close();" value="关闭">
                                    <input class="btn btn-default" type="button" id="btnInvestigationCreateUpdate" value="保存" style="display:none">

                                </div>
                            </div>
                            <div id="divBasic" class="gridSection">

                                <table class="view_table table" style="width:100%">
                                    <colgroup>
                                        <col style="width: 8%;" />
                                        <col style="width: 12%;" />
                                        <col style="width: 8%;" />
                                        <col style="width: 52%;" />
 

                                    </colgroup>
                                    <tbody>

                                        <tr>
                                            <th>@Html.LabelFor(m => m.InvestigationTask.Basic.Province) </th>
                                            <td style="text-align:left;" colspan="3">@Html.DisplayTextFor(m => m.InvestigationTask.Basic.Province)</td>
                                        </tr>
                                        <tr>
                                            <th>@Html.LabelFor(m => m.InvestigationTask.Basic.BeginTime) </th>
                                            <td>
                                                @Html.DisplayFor(m => m.InvestigationTask.Basic.BeginTime)
                                            </td>

                                            <th>@Html.LabelFor(m => m.InvestigationTask.Basic.EndTime) </th>
                                            <td>
                                                @Html.DisplayFor(m => m.InvestigationTask.Basic.EndTime)
                                            </td>
                                        </tr>

                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="case-section-wrap" style="padding-top: 0;">
    <div class="case-section-product">
        <!-- product section -->
        <div class="product-container">
            <div class="product-section">
                <div class="section-content clearfix" style="padding: 0px; padding-left: 5px; padding-right: 5px; ">
                    <div class="table-viewer-header clearfix" style="margin-top: 0px">
                        <span class="table-viewer-topbar-title">
                            线索信息
                        </span>
                    </div>
                    <div id="dv_ClueList">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="case-section-wrap" style="padding-top: 0;">
    <div class="case-section-product">
        <!-- product section -->
        <div class="product-container">
            <div class="product-section">
                <div class="section-content clearfix" style="padding: 0px; padding-left: 5px; padding-right: 5px; ">
                    <form id="form">
                        <div class="ng-scope">
                            @Html.HiddenFor(m => m.Investigation.Basic.InvestigationId)
                            @Html.HiddenFor(m => m.Investigation.Basic.InvestigationNo)
                            @Html.HiddenFor(m => m.Investigation.Basic.InvestigationGuid)

                            @Html.HiddenFor(m => m.InvestigationTask.Basic.TaskNo)
                            <div class="table-viewer-header clearfix" style="margin-top: 0px">
                                <span class="table-viewer-topbar-title">
                                    基本信息
                                </span>
                                <div class="pull-right table-viewer-topbar-content"></div>
                                <span class="toggle-drop-down-icon ng-isolate-scope">
                                    <span class="table-viewer-dropdown icon-up" style="margin-top: 0px" 
                                          onclick="javascript: investigation.Investigations.Investigation.Layout.Display(this);"></span>
                                </span>
                            </div>
                            <div id="divInvestigationBasic" class="gridSection" style="display:none">

                                <table class="view_table table" style="width:100%">
                                    <colgroup>
                                        <col style="width: 8%;" />
                                        <col style="width: 12%;" />
                                        <col style="width: 8%;" />
                                        <col style="width: 12%;" />
                                        <col style="width: 8%;" />
                                        <col style="width: 12%;" />

                                    </colgroup>
                                    <tbody>

                                        <tr>
                                            <th>@Html.LabelFor(m => m.Investigation.Basic.InvestigationNo) </th>
                                            <td style="text-align:left">@Html.DisplayTextFor(m => m.Investigation.Basic.InvestigationNo)</td>

                                            <th>@Html.LabelFor(m => m.Investigation.Basic.BusinessOwnerName) </th>
                                            <td style="text-align:left">@Html.DisplayTextFor(m => m.Investigation.Basic.BusinessOwnerName)</td>
                                            <th>@Html.LabelFor(m => m.Investigation.Basic.CaseTypeId) </th>
                                            <td style="text-align:left">
                                                @Html.DisplayTextFor(m => m.Investigation.Basic.CaseTypeName)
                                            </td>
                                        </tr>
                                        <tr>

                                            <th>@Html.LabelFor(m => m.Investigation.Basic.IndicterName) </th>
                                            <td colspan="3" style="text-align:left">

                                                @Html.DisplayTextFor(m => m.Investigation.Basic.IndicterName)
                                            </td>

                                            <th>@Html.LabelFor(m => m.Investigation.Basic.AuthorizationBeginTime) </th>
                                            <td>
                                                @Html.DisplayFor(m => m.Investigation.Basic.AuthorizationBeginTime)
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>@Html.LabelFor(m => m.Investigation.Basic.Province) </th>
                                            <td colspan="3" style="text-align:left">
                                                @Html.DisplayTextFor(m => m.Investigation.Basic.InvestigationRegion)
                                            </td>

                                            <th>@Html.LabelFor(m => m.Investigation.Basic.AuthorizationEndTime) </th>
                                            <td>
                                                @Html.DisplayFor(m => m.Investigation.Basic.AuthorizationEndTime)
                                            </td>
                                        </tr>

                                        <tr>
                                            <th>@Html.LabelFor(m => m.Investigation.Basic.Remark) </th>
                                            <td colspan="5" style="text-align:left">
                                                @Html.DisplayTextFor(m => m.Investigation.Basic.Remark)
                                            </td>
 
                                        </tr>

                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="case-section-wrap" style="padding-top: 0;">
    <div class="case-section-product">
        <!-- product section -->
        <div class="product-container">
            <div class="product-section">

                <div class="section-content clearfix" style="padding: 0px; padding-left: 5px; padding-right: 5px; ">
                    <div class="table-viewer-header clearfix" style="margin-top: 0px">
                        <span class="table-viewer-topbar-title">
                            调查资料
                        </span>
                        <div class="pull-right table-viewer-topbar-content"></div>
                        <span class="toggle-drop-down-icon ng-isolate-scope">
                            <span  class="table-viewer-dropdown icon-up" style="margin-top: 0px" 
                                  onclick="javascript: investigation.Investigations.Investigation.Files.Display(this);"></span>
                        </span>
                    </div>
                    <div id="divInvestigationFiles" style="display:none">
                        <div id="dv_List">
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>

