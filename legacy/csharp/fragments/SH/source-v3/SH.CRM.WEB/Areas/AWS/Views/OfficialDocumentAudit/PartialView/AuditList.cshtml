@using Dchien.Legal.Common
@using Dchien.Legal.Service

@using Dchien.Legal.Entity.Account;

@model Dchien.Legal.Web.Areas.AWS.ViewModels.OfficialDocumentAudit.AuditListModel

<div class="modal fade" id="auditListModal">
    <div class="modal-dialog" style="width:55%">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("AuditList", "OfficialDocumentAudit", FormMethod.Post, new { id = "officialDocumentAuditForm", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    <div class="modal-header">
                        <button type="button" class="close" onclick="javascript: $('#auditListModal').modal('hide');" >×</button>
                        <h5 class="modal-title ">审批流程</h5>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div class="gridSection">
                                    <table  class="table table-hover" style='width:100%'>
                                        <colgroup>
                                            <col style="width: 20%">
                                            <col style="width: 10%">
                                            <col style="width: 10%">
                                            <col style="width: 40%">
                                            <col style="width: 10%">
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>审批人</th>
                                                <th>审核状态</th>
                                                <th>审核日期</th>
                                                <th>审批意见</th>
                                                <th>审批轮次</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.OfficialDocumentAuditList != null && Model.OfficialDocumentAuditList.Any())
                                            {
                                                foreach (var item in Model.OfficialDocumentAuditList)
                                                {
                                                    <tr>
                                                        <td>
                                                            @item.AuditorName
                                                        </td>
                                                        <td>
                                                            @item.AuditStatusName
                                                        </td>
                                                        <td>
                                                            @(item.AuditDate.HasValue ? item.AuditDate.Value.ToString("yyyy-MM-dd") : string.Empty)
                                                        </td>
                                                        <td>
                                                            @item.AuditContent 
                                                        </td>
                                                        <td>
                                                            @item.AuditRoundId 
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-default" onclick="javascript: $('#auditListModal').modal('hide');" type="button"   value="关闭" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>
