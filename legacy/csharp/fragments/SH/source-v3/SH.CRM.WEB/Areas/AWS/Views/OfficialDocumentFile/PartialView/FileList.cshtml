@using Dchien.Legal.Common
@using Dchien.Legal.Service

@using Dchien.Legal.Entity.Account;

@model Dchien.Legal.Web.Areas.AWS.ViewModels.OfficialDocumentFile.FileListModel

<div class="modal fade" id="fileListModal">
    <div class="modal-dialog" style="width:55%">
        <div class="modal-content" ng-transclude="">
            <div class="ng-scope">
                @using (Html.BeginForm("FileList", "OfficialDocumentFile", FormMethod.Post, new { id = "officialDocumentFileForm", @class = "form-horizontal ng-invalid ng-invalid-required" }))
                {
                    <div class="modal-header">
                        <button type="button" class="close" onclick="javascript: $('#fileListModal').modal('hide');" >×</button>
                        <h5 class="modal-title ">文件列表</h5>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <div class="col-sm-12">
                                <div class="gridSection">
                                    <table  class="table table-hover" style='width:100%'>
                                        <colgroup>
                                            <col style="width: 20%">
                                            <col style="width: 40%">
                                            <col style="width: 20%">
                                            <col style="width: 10%">
                                        </colgroup>
                                        <thead>
                                            <tr>
                                                <th>上传人</th>
                                                <th>文件名称</th>
                                                <th>文件日期</th>
                                                <th>操作</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Files != null && Model.Files.Any())
                                            {
                                                foreach (var item in Model.Files)
                                                {
                                                    <tr>
                                                        <td>
                                                            @item.UploaderName
                                                        </td>
                                                        <td style="text-align:left">
                                                            @item.FileName
                                                        </td>
                                                        <td>
                                                            @(item.UploadTime.HasValue ? item.UploadTime.Value.ToString("yyyy-MM-dd") : string.Empty)
                                                        </td>
                                                        <td>
                                                            <a href='javascript:void(0);' onclick="javascript:officialDocument.OfficialDocuments.OfficialDocument.Files.File.View('@item.FileId','@item.OfficialDocumentGuid','@item.FileName')"><span>查看</span></a>

                                                            <a href='javascript:void(0);' onclick="javascript:officialDocument.OfficialDocuments.OfficialDocument.Files.File.Download('@item.FileId')"><span>下载</span></a>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input class="btn btn-default" onclick="javascript: $('#fileListModal').modal('hide');" type="button"   value="关闭" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>
