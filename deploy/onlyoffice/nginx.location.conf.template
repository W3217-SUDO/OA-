# 仅在现有 HTTPS server 内引入，不替换 OA upstream。
location = /office {
    return 301 /office/;
}
location ^~ /office/ {
    location = /office/ { return 404; }
    location ~* ^/office/(example|admin|adminpanel|controlpanel|info|welcome)(/|$) {
        return 404;
    }
    proxy_pass http://127.0.0.1:@@PORT@@/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host/office;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /office;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $sunhold_office_connection;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
    client_max_body_size 21m;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header X-Content-Type-Options nosniff always;
}
