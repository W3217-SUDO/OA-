# 将 scripts/native_runtime.py 与 scripts/runtime_package.py 一同安装到 OA_NATIVE_TOOL 所在目录。
# 将此模板保存为 /etc/sunhold/native-runtime.env，权限设为 0600，并填写实际配置。
# 运行包与 current 链接目录由管理员持有，服务账户只读；激活前安装依赖锁定环境。
# 配置仅使用未加引号的 KEY=VALUE；激活时用 --env-file 加载此文件与服务相同的设置。
# 运行：python3 /usr/local/libexec/sunhold-native-runtime.py --env-file /etc/sunhold/native-runtime.env activate --package <运行包绝对路径> --current <OA_NATIVE_RUNTIME_CURRENT值> --expected-commit <40位提交号>
OA_NATIVE_TOOL=/usr/local/libexec/sunhold-native-runtime.py
OA_NATIVE_RUNTIME_CURRENT=/srv/sunhold/runtime/current
OA_NATIVE_PYTHON=/srv/sunhold/venv/bin/python
OA_NATIVE_NGINX=/usr/sbin/nginx
OA_NATIVE_MIME_TYPES=/etc/nginx/mime.types
OA_NATIVE_SYSTEMCTL=/usr/bin/systemctl
OA_NATIVE_API_SERVICE=sunhold-native-api@sunhold.service
OA_NATIVE_WEB_SERVICE=sunhold-native-web@sunhold.service
OA_NATIVE_API_HOST=127.0.0.1
OA_NATIVE_API_PORT=8001
OA_NATIVE_WEB_HOST=127.0.0.1
OA_NATIVE_WEB_PORT=8089
APP_ENV=production
SEED_DEMO_DATA=false
DATABASE_URL=
UPLOAD_ROOT=
SECRET_KEY=
INITIAL_ADMIN_PASSWORD=
