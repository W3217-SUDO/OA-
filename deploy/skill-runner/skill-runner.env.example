# 独立环境，禁止加入数据库、OSS、钉钉、模型密钥或 OA 登录配置。
# 管理员填写实际 Python 与本次不可变发布目录下的服务入口。
OA_SKILL_RUNNER_PYTHON=
PYTHONPATH=
OA_SKILL_RUNNER_API_USER=sunhold-oa
OA_SKILL_RUNNER_SOCKET=/run/oa-skill-runner/runner.sock
# 必须是已安装的专用技能镜像，使用 sha256 镜像 ID 或仓库固定摘要。
OA_SKILL_RUNNER_IMAGE=
OA_SKILL_RUNNER_NETWORK=
# OA API 单独配置 DEEPSEEK_HARNESS_SKILL_SOCKET 指向上面的 socket。
