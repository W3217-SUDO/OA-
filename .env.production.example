# Copy this file to .env.production on the server and replace every CHANGE_ME value.
# Keep .env.production outside source control and restrict it to the deployment user (chmod 600).

POSTGRES_DB=legal_platform
TZ=Asia/Shanghai
POSTGRES_USER=legal
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_URL_SAFE_PASSWORD
# The password in DATABASE_URL must be URL-encoded if it contains reserved URL characters.
DATABASE_URL=postgresql+asyncpg://legal:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/legal_platform

REDIS_PASSWORD=CHANGE_ME_GENERATE_URL_SAFE_PASSWORD
REDIS_URL=redis://:CHANGE_ME_URL_ENCODED_PASSWORD@redis:6379/0

SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_64_RANDOM_HEX_CHARACTERS
ACCESS_TOKEN_MINUTES=120

# Required only when the production database has no administrator yet.
# Use a one-time random password, sign in through the private deployment path, then rotate it immediately.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_GENERATE_AT_LEAST_20_RANDOM_CHARACTERS
INITIAL_ADMIN_DISPLAY_NAME=管理者
INITIAL_ADMIN_DEPARTMENT=上海分所
SEED_DEMO_DATA=false

MINIO_ROOT_USER=CHANGE_ME_MINIO_ADMIN_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS

# The production web container listens only on loopback by default.
# Put Caddy/Nginx/your cloud load balancer in front of this address for HTTPS.
WEB_BIND_ADDRESS=127.0.0.1
WEB_HTTP_PORT=8080

# Immutable application image tags are recommended after a registry is available.
API_IMAGE=sunhold-api:0.1.0
WEB_IMAGE=sunhold-web:0.1.0

# Optional Dify integration. Leave blank until it is enabled.
DIFY_BASE_URL=
DIFY_API_KEY=

# Optional DingTalk internal H5 application. Keep AppSecret on the API server only.
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_APP_URL=https://oa.example.com/
