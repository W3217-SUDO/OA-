#!/bin/sh
# OA_MANAGED_PRE_PUSH_V1
set -eu

commit=''
base=''
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/dev|refs/heads/main)
            case "$local_sha" in
                *[!0]*) ;;
                *) echo 'OA pre-push: deleting dev/main is not allowed.' >&2; exit 1 ;;
            esac
            if [ -n "$commit" ] && [ "$commit" != "$local_sha" ]; then
                echo 'OA pre-push: dev/main must reference the same checked commit.' >&2
                exit 1
            fi
            commit="$local_sha"
            base="$remote_sha"
            ;;
    esac
done
[ -n "$commit" ] || exit 0

if [ -z "${OA_QUALITY_PYTHON:-}" ] || [ -z "${OA_QUALITY_NODE:-}" ]; then
    echo 'OA pre-push: set OA_QUALITY_PYTHON (Python 3.12) and OA_QUALITY_NODE (Node.js 22).' >&2
    exit 1
fi
# 未显式设置并发时交由 quality_gate 按 CPU 自适应，默认值只在门禁里定义一处。
jobs=${OA_QUALITY_JOBS:-}
if [ -n "$jobs" ]; then
    case "$jobs" in
        *[!0-9]*|0) echo 'OA pre-push: OA_QUALITY_JOBS must be a positive integer.' >&2; exit 1 ;;
    esac
fi
root=$(git rev-parse --show-toplevel)
report=$(mktemp -d "${TMPDIR:-/tmp}/oa-pre-push-XXXXXX")
echo "OA pre-push: checking $commit; evidence: $report" >&2
PYTHONDONTWRITEBYTECODE=1 PYTHONIOENCODING=utf-8 "$OA_QUALITY_PYTHON" "$root/scripts/quality_gate.py" \
    --profile source --push-commit "$commit" --node "$OA_QUALITY_NODE" ${jobs:+--jobs "$jobs"} --report-dir "$report"
# 代码审查报告第一阶段只提示：门禁通过后才跑，结果和出错都不影响推送（docs/代码审查流程.md）。
if [ -f "$root/scripts/review/report.py" ]; then
    PYTHONDONTWRITEBYTECODE=1 PYTHONIOENCODING=utf-8 "$OA_QUALITY_PYTHON" "$root/scripts/review/report.py" \
        --head "$commit" --base "$base" --node "$OA_QUALITY_NODE" --report-dir "$report/review" >&2 \
        || echo 'OA pre-push: 代码审查报告没产出，不影响推送。' >&2
fi
